(require :asdf)
(asdf:load-asd (merge-pathnames "../../ooparts.asd" *load-truename*))
(asdf:load-system "ooparts/prolog")
(defpackage #:ooparts/prolog/competitive (:use #:cl #:ooparts/prolog))
(in-package #:ooparts/prolog/competitive)
(defun execution-mode ()
  (let ((value (string-downcase (or (uiop:getenv "BENCH_EXECUTION") "auto"))))
    (cond ((string= value "auto") :auto)
          ((string= value "wam") :wam)
          (t (error "Unknown BENCH_EXECUTION: ~A" value)))))
(defparameter *native-complete-cases* '("REVERSE" "QSORT"))
(defun require-complete-native (name statistics)
  "Deep workloads must run completely on one native attempt, cold and warm."
  (when (and (eq (execution-mode) :auto)
             (not (equal (uiop:getenv "OOPARTS_PROLOG_DISABLE_NATIVE") "1"))
             (member name *native-complete-cases* :test #'string=))
    (unless (and (= 1 (getf statistics :native-calls))
                 (zerop (getf statistics :native-deoptimizations)))
      (error "Expected complete native execution for ~A: ~S" name statistics))))
(defun run-case (name)
  (let ((vm (make-query (list (list 'bench (intern name *package*) '?result)))))
    (unwind-protect
         (multiple-value-bind (answer found) (next-solution vm)
           (unless found (error "No answer: ~A" name))
           (let ((statistics (query-statistics vm)))
             (require-complete-native name statistics)
             (values (cdr (assoc '?result answer)) statistics)))
      (close-query vm))))
(defun batch-size ()
  (parse-integer (or (uiop:getenv "BENCH_BATCH") "1")))
(defun run-benchmarks ()
  (let ((*database* (make-database :execution-mode (execution-mode))))
    (load-prolog-file "benchmarks/prolog/competitive.pl")
    (load-prolog-file "benchmarks/prolog/competitive-edges.pl")
    (dolist (name (if (uiop:getenv "BENCH_CASE") (list (uiop:getenv "BENCH_CASE"))
                     '("QUEENS" "TAK" "REVERSE" "QSORT" "GRAPH" "DIFFERENTIATE")))
      (let* ((cold-start (get-internal-run-time))
             (expected (multiple-value-bind (result statistics) (run-case name)
                         (format t "NATIVE ~A ~D ~D~%" name
                                 (getf statistics :native-calls)
                                 (getf statistics :native-deoptimizations))
                         result))
             (batch (batch-size)))
        (format t "COLD ~A ~,9F~%" name (/ (- (get-internal-run-time) cold-start) (float internal-time-units-per-second 1d0)))
        (dotimes (i (parse-integer (or (uiop:getenv "BENCH_REPEATS") "5")))
          (sb-ext:gc :full t)
          (let* ((start (get-internal-run-time)) (bytes (sb-ext:get-bytes-consed)))
            (dotimes (j batch) (assert (eql (run-case name) expected)))
            (let ((elapsed (/ (- (get-internal-run-time) start) (float internal-time-units-per-second 1d0))))
              (format t "RESULT ~A ~D ~,9F ~D ~D ~,9F~%" name expected (/ elapsed batch)
                      (floor (- (sb-ext:get-bytes-consed) bytes) batch) batch elapsed))
            (finish-output)))))))
(run-benchmarks)
