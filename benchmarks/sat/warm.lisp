;;; Warm solve/API timing; parsing and model/statistic checks are outside timing.
(require :asdf)
(let ((*compile-verbose* nil) (*load-verbose* nil))
  (asdf:load-asd (merge-pathnames "../../ooparts.asd" *load-truename*))
  (asdf:load-asd (merge-pathnames "../../ooparts-tests.asd" *load-truename*))
  (asdf:load-system "ooparts/sat")
  (asdf:load-system "ooparts-tests/sat/stats"))
;;; Benchmark protocol follows.
(defvar *inputs*
  (with-open-file (in (first (uiop:command-line-arguments)))
    (let* ((count (read in)) (cases (make-array count)))
      (dotimes (i count cases)
        (let ((n (read in)) (m (read in)) (limit (read in)) (lits nil))
          (dotimes (j m) (loop for lit = (read in) do (push lit lits) until (zerop lit)))
          (setf (aref cases i) (list n limit (coerce (nreverse lits) 'vector))))))))
(defun mix (hash value) (ldb (byte 64 0) (* (logxor hash value) 1099511628211)))
(defun run-batch (index repeats)
  (destructuring-bind (n limit lits) (aref *inputs* index)
    (let ((sc 0) (tc 0) (sw 0) (tw 0) (bytes 0) (total-bytes 0) (gc 0)
          (signature nil) (digest 1469598103934665603))
      (dotimes (r repeats)
        (let* ((c0 (get-internal-run-time)) (w0 (get-internal-real-time))
               (b0 (sb-ext:get-bytes-consed)) (g0 sb-ext:*gc-run-time*)
               (s (ooparts/sat/low-level:satch-init)))
          (ooparts/sat/low-level:satch-reserve s n)
          (map nil (lambda (literal) (ooparts/sat/low-level:satch-add s literal)) lits)
          (let* ((b1 (sb-ext:get-bytes-consed))
                 (c1 (get-internal-run-time)) (w1 (get-internal-real-time))
                 (status (ooparts/sat/low-level:satch-solve s limit))
                 (c2 (get-internal-run-time)) (w2 (get-internal-real-time))
                 (b2 (sb-ext:get-bytes-consed)) (g2 sb-ext:*gc-run-time*)
                 (model 2166136261))
            (incf sc (- c2 c1)) (incf sw (- w2 w1))
            (incf tc (- c2 c0)) (incf tw (- w2 w0))
            (incf bytes (- b2 b1)) (incf total-bytes (- b2 b0)) (incf gc (- g2 g0))
            (when (= status 10)
              (loop for v from 1 to n do
                (setf model (ldb (byte 32 0)
                              (* (logxor model (ldb (byte 32 0) (ooparts/sat/low-level:satch-val s v))) 16777619)))))
            (setf signature
                  (append (list status (ooparts/sat/low-level:satch-conflicts s))
                          (ooparts-tests/sat/stats:test-statistics s)
                          (list model (ooparts/sat/low-level:satch-maximum-variable s))))
            (dolist (v signature) (setf digest (mix digest v)))
            (let ((c3 (get-internal-run-time)) (w3 (get-internal-real-time))
                  (b3 (sb-ext:get-bytes-consed)))
              (ooparts/sat/low-level:satch-release s)
              (incf tc (- (get-internal-run-time) c3))
              (incf tw (- (get-internal-real-time) w3))
              (incf total-bytes (- (sb-ext:get-bytes-consed) b3))))))
      (format t "~D ~,9F ~,9F ~,9F ~,9F ~D ~D ~,9F ~D~{ ~D~}~%"
              repeats (/ sc internal-time-units-per-second) (/ tc internal-time-units-per-second)
              (/ sw internal-time-units-per-second) (/ tw internal-time-units-per-second)
              bytes total-bytes (/ gc internal-time-units-per-second) digest signature)
      (finish-output))))
(format t "READY~%") (finish-output)
(loop for index = (read *standard-input* nil nil) while (and index (>= index 0))
      for repeats = (read) do (run-batch index repeats))
