(defpackage #:ooparts/continuation/tests
  (:use #:cl #:ooparts/continuation)
  (:export #:run-tests))
(in-package #:ooparts/continuation/tests)

;; Independent, substitution-based CBV reduction semantics. No compiler IR,
;; runtime frame, trampoline, effect solver, or CPS evaluator is used here.
(defun ref-value-p (e)
  (or (numberp e) (member e '(nil t))
      (and (consp e) (eq (car e) 'lambda))))
(defun ref-free (e)
  (cond ((symbolp e) (unless (member e '(nil t)) (list e)))
        ((atom e) nil)
        ((eq (car e) 'lambda) (set-difference (ref-free (caddr e)) (cadr e)))
        ((eq (car e) 'shift) (remove (cadr e) (ref-free (caddr e))))
        (t (remove-duplicates (mapcan #'ref-free (cdr e))))))
(defun ref-subst (value var e)
  (cond ((eq e var) value)
        ((atom e) e)
        ((member (car e) '(lambda shift))
         (let* ((lambda-p (eq (car e) 'lambda))
                (bound (if lambda-p (caadr e) (cadr e))) (body (caddr e)))
           (cond ((eq bound var) e)
                 ((member bound (ref-free value))
                  (let ((fresh (gensym "ALPHA")))
                    (list (car e) (if lambda-p (list fresh) fresh)
                          (ref-subst value var (ref-subst fresh bound body)))))
                 (t (list (car e) (cadr e) (ref-subst value var body))))))
        (t (cons (car e) (mapcar (lambda (x) (ref-subst value var x)) (cdr e))))))
(defun ref-plug (context e)
  (dolist (f context e)
    (setf e (case (car f)
              (:reset `(reset ,e))
              (:left `(,(cadr f) ,e ,(caddr f)))
              (:right `(,(cadr f) ,(caddr f) ,e))
              (:if `(if ,e ,(cadr f) ,(caddr f)))
              (t (error "Bad reference context ~S" f))))))
(defun ref-decompose (e &optional context)
  (cond ((ref-value-p e) (values e context))
        ((eq (car e) 'reset)
         (if (ref-value-p (cadr e)) (values e context)
             (ref-decompose (cadr e) (cons '(:reset) context))))
        ((eq (car e) 'shift) (values e context))
        ((eq (car e) 'if)
         (if (ref-value-p (cadr e)) (values e context)
             (ref-decompose (cadr e) (cons (list :if (caddr e) (cadddr e)) context))))
        ((member (car e) '(+ * - = funcall))
         (cond ((not (ref-value-p (cadr e)))
                (ref-decompose (cadr e) (cons (list :left (car e) (caddr e)) context)))
               ((not (ref-value-p (caddr e)))
                (ref-decompose (caddr e) (cons (list :right (car e) (cadr e)) context)))
               (t (values e context))))
        (t (error "Stuck reference term ~S" e))))
(defun reference-eval (e &optional (fuel 10000))
  (loop repeat fuel
        when (ref-value-p e) return e
        do (multiple-value-bind (redex context) (ref-decompose e)
             (case (car redex)
               (shift
                (let ((split (position :reset context :key #'car)))
                  (unless split (error 'missing-reset))
                  (let* ((inner (subseq context 0 split)) (outer (nthcdr (1+ split) context))
                         (x (gensym "RESUME"))
                         (k `(lambda (,x) (reset ,(ref-plug inner x)))))
                    (setf e (ref-plug outer `(reset ,(ref-subst k (cadr redex) (caddr redex))))))))
               (reset (setf e (ref-plug context (cadr redex))))
               (funcall
                (let ((f (cadr redex)))
                  (unless (eq (car f) 'lambda) (error "Not a reference function."))
                  (setf e (ref-plug context (ref-subst (caddr redex) (caadr f) (caddr f))))))
               (if (setf e (ref-plug context (if (cadr redex) (caddr redex) (cadddr redex)))))
               (otherwise
                (setf e (ref-plug context (apply (symbol-function (car redex)) (cdr redex)))))))
        finally (error "Reference reduction exhausted fuel: ~S" e)))

(defun generated-core-terms ()
  ;; Finite, typed-by-construction terminating terms: each shift binder is
  ;; applied to integers, and each exposed result is an integer or Boolean.
  (let ((terms nil))
    (dotimes (i 12)
      (dotimes (j 12)
        (let ((x (gensym "X")) (k (gensym "K")) (h (gensym "H")))
          (dolist (e
                    (list
                     `(reset (+ ,i (shift ,k (+ (funcall ,k ,j) (funcall ,k ,(1+ j))))))
                     `(reset (* ,i (shift ,k (funcall ,k (+ ,j (funcall ,k 2))))))
                     `(reset (+ ,i (reset (+ ,j (shift ,k (funcall ,k 3))))))
                     `(reset (funcall (lambda (,x) (+ ,i ,x))
                                      (shift ,k (+ 2 (funcall ,k ,j)))))
                     `(reset (+ ,i (shift ,k (+ ,j (shift ,h (funcall ,h (funcall ,k 2)))))))
                     `(reset (+ (shift ,k (+ (funcall ,k ,i) (funcall ,k ,j)))
                                (shift ,h (+ 1 (funcall ,h 3)))))
                     `(reset (if (= ,i ,j) (shift ,k (+ 1 (funcall ,k 4))) (+ ,i ,j)))))
            (push e terms)))))
    (nreverse terms)))

(defvar *generator-state*)
(defun generate-choice (n)
  (setf *generator-state* (mod (+ (* *generator-state* 1664525) 1013904223) (expt 2 32)))
  (mod (ash *generator-state* -8) n))
(defun random-core-terms ()
  (let ((*generator-state* 20261029))
    (labels ((term (depth ints continuations)
               (if (zerop depth)
                   (if (and ints (zerop (generate-choice 3)))
                       (nth (generate-choice (length ints)) ints)
                       (- (generate-choice 5) 2))
                   (case (generate-choice 9)
                     ((0 1) (+-term '+ depth ints continuations))
                     (2 (+-term '* depth ints continuations))
                     (3 `(reset ,(term (1- depth) ints continuations)))
                     (4 (let ((k (gensym "K")))
                          `(shift ,k ,(term (1- depth) ints (cons k continuations)))))
                     (5 (let ((x (gensym "X")))
                          `(funcall (lambda (,x) ,(term (1- depth) (cons x ints) continuations))
                                    ,(term (1- depth) ints continuations))))
                     (6 `(if (= ,(term 0 ints continuations) ,(term 0 ints continuations))
                             ,(term (1- depth) ints continuations)
                             ,(term (1- depth) ints continuations)))
                     (7 (if continuations
                            `(funcall ,(nth (generate-choice (length continuations)) continuations)
                                      ,(term (1- depth) ints continuations))
                            (term (1- depth) ints continuations)))
                     (8 (term 0 ints continuations)))))
             (+-term (op depth ints continuations)
               `(,op ,(term (1- depth) ints continuations) ,(term (1- depth) ints continuations))))
      (loop for i below 320 collect `(reset ,(term (if (< i 192) 4 5) nil nil))))))
