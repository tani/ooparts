(require "asdf")
(asdf:load-system "ooparts/curses")
(ooparts/curses:with-screen ()
  (ooparts/curses:cbreak)
  (ooparts/curses:noecho)
  (ooparts/curses:keypad ooparts/curses:*stdscr* t)
  (ooparts/curses:timeout 100)
  (when (ooparts/curses:has-colors)
    (ooparts/curses:start-color)
    (ooparts/curses:init-pair 1 ooparts/curses:+color-cyan+ -1))
  (let ((y 3) (x 3))
    (loop
      (ooparts/curses:erase)
      (ooparts/curses:box ooparts/curses:*stdscr*)
      (ooparts/curses:mvprintw 1 2 "OOPArts Curses -- arrows move, q exits")
      (ooparts/curses:attr-set ooparts/curses:+a-bold+ 1)
      (ooparts/curses:mvaddch y x #\@)
      (ooparts/curses:attrset ooparts/curses:+a-normal+)
      (ooparts/curses:refresh)
      (let ((key (ooparts/curses:getch)))
        (cond ((= key (char-code #\q)) (return))
              ((= key ooparts/curses:+key-up+) (decf y))
              ((= key ooparts/curses:+key-down+) (incf y))
              ((= key ooparts/curses:+key-left+) (decf x))
              ((= key ooparts/curses:+key-right+) (incf x))))
      (setf y (max 2 (min y (- ooparts/curses:*lines* 2)))
            x (max 1 (min x (- ooparts/curses:*cols* 2)))))))
