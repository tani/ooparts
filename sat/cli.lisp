(let ((*compile-verbose* nil) (*load-verbose* nil))
  (load (merge-pathnames "load.lisp" *load-truename*)))
(handler-case
    (let ((args (uiop:command-line-arguments)))
      (unless (= (length args) 1)
        (format *error-output* "Usage: sbcl --script cli.lisp INPUT.cnf~%") (uiop:quit 1))
      (multiple-value-bind (status model) (sat:solve-file (first args))
        (format t "s ~A~%" (ecase status (:sat "SATISFIABLE") (:unsat "UNSATISFIABLE") (:unknown "UNKNOWN")))
        (when model (format t "v~{ ~D~} 0~%" (coerce model 'list)))
        (uiop:quit (ecase status (:sat 10) (:unsat 20) (:unknown 0)))))
  (error (e) (format *error-output* "ooparts/sat: ~A~%" e) (uiop:quit 1)))
