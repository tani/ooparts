(in-package #:ooparts/sat/low-level)
(declaim (sb-ext:unmuffle-conditions sb-ext:compiler-note))
(declaim (optimize (speed 3) (safety 3) (debug 1)))
(defconstant +unknown+ 0)
(defconstant +satisfiable+ 10)
(defconstant +unsatisfiable+ 20)
(declaim (type hash-table *live-solvers* *proof-handles*))
(defvar *api-lock* (sb-thread:make-mutex :name "ooparts/sat/low-level API"))
(defvar *live-solvers* (make-hash-table :test 'eql))
(defvar *proof-handles* (make-hash-table :test 'eql))
(defmacro api-locked (&body body) `(sb-thread:with-recursive-lock (*api-lock*) ,@body))
(declaim (ftype (function (t) (values ooparts/sat/impl::c-address &optional)) require-solver))
(defun require-solver (solver)
  (unless (gethash solver *live-solvers*) (error "Not a live SATCH solver: ~S" solver))
  (the ooparts/sat/impl::c-address solver))
(declaim (ftype (function (t) (values (signed-byte 32) &optional)) require-c-int require-literal))
(defun require-c-int (value)
  (unless (typep value '(signed-byte 32)) (error "C int out of range: ~S" value))
  (the (signed-byte 32) value))
(defun require-literal (value)
  (setf value (require-c-int value))
  (when (= value -2147483648) (error "INT_MIN is not a valid SATCH literal"))
  value)
(defun satch-init ()
  (api-locked
    (let ((solver (ooparts/sat/impl::|c/satch_init|)))
      (setf (gethash solver *live-solvers*) t) solver)))
(defun satch-release (solver)
  (api-locked
    (setf solver (require-solver solver))
    (ooparts/sat/impl::|c/satch_release| solver)
    (let ((handle (gethash solver *proof-handles*)))
      (when handle (remhash handle ooparts/sat/impl::*streams*) (remhash solver *proof-handles*)))
    (remhash solver *live-solvers*) nil))
(defun satch-trace-proof (solver stream)
  "Attach a character stream for ASCII proof or an octet stream for binary proof. NIL detaches."
  (api-locked
    (setf solver (require-solver solver))
    (when stream (check-type stream stream))
    (let ((old (gethash solver *proof-handles*))
          (handle (if stream (ooparts/sat/impl::register-stream stream) 0)))
      (ooparts/sat/impl::|c/satch_trace_proof| solver handle)
      (when old (remhash old ooparts/sat/impl::*streams*))
      (setf (gethash solver *proof-handles*) handle)) nil))
(defun satch-section (solver name)
  (api-locked (setf solver (require-solver solver))
    (let ((address (ooparts/sat/impl::c-string name)))
      (unwind-protect (ooparts/sat/impl::|c/satch_section| solver address)
        (ooparts/sat/impl::c-free address)))))
(defun satch-process-time () (ooparts/sat/impl::|c/satch_process_time|))
(defun satch-version () "0.5.6rc")
(defun satch-identifier () "b4d4081f8971931399b36c8fdd92bdf4aabac005")
(defun satch-compile () "Common Lisp / SBCL x86-64; SATCH production defaults (-DNDEBUG)")

(defun satch-add (solver elit)
 (api-locked (setf solver (require-solver solver))
  (setf elit (require-literal elit))
  (ooparts/sat/impl::|c/satch_add| solver elit)))

(defun satch-add-empty (solver)
 (api-locked (setf solver (require-solver solver))
  (ooparts/sat/impl::|c/satch_add_empty| solver)))

(defun satch-add-unit (solver unit)
 (api-locked (setf solver (require-solver solver))
  (setf unit (require-literal unit))
  (ooparts/sat/impl::|c/satch_add_unit| solver unit)))

(defun satch-add-binary-clause (solver a b)
 (api-locked (setf solver (require-solver solver))
  (setf a (require-literal a))
  (setf b (require-literal b))
  (ooparts/sat/impl::|c/satch_add_binary_clause| solver a b)))

(defun satch-add-ternary-clause (solver a b c)
 (api-locked (setf solver (require-solver solver))
  (setf a (require-literal a))
  (setf b (require-literal b))
  (setf c (require-literal c))
  (ooparts/sat/impl::|c/satch_add_ternary_clause| solver a b c)))

(defun satch-add-quaternary-clause (solver a b c d)
 (api-locked (setf solver (require-solver solver))
  (setf a (require-literal a))
  (setf b (require-literal b))
  (setf c (require-literal c))
  (setf d (require-literal d))
  (ooparts/sat/impl::|c/satch_add_quaternary_clause| solver a b c d)))

(defun satch-reserve (solver max-var)
 (api-locked (setf solver (require-solver solver))
  (setf max-var (require-c-int max-var))
  (when (minusp (the (signed-byte 32) max-var)) (error "Negative variable reserve"))
  (ooparts/sat/impl::|c/satch_reserve| solver max-var)))

(defun satch-maximum-variable (solver)
 (api-locked (setf solver (require-solver solver))
  (ooparts/sat/impl::|c/satch_maximum_variable| solver)))

(defun satch-val (solver elit)
 (api-locked (setf solver (require-solver solver))
  (setf elit (require-literal elit))
  (ooparts/sat/impl::|c/satch_val| solver elit)))

(defun satch-solve (solver conflict-limit)
 (api-locked (setf solver (require-solver solver))
  (setf conflict-limit (require-c-int conflict-limit))
  (ooparts/sat/impl::|c/satch_solve| solver conflict-limit)))

(defun satch-set-verbose-level (solver new-verbose-level)
 (api-locked (setf solver (require-solver solver))
  (setf new-verbose-level (require-c-int new-verbose-level))
  (ooparts/sat/impl::|c/satch_set_verbose_level| solver new-verbose-level)))

(defun satch-enable-logging-messages (solver)
 (api-locked (setf solver (require-solver solver))
  (ooparts/sat/impl::|c/satch_enable_logging_messages| solver)))

(defun satch-ascii-proof (solver)
 (api-locked (setf solver (require-solver solver))
  (ooparts/sat/impl::|c/satch_ascii_proof| solver)))

(defun satch-start-profiling-parsing (solver)
 (api-locked (setf solver (require-solver solver))
  (ooparts/sat/impl::|c/satch_start_profiling_parsing| solver)))

(defun satch-stop-profiling-parsing (solver)
 (api-locked (setf solver (require-solver solver))
  (ooparts/sat/impl::|c/satch_stop_profiling_parsing| solver)))

(defun satch-statistics (solver)
 (api-locked (setf solver (require-solver solver))
  (ooparts/sat/impl::|c/satch_statistics| solver)))

(defun satch-conflicts (solver)
 (api-locked (setf solver (require-solver solver))
  (ooparts/sat/impl::|c/satch_conflicts| solver)))
(defmacro with-solver ((var) &body body)
  `(let ((,var (satch-init))) (unwind-protect (progn ,@body) (satch-release ,var))))
(defun add-clause (solver literals)
  (map nil (lambda (literal)
             (when (zerop (the (signed-byte 32) literal)) (error "Zero inside a clause"))
             (satch-add solver literal)) literals)
  (satch-add solver 0))
(defun solve-cnf (clauses &key (conflict-limit -1) (reserve 0))
  "Return status (0/10/20), signed model vector or NIL, and number of conflicts."
  (with-solver (solver)
    (setf reserve (require-c-int reserve))
    (when (plusp reserve) (satch-reserve solver reserve))
    (dolist (clause clauses) (add-clause solver clause))
    (let ((status (satch-solve solver conflict-limit)))
      (values status
              (when (= status +satisfiable+)
                (map 'vector (lambda (i) (satch-val solver i))
                     (loop for i of-type (unsigned-byte 32) from 1 to (max reserve (satch-maximum-variable solver)) collect i)))
              (satch-conflicts solver)))))
(defun read-dimacs (stream)
  "Read strict DIMACS CNF without using the Lisp reader. Return clauses and declared variable count."
  (let ((clauses nil) (clause nil) (nvars nil) (nclauses nil))
    (declare (type (or null (integer 0 2147483647)) nvars nclauses))
    (loop for line = (read-line stream nil nil) while line do
      (let ((trim (the (simple-array character (*)) (string-left-trim '(#\Space #\Tab #\Return) (the (simple-array character (*)) line)))))
        (unless (or (zerop (length trim)) (char= (char trim 0) #\c))
          (let ((tokens (uiop:split-string trim :separator '(#\Space #\Tab #\Return))))
            (setf tokens (remove "" tokens :test #'string=))
            (cond ((string= (the (simple-array character (*)) (first tokens)) "p")
                   (unless (and (null nvars) (null clauses) (null clause)
                                (= (length tokens) 4) (string= (the (simple-array character (*)) (second tokens)) "cnf"))
                     (error "Invalid DIMACS header"))
                   (let ((nv (parse-integer (third tokens))) (nc (parse-integer (fourth tokens))))
                     (unless (and (typep nv '(integer 0 2147483647)) (typep nc '(integer 0 2147483647)))
                       (error "Invalid DIMACS counts"))
                     (setf nvars nv nclauses nc))
                   )
                  (t
                   (unless nvars (error "DIMACS header missing"))
                   (dolist (token tokens)
                     (let ((literal (require-literal (parse-integer token))))
                       (when (> (abs literal) (the (integer 0 2147483647) nvars)) (error "Literal outside declared variable range"))
                       (if (zerop (the (signed-byte 32) literal)) (progn (push (nreverse clause) clauses) (setf clause nil))
                           (push literal clause))))))))))
    (when clause (error "Unterminated DIMACS clause"))
    (unless (and nvars (= (the (integer 0 2147483647) nclauses) (length clauses))) (error "DIMACS clause count mismatch"))
    (values (nreverse clauses) nvars)))
(defun solve-file (path &key (conflict-limit -1))
  (with-open-file (in path)
    (multiple-value-bind (clauses nvars) (read-dimacs in)
      (solve-cnf clauses :reserve nvars :conflict-limit conflict-limit))))
