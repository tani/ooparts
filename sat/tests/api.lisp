(unless (and (find-package "OOPARTS/SAT/LOW-LEVEL") (fboundp (find-symbol "SATCH-INIT" "OOPARTS/SAT/LOW-LEVEL")))
  (load (merge-pathnames "../load.lisp" *load-truename*)))
(in-package #:ooparts/sat/low-level)
(defvar *checks* 0)
(defun check (test) (incf *checks*) (assert test))
(defun signals-error (thunk) (handler-case (progn (funcall thunk) nil) (error () t)))
;; Original testapi.c scenarios, including continuation after conflict limit.
(check (= 10 (solve-cnf nil)))
(check (= 20 (solve-cnf '(nil))))
(with-solver (s)
  (satch-add s 1) (satch-add s 0)
  (check (= 10 (satch-solve s -1))) (check (= 1 (satch-val s 1))))
(with-solver (s)
  (dolist (c '((1 2) (1 -2) (-1 2))) (add-clause s c))
  (check (= 10 (satch-solve s -1)))
  (dotimes (i 3) (check (= 1 (satch-val s 1))) (check (= 2 (satch-val s 2)))))
(check (= 20 (solve-cnf '((1 2) (1 -2) (-1 2) (-1 -2)))))
(with-solver (s)
  (loop for r in '(-1 1) do (loop for v in '(-1 1) do (loop for w in '(-1 1) do
    (satch-add s r) (satch-add s (* 2 v)) (satch-add s (* 3 w)) (satch-add s 0))))
  (let ((statuses (loop for limit from 0 below 10 for result = (satch-solve s limit)
                        collect result until (/= result 0))))
    (check (= 20 (car (last statuses)))) (check (= 0 (first statuses)))))
;; Independent solver state and safe release/lifetime errors.
(with-solver (a) (with-solver (b)
  (satch-add-unit a 1) (satch-add-unit b -1)
  (check (= 10 (satch-solve a -1))) (check (= 10 (satch-solve b -1)))
  (check (= 1 (satch-val a 1))) (check (= -1 (satch-val b 1)))))
(let ((s (satch-init))) (satch-release s) (check (signals-error (lambda () (satch-release s)))))
(with-solver (s)
  (check (signals-error (lambda () (satch-add s -2147483648))))
  (check (signals-error (lambda () (satch-add s (expt 2 40)))))
  (check (signals-error (lambda () (satch-reserve s -1))))
  (check (signals-error (lambda () (satch-val s 1))))
  (satch-add s 1)
  (check (signals-error (lambda () (satch-solve s -1)))))
(with-solver (s)
  (satch-add-ternary-clause s 1 2 3)
  (satch-add-quaternary-clause s -1 -2 3 4)
  (satch-reserve s 100)
  (check (= 4 (satch-maximum-variable s)))
  (check (= 10 (satch-solve s -1)))
  (check (= 100 (satch-val s -100)))
  (check (signals-error (lambda () (satch-add s 5))))
  (check (signals-error (lambda () (satch-solve s -1)))))
;; Non-quiet reporting/profiling paths; OS adapter and C-format compatibility.
(let ((out (make-string-output-stream)))
  (let ((*standard-output* out))
    (with-solver (s)
      (satch-start-profiling-parsing s) (satch-stop-profiling-parsing s)
      (satch-set-verbose-level s 4)
      (satch-add-binary-clause s 1 2) (satch-add-unit s -1)
      (check (= 10 (satch-solve s -1)))
      (satch-section s "Lisp API") (satch-statistics s)))
  (check (search "Lisp API" (get-output-stream-string out))))
;; Strict DIMACS parser and no read-time evaluation.
(multiple-value-bind (c n) (with-input-from-string (in (format nil "c comment~%p cnf 2 2~%1 -2 0~%2~%0~%")) (read-dimacs in))
  (check (= n 2)) (check (equal c '((1 -2) (2)))))
(dolist (s (list "p cnf 1 1" "p cnf 1 1 2 0" "p cnf 1 1 #.(error 1) 0"))
  (check (signals-error (lambda () (with-input-from-string (in s) (read-dimacs in))))))
 ;; The two-bit clause.vivify field crosses a byte boundary in GCC's layout.
(let ((p (ooparts/sat/impl::c-malloc 16)))
  (unwind-protect
       (progn
         (ooparts/sat/impl::c-memset p #xa5 16)
         (let ((original (ooparts/sat/impl::m-u16 p)))
           (dotimes (value 4)
             (ooparts/sat/impl::set-bits p 7 2 value)
             (let ((actual (ooparts/sat/impl::m-u16 p)))
               (check (and (= value (ldb (byte 2 7) actual))
                           (= (logand original #xfe7f) (logand actual #xfe7f))))))))
    (ooparts/sat/impl::c-free p)))
(format t "API: ~D checks passed.~%" *checks*)
