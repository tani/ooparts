(unless (find-package "OOPARTS/SAT")
  (load (merge-pathnames "../load.lisp" *load-truename*)))
(defpackage #:ooparts/sat/tests (:use #:cl))
(in-package #:ooparts/sat/tests)
(defparameter *checks* 0)
(defun check (value)
  (incf *checks*)
  (assert value))
(defmacro signals (type &body body)
  `(handler-case (progn ,@body nil) (,type () t)))
(defun live-count () (hash-table-count ooparts/sat/low-level::*live-solvers*))

(let ((before (live-count)))
  (multiple-value-bind (status model stats) (sat:solve-cnf nil)
    (check (eq status :sat)) (check (equalp model #()))
    (check (equal stats '(:status :sat :variables 0 :clauses 0 :conflicts 0))))
  (multiple-value-bind (status model) (sat:solve-cnf '(nil))
    (check (eq status :unsat)) (check (null model)))
  (check (= before (live-count))))

;; Lists and vectors, complete assignments, negative queries, detached snapshots.
(let ((snapshot nil) (stats nil))
  (sat:with-solver (s :clauses #((1) #(-2)) :variables 4)
    (declare (type sat:solver s))
    (check (sat:solver-p s)) (check (eq (sat:solver-status s) :building))
    (multiple-value-bind (status m info) (sat:solve s)
      (check (eq status :sat))
      (check (equalp m #(1 -2 3 4)))
      (setf snapshot m stats info))
    (check (sat:value s 1)) (check (not (sat:value s -1)))
    (check (sat:value s -2)) (check (not (sat:value s 2)))
    (check (sat:value s 4)) (check (not (sat:value s -4)))
    (setf (aref (sat:model s) 0) -1)
    (check (sat:value s 1))
    (check (signals sat:solver-state-error (sat:add-clause s '(3))))
    (check (signals sat:solver-state-error (sat:solve s)))
    (check (signals type-error (sat:value s 5)))
    (check (signals type-error (sat:value s 0))))
  (check (sat:model-value snapshot 1))
  (check (sat:model-value snapshot -2))
  (check (not (sat:model-value snapshot -4)))
  (check (= 4 (getf stats :variables)))
  (check (= 2 (getf stats :clauses)))
  (check (signals type-error (sat:model-value snapshot 5)))
  (check (signals type-error (sat:model-value #(1 0) 2))))

(sat:with-solver (s)
  (check (= 1 (sat:new-variable s)))
  (check (eq s (sat:add-clause s #(3 -2))))
  (check (= 4 (sat:new-variable s)))
  (check (eq s (sat:reserve-variables s 6)))
  (sat:reserve-variables s 2)
  (check (= 7 (sat:new-variable s)))
  (check (= 7 (getf (sat:statistics s) :variables)))
  (check (signals sat:solver-state-error (sat:model s)))
  (check (signals sat:solver-state-error (sat:value s 1)))
  (check (eq :sat (sat:solve s))))

;; Every invalid batch is rejected before any of its clauses reach the engine.
(sat:with-solver (s)
  (dolist (bad (list 0 -2147483648 2147483648 1.0 'x))
    (check (signals type-error (sat:add-clause s (list 1 bad)))))
  (check (signals type-error (sat:add-clauses s #((1) (2 0)))))
  (check (signals type-error (sat:add-clauses s '((1) (2 . 3)))))
  (check (signals type-error (sat:add-clause s "")))
  (let ((circle (list 1)))
    (setf (cdr circle) circle)
    (check (signals type-error (sat:add-clause s circle))))
  (check (= 0 (getf (sat:statistics s) :variables)))
  (check (= 0 (getf (sat:statistics s) :clauses)))
  (check (signals type-error (sat:reserve-variables s -1)))
  (check (signals type-error (sat:solve s :conflict-limit -1)))
  (check (signals type-error (sat:solve s :conflict-limit 2147483648)))
  (check (eq :building (sat:solver-status s)))
  (check (eq :sat (sat:solve s))))

;; UNKNOWN is distinct from UNSAT and can be resumed, but cannot accept clauses.
(let ((clauses (loop for a in '(-1 1) append
                 (loop for b in '(-2 2) append
                   (loop for c in '(-3 3) collect (list a b c))))))
  (sat:with-solver (s :clauses clauses)
    (multiple-value-bind (status model stats) (sat:solve s :conflict-limit 0)
      (check (eq status :unknown)) (check (null model))
      (check (eq :unknown (getf stats :status))))
    (check (signals sat:solver-state-error (sat:add-clause s '(1))))
    (check (signals sat:solver-state-error (sat:new-variable s)))
    (check (eq :unsat (sat:solve s)))
    (check (signals sat:solver-state-error (sat:model s)))
    (check (signals sat:solver-state-error (sat:solve s)))))

;; Ownership, idempotent close, exception/nonlocal-exit and constructor cleanup.
(let ((s (sat:make-solver)) (before (1- (live-count))))
  (check (not (sat:solver-closed-p s)))
  (check (null (sat:close-solver s)))
  (check (sat:solver-closed-p s))
  (check (null (sat:close-solver s)))
  (handler-case (sat:solve s)
    (sat:solver-state-error (condition)
      (check (eq s (sat:state-error-solver condition)))
      (check (eq :closed (sat:state-error-actual condition)))
      (check (eq 'sat:solve (sat:state-error-operation condition)))))
  (sat:with-solver (fresh :clauses '((1)))
    (check (signals sat:solver-state-error (sat:add-clause s '(1))))
    (check (eq :sat (sat:solve fresh))))
  (check (= before (live-count)))
  (check (signals error (sat:with-solver (owned) (error "test cleanup"))))
  (check (eq :escaped (catch 'escape (sat:with-solver (owned) (throw 'escape :escaped)))))
  (check (signals type-error (sat:make-solver :clauses '((1) (0)))))
  (check (signals type-error (sat:make-solver :variables -1)))
  (check (= before (live-count))))
(sat:with-solver (s) (sat:close-solver s))
(check (equal '(1 2 3) (multiple-value-list (sat:with-solver (s) (values 1 2 3)))))

;; An engine operation that leaves nonlocally is conservatively made unusable.
(sat:with-solver (s)
  (let ((original (symbol-function 'ooparts/sat/low-level:satch-solve)))
    (unwind-protect
         (progn
           (setf (symbol-function 'ooparts/sat/low-level:satch-solve)
                 (lambda (handle limit)
                   (declare (ignore handle limit))
                   (throw 'engine-interrupted :interrupted)))
           (check (eq :interrupted (catch 'engine-interrupted (sat:solve s))))
           (check (eq :failed (sat:solver-status s)))
           (check (signals sat:solver-state-error (sat:statistics s)))
           (check (signals sat:solver-state-error (sat:solve s))))
      (setf (symbol-function 'ooparts/sat/low-level:satch-solve) original))))

;; Strict stream parsing keeps input open and retains declared unused variables.
(with-input-from-string (in (format nil "c test~%p cnf 4 2~%1 0~%-2 0~%"))
  (multiple-value-bind (status model) (sat:solve-stream in)
    (check (eq status :sat)) (check (equalp model #(1 -2 3 4)))
    (check (open-stream-p in))))
(check (signals error
         (with-input-from-string (in "p cnf 1 1 #.(error 1) 0") (sat:solve-stream in))))
(let ((proof (make-string-output-stream)))
  (sat:with-solver (s :clauses '((1) (-1)) :proof-stream proof)
    (check (eq :unsat (sat:solve s))))
  (check (open-stream-p proof))
  (check (search (format nil "0~%") (get-output-stream-string proof))))
(let ((proof (make-string-output-stream)) (before (live-count)))
  (check (signals error (sat:make-solver :proof-stream proof :proof-format :binary)))
  (close proof)
  (check (signals error (sat:make-solver :proof-stream proof)))
  (check (= before (live-count))))

;; Independent exhaustive oracle, exercising both public CNF representations.
(let ((seed 20261029))
  (labels ((random-number (bound)
             (setf seed (mod (+ (* seed 1664525) 1013904223) 4294967296))
             (mod (ash seed -8) bound))
           (satisfied (clauses bits)
             (every (lambda (clause)
                      (some (lambda (literal)
                              (eq (plusp literal) (logbitp (1- (abs literal)) bits))) clause))
                    clauses)))
    (loop for n from 1 to 6 do
      (dotimes (case 16)
        (let* ((clauses (loop repeat (+ 1 (random-number 20)) collect
                         (loop repeat (+ 1 (random-number 3)) collect
                           (* (1+ (random-number n)) (if (zerop (random-number 2)) 1 -1)))))
               (sat-p (loop for bits below (ash 1 n) thereis (satisfied clauses bits)))
               (input (if (evenp case) clauses
                          (map 'vector (lambda (clause) (coerce clause 'vector)) clauses))))
          (multiple-value-bind (status model stats) (sat:solve-cnf input :variables n)
            (check (eq status (if sat-p :sat :unsat)))
            (check (= n (getf stats :variables)))
            (check (= (length clauses) (getf stats :clauses)))
            (if sat-p
                (check (every (lambda (clause)
                                (some (lambda (lit) (sat:model-value model lit)) clause)) clauses))
                (check (null model)))))))))
(format t "Lisp interface: ~D checks passed (including 96 exhaustive-oracle cases).~%" *checks*)
