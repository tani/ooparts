(unless (and (find-package "OOPARTS/SAT/LOW-LEVEL") (fboundp (find-symbol "SATCH-INIT" "OOPARTS/SAT/LOW-LEVEL")))
  (load (merge-pathnames "../load.lisp" *load-truename*)))
(in-package #:cl-user)
(let ((checks 0))
  (flet ((check (value) (incf checks) (assert value))
         (errors-p (thunk) (handler-case (progn (funcall thunk) nil) (error () t))))
    (check (= (ooparts/sat/impl::c-u64 -1) 18446744073709551615))
    (check (= (ooparts/sat/impl::c-s64 18446744073709551615) -1))
    (check (= (ooparts/sat/impl::c-s32 2147483648) -2147483648))
    (check (= (ooparts/sat/impl::c-u32 -1) 4294967295))
    (dolist (n '(0 1 4294967295 4294967296 9007199254740991 9007199254740992
                9007199254740993 9223372036854775807 18446744073709551615))
      (check (= (ooparts/sat/impl::integer64-double n nil) (float n 1d0))))
    (dolist (n '(-9223372036854775808 -9007199254740993 -4294967297 -1 0 1 9223372036854775807))
      (check (= (ooparts/sat/impl::integer64-double n t) (float n 1d0))))
    ;; Maximum uint64 is a valid sentinel, but never a physical arena size or pointer.
    (let ((cell (ooparts/sat/impl::c-malloc 16)))
      (unwind-protect
           (progn
             (setf (ooparts/sat/impl::m-u64 cell) 18446744073709551615)
             (check (= (ooparts/sat/impl::m-u64 cell) 18446744073709551615))
             (check (errors-p (lambda () (ooparts/sat/impl::m-size cell))))
             (check (errors-p (lambda () (ooparts/sat/impl::m-ptr cell))))
             (setf (ooparts/sat/impl::m-u64 cell) ooparts/sat/impl::+heap-size+)
             (check (= (ooparts/sat/impl::m-size cell) ooparts/sat/impl::+heap-size+)))
        (ooparts/sat/impl::c-free cell)))
    (multiple-value-bind (clauses n)
        (with-input-from-string (in (coerce (format nil "p cnf 1 1~%1 0~%") 'simple-base-string))
          (ooparts/sat/low-level:read-dimacs in))
      (check (and (= n 1) (equal clauses '((1)))))))
  (format t "Numeric/representation boundaries: ~D checks passed.~%" checks))
