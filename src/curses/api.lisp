(uiop:define-package #:ooparts/curses/api
  (:import-from #:ooparts/curses/metrics #:defapi)
  (:use #:cl #:ooparts/curses/model)
  (:import-from #:ooparts/curses/terminal
                #:open-terminal #:close-terminal #:set-input-mode #:terminal-size
                #:terminal-fd #:capture-mode #:restore-mode #:write-terminal-text)
  (:export
   #:*screen* #:*stdscr* #:*lines* #:*cols* #:*colors* #:*color-pairs*
   #:+ok+ #:+err+ #:+a-normal+ #:+a-bold+ #:+a-dim+ #:+a-underline+ #:+a-reverse+
   #:+a-blink+ #:+a-standout+ #:+a-invis+ #:+a-protect+ #:+a-altcharset+
   #:+color-black+ #:+color-red+ #:+color-green+ #:+color-yellow+ #:+color-blue+
   #:+color-magenta+ #:+color-cyan+ #:+color-white+
   #:+key-up+ #:+key-down+ #:+key-left+ #:+key-right+ #:+key-home+ #:+key-end+
   #:+key-backspace+ #:+key-dc+ #:+key-ic+ #:+key-npage+ #:+key-ppage+
   #:+key-enter+ #:+key-mouse+ #:+key-resize+ #:+key-paste-begin+ #:+key-paste-end+
   #:key-f #:keyname #:has-key #:define-key #:key-defined #:keybound #:keyok
   #:initscr #:endwin #:isendwin #:newterm #:set-term #:delscreen #:with-screen
   #:newwin #:delwin #:subwin #:derwin #:dupwin #:mvwin #:mvderwin
   #:syncok #:wsyncup #:wsyncdown #:wcursyncup #:newpad #:subpad
   #:prefresh #:pnoutrefresh #:pechochar #:pecho-wchar
   #:move #:wmove #:getyx #:getbegyx #:getmaxyx #:getparyx #:getsyx #:setsyx #:curs-set
   #:refresh #:wrefresh #:wnoutrefresh #:doupdate #:touchwin #:touchline #:wtouchln
   #:untouchwin #:is-linetouched #:is-wintouched #:redrawwin #:wredrawln
   #:erase #:werase #:clear #:wclear #:clrtoeol #:wclrtoeol #:clrtobot #:wclrtobot
   #:insertln #:winsertln #:deleteln #:wdeleteln #:insdelln #:winsdelln
   #:scroll #:scrl #:wscrl #:setscrreg #:wsetscrreg #:overlay #:overwrite #:copywin
   #:attron #:wattron #:attroff #:wattroff #:attrset #:wattrset
   #:attr-on #:wattr-on #:attr-off #:wattr-off #:attr-set #:wattr-set #:attr-get #:wattr-get
   #:standout #:wstandout #:standend #:wstandend #:color-set #:wcolor-set
   #:bkgd #:wbkgd #:bkgdset #:wbkgdset #:getbkgd #:getbkgrnd #:wgetbkgrnd
   #:bkgrnd #:wbkgrnd #:bkgrndset #:wbkgrndset
   #:start-color #:has-colors #:can-change-color #:init-pair #:pair-content
   #:init-color #:color-content #:color-pair #:pair-number
   #:use-default-colors #:assume-default-colors
   #:init-extended-pair #:init-extended-color #:extended-pair-content #:extended-color-content
   #:echo #:noecho #:raw #:noraw #:cbreak #:nocbreak #:nl #:nonl #:halfdelay
   #:keypad #:nodelay #:timeout #:wtimeout #:notimeout #:flushinp #:ungetch #:unget-wch
   #:clearok #:leaveok #:immedok #:scrollok #:idlok #:idcok
   #:def-prog-mode #:reset-prog-mode #:def-shell-mode #:reset-shell-mode #:savetty #:resetty
   #:beep #:flash #:napms #:termname #:longname #:termattrs #:term-attrs #:has-ic #:has-il
   #:resizeterm #:resize-term #:is-term-resized #:wresize #:set-escdelay #:get-escdelay
   #:set-tabsize #:character-width #:text-width #:unctrl #:wunctrl #:setcchar #:getcchar
   #:mouse-event #:make-mouse-event #:mouse-event-x #:mouse-event-y #:mouse-event-button
   #:mouse-event-action #:mouse-event-modifiers
   #:has-mouse #:mousemask #:getmouse #:ungetmouse #:mouseinterval #:wenclose
   #:mouse-trafo #:wmouse-trafo #:enable-paste
   #:putwin #:getwin #:scr-dump #:scr-restore #:scr-init #:scr-set))
(in-package #:ooparts/curses/api)

(defconstant +ok+ 0)
(defconstant +err+ -1)
(defconstant +key-code-yes+ 256)
(export '+key-code-yes+)
(defconstant +a-normal+ 0)
(defconstant +a-standout+ #x10000)
(defconstant +a-underline+ #x20000)
(defconstant +a-reverse+ #x40000)
(defconstant +a-blink+ #x80000)
(defconstant +a-dim+ #x100000)
(defconstant +a-bold+ #x200000)
(defconstant +a-altcharset+ #x400000)
(defconstant +a-invis+ #x800000)
(defconstant +a-protect+ #x1000000)
(defconstant +color-black+ 0)
(defconstant +color-red+ 1)
(defconstant +color-green+ 2)
(defconstant +color-yellow+ 3)
(defconstant +color-blue+ 4)
(defconstant +color-magenta+ 5)
(defconstant +color-cyan+ 6)
(defconstant +color-white+ 7)
(defconstant +key-down+ 258)
(defconstant +key-up+ 259)
(defconstant +key-left+ 260)
(defconstant +key-right+ 261)
(defconstant +key-home+ 262)
(defconstant +key-backspace+ 263)
(defconstant +key-dc+ 330)
(defconstant +key-ic+ 331)
(defconstant +key-npage+ 338)
(defconstant +key-ppage+ 339)
(defconstant +key-enter+ 343)
(defconstant +key-end+ 360)
(defconstant +key-mouse+ 409)
(defconstant +key-resize+ 410)
(defconstant +key-paste-begin+ 512)
(defconstant +key-paste-end+ 513)
(defvar *screen* nil)
(defvar *stdscr* nil)
(defvar *lines* 0)
(defvar *cols* 0)
(defvar *colors* 0)
(defvar *color-pairs* 65536)
(defvar *initialization-hooks* nil)
(defvar *filter-mode* nil)
(defvar *use-environment* t)
(defvar *use-tioctl* t)
(defvar *keys* (make-hash-table :test #'equal))
(defvar *disabled-keys* (make-hash-table))

(defapi active ()
  (or *screen* (error "Curses is not initialized.")))
(defapi valid-window-p (win)
  (and (window-p win) (not (window-deleted-p win))))
(defapi position-p (win y x)
  (and (valid-window-p win) (integerp y) (integerp x)
       (<= 0 y) (< y (window-rows win)) (<= 0 x) (< x (window-cols win))))
(defapi emit (control &rest arguments)
  (apply #'format (screen-output (active)) control arguments))
(defapi csi (parameters)
  (write-char (code-char 27) (screen-output (active)))
  (write-char #\[ (screen-output *screen*))
  (write-string parameters (screen-output *screen*)))
(defapi flush-output () (force-output (screen-output (active))))

(defapi set-term (screen)
  (prog1 *screen*
    (setf *screen* screen *stdscr* (and screen (screen-standard screen))
          *lines* (if screen (window-rows (screen-standard screen)) 0)
          *cols* (if screen (screen-cols screen) 0)
          *colors* (if (and screen (eq (screen-profile screen) :xterm)) 256 0))))

(defapi newterm (&key (input *terminal-io*) (output *terminal-io*) (native t) (fd 0)
                     rows cols (profile :xterm))
  "Create and select a screen. :NATIVE NIL allows deterministic stream rendering.
Native INPUT/OUTPUT must refer to the TTY identified by FD (default stdin)."
  (unless (member profile '(:vt100 :xterm)) (error "Unknown terminal profile ~S." profile))
  (let ((terminal (when native (open-terminal :stream input :fd fd)))
        (previous *screen*))
    (handler-case
        (progn
          (when (and terminal *use-tioctl*)
            (multiple-value-bind (r c) (terminal-size terminal)
              (setf rows (or rows r) cols (or cols c))))
          (when *use-environment*
            (flet ((env (name) (let ((value (uiop:getenv name))) (and value (ignore-errors (parse-integer value))))))
              (setf rows (or (env "LINES") rows) cols (or (env "COLUMNS") cols))))
          (setf rows (if *filter-mode* 1 (or rows 24)) cols (or cols 80))
          (unless (and (integerp rows) (plusp rows) (integerp cols) (plusp cols))
            (error "Invalid screen dimensions."))
          (let* ((standard (make-window :rows rows :cols cols))
                 (screen (make-screen :rows rows :cols cols :input input :output output
                                      :terminal terminal :profile profile :standard standard
                                      :desired (make-window :rows rows :cols cols)
                                      :physical (make-array (list rows cols) :initial-element nil)
                                      :windows (list standard))))
            (set-term screen)
            (dolist (hook *initialization-hooks*) (funcall hook screen))
            (when terminal (set-input-mode terminal :cbreak))
            (when (eq profile :xterm) (csi "?1049h"))
            (csi "0m")
            (flush-output)
            screen))
      (error (condition)
        (when terminal (close-terminal terminal))
        (set-term previous)
        (error condition)))))
(defapi initscr (&rest options)
  (apply #'newterm options) *stdscr*)
(defapi isendwin () (screen-ended-p (active)))
(defapi endwin ()
  (let ((screen (active)))
    (unless (screen-ended-p screen)
      (unwind-protect
           (progn
             (when (eq (screen-profile screen) :xterm)
               (csi "?1000l") (csi "?1002l") (csi "?1003l") (csi "?1006l") (csi "?2004l"))
             (csi "0m") (emit "~C(B" (code-char 27)) (csi "?25h") (csi "?7h")
             (when (eq (screen-profile screen) :xterm)
               (csi "0 q") (csi "0\"q")
               (maphash (lambda (color rgb) (declare (ignore rgb))
                          (emit "~C]104;~D~C\\" (code-char 27) color (code-char 27)))
                        (screen-colors screen)))
             (when (eq (screen-profile screen) :xterm) (csi "?1049l"))
             (flush-output))
        (unwind-protect
             (when (screen-terminal screen) (close-terminal (screen-terminal screen)))
          (setf (screen-ended-p screen) t)))))
  +ok+)
(defapi delscreen (screen)
  (let ((*screen* screen)) (endwin))
  (when (eq screen *screen*) (set-term nil))
  (dolist (win (screen-windows screen)) (setf (window-deleted-p win) t))
  +ok+)
(defmacro with-screen ((&rest options) &body body)
  "Restore the TTY on normal return, errors and non-local exits."
  `(let ((*screen* nil) (*stdscr* nil) (*lines* 0) (*cols* 0) (*colors* 0))
     (unwind-protect (progn (initscr ,@options) ,@body)
       (when *screen* (delscreen *screen*)))))

(defapi register-window (win)
  (push win (screen-windows (active))) win)
(defapi newwin (rows cols y x)
  (let ((s (active)))
    (setf rows (if (zerop rows) (- (screen-rows s) y) rows)
          cols (if (zerop cols) (- (screen-cols s) x) cols))
    (when (and (<= 0 y) (<= 0 x) (plusp rows) (plusp cols)
               (<= (+ y rows) (screen-rows s)) (<= (+ x cols) (screen-cols s)))
      (register-window (make-window :rows rows :cols cols :y y :x x)))))
(defapi derwin (parent rows cols y x)
  (when (and (valid-window-p parent) (<= 0 y) (<= 0 x))
    (setf rows (if (zerop rows) (- (window-rows parent) y) rows)
          cols (if (zerop cols) (- (window-cols parent) x) cols))
    (when (and (plusp rows) (plusp cols) (<= (+ y rows) (window-rows parent))
               (<= (+ x cols) (window-cols parent)))
      (register-window (make-window :rows rows :cols cols :parent parent :dy y :dx x
                                   :y (+ y (window-y parent)) :x (+ x (window-x parent))
                                   :pad-p (window-pad-p parent))))))
(defapi subwin (parent rows cols y x)
  (derwin parent rows cols (- y (window-y parent)) (- x (window-x parent))))
(defapi delwin (win)
  (if (or (not (valid-window-p win)) (window-children win) (eq win *stdscr*)) +err+
      (progn
        (when (window-parent win)
          (setf (window-children (window-parent win))
                (delete win (window-children (window-parent win)))))
        (setf (window-deleted-p win) t
              (screen-windows (active)) (delete win (screen-windows *screen*))) +ok+)))
(defapi dupwin (win)
  (when (valid-window-p win)
    (let ((copy (make-window :rows (window-rows win) :cols (window-cols win)
                             :y (window-y win) :x (window-x win) :pad-p (window-pad-p win))))
      (dotimes (y (window-rows win))
        (dotimes (x (window-cols win)) (setf (at copy y x) (copy-cell (at win y x)))))
      (setf (window-cy copy) (window-cy win) (window-cx copy) (window-cx win)
            (window-attrs copy) (window-attrs win) (window-pair copy) (window-pair win)
            (window-background copy) (copy-cell (window-background win)))
      (register-window copy))))
(defapi mvwin (win y x)
  (if (and (valid-window-p win) (<= 0 y) (<= 0 x)
           (<= (+ y (window-rows win)) *lines*) (<= (+ x (window-cols win)) *cols*))
      (let ((dy (- y (window-y win))) (dx (- x (window-x win))))
        (labels ((shift (w)
                   (incf (window-y w) dy) (incf (window-x w) dx)
                   (dolist (child (window-children w)) (shift child))))
          (shift win))
        (touchwin win) +ok+) +err+))
(defapi mvderwin (win y x)
  (let ((parent (window-parent win)))
    (if (and parent (<= 0 y) (<= 0 x) (<= (+ y (window-rows win)) (window-rows parent))
             (<= (+ x (window-cols win)) (window-cols parent)))
        (progn (setf (window-dy win) y (window-dx win) x) (touchwin win) +ok+) +err+)))
(defapi syncok (win flag) (setf (window-sync-p win) flag) +ok+)
(defapi wsyncup (win)
  (when (window-parent win)
    (dotimes (y (window-rows win))
      (when (aref (window-dirty win) y) (mark (window-parent win) (+ y (window-dy win)))))
    (wsyncup (window-parent win))) +ok+)
(defapi wsyncdown (win)
  (when (window-parent win)
    (wsyncdown (window-parent win))
    (dotimes (y (window-rows win))
      (when (aref (window-dirty (window-parent win)) (+ y (window-dy win))) (mark win y)))) +ok+)
(defapi wcursyncup (win)
  (when (window-parent win)
    (setf (window-cy (window-parent win)) (+ (window-cy win) (window-dy win))
          (window-cx (window-parent win)) (+ (window-cx win) (window-dx win)))
    (wcursyncup (window-parent win))) +ok+)
(defapi newpad (rows cols)
  (when (and (plusp rows) (plusp cols))
    (register-window (make-window :rows rows :cols cols :pad-p t))))
(defapi subpad (pad rows cols y x)
  (when (window-pad-p pad) (derwin pad rows cols y x)))
(defapi wmove (win y x)
  (if (position-p win y x) (progn (setf (window-cy win) y (window-cx win) x) +ok+) +err+))
(defapi move (y x) (wmove *stdscr* y x))
(defapi getyx (win) (values (window-cy win) (window-cx win)))
(defapi getbegyx (win) (values (window-y win) (window-x win)))
(defapi getmaxyx (win) (values (window-rows win) (window-cols win)))
(defapi getparyx (win) (if (window-parent win) (values (window-dy win) (window-dx win)) (values -1 -1)))
(defapi getsyx () (getyx (screen-desired (active))))
(defapi setsyx (y x)
  (let ((win (screen-desired (active))))
    (if (and (= y -1) (= x -1)) (setf (window-leave-p win) t)
        (progn (setf (window-leave-p win) nil) (wmove win y x)))) +ok+)
(defapi curs-set (visibility)
  (if (member visibility '(0 1 2))
      (prog1 (screen-cursor (active))
        (setf (screen-cursor *screen*) visibility)
        (csi (if (zerop visibility) "?25l" "?25h"))
        (when (eq (screen-profile *screen*) :xterm) (csi (if (= visibility 2) "1 q" "0 q")))
        (flush-output)) +err+))

(defapi wtouchln (win start count changed)
  (if (and (valid-window-p win) (<= 0 start) (<= 0 count) (<= (+ start count) (window-rows win)))
      (progn (loop for y from start below (+ start count)
                   do (setf (aref (window-dirty win) y) (not (null changed)))) +ok+) +err+))
(defapi touchwin (win) (wtouchln win 0 (window-rows win) t))
(defapi untouchwin (win) (wtouchln win 0 (window-rows win) nil))
(defapi touchline (win start count) (wtouchln win start count t))
(defapi is-linetouched (win line) (and (<= 0 line) (< line (window-rows win)) (aref (window-dirty win) line)))
(defapi is-wintouched (win) (some #'identity (window-dirty win)))
(defapi redrawwin (win) (setf (screen-force-p (active)) t) (touchwin win))
(defapi wredrawln (win start count) (setf (screen-force-p (active)) t) (touchline win start count))
(defapi clearok (win flag) (declare (ignore win)) (setf (screen-force-p (active)) flag) +ok+)
(defapi leaveok (win flag) (setf (window-leave-p win) flag) +ok+)
(defapi immedok (win flag) (setf (window-immediate-p win) flag) +ok+)
(defapi scrollok (win flag) (setf (window-scroll-p win) flag) +ok+)
;; Optimization hints never alter the visible semantics.
(defapi idlok (win flag) (declare (ignore win flag)) +ok+)
(defapi idcok (win flag) (declare (ignore win flag)) +ok+)
(defapi maybe-update (win result)
  (when (window-immediate-p win) (wrefresh win)) result)

(defapi erase-cell (win y x)
  "Erase a whole wide glyph if either its leading or trailing cell is touched."
  (let ((cell (at win y x)))
    (when (and (zerop (cell-width cell)) (plusp x))
      (setf (at win y (1- x)) (copy-cell (window-background win))))
    (when (and (= (cell-width cell) 2) (< (1+ x) (window-cols win)))
      (setf (at win y (1+ x)) (copy-cell (window-background win))))
    (setf (at win y x) (copy-cell (window-background win))) (mark win y)))
(defapi normalize-row (win y)
  (dotimes (x (window-cols win))
    (let ((cell (at win y x)))
      (when (or (and (zerop (cell-width cell))
                     (or (zerop x) (/= 2 (cell-width (at win y (1- x))))))
                (and (= 2 (cell-width cell))
                     (or (= x (1- (window-cols win)))
                         (not (zerop (cell-width (at win y (1+ x))))))))
        (setf (at win y x) (copy-cell (window-background win)))))))
(defapi werase (win)
  (dotimes (y (window-rows win))
    (dotimes (x (window-cols win)) (setf (at win y x) (copy-cell (window-background win))))
    (mark win y))
  (wmove win 0 0) (maybe-update win +ok+))
(defapi erase () (werase *stdscr*))
(defapi wclear (win) (setf (screen-force-p (active)) t) (werase win))
(defapi clear () (wclear *stdscr*))
(defapi wclrtoeol (win)
  (loop for x from (window-cx win) below (window-cols win) do (erase-cell win (window-cy win) x))
  (maybe-update win +ok+))
(defapi clrtoeol () (wclrtoeol *stdscr*))
(defapi wclrtobot (win)
  (wclrtoeol win)
  (loop for y from (1+ (window-cy win)) below (window-rows win) do
    (dotimes (x (window-cols win)) (erase-cell win y x))) (maybe-update win +ok+))
(defapi clrtobot () (wclrtobot *stdscr*))
(defapi wsetscrreg (win top bottom)
  (if (and (<= 0 top bottom) (< bottom (window-rows win)))
      (progn (setf (window-top win) top (window-bottom win) bottom) +ok+) +err+))
(defapi setscrreg (top bottom) (wsetscrreg *stdscr* top bottom))
(defapi shift-lines (win top bottom n)
  (let ((old (loop for y from top to bottom collect
                   (loop for x below (window-cols win) collect (copy-cell (at win y x))))))
    (loop for y from top to bottom do
      (let ((source (- y top n)))
        (dotimes (x (window-cols win))
          (setf (at win y x)
                (if (<= 0 source (- bottom top)) (nth x (nth source old))
                    (copy-cell (window-background win))))) (mark win y)))) +ok+)
(defapi winsdelln (win n)
  (if (<= (window-top win) (window-cy win) (window-bottom win))
      (maybe-update win (shift-lines win (window-cy win) (window-bottom win) n)) +err+))
(defapi insdelln (n) (winsdelln *stdscr* n))
(defapi winsertln (win) (winsdelln win 1))
(defapi insertln () (winsertln *stdscr*))
(defapi wdeleteln (win) (winsdelln win -1))
(defapi deleteln () (wdeleteln *stdscr*))
(defapi wscrl (win n)
  (if (window-scroll-p win)
      (maybe-update win (shift-lines win (window-top win) (window-bottom win) (- n))) +err+))
(defapi scrl (n) (wscrl *stdscr* n))
(defapi scroll (win) (wscrl win 1))

(defapi color-pair (number) (ash number 8))
(defapi pair-number (attributes) (ldb (byte 8 8) attributes))
(defapi as-cell (value &optional win)
  (if (typep value 'cell) (copy-cell value)
      (let* ((char (etypecase value
                     (character value) (string (char value 0))
                     (integer (or (code-char (logand value 255)) #\?))))
             (attrs (if (integerp value) (logand value #xffff0000) 0))
             (pair (if (integerp value) (pair-number value) 0)))
        (make-cell :text (string char) :width (max 0 (character-width char))
                   :attrs (logior attrs (if win (window-attrs win) 0))
                   :pair (if (plusp pair) pair (if win (window-pair win) 0))))))
(defapi next-line (win)
  (setf (window-cx win) 0)
  (cond ((= (window-cy win) (window-bottom win))
         (if (window-scroll-p win) (wscrl win 1) +err+))
        ((< (window-cy win) (1- (window-rows win))) (incf (window-cy win)) +ok+)
        (t +err+)))
(defapi write-glyph (win cell)
  (let* ((width (cell-width cell)) (y (window-cy win)) (x (window-cx win)))
    (when (plusp x)
      (let* ((px (if (and (> x 1) (zerop (cell-width (at win y (1- x))))) (- x 2) (1- x)))
             (previous (at win y px)) (old (cell-text previous))
             (code (first-codepoint (cell-text cell)))
             (join (or (zerop width)
                       (and (plusp (length old)) (= (last-codepoint old) #x200d))
                       (and (<= #x1f1e6 code #x1f1ff) (= (length old) (length (codepoint-string (first-codepoint old))))
                            (<= #x1f1e6 (first-codepoint old) #x1f1ff)))))
        (when join
          (let* ((copy (copy-cell previous))
                 (new-width (if (or (= code #xfe0f) (<= #x1f1e6 code #x1f1ff)) 2 (cell-width previous))))
            (when (> (+ px new-width) (window-cols win)) (return-from write-glyph +err+))
            (setf (cell-text copy) (concatenate 'string old (cell-text cell)) (cell-width copy) new-width
                  (at win y px) copy)
            (when (= new-width 2) (setf (at win y (1+ px)) (make-cell :text "" :width 0)))
            (incf (window-cx win) (- new-width (cell-width previous)))
            (mark win y) (return-from write-glyph +ok+)))))
    (when (zerop width) (return-from write-glyph +ok+))
    (when (> width (window-cols win)) (return-from write-glyph +err+))
    (when (> (+ x width) (window-cols win))
      (erase-cell win y x)
      (when (= (next-line win) +err+) (return-from write-glyph +err+))
      (setf y (window-cy win) x 0))
    (dotimes (i width) (erase-cell win y (+ x i)))
    (setf (at win y x) cell)
    (when (= width 2)
      (setf (at win y (1+ x)) (make-cell :text "" :width 0 :attrs (cell-attrs cell) :pair (cell-pair cell))))
    (mark win y)
    (if (= (+ x width) (window-cols win))
