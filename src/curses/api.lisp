                                  (gethash :reserved-bottom (screen-options s) 0)) cols) +err+) (return-from resize-term +err+))
    (wresize (screen-desired s) rows cols)
    (setf *lines* (window-rows *stdscr*) *cols* cols (screen-rows s) rows (screen-cols s) cols
          (screen-physical s) (make-array (list rows cols) :initial-element nil)
          (screen-force-p s) t)) +ok+)
