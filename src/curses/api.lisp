(defapi window-form (win)
  (list :ooparts-curses-window 1 (window-rows win) (window-cols win)
        (window-y win) (window-x win) (window-cy win) (window-cx win)
        (loop for y below (window-rows win) collect
          (loop for x below (window-cols win) for cell = (at win y x)
                collect (list (cell-text cell) (cell-attrs cell) (cell-pair cell) (cell-width cell))))))
(defapi putwin (win stream)
  (with-standard-io-syntax (let ((*print-readably* t)) (write (window-form win) :stream stream))) +ok+)
(defapi getwin (stream)
  (let* ((*read-eval* nil) (form (with-standard-io-syntax
                                (let ((*read-eval* nil)) (read stream nil nil)))))
    (unless (and (listp form) (= (length form) 9) (eq (first form) :ooparts-curses-window)
                 (eql (second form) 1)) (error "Invalid OOPArts window serialization."))
    (destructuring-bind (tag version rows cols y x cy cx data) form
      (declare (ignore tag version))
      (unless (and (integerp rows) (<= 1 rows 10000) (integerp cols) (<= 1 cols 10000)
                   (<= (* rows cols) 1000000) (integerp y) (integerp x)
                   (integerp cy) (<= 0 cy) (< cy rows) (integerp cx) (<= 0 cx) (< cx cols)
                   (= (length data) rows) (every (lambda (row) (= (length row) cols)) data))
        (error "Invalid window dimensions or cell data."))
      (let ((win (make-window :rows rows :cols cols :y y :x x)))
        (loop for row in data for r from 0 do
          (loop for entry in row for c from 0 do
            (destructuring-bind (text attrs pair width) entry
              (unless (and (stringp text) (integerp attrs) (integerp pair) (member width '(0 1 2))
                           (notany (lambda (char) (< (character-width char) 0)) text))
                (error "Invalid serialized cell."))
              (setf (at win r c) (make-cell :text text :attrs attrs :pair pair :width width))))
          (normalize-row win r))
        (setf (window-cy win) cy (window-cx win) cx) (register-window win)))))
(defapi scr-dump (pathname)
  (with-open-file (out pathname :direction :output :if-exists :supersede)
    (putwin (screen-desired (active)) out)))
(defapi scr-restore (pathname)
  (with-open-file (in pathname)
    (let ((win (getwin in)))
      (unwind-protect
           (if (and (= (window-rows win) *lines*) (= (window-cols win) *cols*))
               (copywin win (screen-desired (active)) 0 0 0 0 (1- *lines*) (1- *cols*) nil) +err+)
        (delwin win)))))
(defapi scr-init (pathname)
  (let ((status (scr-restore pathname)))
    (when (= status +ok+) (setf (screen-force-p (active)) t)) status))
(defapi scr-set (pathname) (scr-init pathname))
