      (if (zerop new) (csi "?1006l")
          (progn (csi "?1006h") (csi (if (logtest new +report-mouse-position+) "?1003h" "?1000h"))))
      (flush-output))
    (setf (screen-mouse-mask s) new) (values new old)))
