                          ("KEY_IC" . ,+key-ic+) ("KEY_NPAGE" . ,+key-npage+)
                          ("KEY_PPAGE" . ,+key-ppage+) ("KEY_ENTER" . ,+key-enter+)
                          ("KEY_MOUSE" . ,+key-mouse+) ("KEY_RESIZE" . ,+key-resize+))))
