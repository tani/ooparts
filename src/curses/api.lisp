         (window (intern (concatenate 'string "W" (string-upcase base))))
         (mv (intern (concatenate 'string "MV" (string-upcase base))))
         (mvw (intern (concatenate 'string "MVW" (string-upcase base)))))
    `(progn
       (defapi ,plain ,arguments (,window *stdscr* ,@arguments))
       (defapi ,mv (y x ,@arguments)
         (if (= (move y x) +err+) +err+ (,plain ,@arguments)))
       (defapi ,mvw (win y x ,@arguments)
         (if (= (wmove win y x) +err+) +err+ (,window win ,@arguments)))
       (eval-when (:compile-toplevel :load-toplevel :execute)
         (export '(,plain ,window ,mv ,mvw))))))
