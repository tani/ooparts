(defapi parse-mouse (sequence)
  (when (and (> (length sequence) 5) (char= (char sequence 1) #\[)
             (char= (char sequence 2) #\<) (find (char sequence (1- (length sequence))) "Mm"))
    (let* ((numbers (mapcar (lambda (s) (ignore-errors (parse-integer s)))
                            (uiop:split-string (subseq sequence 3 (1- (length sequence))) :separator ";"))))
      (when (and (= (length numbers) 3) (every #'integerp numbers))
        (destructuring-bind (bits x y) numbers
          (let* ((button (+ 1 (logand bits 3) (if (logbitp 6 bits) 3 0)))
                 (release (char= (char sequence (1- (length sequence))) #\m)) (motion (logbitp 5 bits))
                 (state (if motion +report-mouse-position+ (ash (if release 1 2) (* 5 (1- button)))))
                 (action (cond (motion :motion) (release :release) (t :press)))
                 (options (screen-options (active))) (now (milliseconds))
                 (press (gethash :mouse-press options)))
            (when (and (not motion) (not release)) (setf (gethash :mouse-press options) (list button x y now)))
            (when (and release press (equal (subseq press 0 3) (list button x y))
                       (plusp (screen-mouse-interval *screen*))
                       (<= (- now (fourth press)) (screen-mouse-interval *screen*)))
              (let* ((last (gethash :mouse-click options))
                     (count (if (and last (equal (subseq last 0 3) (list button x y))
                                     (<= (- now (fourth last)) (screen-mouse-interval *screen*)))
                                (min 3 (1+ (fifth last))) 1))
                     (click (ash (ash 1 (+ 1 count)) (* 5 (1- button)))))
                (setf (gethash :mouse-click options) (list button x y now count))
                (when (logtest click (screen-mouse-mask *screen*))
                  (setf state click action (nth (1- count) '(:click :double-click :triple-click))))))
            (when release (remhash :mouse-press options))
            (if (logtest state (screen-mouse-mask *screen*))
                (progn (setf (screen-mouse-events *screen*)
                             (nconc (screen-mouse-events *screen*)
                                    (list (make-mouse-event :x (1- x) :y (1- y) :button button :action action :bstate state
                                      :modifiers (loop for (bit modifier) in '((2 :shift) (3 :alt) (4 :control))
                                                       when (logbitp bit bits) collect modifier)))))
                       +key-mouse+) :ignored)))))))
(defapi milliseconds () (* 1000 (/ (get-internal-real-time) internal-time-units-per-second)))
(defapi poll-character (delay)
  (let ((input (screen-input (active))) (end (and (>= delay 0) (+ (milliseconds) delay))))
    (loop for char = (read-char-no-hang input nil :eof)
          when (eq char :eof) do (return :eof)
          when char do (return char)
          when (and end (>= (milliseconds) end)) do (return nil)
          do (sleep 0.002))))
(defapi check-resize ()
  (let ((s (active)))
    (when (and (screen-terminal s) *use-tioctl*)
      (multiple-value-bind (rows cols) (terminal-size (screen-terminal s))
        (when (and rows (is-term-resized rows cols) (= (resizeterm rows cols) +ok+)) +key-resize+)))))
(defapi decode-escape (win)
  (let ((sequence (string (code-char 27)))
        (delay (if (window-notimeout-p win) -1 (screen-escdelay (active)))))
    (loop for next = (poll-character delay) do
      (unless (characterp next) (return))
      (setf sequence (concatenate 'string sequence (string next)))
      (when (and (= (length sequence) 2) (not (find next "[O"))) (return))
      (let ((code (unless (screen-paste-p (active)) (gethash sequence *keys*))))
        (when (and code (not (gethash code *disabled-keys*))) (return-from decode-escape code)))
      (when (and (> (length sequence) 2) (<= #x40 (char-code next) #x7e))
        (let ((mouse (unless (screen-paste-p (active)) (parse-mouse sequence)))) (when mouse (return-from decode-escape mouse)))
        (when (and (not (screen-paste-p (active)))
                   (string= sequence (format nil "~C[200~C" (code-char 27) #\~)))
          (setf (screen-paste-p *screen*) t) (return-from decode-escape +key-paste-begin+))
        (when (string= sequence (format nil "~C[201~C" (code-char 27) #\~))
          (setf (screen-paste-p *screen*) nil) (return-from decode-escape +key-paste-end+))
        (return))
      (when (> (length sequence) 128) (return)))
    ;; Unknown or incomplete sequences are replayed without losing input.
    (loop for i downfrom (1- (length sequence)) to 1 do (ungetch (char sequence i)))
    (code-char 27)))
(defapi read-event (win)
  (let* ((s (active)) (queued (screen-unget s)))
    (when queued (return-from read-event (pop (screen-unget s))))
    (let ((resized (check-resize))) (when resized (return-from read-event resized)))
    (when (is-wintouched win) (unless (window-pad-p win) (wrefresh win)))
    (let* ((delay (window-delay win)) (end (and (>= delay 0) (+ (milliseconds) delay))) (char nil))
      (loop
        (setf char (poll-character (if end (min 50 (max 0 (- end (milliseconds)))) 50)))
        (when (eq char :eof) (return-from read-event +err+))
        (when char (return))
        (let ((resize (check-resize))) (when resize (return-from read-event resize)))
        (when (and end (>= (milliseconds) end)) (return-from read-event +err+))
        ;; String streams have a known finite end; do not spin at EOF.
        (when (typep (screen-input s) 'string-stream) (return-from read-event +err+)))
      (let ((event (if (and (window-keypad-p win) (= (char-code char) 27))
                       (decode-escape win) char)))
        (when (eq event :ignored) (return-from read-event (read-event win)))
        (when (and (characterp event) (<= (char-code event) 255)
                   (not (gethash :meta (window-options win) t)))
          (setf event (code-char (logand 127 (char-code event)))))
        (when (and (characterp event) (screen-nl-p s) (char= event #\Return)) (setf event #\Newline))
        (when (and (characterp event) (screen-echo-p s)) (wechochar win event)) event))))
