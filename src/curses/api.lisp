  (loop for suffix in '("[A" "[B" "[C" "[D" "[H" "[F" "OA" "OB" "OC" "OD" "OH" "OF"
                         "[1~" "[2~" "[3~" "[4~" "[5~" "[6~" "[7~" "[8~" "OM")
        for code in (list +key-up+ +key-down+ +key-right+ +key-left+ +key-home+ +key-end+
                          +key-up+ +key-down+ +key-right+ +key-left+ +key-home+ +key-end+
                          +key-home+ +key-ic+ +key-dc+ +key-end+ +key-ppage+ +key-npage+
                          +key-home+ +key-end+ +key-enter+)
        do (define-key (concatenate 'string (string (code-char 27)) suffix) code))
