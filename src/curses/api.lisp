(defapi wgetnstr (win n)
  (let ((result (make-array 0 :element-type 'character :fill-pointer 0 :adjustable t))
        (positions nil) (s (active)))
    (let ((echo (screen-echo-p s)))
      (unwind-protect
           (progn
             (setf (screen-echo-p s) nil)
             (loop for event = (read-event win) do
               (cond ((eql event +err+) (return (values (coerce result 'string) +err+)))
                     ((and (characterp event) (find event '(#\Newline #\Return)))
                      (when echo (wechochar win #\Newline))
                      (return (values (coerce result 'string) +ok+)))
                     ((or (eql event +key-backspace+)
                          (and (characterp event) (member (char-code event) '(8 127))))
                      (when (plusp (length result))
                        (decf (fill-pointer result))
                        (let ((position (pop positions)))
                          (when (and echo position)
                            (apply #'wmove win position) (wclrtoeol win) (wrefresh win)))))
                     ((and (characterp event) (or (minusp n) (< (length result) n)))
                      (push (multiple-value-list (getyx win)) positions)
                      (vector-push-extend event result)
                      (when echo (wechochar win event))))))
        (setf (screen-echo-p s) echo)))))
