(uiop:define-package #:ooparts/curses/extras
  (:import-from #:ooparts/curses/metrics #:defapi)
  (:use #:cl #:ooparts/curses/model #:ooparts/curses/api)
  (:import-from #:ooparts/curses/terminal)
  (:export #:filter #:nofilter #:use-env #:use-tioctl #:ripoffline #:getattrs #:key-name
           #:meta #:intrflush #:qiflush #:noqiflush #:typeahead #:baudrate #:erasechar #:killchar
           #:erasewchar #:killwchar #:delay-output #:mvcur #:vwprintw
           #:scanw #:wscanw #:mvscanw #:mvwscanw #:vw-scanw #:vwscanw
           #:slk-init #:slk-set #:slk-wset #:slk-label #:slk-clear #:slk-restore #:slk-touch
           #:slk-refresh #:slk-noutrefresh #:slk-attron #:slk-attroff #:slk-attrset
           #:slk-attr-on #:slk-attr-off #:slk-attr-set #:slk-attr #:slk-color))
(in-package #:ooparts/curses/extras)
(defapi filter () (setf ooparts/curses/api::*filter-mode* t))
(defapi nofilter () (setf ooparts/curses/api::*filter-mode* nil))
(defapi use-env (flag) (setf ooparts/curses/api::*use-environment* flag))
(defapi use-tioctl (flag) (setf ooparts/curses/api::*use-tioctl* flag))
(defapi getattrs (win) (logior (window-attrs win) (color-pair (window-pair win))))
(defapi key-name (char) (if (characterp char) (string char) (keyname char)))
(defapi meta (win flag)
  (setf (gethash :meta (window-options win)) flag)
  (when (screen-terminal *screen*) (ooparts/curses/terminal:terminal-meta (screen-terminal *screen*) flag)) +ok+)
(defapi qiflush ()
  (when (screen-terminal *screen*) (ooparts/curses/terminal:terminal-qiflush (screen-terminal *screen*) t))
  (setf (gethash :qiflush (screen-options *screen*)) t) +ok+)
(defapi noqiflush ()
  (when (screen-terminal *screen*) (ooparts/curses/terminal:terminal-qiflush (screen-terminal *screen*) nil))
  (setf (gethash :qiflush (screen-options *screen*)) nil) +ok+)
(defapi intrflush (win flag) (declare (ignore win)) (if flag (qiflush) (noqiflush)))
(defapi typeahead (fd)
  (if (and (integerp fd) (>= fd -1)) (progn (setf (gethash :typeahead (screen-options *screen*)) fd) +ok+) +err+))
(defapi baudrate () (if (screen-terminal *screen*) (ooparts/curses/terminal:terminal-speed (screen-terminal *screen*)) 0))
(defapi erasechar () (code-char (if (screen-terminal *screen*) (ooparts/curses/terminal:terminal-character (screen-terminal *screen*) :erase) 127)))
(defapi killchar () (code-char (if (screen-terminal *screen*) (ooparts/curses/terminal:terminal-character (screen-terminal *screen*) :kill) 21)))
(defapi erasewchar () (values (erasechar) +ok+))
(defapi killwchar () (values (killchar) +ok+))
(defapi delay-output (milliseconds) (force-output (screen-output *screen*)) (napms milliseconds))
(defapi mvcur (oldrow oldcol newrow newcol)
  (declare (ignore oldrow oldcol))
  (if (and (<= 0 newrow) (< newrow (screen-rows *screen*)) (<= 0 newcol) (< newcol (screen-cols *screen*)))
      (progn (ooparts/curses/api::csi (format nil "~D;~DH" (1+ newrow) (1+ newcol))) (ooparts/curses/api::flush-output) +ok+) +err+))
(defapi vwprintw (win control arguments) (vw-printw win control arguments))

(defvar *ripoffs* nil)
(defvar *slk-format* nil)
(defapi ripoffline (line callback)
  (if (and (member line '(-1 1)) (< (length *ripoffs*) 5))
      (progn (setf *ripoffs* (append *ripoffs* (list (cons line callback)))) +ok+) +err+))
(defapi slk-init (format)
  (if (member format '(0 1 2 3)) (progn (setf *slk-format* format) +ok+) +err+))
(defapi layout-screen (screen)
  (let* ((labels *slk-format*) (ripoffs *ripoffs*) (reserved (+ (length ripoffs) (if labels (if (= labels 3) 2 1) 0)))
         (standard (screen-standard screen)) (top 0) (bottom (screen-rows screen)))
    (setf *ripoffs* nil *slk-format* nil)
    (when (>= reserved bottom) (error "Not enough rows for reserved screen lines."))
    (dolist (entry ripoffs)
      (let* ((y (if (plusp (car entry)) (prog1 top (incf top)) (decf bottom)))
             (win (newwin 1 (screen-cols screen) y 0)))
        (funcall (cdr entry) win (screen-cols screen))))
    (when labels
      (let ((win (newwin (if (= labels 3) 2 1) (screen-cols screen) (- bottom (if (= labels 3) 2 1)) 0)))
        (setf (gethash :slk-window (screen-options screen)) win
              (gethash :slk-format (screen-options screen)) labels
              (gethash :slk-labels (screen-options screen)) (make-array (if (< labels 2) 8 12) :initial-element (list "" 0)))
        (decf bottom (window-rows win))))
    (when (plusp reserved)
      (wresize standard (- bottom top) (screen-cols screen))
      (setf (window-y standard) top *lines* (- bottom top)
            (gethash :reserved-top (screen-options screen)) top
            (gethash :reserved-bottom (screen-options screen)) (- (screen-rows screen) bottom)))))
(pushnew #'layout-screen ooparts/curses/api::*initialization-hooks*)
(defapi slk-window () (gethash :slk-window (screen-options *screen*)))
(defapi slk-set (number text justification)
  (let ((labels (gethash :slk-labels (screen-options *screen*))))
    (if (and labels (<= 1 number (length labels)) (member justification '(0 1 2)))
        (progn (setf (aref labels (1- number)) (list (string-trim '(#\Space) text) justification)) +ok+) +err+)))
(defapi slk-wset (number text justification) (slk-set number text justification))
(defapi slk-label (number)
  (let ((labels (gethash :slk-labels (screen-options *screen*))))
    (when (and labels (<= 1 number (length labels))) (first (aref labels (1- number))))))
(defapi slk-clear ()
  (if (slk-window) (progn (setf (gethash :slk-hidden (screen-options *screen*)) t) (werase (slk-window)) (wrefresh (slk-window))) +err+))
(defapi slk-touch () (if (slk-window) (touchwin (slk-window)) +err+))
(defapi slk-restore () (setf (gethash :slk-hidden (screen-options *screen*)) nil) (slk-refresh))
(defapi slk-noutrefresh ()
  (let ((win (slk-window)) (labels (gethash :slk-labels (screen-options *screen*))))
    (unless win (return-from slk-noutrefresh +err+))
    (werase win)
    (unless (gethash :slk-hidden (screen-options *screen*))
      (let ((width (max 1 (floor (window-cols win) (length labels)))))
        (loop for (text justify) across labels for i from 0 do
          (let* ((text (subseq text 0 (min (length text) (max 1 (1- width)))))
                 (offset (case justify (1 (floor (- width (length text)) 2)) (2 (- width (length text))) (t 0))))
            (wmove win (1- (window-rows win)) (+ (* i width) offset)) (waddstr win text)))))
    (wnoutrefresh win)))
(defapi slk-refresh () (let ((result (slk-noutrefresh))) (if (= result +ok+) (doupdate) result)))
(defapi slk-attron (attrs) (if (slk-window) (wattron (slk-window) attrs) +err+))
(defapi slk-attroff (attrs) (if (slk-window) (wattroff (slk-window) attrs) +err+))
(defapi slk-attrset (attrs) (if (slk-window) (wattrset (slk-window) attrs) +err+))
(defapi slk-attr-on (attrs) (slk-attron attrs))
(defapi slk-attr-off (attrs) (slk-attroff attrs))
(defapi slk-attr-set (attrs pair) (if (slk-window) (wattr-set (slk-window) attrs pair) +err+))
(defapi slk-attr () (if (slk-window) (getattrs (slk-window)) 0))
(defapi slk-color (pair) (if (slk-window) (wcolor-set (slk-window) pair) +err+))

(defapi scan-string (input control)
  "Read scanf conversions without invoking the Lisp reader on untrusted text.
Return an assignment list and count; %n records an offset without counting."
  (let ((i 0) (j 0) (values nil) (count 0))
    (labels ((whitespace (c) (find c '(#\Space #\Tab #\Newline #\Return #\Page)))
             (skip () (loop while (and (< i (length input)) (whitespace (char input i))) do (incf i)))
             (finish () (return-from scan-string (values (nreverse values) count))))
      (loop for char = (and (< j (length control)) (char control j)) while char do
        (incf j)
        (cond ((whitespace char) (skip))
              ((char/= char #\%) (unless (and (< i (length input)) (char= char (char input i))) (finish)) (incf i))
              (t
               (when (>= j (length control)) (error "Truncated scanf conversion."))
               (when (char= (char control j) #\%)
                 (unless (and (< i (length input)) (char= #\% (char input i))) (finish))
                 (incf i) (incf j) (setf char nil))
               (when char
                 (let ((suppress nil) (width nil) (start j))
                   (when (char= (char control j) #\*) (setf suppress t) (incf j))
                   (setf start j)
                   (loop while (and (< j (length control)) (digit-char-p (char control j))) do (incf j))
                   (when (> j start) (setf width (parse-integer control :start start :end j)))
                   (loop while (and (< j (length control)) (find (char control j) "hlLjzt")) do (incf j))
                   (when (>= j (length control)) (error "Truncated scanf conversion."))
                   (let* ((op (char control j)) (set nil) (negate nil) (value nil) (end nil))
                     (incf j)
                     (when (char= op #\[)
                       (when (and (< j (length control)) (char= (char control j) #\^)) (setf negate t) (incf j))
                       (let ((start j))
                         (when (and (< j (length control)) (char= (char control j) #\])) (incf j))
                         (loop while (and (< j (length control)) (char/= (char control j) #\])) do (incf j))
                         (unless (< j (length control)) (error "Unterminated scanf set."))
                         (setf set (subseq control start j)) (incf j)))
                     (unless (find op "c[n") (skip))
                     (setf start i end (min (length input) (+ i (or width (length input)))))
                     (cond
                       ((char= op #\n) (setf value i))
                       ((char= op #\c)
                        (setf end (+ i (or width 1))) (when (> end (length input)) (finish))
                        (setf value (subseq input i end) i end))
                       ((find op "s[")
                        (labels ((member-set (c)
                                   (or (find c set)
                                       (loop for k from 1 below (1- (length set))
                                             thereis (and (char= (char set k) #\-)
                                                          (char<= (char set (1- k)) c (char set (1+ k))))))))
                          (loop while (and (< i end)
                                           (if (char= op #\s) (not (whitespace (char input i)))
                                               (if negate (not (member-set (char input i))) (member-set (char input i)))))
                                do (incf i)))
                        (when (= i start) (finish)) (setf value (subseq input start i)))
                       ((find op "diouxX")
                        (let ((radix (case op (#\o 8) ((#\x #\X) 16) (t 10))) (sign 1))
                          (when (and (< i end) (find (char input i) "+-"))
                            (when (char= (char input i) #\-) (setf sign -1)) (incf i))
                          (when (and (< (+ i 1) end) (char= (char input i) #\0))
                            (cond ((and (find op "ixX") (find (char input (1+ i)) "xX")) (setf radix 16) (incf i 2))
                                  ((char= op #\i) (setf radix 8))))
                          (let ((digits i))
                            (loop while (and (< i end) (digit-char-p (char input i) radix)) do (incf i))
                            (when (= digits i) (finish))
                            (setf value (* sign (parse-integer input :start digits :end i :radix radix))))))
                       ((find op "aAeEfFgG")
                        (loop while (and (< i end) (find (char input i) "+-.0123456789eE")) do (incf i))
                        (let ((token (subseq input start i)))
                          (handler-case
                              (let ((*read-eval* nil) (*read-default-float-format* 'double-float))
                                (setf value (read-from-string token))
                                (unless (numberp value) (finish)))
                            (error () (finish)))))
                       (t (error "Unsupported scanf conversion ~C." op)))
                     (unless suppress (push value values) (unless (char= op #\n) (incf count)))))))))
      (finish))))
(defapi wscanw (win control) (multiple-value-bind (text status) (wgetstr win) (if (= status +err+) (values nil -1) (scan-string text control))))
(defapi scanw (control) (wscanw *stdscr* control))
(defapi mvscanw (y x control) (if (= (move y x) +err+) (values nil -1) (scanw control)))
(defapi mvwscanw (win y x control) (if (= (wmove win y x) +err+) (values nil -1) (wscanw win control)))
(defapi vw-scanw (win control &optional ignored) (declare (ignore ignored)) (wscanw win control))
(defapi vwscanw (win control &optional ignored) (declare (ignore ignored)) (wscanw win control))

;; DEC graphics use single-column ASCII codes plus the alternate charset flag.
(eval-when (:load-toplevel :execute)
  (dolist (entry '(("ULCORNER" #\l #x250c) ("LLCORNER" #\m #x2514) ("URCORNER" #\k #x2510)
                   ("LRCORNER" #\j #x2518) ("LTEE" #\t #x251c) ("RTEE" #\u #x2524)
                   ("BTEE" #\v #x2534) ("TTEE" #\w #x252c) ("HLINE" #\q #x2500)
                   ("VLINE" #\x #x2502) ("PLUS" #\n #x253c) ("S1" #\o #x23ba) ("S9" #\s #x23bd)
                   ("DIAMOND" #\` #x25c6) ("CKBOARD" #\a #x2592) ("DEGREE" #\f #xb0)
                   ("PLMINUS" #\g #xb1) ("BULLET" #\~ #xb7) ("LARROW" #\, #x2190)
                   ("RARROW" #\+ #x2192) ("DARROW" #\. #x2193) ("UARROW" #\- #x2191)
                   ("BOARD" #\h #x2592) ("LANTERN" #\i #x2603) ("BLOCK" #\0 #x2588)
                   ("S3" #\p #x23bb) ("S7" #\r #x23bc) ("LEQUAL" #\y #x2264)
                   ("GEQUAL" #\z #x2265) ("PI" #\{ #x3c0) ("NEQUAL" #\| #x2260) ("STERLING" #\} #xa3)))
    (destructuring-bind (name dec unicode) entry
      (let ((acs (intern (format nil "+ACS-~A+" name))) (wacs (intern (format nil "+WACS-~A+" name))))
        (set acs (make-cell :text (string dec) :attrs +a-altcharset+))
        (set wacs (make-cell :text (string (code-char unicode))))
        (proclaim (list 'special acs wacs)) (export (list acs wacs))))))
