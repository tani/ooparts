(uiop:define-package #:ooparts/curses/form
  (:import-from #:ooparts/curses/metrics #:defapi)
  (:use #:cl #:ooparts/curses/api #:ooparts/curses/model)
  (:import-from #:ooparts/regexp)
  (:export #:new-field #:free-field #:dup-field #:link-field #:field-info #:dynamic-field-info
           #:move-field #:field-buffer #:set-field-buffer #:set-max-field #:field-index
           #:field-just #:set-field-just #:field-fore #:set-field-fore #:field-back #:set-field-back
           #:field-pad #:set-field-pad #:field-opts #:set-field-opts #:field-opts-on #:field-opts-off
           #:field-status #:set-field-status #:field-userptr #:set-field-userptr #:new-page #:set-new-page
           #:new-fieldtype #:free-fieldtype #:link-fieldtype #:set-fieldtype-arg #:set-fieldtype-choice
           #:field-type #:set-field-type #:field-arg #:type-alpha #:type-alnum #:type-integer #:type-numeric
           #:type-enum #:type-regexp #:type-ipv4
           #:new-form #:free-form #:form-fields #:set-form-fields #:field-count
           #:post-form #:unpost-form #:form-driver #:form-driver-w #:current-field #:set-current-field
           #:form-page #:set-form-page #:scale-form #:form-win #:set-form-win #:form-sub #:set-form-sub
           #:form-userptr #:set-form-userptr #:form-opts #:set-form-opts #:form-opts-on #:form-opts-off
           #:form-init #:set-form-init #:form-term #:set-form-term #:field-init #:set-field-init #:field-term #:set-field-term
           #:pos-form-cursor #:data-ahead #:data-behind #:form-request-name #:form-request-by-name))
(in-package #:ooparts/curses/form)
(defconstant +o-visible+ 1) (defconstant +o-active+ 2) (defconstant +o-public+ 4)
(defconstant +o-edit+ 8) (defconstant +o-wrap+ 16) (defconstant +o-blank+ 32)
(defconstant +o-autoskip+ 64) (defconstant +o-nullok+ 128)
(defconstant +o-passok+ 256) (defconstant +o-static+ 512)
(defconstant +o-nl-overload+ 1) (defconstant +o-bs-overload+ 2)
(defconstant +no-justification+ 0) (defconstant +justif-left+ 1)
(defconstant +justif-center+ 2) (defconstant +justif-right+ 3)
(export '(+o-visible+ +o-active+ +o-public+ +o-edit+ +o-wrap+ +o-blank+ +o-autoskip+
          +o-nullok+ +o-passok+ +o-static+ +o-nl-overload+ +o-bs-overload+
          +no-justification+ +justif-left+ +justif-center+ +justif-right+))
(defstruct (field (:constructor %field)) (rows nil) (cols nil) (y nil) (x nil) (offscreen nil) (buffers nil) (just 0) (fore 0) (back 0)
  (pad #\Space) (opts 1023) (status nil) (userptr nil) (page nil) (owner nil) (type nil) (arg nil) (max nil))
(defstruct (fieldtype (:constructor new-fieldtype (field-check char-check))) (field-check nil) (char-check nil) (make-arg nil) (copy-arg nil) (free-arg nil) (next nil) (prev nil))
(defparameter type-alpha :alpha) (defparameter type-alnum :alnum) (defparameter type-integer :integer)
(defparameter type-numeric :numeric) (defparameter type-enum :enum) (defparameter type-regexp :regexp)
(defparameter type-ipv4 :ipv4)
(defapi free-fieldtype (type) (declare (ignore type)) +ok+)
(defapi link-fieldtype (left right)
  (new-fieldtype (lambda (f args) (or (validate-field f left args) (validate-field f right args))) nil))
(defapi set-fieldtype-arg (type make copy free)
  (setf (fieldtype-make-arg type) make (fieldtype-copy-arg type) copy (fieldtype-free-arg type) free) +ok+)
(defapi set-fieldtype-choice (type next prev) (setf (fieldtype-next type) next (fieldtype-prev type) prev) +ok+)
(defapi new-field (rows cols y x &optional (offscreen 0) (buffers 0))
  (when (and (plusp rows) (plusp cols) (notany #'minusp (list y x offscreen buffers)))
    (%field :rows rows :cols cols :y y :x x :offscreen offscreen
            :buffers (make-array (1+ buffers) :initial-element "") :max (* (+ rows offscreen) cols))))
(defapi free-field (field) (if (field-owner field) +err+ +ok+))
(defapi dup-field (field y x)
  (let ((copy (copy-field field)))
    (setf (field-y copy) y (field-x copy) x (field-owner copy) nil
          (field-buffers copy) (map 'vector #'copy-seq (field-buffers field))) copy))
(defapi link-field (field y x)
  (let ((copy (copy-field field))) (setf (field-y copy) y (field-x copy) x (field-owner copy) nil) copy))
(defapi field-info (field) (values (field-rows field) (field-cols field) (field-y field) (field-x field)
                                (field-offscreen field) (1- (length (field-buffers field)))))
(defapi dynamic-field-info (field)
  (values (max (field-rows field) (ceiling (length (field-buffer field 0)) (field-cols field)))
          (field-cols field) (field-max field)))
(defapi move-field (field y x)
  (if (or (field-owner field) (minusp y) (minusp x)) +err+ (progn (setf (field-y field) y (field-x field) x) +ok+)))
(defapi field-buffer (field number)
  (when (< -1 number (length (field-buffers field))) (aref (field-buffers field) number)))
(defapi set-field-buffer (field number text)
  (if (or (not (< -1 number (length (field-buffers field))))
          (and (logtest (field-opts field) +o-static+) (> (length text) (* (+ (field-rows field) (field-offscreen field)) (field-cols field))))
          (and (plusp (field-max field)) (> (length text) (field-max field)))) +err+
      (progn (setf (aref (field-buffers field) number) (copy-seq text) (field-status field) t) +ok+)))
(defapi set-max-field (field maximum)
  (if (or (minusp maximum) (and (plusp maximum) (< maximum (length (field-buffer field 0))))) +err+
      (progn (setf (field-max field) maximum) +ok+)))
(defapi field-index (field) (or (and (field-owner field) (position field (form-fields (field-owner field)))) -1))
(defmacro setter (kind property)
  (let ((get (intern (format nil "~A-~A" kind property))) (set (intern (format nil "SET-~A-~A" kind property))))
    `(defapi ,set (object value) (setf (,get object) value) +ok+)))
(setter field just) (setter field fore) (setter field back) (setter field pad)
(setter field opts) (setter field status) (setter field userptr)
(defapi field-opts-on (f mask) (set-field-opts f (logior (field-opts f) mask)))
(defapi field-opts-off (f mask) (set-field-opts f (logandc2 (field-opts f) mask)))
(defapi new-page (field) (field-page field))
(defapi set-new-page (field flag) (setf (field-page field) flag) +ok+)
(defapi set-field-type (field type &rest args)
  (setf (field-type field) type
        (field-arg field) (if (and (fieldtype-p type) (fieldtype-make-arg type)) (apply (fieldtype-make-arg type) args) args)) +ok+)
(defapi validate-field (field &optional (type (field-type field)) (args (field-arg field)))
  (let ((text (string-trim '(#\Space) (field-buffer field 0))))
    (or (and (zerop (length text)) (logtest (field-opts field) +o-nullok+))
        (case type
          ((nil) t)
          (:alpha (and (>= (length text) (or (first args) 0)) (every #'alpha-char-p text)))
          (:alnum (and (>= (length text) (or (first args) 0)) (every #'alphanumericp text)))
          ((:integer :numeric)
           (let ((number (handler-case
                             (if (eq type :integer) (parse-integer text)
                                 (let ((*read-eval* nil))
                                   (when (every (lambda (c) (find c "+-.0123456789eE")) text)
                                     (let ((v (read-from-string text))) (and (realp v) v)))))
                           (error () nil))))
             (and number (or (null (second args)) (<= (second args) number))
                  (or (null (third args)) (<= number (third args))))))
          (:regexp (ooparts/regexp:match-regexp (ooparts/regexp:compile-regexp-string (first args)) text))
          (:enum (member text (first args) :test (if (second args) #'string= #'string-equal)))
          (:ipv4 (let ((parts (uiop:split-string text :separator ".")))
                   (and (= (length parts) 4) (every (lambda (p) (let ((n (ignore-errors (parse-integer p)))) (and n (<= 0 n 255)))) parts))))
          (otherwise (and (fieldtype-p type) (funcall (fieldtype-field-check type) field args)))))))

(defstruct (form (:constructor %form)) (fields nil) (index 0) (page 0) (win-slot nil) (sub-slot nil) (userptr nil)
  (opts 3) (init-slot nil) (term-slot nil) (field-init nil) (field-term nil) (posted nil) (cursor 0) (insert t) (scroll 0))
(defapi set-form-fields (form fields)
  (let ((fields (coerce fields 'list)))
    (if (or (form-posted form) (null fields) (/= (length fields) (length (remove-duplicates fields)))
            (some (lambda (f) (and (field-owner f) (not (eq (field-owner f) form)))) fields)) +err+
        (progn (dolist (f (form-fields form)) (setf (field-owner f) nil))
               (setf (form-fields form) fields (form-index form) 0 (form-cursor form) 0)
               (dolist (f fields) (setf (field-owner f) form)) +ok+))))
(defapi new-form (fields) (let ((form (%form))) (when (= +ok+ (set-form-fields form fields)) form)))
(defapi free-form (form)
  (if (form-posted form) +err+ (progn (dolist (f (form-fields form)) (setf (field-owner f) nil))
                                   (setf (form-fields form) nil) +ok+)))
(defapi field-count (form) (length (form-fields form)))
(defapi current-field (form) (nth (form-index form) (form-fields form)))
(defapi form-win (form) (or (form-win-slot form) *stdscr*))
(defapi form-sub (form) (or (form-sub-slot form) (form-win form)))
(defapi set-form-win (form win) (if (form-posted form) +err+ (progn (setf (form-win-slot form) win) +ok+)))
(defapi set-form-sub (form win) (if (form-posted form) +err+ (progn (setf (form-sub-slot form) win) +ok+)))
(setter form userptr) (setter form opts)
(defapi set-form-init (f hook) (setf (form-init-slot f) hook) +ok+)
(defapi set-form-term (f hook) (setf (form-term-slot f) hook) +ok+)
(defapi form-init (form) (form-init-slot form))
(defapi form-term (form) (form-term-slot form))
(defapi field-init (form) (form-field-init form))
(defapi field-term (form) (form-field-term form))
(defapi set-field-init (form hook) (setf (form-field-init form) hook) +ok+)
(defapi set-field-term (form hook) (setf (form-field-term form) hook) +ok+)
(defapi form-opts-on (form mask) (set-form-opts form (logior (form-opts form) mask)))
(defapi form-opts-off (form mask) (set-form-opts form (logandc2 (form-opts form) mask)))
(defapi field-page-number (form field)
  (loop with page = 0 for f in (form-fields form) for index from 0
        do (when (and (plusp index) (field-page f)) (incf page))
        when (eq f field) return page))
(defapi set-current-field (form field)
  (let ((index (position field (form-fields form))))
    (if (or (null index) (not (logtest (field-opts field) +o-active+))) +err+
        (progn (when (and (form-posted form) (form-field-term form)) (funcall (form-field-term form) form))
               (setf (form-index form) index (form-page form) (field-page-number form field) (form-cursor form) 0)
               (when (and (form-posted form) (form-field-init form)) (funcall (form-field-init form) form)) +ok+))))
(defapi set-form-page (form page)
  (let ((field (find-if (lambda (f) (= page (field-page-number form f))) (form-fields form))))
    (if field (set-current-field form field) +err+)))
(defapi scale-form (form)
  (values (loop for f in (form-fields form) maximize (+ (field-y f) (field-rows f)))
          (loop for f in (form-fields form) maximize (+ (field-x f) (field-cols f)))))
(defapi render-form (form)
  (let ((win (form-sub form)))
    (dolist (f (form-fields form))
      (when (and (= (form-page form) (field-page-number form f)) (logtest (field-opts f) +o-visible+))
        (let* ((text (if (logtest (field-opts f) +o-public+) (field-buffer f 0) ""))
               (width (* (field-rows f) (field-cols f)))
               (offset (case (field-just f) (2 (floor (max 0 (- width (length text))) 2))
                             (3 (max 0 (- width (length text)))) (t 0))))
          (wattrset win (logior (field-back f) (if (eq f (current-field form)) (field-fore f) 0)))
          (dotimes (i width)
            (let ((y (+ (field-y f) (floor i (field-cols f)))) (x (+ (field-x f) (mod i (field-cols f))))
                  (n (+ (form-scroll form) (- i offset))))
              (when (and (< y (window-rows win)) (< x (window-cols win)))
                (wmove win y x) (waddch win (if (< -1 n (length text)) (char text n) (field-pad f)))))))))
    (pos-form-cursor form)))
(defapi post-form (form)
  (if (form-posted form) +err+
      (progn (setf (form-posted form) t)
             (when (form-init form) (funcall (form-init form) form))
             (when (field-init form) (funcall (field-init form) form)) (render-form form) +ok+)))
(defapi unpost-form (form)
  (if (not (form-posted form)) +err+
      (progn (when (field-term form) (funcall (field-term form) form))
             (when (form-term form) (funcall (form-term form) form)) (setf (form-posted form) nil) +ok+)))
(defapi pos-form-cursor (form)
  (let ((f (current-field form)))
    (wmove (form-sub form) (+ (field-y f) (floor (max 0 (- (form-cursor form) (form-scroll form))) (field-cols f)))
           (+ (field-x f) (mod (max 0 (- (form-cursor form) (form-scroll form))) (field-cols f))))))
(defapi data-ahead (form) (> (length (field-buffer (current-field form) 0)) (form-cursor form)))
(defapi data-behind (form) (plusp (form-cursor form)))
(defparameter *requests*
  '("NEXT_PAGE" "PREV_PAGE" "FIRST_PAGE" "LAST_PAGE" "NEXT_FIELD" "PREV_FIELD" "FIRST_FIELD" "LAST_FIELD"
    "SNEXT_FIELD" "SPREV_FIELD" "SFIRST_FIELD" "SLAST_FIELD" "LEFT_FIELD" "RIGHT_FIELD" "UP_FIELD" "DOWN_FIELD"
    "NEXT_CHAR" "PREV_CHAR" "NEXT_LINE" "PREV_LINE" "NEXT_WORD" "PREV_WORD" "BEG_FIELD" "END_FIELD" "BEG_LINE" "END_LINE"
    "LEFT_CHAR" "RIGHT_CHAR" "UP_CHAR" "DOWN_CHAR" "NEW_LINE" "INS_CHAR" "INS_LINE" "DEL_CHAR" "DEL_PREV" "DEL_LINE"
    "DEL_WORD" "CLR_EOL" "CLR_EOF" "CLR_FIELD" "OVL_MODE" "INS_MODE" "SCR_FLINE" "SCR_BLINE" "SCR_FPAGE" "SCR_BPAGE"
    "SCR_FHPAGE" "SCR_BHPAGE" "SCR_FCHAR" "SCR_BCHAR" "SCR_HFLINE" "SCR_HBLINE" "SCR_HFHALF" "SCR_HBHALF"
    "VALIDATION" "NEXT_CHOICE" "PREV_CHOICE"))
(loop for name in *requests* for code from 2048 do
  (let ((symbol (intern (concatenate 'string "+REQ-" (substitute #\- #\_ name) "+")))) (set symbol code) (proclaim (list 'special symbol)) (export symbol)))
(defapi form-request-name (code) (when (>= code 2048) (nth (- code 2048) *requests*)))
(defapi form-request-by-name (name) (let ((index (position name *requests* :test #'string-equal))) (and index (+ 2048 index))))
(defapi form-driver-w (form request) (form-driver form request))
(defapi form-driver (form request)
  (unless (form-posted form) (return-from form-driver +err+))
  (let* ((f (current-field form)) (text (field-buffer f 0)) (cursor (min (length text) (form-cursor form)))
         (name (and (integerp request) (form-request-name request))) (result +ok+))
    (cond
      ((characterp request)
       (if (not (logtest (field-opts f) +o-edit+)) (setf result +err+)
           (if (and (fieldtype-p (field-type f)) (fieldtype-char-check (field-type f))
                    (not (funcall (fieldtype-char-check (field-type f)) request (field-arg f)))) (setf result +err+)
               (progn
                 (setf result (set-field-buffer f 0 (concatenate 'string (subseq text 0 cursor) (string request)
                                                                    (subseq text (min (length text) (+ cursor (if (form-insert form) 0 1)))))))
                 (when (= result +ok+) (incf (form-cursor form)))))))
      ((null name) (setf result +err+))
      ((member name '("NEXT_FIELD" "SNEXT_FIELD" "RIGHT_FIELD" "DOWN_FIELD" "PREV_FIELD" "SPREV_FIELD" "LEFT_FIELD" "UP_FIELD" "FIRST_FIELD" "SFIRST_FIELD" "LAST_FIELD" "SLAST_FIELD") :test #'equal)
       (if (not (validate-field f)) (setf result +err+)
           (setf result (set-current-field form
             (nth (cond ((search "FIRST" name) 0) ((search "LAST" name) (1- (field-count form)))
                        ((member name '("PREV_FIELD" "SPREV_FIELD" "LEFT_FIELD" "UP_FIELD") :test #'equal)
                         (mod (1- (form-index form)) (field-count form)))
                        (t (mod (1+ (form-index form)) (field-count form)))) (form-fields form))))))
      ((member name '("NEXT_PAGE" "PREV_PAGE" "FIRST_PAGE" "LAST_PAGE") :test #'equal)
       (setf result (set-form-page form (cond ((equal name "FIRST_PAGE") 0)
                                              ((equal name "LAST_PAGE") (field-page-number form (car (last (form-fields form)))))
                                              ((search "PREV" name) (1- (form-page form))) (t (1+ (form-page form)))))))
      ((member name '("NEXT_WORD" "PREV_WORD") :test #'equal)
       (if (equal name "NEXT_WORD")
           (progn (loop while (and (< cursor (length text)) (char/= (char text cursor) #\Space)) do (incf cursor))
                  (loop while (and (< cursor (length text)) (char= (char text cursor) #\Space)) do (incf cursor)))
           (progn (loop while (and (plusp cursor) (char= (char text (1- cursor)) #\Space)) do (decf cursor))
                  (loop while (and (plusp cursor) (char/= (char text (1- cursor)) #\Space)) do (decf cursor))))
       (setf (form-cursor form) cursor))
      ((member name '("INS_CHAR" "INS_LINE" "NEW_LINE") :test #'equal)
       (let* ((count (if (equal name "INS_CHAR") 1 (field-cols f)))
              (start (if (equal name "INS_LINE") (* (floor cursor (field-cols f)) (field-cols f)) cursor)))
         (setf result (set-field-buffer f 0 (concatenate 'string (subseq text 0 start)
                                                       (make-string count :initial-element #\Space) (subseq text start))))
         (when (and (= result +ok+) (equal name "NEW_LINE")) (incf (form-cursor form) count))))
      ((member name '("DEL_LINE" "DEL_WORD") :test #'equal)
       (let* ((start (if (equal name "DEL_LINE") (* (floor cursor (field-cols f)) (field-cols f)) cursor))
              (end (if (equal name "DEL_LINE") (min (length text) (+ start (field-cols f)))
                       (or (position #\Space text :start cursor) (length text)))))
         (setf result (set-field-buffer f 0 (concatenate 'string (subseq text 0 start) (subseq text end)))
               (form-cursor form) start)))
      ((and (>= (length name) 4) (string= name "SCR_" :end1 4))
       (let* ((backward (or (search "_B" name) (search "_HB" name)))
              (step (cond ((search "HPAGE" name) (max 1 (floor (* (field-rows f) (field-cols f)) 2)))
                          ((search "PAGE" name) (* (field-rows f) (field-cols f)))
                          ((search "HALF" name) (max 1 (floor (field-cols f) 2)))
                          ((search "CHAR" name) 1) (t (field-cols f))))
              (limit (max 0 (- (length text) (* (field-rows f) (field-cols f))))))
         (setf (form-scroll form) (max 0 (min limit (+ (form-scroll form) (* (if backward -1 1) step)))))))
      ((equal name "VALIDATION") (unless (validate-field f) (setf result +err+)))
      ((equal name "INS_MODE") (setf (form-insert form) t))
      ((equal name "OVL_MODE") (setf (form-insert form) nil))
      ((member name '("NEXT_CHAR" "RIGHT_CHAR" "PREV_CHAR" "LEFT_CHAR" "BEG_FIELD" "END_FIELD" "BEG_LINE" "END_LINE" "UP_CHAR" "DOWN_CHAR" "NEXT_LINE" "PREV_LINE") :test #'equal)
       (setf (form-cursor form) (max 0 (min (length text)
         (cond ((equal name "BEG_FIELD") 0) ((equal name "END_FIELD") (length text))
               ((equal name "BEG_LINE") (* (floor cursor (field-cols f)) (field-cols f)))
               ((equal name "END_LINE") (* (1+ (floor cursor (field-cols f))) (field-cols f)))
               ((member name '("UP_CHAR" "PREV_LINE") :test #'equal) (- cursor (field-cols f)))
               ((member name '("DOWN_CHAR" "NEXT_LINE") :test #'equal) (+ cursor (field-cols f)))
               ((member name '("PREV_CHAR" "LEFT_CHAR") :test #'equal) (1- cursor)) (t (1+ cursor)))))))
      ((member name '("DEL_CHAR" "DEL_PREV" "CLR_EOL" "CLR_EOF" "CLR_FIELD") :test #'equal)
       (let* ((start (cond ((equal name "CLR_FIELD") 0) ((equal name "DEL_PREV") (max 0 (1- cursor))) (t cursor)))
              (end (cond ((member name '("CLR_FIELD" "CLR_EOF") :test #'equal) (length text))
                         ((equal name "CLR_EOL") (min (length text) (* (1+ (floor cursor (field-cols f))) (field-cols f))))
                         ((equal name "DEL_PREV") cursor) (t (min (length text) (1+ cursor))))))
         (setf result (set-field-buffer f 0 (concatenate 'string (subseq text 0 start) (subseq text end)))
               (form-cursor form) start)))
      ((member name '("NEXT_CHOICE" "PREV_CHOICE") :test #'equal)
       (let ((type (field-type f)))
         (if (fieldtype-p type)
             (let ((hook (if (equal name "NEXT_CHOICE") (fieldtype-next type) (fieldtype-prev type))))
               (unless (and hook (funcall hook f (field-arg f))) (setf result +err+)))
             (if (eq type :enum)
                 (let* ((choices (first (field-arg f))) (index (or (position text choices :test #'string-equal) 0)))
                   (setf result (set-field-buffer f 0 (nth (mod (+ index (if (equal name "NEXT_CHOICE") 1 -1)) (length choices)) choices))))
                 (setf result +err+)))))
      (t (setf result +err+)))
    (when (= result +ok+) (render-form form)) result))
