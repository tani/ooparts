;;; Menus use independent item models; no external widget library is required.
(uiop:define-package #:ooparts/curses/menu
  (:import-from #:ooparts/curses/metrics #:defapi)
  (:use #:cl #:ooparts/curses/api #:ooparts/curses/model)
  (:export #:new-item #:free-item #:item-name #:item-description #:item-index #:item-value
           #:set-item-value #:item-visible #:item-userptr #:set-item-userptr #:item-opts
           #:set-item-opts #:item-opts-on #:item-opts-off
           #:new-menu #:free-menu #:set-menu-items #:menu-items #:item-count
           #:post-menu #:unpost-menu #:menu-driver #:menu-driver-w #:current-item #:set-current-item
           #:set-top-row #:top-row #:set-menu-format #:menu-format #:scale-menu
           #:set-menu-win #:menu-win #:set-menu-sub #:menu-sub #:set-menu-mark #:menu-mark
           #:set-menu-pattern #:menu-pattern #:set-menu-spacing #:menu-spacing
           #:set-menu-userptr #:menu-userptr #:set-menu-opts #:menu-opts #:menu-opts-on #:menu-opts-off
           #:set-menu-fore #:menu-fore #:set-menu-back #:menu-back #:set-menu-grey #:menu-grey
           #:set-menu-pad #:menu-pad #:set-menu-init #:menu-init #:set-menu-term #:menu-term
           #:set-item-init #:item-init #:set-item-term #:item-term #:pos-menu-cursor
           #:menu-request-name #:menu-request-by-name))
(in-package #:ooparts/curses/menu)
(defconstant +o-selectable+ 1)
(defconstant +o-onevalue+ 1)
(defconstant +o-showdesc+ 2)
(defconstant +o-rowmajor+ 4)
(defconstant +o-ignorecase+ 8)
(defconstant +o-showmatch+ 16)
(defconstant +o-noncyclic+ 32)
(export '(+o-selectable+ +o-onevalue+ +o-showdesc+ +o-rowmajor+ +o-ignorecase+ +o-showmatch+ +o-noncyclic+))
(defstruct (item (:constructor %item (name description))) (name nil) (description nil) (value nil) (userptr nil) (opts 1) (owner nil))
(defstruct (menu (:constructor %menu)) (items nil) (index 0) (top 0) (rows 16) (cols 1) (win-slot nil) (sub-slot nil)
  (mark "-") (pattern "") (spacing-slot '(1 1 1)) (userptr nil) (opts 31) (fore +a-standout+) (back 0)
  (grey +a-dim+) (pad #\Space) (init nil) (term nil) (item-init nil) (item-term nil) (posted nil))
(defapi new-item (name &optional (description ""))
  (when (plusp (length name)) (%item (copy-seq name) (copy-seq description))))
(defapi free-item (item) (if (item-owner item) +err+ +ok+))
(defapi item-index (item) (or (and (item-owner item) (position item (menu-items (item-owner item)))) -1))
(defapi item-visible (item)
  (let ((m (item-owner item)))
    (and m (menu-posted m) (<= (* (menu-top m) (menu-cols m)) (item-index item))
         (< (item-index item) (* (+ (menu-top m) (menu-rows m)) (menu-cols m))))))
(defapi set-item-value (item value)
  (if (and (item-owner item) (logtest (menu-opts (item-owner item)) +o-onevalue+)) +err+
      (progn (setf (item-value item) value) +ok+)))
(defmacro property-api (kind property)
  (let ((getter (intern (format nil "~A-~A" kind property)))
        (setter (intern (format nil "SET-~A-~A" kind property))))
    `(defapi ,setter (object value) (setf (,getter object) value) +ok+)))
(property-api item userptr) (property-api item opts)
(defapi item-opts-on (item opts) (set-item-opts item (logior opts (item-opts item))))
(defapi item-opts-off (item opts) (set-item-opts item (logandc2 (item-opts item) opts)))
(defapi set-menu-items (menu items)
  (let ((items (coerce items 'list)))
    (if (or (menu-posted menu) (null items) (/= (length items) (length (remove-duplicates items)))
            (some (lambda (i) (and (item-owner i) (not (eq (item-owner i) menu)))) items)) +err+
        (progn (dolist (i (menu-items menu)) (setf (item-owner i) nil))
               (setf (menu-items menu) items (menu-index menu) 0 (menu-top menu) 0)
               (dolist (i items) (setf (item-owner i) menu)) +ok+))))
(defapi new-menu (items) (let ((m (%menu))) (when (= +ok+ (set-menu-items m items)) m)))
(defapi free-menu (m)
  (if (menu-posted m) +err+ (progn (dolist (i (menu-items m)) (setf (item-owner i) nil)) (setf (menu-items m) nil) +ok+)))
(defapi item-count (m) (length (menu-items m)))
(defapi current-item (m) (nth (menu-index m) (menu-items m)))
(defapi invoke-hook (hook m) (when hook (funcall hook m)))
(defapi set-current-item (m item)
  (let ((index (position item (menu-items m))))
    (if (null index) +err+
        (progn (when (menu-posted m) (invoke-hook (menu-item-term m) m))
               (setf (menu-index m) index)
               (when (menu-posted m) (invoke-hook (menu-item-init m) m))
               (when (< index (* (menu-top m) (menu-cols m))) (setf (menu-top m) (floor index (menu-cols m))))
               (when (>= index (* (+ (menu-top m) (menu-rows m)) (menu-cols m)))
                 (setf (menu-top m) (1+ (- (floor index (menu-cols m)) (menu-rows m))))) +ok+))))
(defapi menu-win (m) (or (menu-win-slot m) *stdscr*))
(defapi menu-sub (m) (or (menu-sub-slot m) (menu-win m)))
(defapi set-menu-win (m win) (if (menu-posted m) +err+ (progn (setf (menu-win-slot m) win) +ok+)))
(defapi set-menu-sub (m win) (if (menu-posted m) +err+ (progn (setf (menu-sub-slot m) win) +ok+)))
(property-api menu mark) (property-api menu userptr) (property-api menu opts)
(property-api menu fore) (property-api menu back) (property-api menu grey) (property-api menu pad)
(property-api menu init) (property-api menu term)
;; Hooks are properties of a menu, despite the historical item_* names.
(defapi item-init (m) (menu-item-init m))
(defapi item-term (m) (menu-item-term m))
(defapi set-item-init (m hook) (setf (menu-item-init m) hook) +ok+)
(defapi set-item-term (m hook) (setf (menu-item-term m) hook) +ok+)
(defapi menu-opts-on (m opts) (set-menu-opts m (logior (menu-opts m) opts)))
(defapi menu-opts-off (m opts) (set-menu-opts m (logandc2 (menu-opts m) opts)))
(defapi set-menu-format (m rows cols)
  (if (or (menu-posted m) (minusp rows) (minusp cols)) +err+
      (progn (when (plusp rows) (setf (menu-rows m) rows)) (when (plusp cols) (setf (menu-cols m) cols)) +ok+)))
(defapi menu-format (m) (values (menu-rows m) (menu-cols m)))
(defapi set-menu-spacing (m description rows cols)
  (if (every (lambda (n) (and (integerp n) (plusp n))) (list description rows cols))
      (progn (setf (menu-spacing-slot m) (list description rows cols)) +ok+) +err+))
(defapi menu-spacing (m) (values-list (menu-spacing-slot m)))
(defapi cell-size (m)
  (+ (length (menu-mark m)) (loop for i in (menu-items m) maximize
        (+ (length (item-name i)) (if (logtest (menu-opts m) +o-showdesc+)
                                   (+ (first (menu-spacing-slot m)) (length (item-description i))) 0)))))
(defapi scale-menu (m)
  (values (* (min (menu-rows m) (ceiling (item-count m) (menu-cols m))) (second (menu-spacing-slot m)))
          (+ (* (menu-cols m) (cell-size m)) (* (1- (menu-cols m)) (third (menu-spacing-slot m))))))
(defapi top-row (m) (menu-top m))
(defapi set-top-row (m row)
  (if (< -1 row (ceiling (item-count m) (menu-cols m)))
      (progn (setf (menu-top m) row) (set-current-item m (nth (* row (menu-cols m)) (menu-items m)))) +err+))
(defapi render-menu (m)
  (let ((win (menu-sub m)) (size (cell-size m)))
    (werase win)
    (loop for item in (menu-items m) for index from 0
          for row = (- (floor index (menu-cols m)) (menu-top m)) for col = (mod index (menu-cols m))
          when (<= 0 row (1- (menu-rows m))) do
          (let ((y (* row (second (menu-spacing-slot m)))) (x (* col (+ size (third (menu-spacing-slot m))))))
            (when (and (< y (window-rows win)) (< x (window-cols win)))
              (wmove win y x)
              (wattrset win (cond ((not (logtest (item-opts item) +o-selectable+)) (menu-grey m))
                                 ((= index (menu-index m)) (menu-fore m)) (t (menu-back m))))
              (waddnstr win (concatenate 'string
                            (if (or (item-value item) (= index (menu-index m))) (menu-mark m)
                                (make-string (length (menu-mark m)) :initial-element (menu-pad m)))
                            (item-name item)
                            (if (logtest (menu-opts m) +o-showdesc+)
                                (concatenate 'string (make-string (first (menu-spacing-slot m)) :initial-element (menu-pad m)) (item-description item)) ""))
                       (min size (- (window-cols win) x))))))
    (wattrset win (menu-back m))))
(defapi post-menu (m)
  (if (or (menu-posted m) (null (menu-items m))) +err+
      (progn (setf (menu-posted m) t) (invoke-hook (menu-init m) m) (invoke-hook (menu-item-init m) m) (render-menu m) +ok+)))
(defapi unpost-menu (m)
  (if (not (menu-posted m)) +err+
      (progn (invoke-hook (menu-item-term m) m) (invoke-hook (menu-term m) m)
             (setf (menu-posted m) nil) (werase (menu-sub m)) +ok+)))
(defapi set-menu-pattern (m pattern)
  (let ((item (find-if (lambda (i) (and (logtest (item-opts i) +o-selectable+)
                                       (<= (length pattern) (length (item-name i)))
                                       (funcall (if (logtest (menu-opts m) +o-ignorecase+) #'string-equal #'string=)
                                                pattern (item-name i) :end2 (length pattern)))) (menu-items m))))
    (if item (progn (setf (menu-pattern m) pattern) (set-current-item m item)) +err+)))
(defparameter *requests* '("LEFT_ITEM" "RIGHT_ITEM" "UP_ITEM" "DOWN_ITEM" "SCR_ULINE" "SCR_DLINE"
                          "SCR_DPAGE" "SCR_UPAGE" "FIRST_ITEM" "LAST_ITEM" "NEXT_ITEM" "PREV_ITEM"
                          "TOGGLE_ITEM" "CLEAR_PATTERN" "BACK_PATTERN" "NEXT_MATCH" "PREV_MATCH"))
(loop for name in *requests* for code from 1024 do
  (let ((symbol (intern (concatenate 'string "+REQ-" (substitute #\- #\_ name) "+"))))
    (set symbol code) (proclaim (list 'special symbol)) (export symbol)))
(defapi menu-request-name (code) (nth (- code 1024) *requests*))
(defapi menu-request-by-name (name) (let ((n (position name *requests* :test #'string-equal))) (and n (+ n 1024))))
(defapi menu-driver (m request)
  (unless (menu-posted m) (return-from menu-driver +err+))
  (let* ((name (and (integerp request) (>= request 1024) (menu-request-name request)))
         (index (menu-index m)) (result +ok+))
    (cond ((characterp request) (setf result (set-menu-pattern m (concatenate 'string (menu-pattern m) (string request)))))
          ((member name '("CLEAR_PATTERN" "BACK_PATTERN") :test #'equal)
           (setf result (set-menu-pattern m (if (equal name "CLEAR_PATTERN") "" (subseq (menu-pattern m) 0 (max 0 (1- (length (menu-pattern m)))))))))
          ((equal name "TOGGLE_ITEM") (setf result (set-item-value (current-item m) (not (item-value (current-item m))))))
          (t
           (setf index (+ index (cond ((member name '("NEXT_ITEM" "RIGHT_ITEM" "NEXT_MATCH") :test #'equal) 1)
                                     ((member name '("PREV_ITEM" "LEFT_ITEM" "PREV_MATCH") :test #'equal) -1)
                                     ((member name '("DOWN_ITEM" "SCR_DLINE") :test #'equal) (menu-cols m))
                                     ((member name '("UP_ITEM" "SCR_ULINE") :test #'equal) (- (menu-cols m)))
                                     ((equal name "SCR_DPAGE") (* (menu-cols m) (menu-rows m)))
                                     ((equal name "SCR_UPAGE") (- (* (menu-cols m) (menu-rows m)))) (t 0))))
           (cond ((equal name "FIRST_ITEM") (setf index 0)) ((equal name "LAST_ITEM") (setf index (1- (item-count m)))))
           (cond ((null name) (setf result +err+))
                 ((and (logtest (menu-opts m) +o-noncyclic+) (not (< -1 index (item-count m)))) (setf result +err+))
                 (t (setf result (set-current-item m (nth (mod index (item-count m)) (menu-items m))))))))
    (when (= result +ok+) (render-menu m)) result))
(defapi menu-driver-w (m request) (menu-driver m request))
(defapi pos-menu-cursor (m)
  (wmove (menu-sub m) (- (floor (menu-index m) (menu-cols m)) (menu-top m))
         (* (mod (menu-index m) (menu-cols m)) (+ (cell-size m) (third (menu-spacing-slot m))))))
