(uiop:define-package #:ooparts/curses/panel
  (:import-from #:ooparts/curses/metrics #:defapi)
  (:use #:cl #:ooparts/curses/model #:ooparts/curses/api)
  (:export #:new-panel #:del-panel #:top-panel #:bottom-panel #:show-panel #:hide-panel
           #:panel-hidden #:panel-window #:replace-panel #:move-panel #:panel-above #:panel-below
           #:panel-userptr #:set-panel-userptr #:update-panels))
(in-package #:ooparts/curses/panel)
(defstruct (panel (:constructor make-panel (window screen))) (window nil) (screen nil) (hidden nil) (userptr-slot nil) (deleted nil))
(defapi stack (&optional (s *screen*)) (gethash :panels (screen-options s)))
(defapi (setf stack) (value &optional (s *screen*)) (setf (gethash :panels (screen-options s)) value))
(defapi new-panel (window)
  (when (ooparts/curses/api::valid-window-p window)
    (let ((p (make-panel window *screen*))) (setf (stack) (append (stack) (list p))) p)))
(defapi del-panel (p)
  (if (panel-deleted p) +err+ (progn (setf (stack (panel-screen p)) (remove p (stack (panel-screen p)))
                                         (panel-deleted p) t) +ok+)))
(defapi top-panel (p)
  (if (panel-deleted p) +err+
      (progn (setf (stack (panel-screen p)) (append (remove p (stack (panel-screen p))) (list p))
                   (panel-hidden p) nil) +ok+)))
(defapi bottom-panel (p)
  (if (panel-deleted p) +err+
      (progn (setf (stack (panel-screen p)) (cons p (remove p (stack (panel-screen p)))) (panel-hidden p) nil) +ok+)))
(defapi hide-panel (p) (if (panel-deleted p) +err+ (progn (setf (panel-hidden p) t) +ok+)))
(defapi show-panel (p) (top-panel p))
(defapi replace-panel (p win)
  (if (and (not (panel-deleted p)) (ooparts/curses/api::valid-window-p win))
      (progn (setf (panel-window p) win) +ok+) +err+))
(defapi move-panel (p y x) (if (panel-deleted p) +err+ (mvwin (panel-window p) y x)))
(defapi visible-stack (&optional (s *screen*)) (remove-if #'panel-hidden (stack s)))
(defapi panel-above (p)
  (if p (second (member p (visible-stack (panel-screen p)))) (first (visible-stack))))
(defapi panel-below (p)
  (let ((items (reverse (visible-stack (if p (panel-screen p) *screen*)))))
    (if p (second (member p items)) (first items))))
(defapi panel-userptr (p) (panel-userptr-slot p))
(defapi set-panel-userptr (p value) (setf (panel-userptr-slot p) value) +ok+)
(defapi update-panels ()
  (touchwin *stdscr*) (wnoutrefresh *stdscr*)
  (dolist (p (visible-stack)) (touchwin (panel-window p)) (wnoutrefresh (panel-window p))) +ok+)
