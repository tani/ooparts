;;; Fixed-profile terminfo/termcap interfaces and parameter expansion.
(uiop:define-package #:ooparts/curses/terminfo
  (:import-from #:ooparts/curses/metrics #:defapi)
  (:use #:cl #:ooparts/curses/model #:ooparts/curses/capabilities)
  (:import-from #:ooparts/curses/api)
  (:export #:setupterm #:restartterm #:set-curterm #:del-curterm #:*cur-term*
           #:tigetflag #:tigetnum #:tigetstr #:tgetent #:tgetflag #:tgetnum #:tgetstr
           #:tparm #:tiparm #:tgoto #:tputs #:putp #:vidattr #:vidputs #:vid-attr #:vid-puts))
(in-package #:ooparts/curses/terminfo)
(defstruct terminal-description name fd flags numbers strings)
(defvar *cur-term* nil)
(defvar *static-parameters* (make-hash-table))
(defapi escape (suffix) (concatenate 'string (string (code-char 27)) suffix))
(defapi description (name fd)
  (let* ((xterm (or (search "xterm" name) (search "screen" name) (search "tmux" name)))
         (vt100 (member name '("vt100" "vt102" "ansi") :test #'string=)))
    (when (or xterm vt100)
      (let ((flags (make-hash-table :test #'equal)) (numbers (make-hash-table :test #'equal))
            (strings (make-hash-table :test #'equal)))
        (dolist (flag '("am" "msgr" "xon")) (setf (gethash flag flags) t))
        (dolist (entry `(("cols" . ,(if ooparts/curses/api:*screen* ooparts/curses/api:*cols* 80))
                         ("lines" . ,(if ooparts/curses/api:*screen* ooparts/curses/api:*lines* 24))
                         ("it" . 8) ("colors" . ,(if xterm 256 -1)) ("pairs" . ,(if xterm 65536 -1))))
          (setf (gethash (car entry) numbers) (cdr entry)))
        (dolist (entry '(("clear" . "[H\033[2J") ("cup" . "[%i%p1%d;%p2%dH")
                         ("home" . "[H") ("el" . "[K") ("ed" . "[J")
                         ("cuu1" . "[A") ("cud1" . "[B") ("cuf1" . "[C") ("cub1" . "[D")
                         ("cuu" . "[%p1%dA") ("cud" . "[%p1%dB")
                         ("cuf" . "[%p1%dC") ("cub" . "[%p1%dD")
                         ("hpa" . "[%i%p1%dG") ("vpa" . "[%i%p1%dd")
                         ("csr" . "[%i%p1%d;%p2%dr") ("sgr0" . "[0m")
                         ("bold" . "[1m") ("dim" . "[2m") ("smul" . "[4m") ("rmul" . "[24m")
                         ("rev" . "[7m") ("blink" . "[5m") ("invis" . "[8m")
                         ("smso" . "[7m") ("rmso" . "[27m")
                         ("sc" . "7") ("rc" . "8") ("smacs" . "(0") ("rmacs" . "(B")
                         ("ind" . "D") ("ri" . "M") ("smkx" . "[?1h\033=") ("rmkx" . "[?1l\033>")
                         ("il1" . "[L") ("dl1" . "[M") ("ich1" . "[@") ("dch1" . "[P")
                         ("il" . "[%p1%dL") ("dl" . "[%p1%dM") ("ich" . "[%p1%d@") ("dch" . "[%p1%dP")
                         ("civis" . "[?25l") ("cnorm" . "[?25h")
                         ("kcuu1" . "OA") ("kcud1" . "OB") ("kcuf1" . "OC") ("kcub1" . "OD")
                         ("khome" . "[H") ("kend" . "[F") ("kdch1" . "[3~") ("kich1" . "[2~")
                         ("knp" . "[6~") ("kpp" . "[5~")))
          (setf (gethash (car entry) strings) (escape (cdr entry))))
        (setf (gethash "clear" strings) (concatenate 'string (escape "[H") (escape "[2J"))
              (gethash "smkx" strings) (concatenate 'string (escape "[?1h") (escape "="))
              (gethash "rmkx" strings) (concatenate 'string (escape "[?1l") (escape ">"))
              (gethash "bel" strings) (string (code-char 7))
              (gethash "cr" strings) (string #\Return) (gethash "ht" strings) (string #\Tab))
        (when xterm
          (dolist (entry '(("smcup" . "[?1049h") ("rmcup" . "[?1049l")
                           ("setaf" . "[38;5;%p1%dm") ("setab" . "[48;5;%p1%dm")
                           ("op" . "[39;49m") ("initc" . "]4;%p1%d;rgb:%p2%02x/%p3%02x/%p4%02x\007")
                           ("cvvis" . "[?25h\033[1 q")))
            (setf (gethash (car entry) strings) (escape (cdr entry))))
          (setf (gethash "ccc" flags) t))
        (make-terminal-description :name name :fd fd :flags flags :numbers numbers :strings strings)))))
(defapi setupterm (&optional (name (or (uiop:getenv "TERM") "xterm")) (fd 1))
  (let ((terminal (description name fd)))
    (if terminal (progn (setf *cur-term* terminal) (values 0 1)) (values -1 0))))
(defapi set-curterm (terminal) (prog1 *cur-term* (setf *cur-term* terminal)))
(defapi del-curterm (terminal) (when (eq terminal *cur-term*) (setf *cur-term* nil)) 0)
(defapi ensure-terminal ()
  (or *cur-term* (progn (setupterm (if ooparts/curses/api:*screen* (ooparts/curses/api:termname) "xterm")) *cur-term*)))
(defapi restartterm (name &optional (fd 1))
  (multiple-value-bind (status reason) (setupterm name fd)
    (when (and (zerop status) ooparts/curses/api:*screen*)
      (setf (screen-profile ooparts/curses/api:*screen*) (if (search "vt" name) :vt100 :xterm)
            (screen-force-p ooparts/curses/api:*screen*) t))
    (values status reason)))
(defapi tigetflag (name)
  (if (member name *boolean-capabilities* :test #'string=)
      (if (gethash name (terminal-description-flags (ensure-terminal))) 1 0) -1))
(defapi tigetnum (name)
  (if (member name *numeric-capabilities* :test #'string=)
      (gethash name (terminal-description-numbers (ensure-terminal)) -1) -2))
(defapi tigetstr (name)
  (if (member name *string-capabilities* :test #'string=)
      (gethash name (terminal-description-strings (ensure-terminal))) -1))
(defparameter *termcap-names*
  '(("co" . "cols") ("li" . "lines") ("Co" . "colors") ("pa" . "pairs") ("it" . "it")
    ("am" . "am") ("ms" . "msgr") ("xo" . "xon") ("cc" . "ccc")
    ("cm" . "cup") ("cl" . "clear") ("ce" . "el") ("cd" . "ed") ("ho" . "home")
    ("up" . "cuu1") ("do" . "cud1") ("nd" . "cuf1") ("le" . "cub1")
    ("so" . "smso") ("se" . "rmso") ("us" . "smul") ("ue" . "rmul")
    ("md" . "bold") ("me" . "sgr0") ("mr" . "rev") ("mb" . "blink")
    ("ti" . "smcup") ("te" . "rmcup") ("ks" . "smkx") ("ke" . "rmkx")
    ("ku" . "kcuu1") ("kd" . "kcud1") ("kr" . "kcuf1") ("kl" . "kcub1")
    ("AF" . "setaf") ("AB" . "setab") ("bl" . "bel") ("cr" . "cr") ("ta" . "ht")))
(defapi cap-name (name) (or (cdr (assoc name *termcap-names* :test #'string=)) (cdr (assoc name *termcap-aliases* :test #'string=)) name))
(defapi tgetent (name) (if (zerop (setupterm name)) 1 0))
(defapi tgetflag (name) (max 0 (tigetflag (cap-name name))))
(defapi tgetnum (name) (max -1 (tigetnum (cap-name name))))
(defapi tgetstr (name) (let ((value (tigetstr (cap-name name)))) (and (stringp value) value)))

(defapi format-parameter (op spec value)
  (let* ((spec (string-left-trim ":" spec)) (dot (position #\. spec))
         (width-digits (remove-if-not #'digit-char-p (subseq spec 0 dot)))
         (width (if (plusp (length width-digits)) (parse-integer width-digits) 0))
         (precision (and dot (let ((digits (subseq spec (1+ dot)))) (if (zerop (length digits)) 0 (parse-integer digits)))))
         (numeric (find op "doxX"))
         (digits (case op (#\s (princ-to-string value)) (#\c (string (code-char value)))
                        (t (write-to-string (abs value) :base (case op (#\o 8) ((#\x #\X) 16) (t 10)) :radix nil))))
         (sign (if (and numeric (minusp value)) "-" (if (and numeric (char= op #\d) (find #\+ spec)) "+"
                       (if (and numeric (char= op #\d) (find #\Space spec)) " " ""))))
         (prefix (if (and numeric (find #\# spec) (not (zerop value)))
                     (case op (#\o "0") (#\x "0x") (#\X "0X") (t "")) "")))
    (when (find op "xX") (setf digits (if (char= op #\x) (string-downcase digits) (string-upcase digits))))
    (when precision
      (setf digits (if numeric
                       (concatenate 'string (make-string (max 0 (- precision (length digits))) :initial-element #\0)
                                    (if (and (zerop precision) (zerop value)) "" digits))
                       (if (char= op #\s) (subseq digits 0 (min precision (length digits))) digits))))
    (let* ((body (concatenate 'string sign prefix digits)) (n (max 0 (- width (length body)))))
      (cond ((find #\- spec) (concatenate 'string body (make-string n :initial-element #\Space)))
            ((and numeric (not precision) (find #\0 spec))
             (concatenate 'string sign prefix (make-string n :initial-element #\0) digits))
            (t (concatenate 'string (make-string n :initial-element #\Space) body))))))

(defapi tparm (template &rest arguments)
  "Expand the terminfo stack language. Lisp values replace C varargs."
  (let ((parameters (make-array 9 :initial-element 0)) (stack nil)
        (locals (make-hash-table)) (frames nil) (enabled t) (i 0))
    (loop for value in arguments for n below 9 do (setf (aref parameters n) value))
    (labels ((take () (or (pop stack) (error "Terminfo parameter stack underflow.")))
             (push-result (value) (when enabled (push value stack)))
             (next () (when (>= i (length template)) (error "Truncated terminfo directive.")) (prog1 (char template i) (incf i)))
             (binary (op) (when enabled (let ((b (take)) (a (take))) (push (funcall op a b) stack)))))
      (with-output-to-string (out)
        (loop for char = (and (< i (length template)) (next)) while char do
          (if (char/= char #\%) (when enabled (write-char char out))
              (let ((op (next)))
                (case op
                  (#\? (push (list enabled nil) frames))
                  (#\t (unless frames (error "Unmatched %%t."))
                        (setf (second (first frames)) (and enabled (not (zerop (take))))
                              enabled (and (first (first frames)) (second (first frames)))))
                  (#\e (unless frames (error "Unmatched %%e."))
                        (setf enabled (and (first (first frames)) (not (second (first frames))))))
                  (#\; (unless frames (error "Unmatched %%;.")) (setf enabled (first (pop frames))))
                  (#\% (when enabled (write-char #\% out)))
                  (#\p (let ((n (digit-char-p (next))))
                         (unless (and n (<= 1 n 9)) (error "Invalid terminfo parameter."))
                         (push-result (aref parameters (1- n)))))
                  (#\{ (let ((start i)) (loop until (char= (next) #\}))
                          (push-result (parse-integer template :start start :end (1- i)))))
                  (#\' (let ((c (next))) (unless (char= (next) #\') (error "Invalid terminfo literal."))
                          (push-result (char-code c))))
                  (#\P (let ((name (next))) (when enabled
                          (setf (gethash name (if (upper-case-p name) *static-parameters* locals)) (take)))))
                  (#\g (let ((name (next))) (push-result (gethash name (if (upper-case-p name) *static-parameters* locals) 0))))
                  (#\i (when enabled (incf (aref parameters 0)) (incf (aref parameters 1))))
                  (#\l (when enabled (push (length (take)) stack)))
                  (#\+ (binary #'+)) (#\- (binary #'-)) (#\* (binary #'*))
                  (#\/ (binary #'truncate)) (#\m (binary #'rem)) (#\& (binary #'logand))
                  (#\| (binary #'logior)) (#\^ (binary #'logxor))
                  (#\= (binary (lambda (a b) (if (= a b) 1 0))))
                  (#\> (binary (lambda (a b) (if (> a b) 1 0))))
                  (#\< (binary (lambda (a b) (if (< a b) 1 0))))
                  (#\A (binary (lambda (a b) (if (and (not (zerop a)) (not (zerop b))) 1 0))))
                  (#\O (binary (lambda (a b) (if (or (not (zerop a)) (not (zerop b))) 1 0))))
                  (#\! (when enabled (push (if (zerop (take)) 1 0) stack)))
                  (#\~ (when enabled (push (lognot (take)) stack)))
                  (otherwise
                   (let ((start (1- i)))
                     (loop until (find op "doxXsc") do (setf op (next)))
                     (when enabled
                       (write-string (format-parameter op (subseq template start (1- i)) (take)) out))))))))
        (when frames (error "Unterminated terminfo conditional."))))))
(defapi tiparm (template &rest arguments) (apply #'tparm template arguments))
(defapi tgoto (template column row) (tparm template row column))
(defapi tputs (text &optional (affected-lines 1) (putchar (lambda (c) (write-char c (if ooparts/curses/api:*screen* (screen-output ooparts/curses/api:*screen*) *standard-output*)))))
  (when text
    (loop with i = 0 while (< i (length text)) do
      (if (and (char= (char text i) #\$) (< (+ i 1) (length text)) (char= (char text (1+ i)) #\<))
          (let ((end (position #\> text :start (+ i 2))))
            (unless end (error "Unterminated padding directive."))
            (let* ((spec (subseq text (+ i 2) end))
                   (number (remove-if-not (lambda (c) (or (digit-char-p c) (char= c #\.))) spec))
                   (delay (if (plusp (length number)) (let ((*read-eval* nil)) (read-from-string number)) 0)))
              (sleep (/ (* delay (if (find #\* spec) affected-lines 1)) 1000)))
            (setf i (1+ end)))
          (progn (funcall putchar (char text i)) (incf i))))) 0)
(defapi putp (text) (tputs text))
(defapi attribute-string (attributes pair)
  (let* ((out (make-string-output-stream))
         (ooparts/curses/api:*screen* (make-screen :profile (if (search "vt" (terminal-description-name (ensure-terminal))) :vt100 :xterm)
                                                  :output out :color-p t)))
    (ooparts/curses/api::output-attributes (make-cell :attrs attributes :pair pair))
    (get-output-stream-string out)))
(defapi vid-puts (attributes pair putchar) (tputs (attribute-string attributes pair) 1 putchar))
(defapi vid-attr (attributes pair) (putp (attribute-string attributes pair)))
(defapi vidputs (attributes putchar) (vid-puts attributes (ooparts/curses/api:pair-number attributes) putchar))
(defapi vidattr (attributes) (vid-attr attributes (ooparts/curses/api:pair-number attributes)))
