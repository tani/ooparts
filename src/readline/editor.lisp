(uiop:define-package #:ooparts/readline/editor
  (:use #:cl)
  (:import-from #:ooparts/curses/model #:text-width)
  (:export #:make-editor #:editor-text #:editor-cursor #:editor-search-query
           #:apply-key #:render-line #:printable #:display-width))
(in-package #:ooparts/readline/editor)

(defstruct editor
  (text "") (cursor 0) (kill "") (history nil) (history-index 0) (draft "")
  completion search-query search-saved (search-index -1))
(defun printable (text)
  (coerce (loop for char across text for code = (char-code char)
                when (member code '(9 10 13)) collect #\Space
                else when (and (>= code 32) (not (<= 127 code 159))) collect char) 'string))
(defun display-width (text &optional (end (length text)))
  (text-width (subseq text 0 end)))
(defun replace-range (editor start end replacement)
  (setf (editor-text editor)
        (concatenate 'string (subseq (editor-text editor) 0 start) replacement
                     (subseq (editor-text editor) end))
        (editor-cursor editor) (+ start (length replacement))))
(defun space-p (char) (find char '(#\Space #\Tab)))
(defun word-start (text position)
  (loop while (and (> position 0) (space-p (char text (1- position)))) do (decf position))
  (loop while (and (> position 0) (not (space-p (char text (1- position))))) do (decf position))
  position)
(defun word-end (text position)
  (loop while (and (< position (length text)) (space-p (char text position))) do (incf position))
  (loop while (and (< position (length text)) (not (space-p (char text position)))) do (incf position))
  position)
(defun history-move (editor delta)
  (when (zerop (editor-history-index editor)) (setf (editor-draft editor) (editor-text editor)))
  (setf (editor-history-index editor)
        (max 0 (min (length (editor-history editor)) (+ (editor-history-index editor) delta)))
        (editor-text editor) (if (zerop (editor-history-index editor)) (editor-draft editor)
                                (nth (1- (editor-history-index editor)) (editor-history editor))))
  (setf (editor-cursor editor) (length (editor-text editor))))
(defun search-history (editor &optional next)
  (loop for text in (editor-history editor) for index from 0
        when (and (or (not next) (> index (editor-search-index editor)))
                  (search (editor-search-query editor) text)) do
          (setf (editor-text editor) text (editor-cursor editor) (length text)
                (editor-search-index editor) index)
          (return t)))
(defun complete (editor)
  (when (editor-completion editor)
    (let* ((end (editor-cursor editor))
           (start (1+ (or (position-if #'space-p (editor-text editor) :end end :from-end t) -1)))
           (prefix (subseq (editor-text editor) start end))
           (matches (remove-duplicates
                     (remove-if-not (lambda (s) (and (stringp s) (<= (length prefix) (length s))
                                                     (string= prefix s :end2 (length prefix))))
                                    (funcall (editor-completion editor) prefix)) :test #'string=)))
      (when matches
        (let* ((first (first matches)) (length (length first)))
          (dolist (match (rest matches))
            (setf length (min length (length match)))
            (loop for i below length unless (char= (char first i) (char match i)) do
              (setf length i) (return)))
          (replace-range editor start end (printable (subseq first 0 length)))
          (when (rest matches) (values :candidates (mapcar #'printable matches))))))))
(defun apply-key (editor key)
  "Apply a character or normalized key event; return an optional editor action."
  (let* ((text (editor-text editor)) (cursor (editor-cursor editor))
         (code (and (characterp key) (char-code key))))
    (when (editor-search-query editor)
      (cond ((or (eq key :escape) (eql code 7))
             (setf (editor-text editor) (car (editor-search-saved editor))
                   (editor-cursor editor) (cdr (editor-search-saved editor))
                   (editor-search-query editor) nil))
            ((eql code 18) (search-history editor t))
            ((member code '(10 13)) (setf (editor-search-query editor) nil))
            ((member code '(8 127))
             (let ((query (editor-search-query editor)))
               (when (plusp (length query))
                 (setf (editor-search-query editor) (subseq query 0 (1- (length query))))
                 (search-history editor))))
            ((and code (>= code 32) (not (<= 127 code 159)))
             (setf (editor-search-query editor)
                   (concatenate 'string (editor-search-query editor) (string key)))
             (search-history editor))
            (t (setf (editor-search-query editor) nil)
               (return-from apply-key (apply-key editor key))))
      (return-from apply-key nil))
    (cond
      ((eq key :eof) (if (zerop (length text)) :eof :accept))
      ((and (consp key) (eq (car key) :paste))
       (replace-range editor cursor cursor (printable (cdr key))) nil)
      ((or (eq key :home) (eql code 1)) (setf (editor-cursor editor) 0) nil)
      ((or (eq key :end) (eql code 5)) (setf (editor-cursor editor) (length text)) nil)
      ((or (eq key :left) (eql code 2)) (setf (editor-cursor editor) (max 0 (1- cursor))) nil)
      ((or (eq key :right) (eql code 6)) (setf (editor-cursor editor) (min (length text) (1+ cursor))) nil)
      ((eq key :backward-word) (setf (editor-cursor editor) (word-start text cursor)) nil)
      ((eq key :forward-word) (setf (editor-cursor editor) (word-end text cursor)) nil)
      ((or (eq key :up) (eql code 16)) (history-move editor 1) nil)
      ((or (eq key :down) (eql code 14)) (history-move editor -1) nil)
      ((member code '(10 13)) :accept)
      ((member code '(3 7)) :abort)
      ((and (eql code 4) (zerop (length text))) :eof)
      ((or (eq key :delete) (eql code 4))
       (when (< cursor (length text)) (replace-range editor cursor (1+ cursor) "")) nil)
      ((or (eq key :backspace) (member code '(8 127)))
       (when (> cursor 0) (replace-range editor (1- cursor) cursor "")) nil)
      ((eql code 9) (complete editor))
      ((member code '(11 21 23))
       (let ((start (case code (11 cursor) (21 0) (23 (word-start text cursor))))
             (end (if (= code 11) (length text) cursor)))
         (setf (editor-kill editor) (subseq text start end))
         (replace-range editor start end "")) nil)
      ((eq key :delete-word)
       (let ((end (word-end text cursor)))
         (setf (editor-kill editor) (subseq text cursor end))
         (replace-range editor cursor end "")) nil)
      ((eql code 25) (replace-range editor cursor cursor (editor-kill editor)) nil)
      ((eql code 20)
       (when (and (> cursor 0) (> (length text) 1))
         (let* ((right (min cursor (1- (length text)))) (copy (copy-seq text)))
           (let ((left (char copy (1- right))))
             (setf (char copy (1- right)) (char copy right))
             (setf (char copy right) left))
           (setf (editor-text editor) copy (editor-cursor editor) (1+ right)))) nil)
      ((eql code 18)
       (setf (editor-search-query editor) "" (editor-search-saved editor) (cons text cursor)
             (editor-search-index editor) -1) nil)
      ((eql code 12) :clear)
      ((and code (>= code 32) (not (<= 127 code 159)))
       (replace-range editor cursor cursor (string key)) nil)
      (t nil))))
(defun render-line (editor prompt columns)
  "Return a horizontal viewport and cursor column; reserve the final terminal cell."
  (let* ((columns (max 4 columns))
         (prompt (printable (if (editor-search-query editor)
                              (format nil "(search ~A) " (editor-search-query editor)) prompt)))
         (prefix "") (text (editor-text editor)) (cursor (editor-cursor editor)) (start 0))
    (loop for char across prompt
          while (< (display-width (concatenate 'string prefix (string char))) (- columns 2)) do
            (setf prefix (concatenate 'string prefix (string char))))
    (let ((available (max 1 (- columns 1 (display-width prefix)))))
      (loop while (and (< start cursor) (>= (display-width (subseq text start cursor)) available))
            do (incf start))
      (let ((end start))
        (loop while (and (< end (length text))
                         (<= (display-width (subseq text start (1+ end))) available)) do (incf end))
        (values (concatenate 'string prefix (subseq text start end))
                (+ (display-width prefix) (display-width (subseq text start cursor))))))))
