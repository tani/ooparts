  (:use #:cl)
  (:export #:u8-incf #:u16-incf #:u32-incf #:u64-incf #:s8-incf #:s16-incf #:s32-incf #:s64-incf #:*allocations* #:*free-bins* #:*function-handles* #:*functions* #:*heap* #:*heap-start* #:*heap-top* #:*next-function* #:*next-stream* #:*stack* #:*stack-start* #:*stack-top* #:*streams* #:+heap-size+ #:+stack-size+ #:allocation-size #:c-abort #:c-abs #:c-address #:c-bool #:c-calloc #:c-fclose #:c-fflush #:c-fopen #:c-format #:c-fprintf #:c-fputc #:c-fputs #:c-free #:c-fscanf #:c-getpid #:c-getrusage #:c-isatty #:c-length #:c-log #:c-log10 #:c-malloc #:c-memcpy #:c-memmove #:c-memset #:c-pow #:c-printf #:c-putc #:c-realloc #:c-s16 #:c-s32 #:c-s64 #:c-s8 #:c-size #:c-sprintf #:c-sqrt #:c-strcmp #:c-string #:c-strlen #:c-sysconf #:c-true #:c-u16 #:c-u32 #:c-u64 #:c-u8 #:c-vfprintf #:c-vprintf #:checked-address #:checked-sap #:copy-bytes #:define-integer-conversion #:define-memory-accessor #:ensure-arenas #:function-from-handle #:function-handle #:integer64-double #:lisp-string #:m-f32 #:m-f64 #:m-ptr #:m-s16 #:m-s32 #:m-s64 #:m-s8 #:m-size #:m-u16 #:m-u32 #:m-u64 #:m-u8 #:register-stream #:set-bits #:stack-alloc #:stream-value))
(in-package #:ooparts/sat/runtime)
;;; C representation support, written entirely in Lisp. No C solver/FFI calls.
;;; Native SBCL storage uses private arenas; the portable backend uses virtual
;;; addresses into growable octet vectors. Both retain the same checked layout.
;;; The fixed LP64 layout is independently checked by tools/sat/translate.py against GCC.
#+sbcl
(declaim (sb-ext:unmuffle-conditions sb-ext:compiler-note))
#+(and sbcl x86-64 (not ooparts-portable-sat))
(declaim (optimize (speed 3) (safety 1) (debug 1)))
#-(and sbcl x86-64 (not ooparts-portable-sat))
(declaim (optimize (speed 1) (safety 3) (debug 1)))
(deftype c-address () '(signed-byte 58))
(deftype c-size () '(integer 0 268435456))
(deftype c-length () '(or c-size (eql 18446744073709551615)))
(declaim (type (or null #+(and sbcl x86-64 (not ooparts-portable-sat)) sb-sys:system-area-pointer
                   #-(and sbcl x86-64 (not ooparts-portable-sat)) (simple-array (unsigned-byte 8) (*))) *heap* *stack*)
         (type c-size *heap-top* *stack-top*)
         (type (unsigned-byte 57) *heap-start* *stack-start*)
         (type hash-table *allocations* *free-bins* *streams* *function-handles* *functions*)
         (type (unsigned-byte 32) *next-stream* *next-function*))
(defvar *heap-start* 0)
(defvar *stack-start* 0)
(defconstant +heap-size+ (* 256 1024 1024))
(defconstant +stack-size+ (* 16 1024 1024))
(defvar *heap* nil)
(defvar *heap-top* 0)
(defvar *stack* nil)
(defvar *stack-top* 0)
(defvar *allocations* (make-hash-table :test 'eql))
(defvar *free-bins* (make-hash-table :test 'eql))
(defvar *streams* (make-hash-table :test 'eql))
(defvar *next-stream* 16)
#+(and sbcl x86-64 (not ooparts-portable-sat))
(defun ensure-arenas ()
  (unless *heap*
    (setf *heap* (sb-sys:allocate-system-memory +heap-size+)
          *stack* (sb-sys:allocate-system-memory +stack-size+)
          *heap-top* 16 *stack-top* 0
          *heap-start* (the (unsigned-byte 57) (sb-sys:sap-int *heap*))
          *stack-start* (the (unsigned-byte 57) (sb-sys:sap-int *stack*)))))
#-(and sbcl x86-64 (not ooparts-portable-sat))
(defun ensure-arenas ()
  (unless *heap*
    (unless (and (= (float-radix 1f0) 2) (= (float-digits 1f0) 24)
                 (= (float-radix 1d0) 2) (= (float-digits 1d0) 53))
      (error "The portable SAT backend requires binary single/double floats with 24/53 digits."))
    (setf *heap* (make-array 4096 :element-type '(unsigned-byte 8) :initial-element 0)
          *stack* (make-array 4096 :element-type '(unsigned-byte 8) :initial-element 0)
          *heap-top* 16 *stack-top* 0
          *heap-start* 4096 *stack-start* #x20000000)))
#-(and sbcl x86-64 (not ooparts-portable-sat))
(defun grow-arena (storage size limit)
  (if (<= size (length storage)) storage
      (let ((replacement (make-array (min limit (max size (* 2 (length storage))))
                                     :element-type '(unsigned-byte 8) :initial-element 0)))
        (replace replacement storage)
        replacement)))
(declaim (inline checked-address))
(declaim (ftype (function (c-address c-size) (values (unsigned-byte 57) &optional)) checked-address))
(defun checked-address (address width)
  (declare (type c-address address) (type c-size width))
  (let ((h *heap-start*)
        (s *stack-start*))
    (unless (or (<= h address (- (+ h *heap-top*) width))
                (<= s address (- (+ s *stack-top*) width)))
      (error "Invalid translated C memory access: ~X (~D bytes)" address width))
    (the (unsigned-byte 57) address)))
#+(and sbcl x86-64 (not ooparts-portable-sat))
(progn
(defmacro checked-sap (address width)
  `(sb-sys:int-sap (checked-address ,address ,width)))
(defmacro define-memory-accessor (name primitive width type)
  (declare (optimize (speed 1) (safety 3)))
  `(progn
     (defmacro ,name (address)
       (list ',primitive (list 'checked-sap address ,width) 0))
     (defsetf ,name (address) (value)
       (list 'setf (list ',primitive (list 'checked-sap address ,width) 0)
             (list 'the ',type value)))))
(define-memory-accessor m-u8 sb-sys:sap-ref-8 1 (unsigned-byte 8))
(define-memory-accessor m-u16 sb-sys:sap-ref-16 2 (unsigned-byte 16))
(define-memory-accessor m-u32 sb-sys:sap-ref-32 4 (unsigned-byte 32))
(define-memory-accessor m-u64 sb-sys:sap-ref-64 8 (unsigned-byte 64))
(define-memory-accessor m-s8 sb-sys:signed-sap-ref-8 1 (signed-byte 8))
(define-memory-accessor m-s16 sb-sys:signed-sap-ref-16 2 (signed-byte 16))
(define-memory-accessor m-s32 sb-sys:signed-sap-ref-32 4 (signed-byte 32))
(define-memory-accessor m-s64 sb-sys:signed-sap-ref-64 8 (signed-byte 64))
(define-memory-accessor m-f32 sb-sys:sap-ref-single 4 single-float)
(define-memory-accessor m-f64 sb-sys:sap-ref-double 8 double-float)
)
#-(and sbcl x86-64 (not ooparts-portable-sat))
(progn
  (defun memory-location (address width)
    (checked-address address width)
    (if (<= *heap-start* address (+ *heap-start* *heap-top*))
        (values *heap* (- address *heap-start*))
        (values *stack* (- address *stack-start*))))

  (defun read-integer-word (address width)
    (multiple-value-bind (storage offset) (memory-location address width)
      (loop for i below width
            for shift from 0 by 8
            sum (ash (aref storage (+ offset i)) shift))))

  (defun write-integer-word (address width value)
    (multiple-value-bind (storage offset) (memory-location address width)
      (dotimes (i width)
        (setf (aref storage (+ offset i)) (ldb (byte 8 (* 8 i)) value))))
    value)

  (defun signed-integer-word (word bits)
    (if (logbitp (1- bits) word) (- word (ash 1 bits)) word))

  ;; INTEGER-DECODE-FLOAT and SCALE-FLOAT keep the byte representation
  ;; independent of the host's byte order and pointer size. SATCH uses finite
  ;; binary floats; unsupported non-finite bit patterns are rejected explicitly.
  (defun encode-binary-float (value precision exponent-bits)
    (multiple-value-bind (significand exponent sign) (integer-decode-float value)
      (let* ((fraction-bits (1- precision))
             (bias (1- (ash 1 (1- exponent-bits))))
             (sign-bit (if (minusp sign) (ash 1 (+ fraction-bits exponent-bits)) 0)))
        (if (zerop significand) sign-bit
            (let* ((length (integer-length significand))
                   (encoded-exponent (+ exponent length -1 bias)))
              (if (plusp encoded-exponent)
                  (logior sign-bit (ash encoded-exponent fraction-bits)
                          (ldb (byte fraction-bits 0) (ash significand (- precision length))))
                  (logior sign-bit (ash significand (+ exponent bias precision -2)))))))))

  (defun decode-binary-float (word precision exponent-bits prototype)
    (let* ((fraction-bits (1- precision))
           (exponent (ldb (byte exponent-bits fraction-bits) word))
           (fraction (ldb (byte fraction-bits 0) word))
           (bias (1- (ash 1 (1- exponent-bits)))))
      (when (= exponent (1- (ash 1 exponent-bits)))
        (error "Non-finite IEEE bit pattern in portable SAT storage: ~X" word))
      (let ((magnitude (if (zerop exponent)
                           (scale-float (float fraction prototype) (- 1 bias fraction-bits))
                           (scale-float (float (+ (ash 1 fraction-bits) fraction) prototype)
                                        (- exponent bias fraction-bits)))))
        (if (logbitp (+ fraction-bits exponent-bits) word) (- magnitude) magnitude))))

  (defmacro define-portable-memory-accessor (name width type &optional signed)
    (let ((reader `(list 'read-integer-word address ,width)))
      `(progn
         (defmacro ,name (address)
           (list 'the ',type
                 ,(if signed `(list 'signed-integer-word ,reader ,(* 8 width)) reader)))
         (defsetf ,name (address) (value)
           (list 'write-integer-word address ,width (list 'the ',type value))))))
  (define-portable-memory-accessor m-u8 1 (unsigned-byte 8))
  (define-portable-memory-accessor m-u16 2 (unsigned-byte 16))
  (define-portable-memory-accessor m-u32 4 (unsigned-byte 32))
  (define-portable-memory-accessor m-u64 8 (unsigned-byte 64))
  (define-portable-memory-accessor m-s8 1 (signed-byte 8) t)
  (define-portable-memory-accessor m-s16 2 (signed-byte 16) t)
  (define-portable-memory-accessor m-s32 4 (signed-byte 32) t)
  (define-portable-memory-accessor m-s64 8 (signed-byte 64) t)
  (defmacro m-f32 (address)
    `(the single-float (decode-binary-float (read-integer-word ,address 4) 24 8 1f0)))
  (defsetf m-f32 (address) (value)
    (let ((v (gensym "FLOAT")))
      `(let ((,v (the single-float ,value)))
         (write-integer-word ,address 4 (encode-binary-float ,v 24 8))
         ,v)))
  (defmacro m-f64 (address)
    `(the double-float (decode-binary-float (read-integer-word ,address 8) 53 11 1d0)))
  (defsetf m-f64 (address) (value)
    (let ((v (gensym "FLOAT")))
      `(let ((,v (the double-float ,value)))
         (write-integer-word ,address 8 (encode-binary-float ,v 53 11))
         ,v))))
(defmacro m-ptr (address)
  (let ((cell (gensym "CELL")) (word (gensym "POINTER")))
    `(let* ((,cell ,address) (,word (m-u64 ,cell)))
       (unless (zerop (ash ,word -57))
         (error "Invalid native pointer stored at ~X" ,cell))
       (ldb (byte 57 0) ,word))))
(defmacro m-size (address)
  (let ((cell (gensym "CELL")) (word (gensym "SIZE")))
    `(let* ((,cell ,address) (,word (m-u64 ,cell)))
       (unless (<= ,word +heap-size+)
         (error "Invalid allocation size stored at ~X" ,cell))
       (ldb (byte 29 0) ,word))))
(defsetf m-size (address) (value)
  `(setf (m-u64 ,address) (the c-size ,value)))
(defsetf m-ptr (address) (value)
  `(setf (m-u64 ,address) (the (unsigned-byte 57) ,value)))
(defmacro define-integer-conversion (name bits signed)
  (declare (optimize (speed 1) (safety 3)))
  (let ((half (case bits (8 128) (16 32768) (32 2147483648) (64 9223372036854775808)))
        (full (case bits (8 256) (16 65536) (32 4294967296) (64 18446744073709551616))))
   `(defmacro ,name (value)
     (let ((v (gensym "VALUE")))
       (list 'let (list (list v (list 'ldb (list 'byte ,bits 0) value)))
             ,(if signed `(list 'if (list '>= v ,half)
                                 (list '- v ,full) v) 'v))))))
(define-integer-conversion c-u8 8 nil)
(define-integer-conversion c-u16 16 nil)
(define-integer-conversion c-u32 32 nil)
(define-integer-conversion c-u64 64 nil)
(define-integer-conversion c-s8 8 t)
(define-integer-conversion c-s16 16 t)
(define-integer-conversion c-s32 32 t)
(define-integer-conversion c-s64 64 t)
;;; Wrapping arithmetic on generalized places. The place and delta are each
;;; evaluated once; all arithmetic stays visible to the caller's compiler.
(defmacro define-wrapping-incf (name conversion)
  (declare (optimize (speed 1) (safety 3)))
  `(defmacro ,name (place &optional (delta 1) &environment environment)
     (multiple-value-bind (variables values stores setter getter)
         (get-setf-expansion place environment)
       (declare (type list variables values stores))
       (assert (and (consp stores) (null (cdr stores))))
       `(let* (,@(mapcar #'list variables values)
               (,(first stores) (,',conversion (+ ,getter ,delta))))
          ,setter
          ,(first stores)))))
(define-wrapping-incf u8-incf c-u8)
(define-wrapping-incf u16-incf c-u16)
(define-wrapping-incf u32-incf c-u32)
(define-wrapping-incf u64-incf c-u64)
(define-wrapping-incf s8-incf c-s8)
(define-wrapping-incf s16-incf c-s16)
(define-wrapping-incf s32-incf c-s32)
(define-wrapping-incf s64-incf c-s64)

(declaim (inline set-bits))
(defmacro c-true (x) `(not (zerop ,x)))
(defmacro c-bool (x) `(if (zerop ,x) 0 1))
(defun set-bits (address position size value)
  (declare (type c-address address) (type (integer 0 7) position) (type (integer 1 8) size) (type (unsigned-byte 8) value))
  (if (<= (+ size position) 8)
      (setf (ldb (byte size position) (m-u8 address)) value)
      (setf (ldb (byte size position) (m-u16 address)) value))
  value)
(declaim (ftype (function (c-size) (values c-address &optional)) stack-alloc))
(defun stack-alloc (size)
  (declare (type c-size size))
  (ensure-arenas)
  (let* ((offset (logand (+ *stack-top* 15) -16)) (end (+ offset (max 1 size))))
    (when (> end +stack-size+) (error "Translated C automatic-storage arena exhausted"))
    #-(and sbcl x86-64 (not ooparts-portable-sat))
    (setf *stack* (grow-arena *stack* end +stack-size+))
    (setf *stack-top* end)
    (+ *stack-start* offset)))
(declaim (ftype (function (c-size) (values c-size &optional)) allocation-size))
(defun allocation-size (size)
  (declare (type c-size size))
  (ash 1 (max 4 (integer-length (1- (max 1 size))))))
(declaim (ftype (function (c-size) (values c-address &optional)) c-malloc))
(defun c-malloc (size)
  (declare (type c-size size))
  (ensure-arenas)
  (let* ((capacity (allocation-size size)) (bin (gethash capacity *free-bins*))
         (address (if bin (pop (gethash capacity *free-bins*))
                    (let ((end (+ *heap-top* capacity)))
                      (when (> end +heap-size+) (error "SATCH Lisp heap arena exhausted (~D bytes)" +heap-size+))
                      #-(and sbcl x86-64 (not ooparts-portable-sat))
                      (setf *heap* (grow-arena *heap* end +heap-size+))
                      (prog1 (+ *heap-start* *heap-top*) (setf *heap-top* end))))))
    (setf (gethash address *allocations*) capacity)
    address))
(declaim (ftype (function (c-address) (values (integer 0 0) &optional)) c-free))
(defun c-free (address)
  (declare (type c-address address))
  (unless (zerop address)
    (let ((size (the (or null c-size) (gethash address *allocations*))))
      (unless size (error "Invalid free or double free: ~X" address))
      (remhash address *allocations*)
      (push address (gethash size *free-bins*))))
  0)
(declaim (ftype (function (c-address c-address c-size) (values c-address &optional)) copy-bytes))
(defun copy-bytes (destination source size)
  (declare (type c-address destination) (type c-address source) (type c-size size))
  #+(and sbcl x86-64 (not ooparts-portable-sat))
  (when (plusp size)
    (let ((dst (checked-sap destination size)) (src (checked-sap source size)))
      (if (and (> destination source) (< destination (+ source size)))
          (loop for i downfrom (1- size) to 0 do
            (setf (sb-sys:sap-ref-8 dst i) (sb-sys:sap-ref-8 src i)))
          (loop for i fixnum below size do
            (setf (sb-sys:sap-ref-8 dst i) (sb-sys:sap-ref-8 src i))))))
  #-(and sbcl x86-64 (not ooparts-portable-sat))
  (when (plusp size)
    (multiple-value-bind (destination-storage destination-offset) (memory-location destination size)
      (multiple-value-bind (source-storage source-offset) (memory-location source size)
        (replace destination-storage source-storage
                 :start1 destination-offset :end1 (+ destination-offset size)
                 :start2 source-offset :end2 (+ source-offset size)))))
  destination)
(declaim (ftype (function (c-address c-address c-size) (values c-address &optional)) c-memcpy))
(defun c-memcpy (d s n)
  (declare (type c-address d) (type c-address s) (type c-size n)) (copy-bytes d s n))
(declaim (ftype (function (c-address c-address c-size) (values c-address &optional)) c-memmove))
(defun c-memmove (d s n)
  (declare (type c-address d) (type c-address s) (type c-size n)) (copy-bytes d s n))
(declaim (ftype (function (c-address (signed-byte 32) c-size) (values c-address &optional)) c-memset))
(defun c-memset (d v n)
  (declare (type c-address d) (type (signed-byte 32) v) (type c-size n))
  #+(and sbcl x86-64 (not ooparts-portable-sat))
  (when (plusp n)
    (let ((sap (checked-sap d n)) (byte (ldb (byte 8 0) v)))
      (dotimes (i n) (setf (sb-sys:sap-ref-8 sap i) byte))))
  #-(and sbcl x86-64 (not ooparts-portable-sat))
  (when (plusp n)
    (multiple-value-bind (storage offset) (memory-location d n)
      (fill storage (ldb (byte 8 0) v) :start offset :end (+ offset n))))
  d)
(declaim (ftype (function (c-size c-size) (values c-address &optional)) c-calloc))
(defun c-calloc (count size)
  (declare (type c-size count) (type c-size size))
  (let* ((bytes (* count size)) (address (c-malloc bytes)))
    (c-memset address 0 bytes)))
(declaim (ftype (function (c-address c-size) (values c-address &optional)) c-realloc))
(defun c-realloc (address size)
  (declare (type c-address address) (type c-size size))
  (if (zerop address) (c-malloc size)
      (let ((old-size (the (or null c-size) (gethash address *allocations*))))
        (unless old-size (error "Realloc of unknown address"))
        (if (>= old-size size) address
            (let ((new (c-malloc size)))
              (copy-bytes new address old-size) (c-free address) new)))))
(declaim (ftype (function (simple-string) (values c-address &optional)) c-string))
(defun c-string (string)
  (declare (type simple-string string))
  (let ((address (c-malloc (the c-size (1+ (length string))))))
    (loop for ch across string for i of-type c-size from 0 do (setf (m-u8 (+ address i)) (char-code ch)))
    (setf (m-u8 (+ address (the c-size (length string)))) 0) address))
(declaim (ftype (function (c-address) (values simple-string &optional)) lisp-string))
(defun lisp-string (pointer)
  (declare (type c-address pointer))
  (with-output-to-string (out)
    (loop for p of-type c-address from pointer for ch = (m-u8 p) until (zerop ch) do (write-char (code-char ch) out))))
(declaim (ftype (function (c-address) (values c-size &optional)) c-strlen))
(defun c-strlen (p)
  (declare (type c-address p)) (loop for i of-type c-size from 0 until (zerop (m-u8 (+ p i))) finally (return i)))
(declaim (ftype (function (c-address c-address) (values (signed-byte 32) &optional)) c-strcmp))
(defun c-strcmp (a b)
  (declare (type c-address a) (type c-address b))
  (loop for i of-type c-size from 0 for x = (m-u8 (+ a i)) for y = (m-u8 (+ b i))
        when (/= x y) return (- x y) when (zerop x) return 0))
(declaim (ftype (function ((signed-byte 32)) (values (signed-byte 32) &optional)) c-abs))
(defun c-abs (x)
  (declare (type (signed-byte 32) x)) (abs x))
(defmacro c-log (x) `(log (the (double-float (0d0) *) ,x)))
(defmacro c-log10 (x)
  `(the double-float (log (the (double-float (0d0) *) ,x) 10d0)))
(defmacro c-sqrt (x) `(sqrt (the (double-float 0d0 *) ,x)))
(defmacro c-pow (x y) `(expt (the (double-float (0d0) *) ,x) (the double-float ,y)))
(defmacro integer64-double (value signed)
  (let ((v (gensym "INTEGER64")))
    `(let ((,v ,value))
       (+ (* (float ,(if signed `(c-s32 (ldb (byte 32 32) ,v)) `(ldb (byte 32 32) ,v)) 1d0)
             4294967296d0)
          (float (ldb (byte 32 0) ,v) 1d0)))))
(defun c-abort () (error "SATCH rejected the operation (see diagnostic above)"))
(defun c-isatty (fd) (declare (ignore fd)) 0)
(declaim (ftype (function ((unsigned-byte 32)) (values stream &optional)) stream-value))
(defun stream-value (handle)
  (declare (type (unsigned-byte 32) handle))
  (case handle (1 *standard-output*) (2 *error-output*)
    (otherwise (or (gethash handle *streams*) (error "Unknown stream handle ~S" handle)))))
(declaim (ftype (function (stream) (values (unsigned-byte 32) &optional)) register-stream))
(defun register-stream (stream)
  (declare (type stream stream))
  (let ((handle (incf *next-stream*))) (setf (gethash handle *streams*) stream) handle))
(declaim (ftype (function (c-address list) (values simple-string &optional)) c-format))
(defun c-format (pointer args)
  (declare (optimize (speed 1) (safety 3)))
  (declare (type c-address pointer) (type list args))
  (let ((fmt (lisp-string pointer)) (pos 0))
    (declare (type (unsigned-byte 24) pos))
    (with-output-to-string (out)
      (loop while (< pos (length fmt)) do
        (let ((ch (char fmt pos)))
          (incf pos)
          (if (char/= ch #\%) (write-char ch out)
              (if (char= (char fmt pos) #\%) (progn (write-char #\% out) (incf pos))
                  (let ((left nil) (width 0) (precision nil))
                    (declare (type (unsigned-byte 16) width) (type (or null (unsigned-byte 16)) precision))
                    (loop while (find (char fmt pos) "-+ #0") do
                      (when (char= (char fmt pos) #\-) (setf left t)) (incf pos))
                    (loop while (digit-char-p (char fmt pos)) do
                      (setf width (+ (* width 10) (the (integer 0 9) (digit-char-p (char fmt pos))))) (incf pos))
                    (when (char= (char fmt pos) #\.)
                      (incf pos) (setf precision 0)
                      (loop while (digit-char-p (char fmt pos)) do
                        (setf precision (+ (* precision 10) (the (integer 0 9) (digit-char-p (char fmt pos))))) (incf pos)))
                    (loop while (find (char fmt pos) "lhzjtL") do (incf pos))
                    (let* ((kind (char fmt pos)) (arg (pop args))
                           (text (case kind
                                   (#\s (let ((s (lisp-string (the c-address arg)))) (if precision (subseq s 0 (min precision (length s))) s)))
                                   (#\c (string (code-char arg)))
                                   ((#\d #\i #\u) (format nil "~D" arg))
