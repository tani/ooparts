;;; Direct native-Prolog elaboration for the SML '97 Core.
;;;
;;; The input and output of the elaborator are native terms.  In particular,
;;; no Common Lisp typechecker or AST interpreter is hidden behind this file:
;;; AST recognition, scope, inference, constructor classification, declaration
;;; elaboration, and persistent-basis conversion below are Prolog relations.
;;; The small host bridge is restricted to opaque lexical leaves, fresh host
;;; symbols/identities, and source-located diagnostics.

(uiop:define-package #:ooparts/sml/elaborate
  (:use #:cl)
  (:import-from #:ooparts/prolog
    #:*database* #:<- #:<-- #:--> #:make-database #:query)
  (:import-from #:ooparts/prolog/kernel/instructions
    #:dcg-internal)
  (:import-from #:ooparts/sml/source
    #:sml-source-error #:sml-error-span)
  (:import-from #:ooparts/sml/syntax
    #:identifier-path #:identifier-name #:ast-node-span #:literal-kind #:literal-value
    #:real-literal-negative-p #:real-literal-significand #:real-literal-scale)
  (:import-from #:ooparts/sml/runtime
    #:+reference-identity+ #:+sml-word-bits+ #:+sml-word-modulus+)
  (:import-from #:ooparts/sml/types
    #:install-type-predicates #:make-type-name #:sml-type-error
    #:type-name #:type-var #:=> #:@ #:record #:field #:scheme #:type-function
    #:type-env #:binding #:type-unify #:record-type #:type-application
    #:apply-type-function #:instantiate-type-scheme #:generalize-type
    #:free-type-variables #:free-type-names #:realize-type #:realization #:name-map
    #:ensure-equality)
  (:export
    #:*core-elaboration-database* #:make-core-elaboration-database
    #:install-elaboration-predicates #:elaborate-program #:elaborate-declarations
    #:thaw-static #:freeze-static #:freeze-type #:thaw-type
    #:sml-elaboration-error #:elaboration-error-kind))
(in-package #:ooparts/sml/elaborate)

(define-condition sml-elaboration-error (sml-type-error)
  ((span :initarg :span :initform nil :reader sml-error-span)
   (kind :initarg :kind :initform :static :reader elaboration-error-kind))
  (:report (lambda (condition stream)
             (format stream "~A~@[ at ~S~]"
                     (ooparts/sml/types::%type-error-message condition)
                     (and (sml-error-span condition)
                          (ooparts/sml/source:source-name
                           (ooparts/sml/source:source-span-source
                            (sml-error-span condition))))))))

(defun %fail (span message &optional (kind :static))
  (error 'sml-elaboration-error :span span :kind kind :message message))

(defun %path (identifier)
  (identifier-path identifier))

(defun %name (identifier)
  (identifier-name identifier))

(defun %explicit-type-variable-names (ast)
  "Collect scoped type-variable spellings without growing the logical heap."
  (let ((names nil))
    (labels ((walk (node)
               (cond
                 ((atom node) nil)
                 ((eq (car node) :node)
                  (case (second node)
                    (:type-variable
                     (let ((name (%name (cdr (assoc :identifier (fourth node))))))
                       (unless (member name names :test #'equal)
                         (push name names))))
                    ((:value-declaration :function-declaration) nil)
                    (otherwise
                     (walk (car node))
                     (walk (cdr node)))))
                 (t
                  (walk (car node))
                  (walk (cdr node))))))
      (walk ast))
    (nreverse names)))

(defun %label (node)
  ;; LABEL is a native (:NODE :LABEL SPAN ((:NAME . string))) node.
  (cdr (assoc :name (fourth node))))

(defun %equality-variable-name-p (name)
  (and (> (length name) 1) (char= #\' (char name 0))
       (char= #\' (char name 1))))

(defun %semantic-span-node-p (tag)
  (member tag
          '(:x-literal :x-variable :x-unit :x-typed :x-record :x-selector
            :x-sequence :x-list :x-application :x-andalso :x-orelse :x-if
            :x-raise :x-while :x-function :x-case :x-handle :x-let
            :p-wildcard :p-unit :p-literal :p-variable :p-typed :p-constructor
            :p-list-nil :p-list-cons :p-record :p-layered)
          :test #'eq))

(defun %reified-variable-symbol-p (value)
  (and (symbolp value)
       (null (symbol-package value))
       (let ((name (symbol-name value)))
         (and (> (length name) 2)
              (string= "?G" name :end2 2)
              (every #'digit-char-p (subseq name 2))))))

(defun %compact-semantic-image (semantic &optional preserve-overloads-p)
  "Compact an ordinary frozen semantic graph without touching live type cells.
PRESERVE-OVERLOADS-P retains unresolved occurrences until their declaration.
Sharing is preserved, but no other frozen source/type annotation is retained
where native emission never consumes it."
  (let ((seen (make-hash-table :test #'eq))
        (declaration-tags
          '(:d-value :d-mixed-value :d-functions :d-datatype :d-replication
            :d-exceptions :d-local :d-abstype)))
    (labels ((walk-generic (term)
               ;; Cache the candidate before descending for cycles/shared
               ;; references, then retain the original cons when no child
               ;; changed.  Canonical plain match bodies therefore cross into
               ;; emission without a second equivalent semantic forest.
               (let ((copy (cons nil nil)))
                 (setf (gethash term seen) copy)
                 (let ((head (walk (car term)))
                       (tail (walk (cdr term))))
                   (if (and (eq head (car term)) (eq tail (cdr term)))
                       (progn (setf (gethash term seen) term) term)
                       (progn (setf (car copy) head (cdr copy) tail) copy)))))
             (walk (term)
               (if (not (consp term))
                   term
                   (or (gethash term seen)
                       (let ((tag (car term)))
                         (cond
                           ((and preserve-overloads-p (eq tag :x-variable)
                                 (consp (fifth term))
                                 (eq (car (fifth term)) :overloaded))
                            (let ((copy (cons nil nil)))
                              (setf (gethash term seen) copy)
                              (setf (car copy) (walk (car term))
                                    (cdr copy) (walk (cdr term)))
                              copy))
                           ((and (eq tag :bind) (null (third term)))
                            (walk-generic term))
                           ((and (eq tag :fb) (null (fourth term)))
                            (walk-generic term))
                           ((and (eq tag :rc) (null (fifth term)))
                            (walk-generic term))
                           ((and (member tag declaration-tags :test #'eq)
                                 (null (second term)))
                            (walk-generic term))
                           ((and (%semantic-span-node-p tag)
                                 (null (second term)) (null (third term)))
                            (walk-generic term))
                           ((eq tag :bind)
                            (let ((copy (list :bind (second term) nil (fourth term))))
                              (setf (gethash term seen) copy)
                              copy))
                           ((eq tag :fb)
                            (let ((copy (list :fb (second term) (third term) nil nil)))
                              (setf (gethash term seen) copy)
                              (setf (fifth copy) (walk (fifth term)))
                              copy))
                           ((eq tag :rc)
                            (let ((copy (list :rc (second term) (third term)
                                              (fourth term) nil (sixth term))))
                              (setf (gethash term seen) copy)
                              copy))
                           ((member tag declaration-tags :test #'eq)
                            (let ((copy (cons tag (cons nil nil))))
                              (setf (gethash term seen) copy)
                              (setf (cddr copy) (walk (cddr term)))
                              copy))
                           ((%semantic-span-node-p tag)
                            (let ((copy (cons tag (cons nil (cons nil nil)))))
                              (setf (gethash term seen) copy)
                              (setf (cdddr copy) (walk (cdddr term)))
                              copy))
                           (t (walk-generic term))))))))
      (walk semantic))))

(let ((serial 0))
  (defun %fresh-symbol (prefix)
    ;; Interned names make emitted code readable and safely reloadable.  Their
    ;; identities are deliberately not derived from SML source capitalization.
    (intern (format nil "~A.~D" prefix (incf serial))
            (find-package '#:ooparts/sml/elaborate)))
  (defun %fresh-binding (name)
    (%fresh-symbol (format nil "V.~A" name)))
  (defun %fresh-identity (name)
    (%fresh-symbol (format nil "T.~A" name)))
  (defun %fresh-frozen-cell ()
    (%fresh-symbol "F"))
  (defun %fresh-match-overload-key ()
    (%fresh-symbol "O")))

(defun %real-value (literal)
  ;; SML decimal input remains exact until this single host boundary.  REAL is
  ;; documented by the backend as the host double-float representation.
  (let ((value (literal-value literal)))
    (* (if (real-literal-negative-p value) -1 1)
       (coerce (* (real-literal-significand value)
                  (expt 10 (real-literal-scale value)))
               'double-float))))

(defun %prefix-suffix (prefix path)
  ;; OPEN imports components, never the value or type entry denoting the
  ;; structure path itself.  The three source namespaces are independent.
  (and (< (length prefix) (length path))
       (equal prefix (subseq path 0 (length prefix)))
       (subseq path (length prefix))))

(defun make-core-elaboration-database ()
  (let ((database (make-database :term-model :native :execution-mode :wam)))
    (install-type-predicates database)
    (install-elaboration-predicates database)))

(defun %install-elaboration-persistent-predicates (database)
  (let ((*database* database))

    ;;; Persistent external bases.  A frozen type-variable cell is (:FV ID).
    ;;; Free cells are shared by a map during each thaw/freeze pass, so an
    ;;; unquantified imperative type variable never becomes accidentally
    ;;; polymorphic between interactive compilations.
    (<-- (%external-equality :ordinary ?equality) (var ?equality) !)
    (<- (%external-equality :equality :equality) !)

    (<-- (%map-lookup ?key ((:map ?found-key ?value) . ?rest) ?value)
        (== ?key ?found-key) !)
    (<- (%map-lookup ?key (?entry . ?rest) ?value)
        (%map-lookup ?key ?rest ?value))
    (<-- (%outside-scope-map ?extended ?local ?out)
        (%drop-local-maps ?extended ?local ?out))
    (<-- (%drop-local-maps nil ?local nil) !)
    (<- (%drop-local-maps ((:map ?key ?value) . ?entries) ?local ?out)
        (or (-> (%map-key-present ?key ?local)
                (= ?out ?rest))
            (= ?out ((:map ?key ?value) . ?rest)))
        (%drop-local-maps ?entries ?local ?rest))
    (<-- (%map-key-present ?key ((:map ?same ?value) . ?rest)) (== ?key ?same) !)
    (<- (%map-key-present ?key (?entry . ?rest)) (%map-key-present ?key ?rest))

    (<-- (%thaw-type (type-var (:fv ?id) ?kind ?external-equality) ?in ?out ?type)
        !
        (or (-> (%map-lookup (:fv ?id) ?in ?found)
                (and (= ?type ?found) (= ?out ?in)))
            (and (%external-equality ?external-equality ?equality)
                 (and (= ?type (type-var ?cell ?kind ?equality))
                      (= ?out ((:map (:fv ?id) ?type) . ?in))))))
    (<- (%thaw-type (type-var ?cell ?kind ?equality) ?in ?out ?type)
        !
        ;; External bases never contain live cells, but accepting one here is
        ;; useful for direct DCG clients constructing native terms themselves.
        (%thaw-type ?cell ?in ?next ?new-cell)
        (= ?out ?next)
        (= ?type (type-var ?new-cell ?kind ?equality)))
    (<- (%thaw-type (=> ?domain ?range) ?in ?out (=> ?new-domain ?new-range))
        ! (%thaw-type ?domain ?in ?middle ?new-domain)
        (%thaw-type ?range ?middle ?out ?new-range))
    (<- (%thaw-type (@ ?name ?arguments) ?in ?out (@ ?name ?new-arguments))
        ! (%thaw-types ?arguments ?in ?out ?new-arguments))
    (<- (%thaw-type (record ?fields :closed) ?in ?out (record ?new-fields :closed))
        ! (%thaw-fields ?fields ?in ?out ?new-fields))
    (<- (%thaw-type (record ?fields ?tail) ?in ?out (record ?new-fields ?new-tail))
        ! (%thaw-fields ?fields ?in ?middle ?new-fields)
        (%thaw-type ?tail ?middle ?out ?new-tail))
    (<- (%thaw-type (scheme ?quantified ?body) ?in ?out (scheme ?new-quantified ?new-body))
        ! (%thaw-quantified ?quantified ?local ?new-quantified)
        (%append ?local ?in ?combined)
        (%thaw-type ?body ?combined ?extended ?new-body)
        (%outside-scope-map ?extended ?local ?out))
    (<- (%thaw-type (type-function ?parameters ?body) ?in ?out
                    (type-function ?new-parameters ?new-body))
        ! (%thaw-parameters ?parameters ?local ?new-parameters)
        (%append ?local ?in ?combined)
        (%thaw-type ?body ?combined ?extended ?new-body)
        (%outside-scope-map ?extended ?local ?out))
    (<- (%thaw-type ?other ?in ?in ?other) !)

    (<-- (%thaw-types nil ?map ?map nil) !)
    (<- (%thaw-types (?type . ?types) ?in ?out (?new . ?rest))
        (%thaw-type ?type ?in ?middle ?new)
        (%thaw-types ?types ?middle ?out ?rest))
    (<-- (%thaw-fields nil ?map ?map nil) !)
    (<- (%thaw-fields ((field ?label ?type) . ?fields) ?in ?out
                      ((field ?label ?new) . ?rest))
        (%thaw-type ?type ?in ?middle ?new)
        (%thaw-fields ?fields ?middle ?out ?rest))

    (<-- (%thaw-quantified nil nil nil) !)
    (<- (%thaw-quantified ((:fv ?id ?kind ?external-equality) . ?rest)
                          ((:map (:fv ?id) ?new) . ?local) (?new . ?new-rest))
        (%external-equality ?external-equality ?equality)
        (= ?new (type-var ?cell ?kind ?equality))
        (%thaw-quantified ?rest ?local ?new-rest))
    (<-- (%thaw-parameters nil nil nil) !)
    (<- (%thaw-parameters ((type-var (:fv ?id) ?kind ?external-equality) . ?rest)
                          ((:map (:fv ?id) ?new) . ?local) (?new . ?new-rest))
        (%external-equality ?external-equality ?equality)
        (= ?new (type-var ?cell ?kind ?equality))
        (%thaw-parameters ?rest ?local ?new-rest))
    (<- (%thaw-parameters ((:fv ?id ?kind ?external-equality) . ?rest)
                          ((:map (:fv ?id) ?new) . ?local) (?new . ?new-rest))
        (%external-equality ?external-equality ?equality)
        (= ?new (type-var ?cell ?kind ?equality))
        (%thaw-parameters ?rest ?local ?new-rest))

    (<-- (%freeze-type ?type ?in ?out ?frozen) (var ?type) !
        (%freeze-cell ?type :type :ordinary ?in ?out ?frozen))
    (<- (%freeze-type (type-var ?cell ?kind ?equality) ?in ?out ?frozen)
        (var ?cell) !
        (or (-> (var ?equality) (= ?external :ordinary))
            (= ?external :equality))
        (%freeze-cell ?cell ?kind ?external ?in ?out ?frozen))
    (<- (%freeze-type (type-var ?cell :row ?equality) ?in ?out ?frozen)
        (nonvar ?cell) !
        (or (-> (var ?equality) (= ?external :ordinary))
            (= ?external :equality))
        (%freeze-type ?cell ?in ?out ?frozen-cell)
        (= ?frozen (type-var ?frozen-cell :row ?external)))
    (<- (%freeze-type (type-var ?cell ?kind ?equality) ?in ?out ?frozen)
        ! (%freeze-type ?cell ?in ?out ?frozen))
    (<- (%freeze-type (=> ?domain ?range) ?in ?out (=> ?new-domain ?new-range))
        ! (%freeze-type ?domain ?in ?middle ?new-domain)
        (%freeze-type ?range ?middle ?out ?new-range))
    (<- (%freeze-type (@ ?name ?arguments) ?in ?out (@ ?name ?new-arguments))
        ! (%freeze-types ?arguments ?in ?out ?new-arguments))
    (<- (%freeze-type (record ?fields :closed) ?in ?out (record ?new-fields :closed))
        ! (%freeze-fields ?fields ?in ?out ?new-fields))
    (<- (%freeze-type (record ?fields ?tail) ?in ?out (record ?new-fields ?new-tail))
        ! (%freeze-fields ?fields ?in ?middle ?new-fields)
        (%freeze-type ?tail ?middle ?out ?new-tail))
    (<- (%freeze-type (scheme ?quantified ?body) ?in ?out (scheme ?frozen-quantified ?frozen-body))
        ! (%freeze-quantified ?quantified ?seed ?frozen-quantified)
        (%append ?seed ?in ?combined)
        (%freeze-type ?body ?combined ?extended ?frozen-body)
        (%outside-scope-map ?extended ?seed ?out))
    (<- (%freeze-type (type-function ?parameters ?body) ?in ?out
                      (type-function ?frozen-parameters ?frozen-body))
        ! (%freeze-parameters ?parameters ?seed ?frozen-parameters)
        (%append ?seed ?in ?combined)
        (%freeze-type ?body ?combined ?extended ?frozen-body)
        (%outside-scope-map ?extended ?seed ?out))
    (<- (%freeze-type ?other ?in ?in ?other) !)

    (<-- (%freeze-cell ?cell ?kind ?external ?in ?out
                       (type-var (:fv ?id) ?kind ?external))
        (or (-> (%map-lookup ?cell ?in (:fv ?id)) true)
            (and (lisp ?fresh (%fresh-frozen-cell))
                 (= ?id ?fresh)))
        (or (-> (%map-lookup ?cell ?in ?ignored) (= ?out ?in))
            (= ?out ((:map ?cell (:fv ?id)) . ?in))) !)
    (<-- (%freeze-types nil ?map ?map nil) !)
    (<- (%freeze-types (?type . ?types) ?in ?out (?new . ?rest))
        (%freeze-type ?type ?in ?middle ?new)
        (%freeze-types ?types ?middle ?out ?rest))
    (<-- (%freeze-fields nil ?map ?map nil) !)
    (<- (%freeze-fields ((field ?label ?type) . ?fields) ?in ?out
                        ((field ?label ?new) . ?rest))
        (%freeze-type ?type ?in ?middle ?new)
        (%freeze-fields ?fields ?middle ?out ?rest))
    (<-- (%freeze-quantified nil nil nil) !)
    (<- (%freeze-quantified (?variable . ?rest) ?maps
                            ((:fv ?id ?kind ?external) . ?frozen-rest))
        (%freeze-cell-for-quantifier ?variable ?kind ?external (:fv ?id))
        (= ?maps ((:map ?cell (:fv ?id)) . ?local))
        (%variable-cell ?variable ?cell)
        (%freeze-quantified ?rest ?local ?frozen-rest))
    (<-- (%freeze-cell-for-quantifier ?variable :type :ordinary (:fv ?id))
        (var ?variable) ! (lisp ?id (%fresh-frozen-cell)))
    (<- (%freeze-cell-for-quantifier (type-var ?cell ?kind ?equality) ?kind ?external (:fv ?id))
        (lisp ?id (%fresh-frozen-cell))
        (or (-> (var ?equality) (= ?external :ordinary)) (= ?external :equality)) !)
    (<-- (%variable-cell ?variable ?variable) (var ?variable) !)
    (<- (%variable-cell (type-var ?cell ?kind ?equality) ?cell) !)
    (<- (%variable-cell ?variable ?variable))
    (<-- (%freeze-parameters nil nil nil) !)
    (<- (%freeze-parameters ?parameters ?maps ?frozen)
        (%freeze-quantified ?parameters ?maps ?descriptors)
        (%frozen-parameter-descriptors ?descriptors ?frozen))
    (<-- (%frozen-parameter-descriptors nil nil) !)
    (<- (%frozen-parameter-descriptors ((:fv ?id ?kind ?equality) . ?descriptors)
                                       ((type-var (:fv ?id) ?kind ?equality) . ?parameters))
        (%frozen-parameter-descriptors ?descriptors ?parameters))

    ;;; Generic native snapshots use one variable map across a complete product.
    ;;; Frozen terms are ground host data; thawing restores every shared cell,
    ;;; including aliases between static state, views and executable semantics.
    (<-- (%native-type-term (scheme ?quantified ?body)) !)
    (<- (%native-type-term (type-function ?parameters ?body)) !)
    (<- (%native-type-term (type-var ?cell ?kind ?equality)) !)
    (<- (%native-type-term (@ ?name ?arguments)) !)
    (<- (%native-type-term (record ?fields ?tail)) !)
    (<- (%native-type-term (=> ?domain ?range)) !)
    (<-- (%thaw-native ?term ?in ?in ?term) (var ?term) !)
    (<- (%thaw-native ?term ?in ?out ?new)
        (%native-type-term ?term) ! (%thaw-type ?term ?in ?out ?new))
    (<- (%thaw-native (?head . ?tail) ?in ?out (?new-head . ?new-tail))
        ! (%thaw-native ?head ?in ?middle ?new-head)
        (%thaw-native ?tail ?middle ?out ?new-tail))
    (<- (%thaw-native ?other ?in ?in ?other) !)
    (<-- (%freeze-native ?term ?in ?out ?new)
        (var ?term) ! (%freeze-type ?term ?in ?out ?new))
    (<- (%freeze-native ?term ?in ?out ?new)
        (%native-type-term ?term) ! (%freeze-type ?term ?in ?out ?new))
    (<- (%freeze-native (?head . ?tail) ?in ?out (?new-head . ?new-tail))
        ! (%freeze-native ?head ?in ?middle ?new-head)
        (%freeze-native ?tail ?middle ?out ?new-tail))
    (<- (%freeze-native ?other ?in ?in ?other) !)

    ;;; Reconstruct a ground executable match body and a separate list of live
    ;;; overload obligations.  The third and fourth arguments are a difference
    ;;; list: each occurrence contributes its fresh key and complete type while
    ;;; the body retains only that key, its family, symbol, and source span.
    ;;; No logic variable is allowed to escape through an ordinary metadata leaf.
    (<-- (%compact-match-semantic
         (:x-variable ?span ?type ?symbol (:overloaded ?family))
         (:x-variable ?span (:deferred-match-overload ?key) ?symbol
                      (:overloaded ?family))
         ?rest ((:match-overload ?key ?type) . ?rest))
        (lisp ?key (%fresh-match-overload-key)) !)
    (<- (%compact-match-semantic (:bind ?name ?type ?host)
                                 (:bind ?name nil ?host) ?obligations ?obligations) !)
    (<- (%compact-match-semantic (:fb ?name ?host ?type ?rules)
                                 (:fb ?name ?host nil ?new-rules) ?in ?out)
        ! (%compact-match-semantic ?rules ?new-rules ?in ?out))
    (<- (%compact-match-semantic (:rc ?name ?host ?source ?scheme ?status)
                                 (:rc ?name ?host ?source nil ?status)
                                 ?obligations ?obligations) !)
    ;;; The selector row type and function argument are redundant annotation
    ;;; payloads.  Emission, nonexpansiveness, and overload resolution consume
    ;;; only LABEL/RULES respectively; retaining either would retain live cells.
    (<- (%compact-match-semantic (:x-selector ?span ?type ?label ?record)
                                 (:x-selector nil nil ?label nil)
                                 ?obligations ?obligations) !)
    (<- (%compact-match-semantic (:x-function ?span ?type ?argument ?rules)
                                 (:x-function nil nil nil ?new-rules) ?in ?out)
        ! (%compact-match-semantic ?rules ?new-rules ?in ?out))
    (<- (%compact-match-semantic (?tag ?span . ?rest) (?tag nil . ?new-rest) ?in ?out)
        (%semantic-compaction-declaration-tag ?tag) !
        (%compact-match-semantic ?rest ?new-rest ?in ?out))
    (<- (%compact-match-semantic (?tag ?span ?type . ?rest)
                                 (?tag nil nil . ?new-rest) ?in ?out)
        (lispp (%semantic-span-node-p ?tag)) !
        (%compact-match-semantic ?rest ?new-rest ?in ?out))
    (<- (%compact-match-semantic (?head . ?tail) (?new-head . ?new-tail) ?in ?out)
        ! (%compact-match-semantic ?head ?new-head ?in ?middle)
        (%compact-match-semantic ?tail ?new-tail ?middle ?out))
    (<- (%compact-match-semantic ?other ?other ?obligations ?obligations)
        (nonvar ?other) !)

    (<-- (%semantic-compaction-declaration-tag :d-value) !)
    (<- (%semantic-compaction-declaration-tag :d-mixed-value) !)
    (<- (%semantic-compaction-declaration-tag :d-functions) !)
    (<- (%semantic-compaction-declaration-tag :d-datatype) !)
    (<- (%semantic-compaction-declaration-tag :d-replication) !)
    (<- (%semantic-compaction-declaration-tag :d-exceptions) !)
    (<- (%semantic-compaction-declaration-tag :d-local) !)
    (<- (%semantic-compaction-declaration-tag :d-abstype) !)

    ;;; Prove the retained body ground before it leaves the Prolog query.  This
    ;;; walks every retained cons, including deferred markers, rather than
    ;;; treating unexpected live metadata as an opaque neutral leaf.
    (<-- (%plain-match-semantic (:deferred-match-overload ?key))
        (nonvar ?key) !)
    (<- (%plain-match-semantic (?head . ?tail)) !
        (%plain-match-semantic ?head) (%plain-match-semantic ?tail))
    (<- (%plain-match-semantic ?other) (nonvar ?other) !)

    ;;; Restore overload types only after all batches have been thawed under one
    ;;; map shared with STATIC, ARGUMENT, and RESULT.  Exact key identity selects
    ;;; each obligation; no structural type matching or host cache is involved.
    (<-- (%match-overload-lookup ?key ((:match-overload ?found ?type) . ?rest) ?type)
        (== ?key ?found) !)
    (<- (%match-overload-lookup ?key (?entry . ?rest) ?type)
        (%match-overload-lookup ?key ?rest ?type))
    ;;; One obligation is emitted per deferred marker.  With no obligations the
    ;;; ground plain forest is already the complete eager semantic result.
    (<-- (%restore-match-overloads ?semantic nil ?semantic) !)
    (<- (%restore-match-overloads
         (:x-variable ?span (:deferred-match-overload ?key) ?symbol
                      (:overloaded ?family))
         ?obligations
         (:x-variable ?span ?type ?symbol (:overloaded ?family)))
        ! (%match-overload-lookup ?key ?obligations ?type))
    (<- (%restore-match-overloads (?head . ?tail) ?obligations
                                  (?new-head . ?new-tail))
        ! (%restore-match-overloads ?head ?obligations ?new-head)
        (%restore-match-overloads ?tail ?obligations ?new-tail))
    (<- (%restore-match-overloads ?other ?obligations ?other) (nonvar ?other) !)

    ;;; Keep the fully typed intermediate inside this predicate's activation.
    ;;; A top-level query variable would root that image even after compaction,
    ;;; throughout the freeze that this batching is intended to make bounded.
    (<-- (%compact-match-rules ?static ?tyvars ?rules ?argument ?result
                               ?compacted ?obligations)
        (%match-rules ?static ?tyvars ?rules ?argument ?result ?semantic)
        (%compact-match-semantic ?semantic ?compacted nil ?obligations)
        (%plain-match-semantic ?compacted) !)

    ;;; Compound terms stay on recursive branches instead of spending a host
    ;;; argument copy merely to reject them as symbols.  Detached symbols are
    ;;; restored one per identity below; their full names are never type IDs.
    ;;; Reified query variables are neutral leaves, not type descriptors.  This
    ;;; walker restores them without ever interpreting arbitrary semantic cons
    ;;; tails as TYPE-VAR terms, and shares one fresh cell per detached symbol.
    (<-- (%thaw-reified ?term ?in ?in ?term) (var ?term) !)
    (<- (%thaw-reified ?symbol ?in ?out ?fresh)
        (atom ?symbol)
        (lispp (%reified-variable-symbol-p ?symbol)) !
        (or (-> (%map-lookup ?symbol ?in ?fresh) (= ?out ?in))
            (= ?out ((:map ?symbol ?fresh) . ?in))))
    ;;; A compact semantic payload has no detached variables.  Prove that
    ;;; property before sharing a tail unchanged; a failed proof falls through
    ;;; to the generic copying restoration below.  This keeps ground executable
    ;;; data eager while avoiding a redundant tree at the emission boundary.
    (<-- (%reified-free-native ?term) (var ?term) ! fail)
    (<- (%reified-free-native ?symbol)
        (atom ?symbol)
        (lispp (%reified-variable-symbol-p ?symbol)) ! fail)
    (<- (%reified-free-native (?head . ?tail)) !
        (%reified-free-native ?head) (%reified-free-native ?tail))
    (<- (%reified-free-native ?other) (nonvar ?other) !)
    ;;; No whole-product shortcut: shared and possibly cyclic metadata requires
    ;;; the same alias-aware recursive restoration as individual semantic tails.
    (<- (%thaw-reified (?head . ?tail) nil ?out (?new-head . ?tail))
        (%reified-free-native ?tail) !
        (%thaw-reified ?head nil ?out ?new-head))
    (<- (%thaw-reified (?head . ?tail) ?in ?out (?new-head . ?new-tail))
        ! (%thaw-reified ?head ?in ?middle ?new-head)
        (%thaw-reified ?tail ?middle ?out ?new-tail))
    (<- (%thaw-reified ?other ?in ?in ?other) !)

    ;;; Only unquantified cells cross a match-query boundary.  Static schemes
    ;;; without weak variables are deliberately left untouched; unifying their
    ;;; quantified bodies would sever quantifier/body sharing.  A weak scheme
    ;;; reconciles just its unquantified positions against the streamed image.
    (<-- (%restore-static-snapshot (:static ?old-values ?old-types)
                                  (:static ?new-values ?new-types))
        (%restore-static-value-snapshots ?old-values ?new-values))
    (<-- (%restore-static-value-snapshots nil nil) !)
    (<- (%restore-static-value-snapshots
         ((:value ?path ?old-scheme ?host ?status) . ?old-values)
         ((:value ?path ?new-scheme ?host ?status) . ?new-values))
        (free-type-variables ?old-scheme ?weak)
        (or (-> (= ?weak nil) true)
            (and (= ?old-scheme (scheme ?quantified ?old-body))
                 (and (= ?new-scheme (scheme ?new-quantified ?new-body))
                      (%restore-scoped-type ?old-body ?new-body ?quantified))))
        (%restore-static-value-snapshots ?old-values ?new-values))
    (<-- (%restore-scoped-type ?original ?restored ?quantified)
        (var ?original) !
        (or (-> (%quantified-cell ?original ?quantified) true)
            (type-unify ?original ?restored)))
    (<- (%restore-scoped-type (type-var ?cell ?kind ?equality) ?restored ?quantified)
        ! (or (-> (%quantified-cell ?cell ?quantified) true)
              (type-unify (type-var ?cell ?kind ?equality) ?restored)))
    (<- (%restore-scoped-type (=> ?old-domain ?old-range)
                              (=> ?new-domain ?new-range) ?quantified)
        ! (%restore-scoped-type ?old-domain ?new-domain ?quantified)
        (%restore-scoped-type ?old-range ?new-range ?quantified))
    (<- (%restore-scoped-type (@ ?name ?old-arguments)
                              (@ ?name ?new-arguments) ?quantified)
        ! (%restore-scoped-type ?old-arguments ?new-arguments ?quantified))
    (<- (%restore-scoped-type (record ?old-fields ?old-tail)
                              (record ?new-fields ?new-tail) ?quantified)
        ! (%restore-scoped-type ?old-fields ?new-fields ?quantified)
        (%restore-scoped-type ?old-tail ?new-tail ?quantified))
    (<- (%restore-scoped-type (?old-head . ?old-tail) (?new-head . ?new-tail) ?quantified)
        ! (%restore-scoped-type ?old-head ?new-head ?quantified)
        (%restore-scoped-type ?old-tail ?new-tail ?quantified))
    (<- (%restore-scoped-type ?other ?other ?quantified) !)
    (<-- (%quantified-cell ?cell ((type-var ?found ?kind ?equality) . ?rest))
        (== ?cell ?found) !)
    (<- (%quantified-cell ?cell ((type-var ?other ?kind ?equality) . ?rest))
        (%quantified-cell ?cell ?rest))
    (<- (%quantified-cell ?cell (?other . ?rest))
        (%quantified-cell ?cell ?rest))

    (<-- (%append nil ?right ?right) !)
    (<- (%append (?head . ?left) ?right (?head . ?rest))
        (%append ?left ?right ?rest))

    (<-- (thaw-static (:static ?values ?types) (:static ?new-values ?new-types))
        (%thaw-values ?values nil ?middle ?new-values)
        (%thaw-type-constructors ?types ?middle ?ignored ?new-types))
    (<-- (%thaw-values nil ?map ?map nil) !)
    (<- (%thaw-values ((:value ?path ?scheme ?symbol ?status) . ?rest) ?in ?out
                      ((:value ?path ?new-scheme ?symbol ?status) . ?new-rest))
        (%thaw-type ?scheme ?in ?middle ?new-scheme)
        (%thaw-values ?rest ?middle ?out ?new-rest))
    (<-- (%thaw-type-constructors nil ?map ?map nil) !)
    (<- (%thaw-type-constructors ((:tycon ?path ?definition) . ?rest) ?in ?out
                                 ((:tycon ?path ?new-definition) . ?new-rest))
        (%thaw-type ?definition ?in ?middle ?new-definition)
        (%thaw-type-constructors ?rest ?middle ?out ?new-rest))

    (<-- (freeze-static (:static ?values ?types) (:static ?new-values ?new-types))
        (%freeze-values ?values nil ?middle ?new-values)
        (%freeze-type-constructors ?types ?middle ?ignored ?new-types))
    (<-- (%freeze-values nil ?map ?map nil) !)
    (<- (%freeze-values ((:value ?path ?scheme ?symbol ?status) . ?rest) ?in ?out
                        ((:value ?path ?new-scheme ?symbol ?status) . ?new-rest))
        (%freeze-type ?scheme ?in ?middle ?new-scheme)
        (%freeze-values ?rest ?middle ?out ?new-rest))
    (<-- (%freeze-type-constructors nil ?map ?map nil) !)
    (<- (%freeze-type-constructors ((:tycon ?path ?definition) . ?rest) ?in ?out
                                   ((:tycon ?path ?new-definition) . ?new-rest))
        (%freeze-type ?definition ?in ?middle ?new-definition)
        (%freeze-type-constructors ?rest ?middle ?out ?new-rest))
    (<-- (freeze-type ?type ?frozen) (%freeze-type ?type nil ?ignored ?frozen))
    (<-- (thaw-type ?type ?thawed) (%thaw-type ?type nil ?ignored ?thawed))

    ;;; Static lookup and persistent extension.  Paths are source spelling until
    ;;; name identity has been established; value/type identity itself lives in
    ;;; host symbols and TYPE-NAME identities respectively.
    (<-- (%lookup-value (:static ((:value ?entry-path ?scheme ?symbol ?status) . ?rest) ?types)
                        ?path (:value ?path ?scheme ?symbol ?status))
        (lispp (equal ?entry-path ?path)) !)
    (<- (%lookup-value (:static (?entry . ?values) ?types) ?path ?found)
        (%lookup-value (:static ?values ?types) ?path ?found))
    (<-- (%lookup-type (:static ?values ((:tycon ?entry-path ?definition) . ?rest))
                       ?path ?definition)
        (lispp (equal ?entry-path ?path)) !)
    (<- (%lookup-type (:static ?values (?entry . ?types)) ?path ?found)
        (%lookup-type (:static ?values ?types) ?path ?found))
    (<-- (%require-value ?static ?path ?entry ?span)
        (or (-> (%lookup-value ?static ?path ?found) (= ?entry ?found))
            (lisp (%fail ?span (format nil "Unbound value identifier ~{~A~^.~}." ?path)))))
    (<-- (%require-type ?static ?path ?definition ?span)
        (or (-> (%lookup-type ?static ?path ?found) (= ?definition ?found))
            (lisp (%fail ?span (format nil "Unbound type constructor ~{~A~^.~}." ?path)))))
    (<-- (%extend-values (:static ?values ?types) ?new (:static ?combined ?types))
        (%append ?new ?values ?combined))
    (<-- (%extend-types (:static ?values ?types) ?new (:static ?values ?combined))
        (%append ?new ?types ?combined))
    (<-- (%static-type-environment (:static ?values ?types) (type-env ?bindings))
        (%scheme-bindings ?values ?bindings))
    (<-- (%scheme-bindings nil nil) !)
    (<- (%scheme-bindings ((:value ?path ?scheme ?symbol ?status) . ?rest)
                          ((binding ?path ?scheme) . ?bindings))
        (%scheme-bindings ?rest ?bindings))

    ;;; Internal productions denote the original pervasive primitives even
    ;;; after source declarations shadow their names.  Persistent extension
    ;;; prepends bindings, so the oldest matching entry is the initial one;
    ;;; ordinary source lookup above deliberately remains newest-first.
    (<-- (%initial-type-binding ((:tycon ?entry-path ?definition) . ?rest) ?path ?result)
        (lispp (equal ?entry-path ?path))
        (or (-> (%initial-type-binding ?rest ?path ?older)
                (= ?result ?older))
            (= ?result ?definition)) !)
    (<- (%initial-type-binding (?entry . ?rest) ?path ?result)
        (%initial-type-binding ?rest ?path ?result))
    (<-- (%primitive-type-name ?static ?name ?span (type-name ?spelling ?identity ?arity ?equality ?flexibility))
        (= ?static (:static ?values ?types))
        (lisp ?path (list ?name))
        (or (-> (%initial-type-binding ?types ?path
                       (type-name ?spelling ?identity ?arity ?equality ?flexibility)) true)
            (lisp (%fail ?span (format nil "The initial type constructor ~A is unavailable." ?name)))))
    (<-- (%named-type ?static ?name ?span ?type)
        (%primitive-type-name ?static ?name ?span (type-name ?spelling ?identity ?arity ?equality ?flexibility))
        (= ?type (@ (type-name ?spelling ?identity ?arity ?equality ?flexibility) nil)))
    (<-- (%unit-type ?type) (record-type nil :closed ?type))
    (<-- (%fresh-type (type-var ?cell :type ?equality)))
    (<-- (%fresh-row (type-var ?cell :row ?equality)))
    (<-- (%named-type-variable ?name ?type)
        (%fresh-type ?type)
        (or (-> (lispp (%equality-variable-name-p ?name))
                (ensure-equality ?type))
            true))

    database))

(defun %install-elaboration-expression-predicates (database)
  (let ((*database* database))
    ;;; Explicit/scoped type-variable maps use source spelling only here.  Type
    ;;; names and schemes continue to use logical-cell identity throughout.
    (<-- (%tyvar-lookup ((:tyvar ?entry-name ?type) . ?rest) ?name ?type)
        (lispp (equal ?entry-name ?name)) !)
    (<- (%tyvar-lookup (?entry . ?rest) ?name ?type) (%tyvar-lookup ?rest ?name ?type))
    (<-- (%type-variable ?tyvars ?name (type-var (:fv ?name) ?kind ?external) ?type)
        (%thaw-type (type-var (:fv ?name) ?kind ?external) nil ?ignored ?new)
        (= ?type ?new))
    (<-- (%extend-explicit-type-variables nil ?tyvars ?tyvars) !)
    (<- (%extend-explicit-type-variables (?identifier . ?identifiers) ?in ?out)
        (lisp ?name (%name ?identifier))
        (%named-type-variable ?name ?type)
        (%extend-explicit-type-variables ?identifiers ?in ?rest)
        (= ?out ((:tyvar ?name ?type) . ?rest)))

    (<-- (%syntactic-type ?static ?tyvars (:node :type-variable ?span ((:identifier . ?identifier))) ?type)
        (lisp ?name (%name ?identifier))
        (or (-> (%tyvar-lookup ?tyvars ?name ?found) (= ?type ?found))
            (and (%named-type-variable ?name ?type) true)))
    (<- (%syntactic-type ?static ?tyvars (:node :grouped-type ?span ((:type . ?child))) ?type)
        (%syntactic-type ?static ?tyvars ?child ?type))
    (<- (%syntactic-type ?static ?tyvars (:node :function-type ?span ((:domain . ?domain) (:range . ?range))) ?type)
        (%syntactic-type ?static ?tyvars ?domain ?domain-type)
        (%syntactic-type ?static ?tyvars ?range ?range-type)
        (= ?type (=> ?domain-type ?range-type)))
    (<- (%syntactic-type ?static ?tyvars (:node :tuple-type ?span ((:types . ?types))) ?type)
        (%syntactic-types ?static ?tyvars ?types ?element-types)
        (%numeric-fields ?element-types 1 ?fields)
        (record-type ?fields :closed ?type))
    (<- (%syntactic-type ?static ?tyvars (:node :record-type ?span ((:rows . nil))) ?type)
        (%unit-type ?type))
    (<- (%syntactic-type ?static ?tyvars (:node :record-type ?span ((:rows . ?rows))) ?type)
        (lispp ?rows)
        (%syntactic-type-rows ?static ?tyvars ?rows ?fields)
        (record-type ?fields :closed ?type))
    (<- (%syntactic-type ?static ?tyvars
                         (:node :constructed-type ?span ((:arguments . ?arguments) (:constructor . ?constructor)))
                         ?type)
        (%syntactic-types ?static ?tyvars ?arguments ?argument-types)
        (lisp ?path (%path ?constructor))
        (%require-type ?static ?path ?definition ?span)
        (%apply-type-constructor ?definition ?argument-types ?type ?span))
    (<-- (%syntactic-types ?static ?tyvars nil nil) !)
    (<- (%syntactic-types ?static ?tyvars (?type . ?types) (?result . ?results))
        (%syntactic-type ?static ?tyvars ?type ?result)
        (%syntactic-types ?static ?tyvars ?types ?results))
    (<-- (%syntactic-type-rows ?static ?tyvars nil nil) !)
    (<- (%syntactic-type-rows ?static ?tyvars
                              ((:node :type-row ?span ((:label . ?label) (:type . ?type))) . ?rows)
                              ((field ?name ?result) . ?results))
        (lisp ?name (%label ?label))
        (%syntactic-type ?static ?tyvars ?type ?result)
        (%syntactic-type-rows ?static ?tyvars ?rows ?results))
    (<-- (%apply-type-constructor (type-name ?spelling ?identity ?arity ?equality ?flexibility)
                                  ?arguments (@ (type-name ?spelling ?identity ?arity ?equality ?flexibility) ?arguments)
                                  ?span)
        (type-application (type-name ?spelling ?identity ?arity ?equality ?flexibility) ?arguments ?ignored))
    (<- (%apply-type-constructor (type-function ?parameters ?body) ?arguments ?result ?span)
        (apply-type-function (type-function ?parameters ?body) ?arguments ?result))
    (<- (%apply-type-constructor ?other ?arguments ?result ?span)
        (lisp (%fail ?span "The type constructor is neither a type name nor an arity-matched alias.")))
    (<-- (%numeric-fields nil ?index nil) !)
    (<- (%numeric-fields (?type . ?types) ?index ((field ?label ?type) . ?fields))
        (is ?next (+ ?index 1))
        (lisp ?label (write-to-string ?index))
        (%numeric-fields ?types ?next ?fields))

    ;;; Literals and constructor status.  Arithmetic wraps at Word type, but a
    ;;; source literal itself must denote a value in the configured range.
    (<-- (%check-literal-range :word ?literal ?span)
        ! (lisp ?value (literal-value ?literal))
        (or (-> (lispp (and (<= 0 ?value) (< ?value +sml-word-modulus+))) true)
            (lisp (%fail ?span
                         (format nil "Word literal ~D is outside the configured unsigned ~D-bit range 0..~D."
                                 ?value +sml-word-bits+ (1- +sml-word-modulus+))
                         :range))))
    (<- (%check-literal-range ?kind ?literal ?span) !)
    (<-- (%literal-type ?literal ?static ?span ?type)
        (lisp ?kind (literal-kind ?literal))
        (%check-literal-range ?kind ?literal ?span)
        (%primitive-literal-type ?kind ?static ?span ?type))
    (<-- (%primitive-literal-type :integer ?static ?span ?type) ! (%named-type ?static "int" ?span ?type))
    (<- (%primitive-literal-type :real ?static ?span ?type) ! (%named-type ?static "real" ?span ?type))
    (<- (%primitive-literal-type :word ?static ?span ?type) ! (%named-type ?static "word" ?span ?type))
    (<- (%primitive-literal-type :character ?static ?span ?type) ! (%named-type ?static "char" ?span ?type))
    (<- (%primitive-literal-type :string ?static ?span ?type) ! (%named-type ?static "string" ?span ?type))

    ;;; As with patterns, source syntax selects one expression elaboration.
    ;;; Commit after all local binding and type unifications succeed so unused
    ;;; alternatives cannot retain the rest of a large match declaration.
    (<-- (%expression ?static ?tyvars ?ast ?semantic)
        (%expression-definition ?static ?tyvars ?ast ?semantic) !)
    ;;; Typed expression terms are deliberately distinct from the parser AST.
    ;;; The emitter consumes only these terms after all relevant unifications.
    (<-- (%expression-definition ?static ?tyvars (:node :literal-expression ?span ((:literal . ?literal))) ?semantic)
        (%literal-type ?literal ?static ?span ?type)
        (= ?semantic (:x-literal ?span ?type ?literal)))
    (<- (%expression-definition ?static ?tyvars (:node :identifier-expression ?span ((:identifier . ?identifier) (:op-p . ?op))) ?semantic)
        (lisp ?path (%path ?identifier))
        (%require-value ?static ?path (:value ?path ?scheme ?symbol ?status) ?span)
        (instantiate-type-scheme ?scheme ?type)
        (= ?semantic (:x-variable ?span ?type ?symbol ?status)))
    (<- (%expression-definition ?static ?tyvars (:node :unit-expression ?span ?slots) ?semantic)
        (%unit-type ?type)
        (= ?semantic (:x-unit ?span ?type)))
    (<- (%expression-definition ?static ?tyvars (:node :grouped-expression ?span ((:expression . ?child))) ?semantic)
        (%expression ?static ?tyvars ?child ?inner)
        (%type ?inner ?inner-type)
        (= ?semantic (:x-typed ?span ?inner-type ?inner)))
    (<- (%expression-definition ?static ?tyvars (:node :record-expression ?span ((:rows . nil))) ?semantic)
        (%unit-type ?type)
        (= ?semantic (:x-unit ?span ?type)))
    (<- (%expression-definition ?static ?tyvars (:node :record-expression ?span ((:rows . ?rows))) ?semantic)
        (lispp ?rows)
        (%expression-rows ?static ?tyvars ?rows ?semantic-rows ?fields)
        (record-type ?fields :closed ?type)
        (= ?semantic (:x-record ?span ?type ?semantic-rows)))
    (<- (%expression-definition ?static ?tyvars (:node :selector-expression ?span ((:label . ?label))) ?semantic)
        (lisp ?name (%label ?label))
        (%fresh-row ?tail) (%fresh-type ?field-type)
        (record-type ((field ?name ?field-type)) ?tail ?record)
        (= ?type (=> ?record ?field-type))
        (= ?semantic (:x-selector ?span ?type ?name ?record)))
    (<- (%expression-definition ?static ?tyvars (:node :tuple-expression ?span ((:expressions . ?expressions))) ?semantic)
        (%expressions ?static ?tyvars ?expressions ?items)
        (%semantic-fields ?items 1 ?fields ?rows)
        (record-type ?fields :closed ?type)
        (= ?semantic (:x-record ?span ?type ?rows)))
    (<- (%expression-definition ?static ?tyvars (:node :sequence-expression ?span ((:expressions . ?expressions))) ?semantic)
        (%expressions ?static ?tyvars ?expressions ?items)
        (%last-type ?items ?type)
        (= ?semantic (:x-sequence ?span ?type ?items)))
    (<- (%expression-definition ?static ?tyvars (:node :list-expression ?span ((:expressions . ?expressions))) ?semantic)
        (%expressions ?static ?tyvars ?expressions ?items)
        (%fresh-type ?element)
        (%list-element-types ?items ?element)
        (%primitive-type-name ?static "list" ?span
                              (type-name ?spelling ?identity 1 ?equality ?flexibility))
        (type-application (type-name ?spelling ?identity 1 ?equality ?flexibility) (?element) ?type)
        (= ?semantic (:x-list ?span ?type ?items)))
    (<- (%expression-definition ?static ?tyvars (:node :let-expression ?span ((:declarations . ?declarations) (:expressions . ?expressions))) ?semantic)
        (%static-free-type-names ?static ?visible-names)
        (%declaration-list-with-lifetimes ?static ?tyvars ?declarations ?local-static
                                          ?semantic-declarations ?lifetime-checkpoints)
        (%expressions ?local-static ?tyvars ?expressions ?items)
        (%check-lifetime-checkpoints ?lifetime-checkpoints)
        (%last-type ?items ?type)
        (free-type-names ?type ?result-names)
        (or (-> (%type-names-subset ?result-names ?visible-names) true)
            (lisp (%fail ?span "A local datatype escapes into the result type of a let expression.")))
        (= ?semantic (:x-let ?span ?type ?semantic-declarations ?items)))
    (<-- (%static-free-type-names (:static ?values ?types) ?names)
        (%static-value-type-names ?values ?value-names)
        (%static-constructor-type-names ?types ?type-names)
        (%append ?value-names ?type-names ?names))
    (<-- (%static-value-type-names ?values ?names)
        (%static-value-type-names-forward ?values nil ?reversed)
        (%reverse-names ?reversed nil ?names))
    (<-- (%static-value-type-names-forward nil ?reversed ?reversed) !)
    (<- (%static-value-type-names-forward ((:value ?path ?scheme ?host ?status) . ?values) ?reversed ?names)
        (free-type-names ?scheme ?first)
        (%reverse-names ?first nil ?reversed-first)
        (%append ?reversed-first ?reversed ?next-reversed)
        (%static-value-type-names-forward ?values ?next-reversed ?names))
    (<-- (%static-constructor-type-names ?types ?names)
        (%static-constructor-type-names-forward ?types nil ?reversed)
        (%reverse-names ?reversed nil ?names))
    (<-- (%static-constructor-type-names-forward nil ?reversed ?reversed) !)
    (<- (%static-constructor-type-names-forward ((:tycon ?path ?definition) . ?types) ?reversed ?names)
        (or (-> (= ?definition (type-name ?spelling ?identity ?arity ?equality ?flexibility))
                (free-type-names (@ ?definition nil) ?first))
            (free-type-names ?definition ?first))
        (%reverse-names ?first nil ?reversed-first)
        (%append ?reversed-first ?reversed ?next-reversed)
        (%static-constructor-type-names-forward ?types ?next-reversed ?names))
    (<-- (%type-names-subset nil ?visible) !)
    (<- (%type-names-subset (?name . ?names) ?visible)
        (%type-name-visible ?name ?visible)
        (%type-names-subset ?names ?visible))
    (<-- (%type-name-visible (type-name ?spelling ?identity ?arity ?equality ?flexibility)
                            ((type-name ?other-spelling ?identity ?other-arity ?other-equality ?other-flexibility) . ?rest)) !)
    (<- (%type-name-visible ?name (?other . ?rest))
        (%type-name-visible ?name ?rest))
    (<- (%expression-definition ?static ?tyvars (:node :application-expression ?span ((:function . ?function) (:argument . ?argument))) ?semantic)
        (%expression ?static ?tyvars ?function ?function-semantic)
        (%expression ?static ?tyvars ?argument ?argument-semantic)
        (%type ?function-semantic ?function-type)
        (%type ?argument-semantic ?argument-type)
        (%fresh-type ?result)
        (type-unify ?function-type (=> ?argument-type ?result))
        (= ?semantic (:x-application ?span ?result ?function-semantic ?argument-semantic)))
    (<- (%expression-definition ?static ?tyvars (:node :infix-expression ?span ((:operator . ?operator) (:left . ?left) (:right . ?right))) ?semantic)
        (%expression ?static ?tyvars ?left ?left-semantic)
        (%expression ?static ?tyvars ?right ?right-semantic)
        (%record-from-pair ?left-semantic ?right-semantic ?argument ?span)
        (lisp ?path (%path ?operator))
        (%require-value ?static ?path (:value ?path ?scheme ?symbol ?status) ?span)
        (instantiate-type-scheme ?scheme ?function-type)
        (%fresh-type ?result)
        (%type ?argument ?argument-type)
        (type-unify ?function-type (=> ?argument-type ?result))
        (= ?semantic (:x-application ?span ?result (:x-variable ?span ?function-type ?symbol ?status) ?argument)))
    (<- (%expression-definition ?static ?tyvars (:node :typed-expression ?span ((:expression . ?child) (:type . ?syntax))) ?semantic)
        (%expression ?static ?tyvars ?child ?inner)
        (%type ?inner ?inner-type)
        (%syntactic-type ?static ?tyvars ?syntax ?annotation)
        (type-unify ?inner-type ?annotation)
        (= ?semantic (:x-typed ?span ?annotation ?inner)))
    (<- (%expression-definition ?static ?tyvars (:node :andalso-expression ?span ((:left . ?left) (:right . ?right))) ?semantic)
        (%expression ?static ?tyvars ?left ?left-semantic)
        (%expression ?static ?tyvars ?right ?right-semantic)
        (%named-type ?static "bool" ?span ?bool)
        (%type ?left-semantic ?left-type) (%type ?right-semantic ?right-type)
        (type-unify ?left-type ?bool) (type-unify ?right-type ?bool)
        (= ?semantic (:x-andalso ?span ?bool ?left-semantic ?right-semantic)))
    (<- (%expression-definition ?static ?tyvars (:node :orelse-expression ?span ((:left . ?left) (:right . ?right))) ?semantic)
        (%expression ?static ?tyvars ?left ?left-semantic)
        (%expression ?static ?tyvars ?right ?right-semantic)
        (%named-type ?static "bool" ?span ?bool)
        (%type ?left-semantic ?left-type) (%type ?right-semantic ?right-type)
        (type-unify ?left-type ?bool) (type-unify ?right-type ?bool)
        (= ?semantic (:x-orelse ?span ?bool ?left-semantic ?right-semantic)))
    (<- (%expression-definition ?static ?tyvars (:node :if-expression ?span ((:condition . ?condition) (:then . ?then) (:else . ?else))) ?semantic)
        (%expression ?static ?tyvars ?condition ?condition-semantic)
        (%expression ?static ?tyvars ?then ?then-semantic)
        (%expression ?static ?tyvars ?else ?else-semantic)
        (%named-type ?static "bool" ?span ?bool)
        (%type ?condition-semantic ?condition-type)
        (%type ?then-semantic ?result) (%type ?else-semantic ?else-type)
        (type-unify ?condition-type ?bool) (type-unify ?result ?else-type)
        (= ?semantic (:x-if ?span ?result ?condition-semantic ?then-semantic ?else-semantic)))
    (<- (%expression-definition ?static ?tyvars (:node :while-expression ?span ((:condition . ?condition) (:body . ?body))) ?semantic)
        (%expression ?static ?tyvars ?condition ?condition-semantic)
        (%expression ?static ?tyvars ?body ?body-semantic)
        (%named-type ?static "bool" ?span ?bool)
        (%unit-type ?unit)
        (%type ?condition-semantic ?condition-type)
        (type-unify ?condition-type ?bool)
        (= ?semantic (:x-while ?span ?unit ?condition-semantic ?body-semantic)))
    (<- (%expression-definition ?static ?tyvars (:node :raise-expression ?span ((:expression . ?child))) ?semantic)
        (%expression ?static ?tyvars ?child ?inner)
        (%named-type ?static "exn" ?span ?exn)
        (%type ?inner ?inner-type)
        (type-unify ?inner-type ?exn)
        (%fresh-type ?type)
        (= ?semantic (:x-raise ?span ?type ?inner)))
    (<- (%expression-definition ?static ?tyvars (:node :case-expression ?span ((:expression . ?child) (:match . ?match))) ?semantic)
        (%expression ?static ?tyvars ?child ?scrutinee)
        (%type ?scrutinee ?scrutinee-type)
        (%fresh-type ?result)
        (%match ?static ?tyvars ?match ?scrutinee-type ?result ?semantic-match)
        (= ?semantic (:x-case ?span ?result ?scrutinee ?semantic-match)))
    (<- (%expression-definition ?static ?tyvars (:node :handle-expression ?span ((:expression . ?child) (:match . ?match))) ?semantic)
        (%expression ?static ?tyvars ?child ?inner)
        (%type ?inner ?inner-type)
        (%match ?static ?tyvars ?match ?exn-type ?inner-type ?semantic-match)
        (%named-type ?static "exn" ?span ?expected-exn)
        (type-unify ?exn-type ?expected-exn)
        (= ?semantic (:x-handle ?span ?inner-type ?inner ?semantic-match)))
    (<- (%expression-definition ?static ?tyvars (:node :fn-expression ?span ((:match . ?match))) ?semantic)
        (%fresh-type ?argument) (%fresh-type ?result)
        (%match ?static ?tyvars ?match ?argument ?result ?semantic-match)
        (= ?semantic (:x-function ?span (=> ?argument ?result) ?argument ?semantic-match)))

    (<-- (%expression-type (:x-literal ?span ?type ?literal) ?type) !)
    (<- (%expression-type (:x-variable ?span ?type ?symbol ?status) ?type) !)
    (<- (%expression-type (:x-unit ?span ?type) ?type) !)
    (<- (%expression-type (:x-record ?span ?type ?rows) ?type) !)
    (<- (%expression-type (:x-selector ?span ?type ?name ?record) ?type) !)
    (<- (%expression-type (:x-sequence ?span ?type ?items) ?type) !)
    (<- (%expression-type (:x-list ?span ?type ?items) ?type) !)
    (<- (%expression-type (:x-let ?span ?type ?declarations ?items) ?type) !)
    (<- (%expression-type (:x-application ?span ?type ?function ?argument) ?type) !)
    (<- (%expression-type (:x-typed ?span ?type ?child) ?type) !)
    (<- (%expression-type (:x-andalso ?span ?type ?left ?right) ?type) !)
    (<- (%expression-type (:x-orelse ?span ?type ?left ?right) ?type) !)
    (<- (%expression-type (:x-if ?span ?type ?condition ?then ?else) ?type) !)
    (<- (%expression-type (:x-while ?span ?type ?condition ?body) ?type) !)
    (<- (%expression-type (:x-raise ?span ?type ?child) ?type) !)
    (<- (%expression-type (:x-case ?span ?type ?child ?match) ?type) !)
    (<- (%expression-type (:x-handle ?span ?type ?child ?match) ?type) !)
    (<- (%expression-type (:x-function ?span ?type ?argument ?match) ?type) !)
    (<-- (%type ?semantic ?type) (%expression-type ?semantic ?type))

    (<-- (%expressions ?static ?tyvars nil nil) !)
    (<- (%expressions ?static ?tyvars (?ast . ?asts) (?semantic . ?semantics))
        (%expression ?static ?tyvars ?ast ?semantic)
        (%expressions ?static ?tyvars ?asts ?semantics))
    (<-- (%last-type (?item) ?type) ! (%type ?item ?type))
    (<- (%last-type (?item . ?items) ?type) (%last-type ?items ?type))
    (<-- (%expression-rows ?static ?tyvars nil nil nil) !)
    (<- (%expression-rows ?static ?tyvars
                          ((:node :expression-row ?span ((:label . ?label) (:expression . ?ast))) . ?rows)
                          ((:x-row ?name ?semantic) . ?semantics) ((field ?name ?type) . ?fields))
        (lisp ?name (%label ?label))
        (%expression ?static ?tyvars ?ast ?semantic)
        (%type ?semantic ?type)
        (%expression-rows ?static ?tyvars ?rows ?semantics ?fields))
    (<-- (%semantic-fields nil ?index nil nil) !)
    (<- (%semantic-fields (?item . ?items) ?index ((field ?label ?type) . ?fields)
                          ((:x-row ?label ?item) . ?rows))
        (%type ?item ?type)
        (lisp ?label (write-to-string ?index))
        (is ?next (+ ?index 1))
        (%semantic-fields ?items ?next ?fields ?rows))
    (<-- (%list-element-types nil ?element) !)
    (<- (%list-element-types (?item . ?items) ?element)
        (%type ?item ?item-type)
        (type-unify ?item-type ?element)
        (%list-element-types ?items ?element))
    (<-- (%record-from-pair ?left ?right (:x-record ?span ?type ((:x-row "1" ?left) (:x-row "2" ?right))) ?span)
        (%type ?left ?left-type) (%type ?right ?right-type)
        (record-type ((field "1" ?left-type) (field "2" ?right-type)) :closed ?type))

    database))

(defun %install-elaboration-pattern-predicates (database)
  (let ((*database* database))
    ;;; Match elaboration keeps every rule's lexical bindings independent but
    ;;; unifies all scrutinee/result types so exhausted matches have a real
    ;;; static function type before code generation begins.
    (<- (%match ?static ?tyvars (:node :match ?span ((:rules . ?rules))) ?argument ?result (:rules ?semantic-rules))
        (lispp (%long-match-p ?rules)) !
        (ooparts/sml/elaborate::%static-weak-type-variables ?static ?weak)
        (or (-> (and (= ?weak nil) (= ?tyvars nil)) (= ?shared-static t))
            (= ?shared-static nil))
        (%freeze-native (?static ?tyvars ?argument ?result) nil ?ignored ?frozen-input)
        (lisp ?stream-output (%stream-match-rules ?frozen-input ?rules ?span ?shared-static))
        (%finish-stream-match ?static ?tyvars ?argument ?result ?shared-static
                              ?stream-output ?semantic-rules))

    ;;; These are last goals, rather than ordinary calls, so EXECUTE discards
    ;;; each producer's Y slots before the next graph is reconstructed.  In
    ;;; particular, source RULES/FROZEN-INPUT do not survive streaming, the
    ;;; packed output does not survive thawing, and plain rules do not survive
    ;;; overload restoration.  Only live types and the caller's semantic output
    ;;; cross these boundaries; all sharing still comes from the one thaw map.
    (<- (%finish-stream-match ?static ?tyvars ?argument ?result ?shared-static
                              (?frozen-state ?frozen-obligations (:rules ?plain-rules))
                              ?semantic-rules)
        (%thaw-native (?frozen-state ?frozen-obligations) nil ?ignored-thaw
                      ((?streamed-static ?streamed-tyvars ?streamed-argument ?streamed-result)
                       ?streamed-obligations))
        (%restore-stream-match-overloads
         ?static ?tyvars ?argument ?result ?shared-static
         ?plain-rules ?streamed-obligations
         ?streamed-static ?streamed-tyvars ?streamed-argument ?streamed-result
         ?semantic-rules))
    (<- (%restore-stream-match-overloads
         ?static ?tyvars ?argument ?result ?shared-static
         ?plain-rules ?streamed-obligations
         ?streamed-static ?streamed-tyvars ?streamed-argument ?streamed-result
         ?semantic-rules)
        (%restore-match-overloads ?plain-rules ?streamed-obligations ?semantic-rules)
        (%finish-stream-match-state
         ?static ?tyvars ?argument ?result ?shared-static
         ?streamed-static ?streamed-tyvars ?streamed-argument ?streamed-result))
    (<- (%finish-stream-match-state
         ?static ?tyvars ?argument ?result ?shared-static
         ?streamed-static ?streamed-tyvars ?streamed-argument ?streamed-result)
        (or (-> (= ?shared-static t) true)
            (and (%restore-static-snapshot ?static ?streamed-static)
                 (%restore-scoped-type ?tyvars ?streamed-tyvars nil)))
        (type-unify ?argument ?streamed-argument)
        (type-unify ?result ?streamed-result))
    (<- (%match ?static ?tyvars (:node :match ?span ((:rules . ?rules))) ?argument ?result (:rules ?semantic-rules))
        (%match-rules ?static ?tyvars ?rules ?argument ?result ?semantic-rules))
    (<-- (%match-rules ?static ?tyvars nil ?argument ?result nil) !)
    (<- (%match-rules ?static ?tyvars
                      ((:node :match-rule ?span ((:pattern . ?pattern) (:expression . ?expression))) . ?rules)
                      ?argument ?result ((:rule ?semantic-pattern ?semantic-expression) . ?semantic-rules))
        (%pattern ?static ?tyvars ?pattern ?argument ?semantic-pattern)
        (%pattern-bindings ?semantic-pattern ?bindings)
        (%binders-environment ?bindings ?values)
        (%extend-values ?static ?values ?local)
        (%expression ?local ?tyvars ?expression ?semantic-expression)
        (%type ?semantic-expression ?expression-type)
        (type-unify ?expression-type ?result)
        (%match-rules ?static ?tyvars ?rules ?argument ?result ?semantic-rules))

    ;;; A source pattern has one grammatical elaboration.  Commit only after
    ;;; its binding and type checks succeed; unused AST alternatives must not
    ;;; retain every partially typed match that precedes a large declaration.
    (<-- (%pattern ?static ?tyvars ?pattern ?type ?semantic)
        (%pattern-definition ?static ?tyvars ?pattern ?type ?semantic) !)
    ;;; Patterns produce binder descriptors (:BIND NAME TYPE HOST-SYMBOL).
    ;;; Constructor status, not capitalization, selects the constructor rules.
    (<-- (%pattern-definition ?static ?tyvars (:node :wildcard-pattern ?span ?slots) ?type
                   (:p-wildcard ?span ?type nil)) !)
    (<- (%pattern-definition ?static ?tyvars (:node :unit-pattern ?span ?slots) ?type
                  (:p-unit ?span ?type nil))
        (%unit-type ?unit)
        (type-unify ?type ?unit))
    (<- (%pattern-definition ?static ?tyvars (:node :literal-pattern ?span ((:literal . ?literal))) ?type
                  (:p-literal ?span ?type nil ?literal))
        (%literal-type ?literal ?static ?span ?literal-type)
        (type-unify ?type ?literal-type))
    (<- (%pattern-definition ?static ?tyvars (:node :grouped-pattern ?span ((:pattern . ?pattern))) ?type ?semantic)
        (%pattern ?static ?tyvars ?pattern ?type ?semantic))
    (<- (%pattern-definition ?static ?tyvars (:node :typed-pattern ?span ((:pattern . ?pattern) (:type . ?syntax))) ?type ?semantic)
        (%pattern ?static ?tyvars ?pattern ?type ?inner)
        (%syntactic-type ?static ?tyvars ?syntax ?annotation)
        (type-unify ?type ?annotation)
        (%pattern-bindings ?inner ?bindings)
        (= ?semantic (:p-typed ?span ?type ?bindings ?inner)))
    (<- (%pattern-definition ?static ?tyvars (:node :identifier-pattern ?span ((:identifier . ?identifier) (:op-p . ?op))) ?type ?semantic)
        (lisp ?path (%path ?identifier))
        (or (-> (%lookup-value ?static ?path (:value ?path ?scheme ?symbol (:constructor ?identity 0 ?exception)))
                (and (instantiate-type-scheme ?scheme ?constructor-type)
                     (and (type-unify ?type ?constructor-type)
                          (= ?semantic (:p-constructor ?span ?type nil ?identity ?symbol 0 nil)))))
            (or (-> (%lookup-value ?static ?path (:value ?path ?scheme ?symbol (:constructor ?identity 1 ?exception)))
                    (lisp (%fail ?span "A value-carrying constructor pattern requires an argument.")))
                (and (lisp ?name (%name ?identifier))
                     (and (= ?path (?name))
                          (and (lisp ?host (%fresh-binding ?name))
                               (= ?semantic (:p-variable ?span ?type ((:bind ?name ?type ?host)) ?name ?host))))))))
    (<- (%pattern-definition ?static ?tyvars (:node :construct-pattern ?span ((:constructor . ?constructor) (:op-p . ?op) (:argument . ?argument))) ?type ?semantic)
        (lisp ?path (%path ?constructor))
        (%require-value ?static ?path (:value ?path ?scheme ?symbol (:constructor ?identity 1 ?exception)) ?span)
        (instantiate-type-scheme ?scheme ?constructor-type)
        (%fresh-type ?payload)
        (type-unify ?constructor-type (=> ?payload ?type))
        (%pattern ?static ?tyvars ?argument ?payload ?argument-semantic)
        (%pattern-bindings ?argument-semantic ?bindings)
        (= ?semantic (:p-constructor ?span ?type ?bindings ?identity ?symbol 1 ?argument-semantic)))
    (<- (%pattern-definition ?static ?tyvars (:node :infix-pattern ?span ((:operator . ?operator) (:left . ?left) (:right . ?right))) ?type ?semantic)
        (lisp ?path (%path ?operator))
        (%require-value ?static ?path (:value ?path ?scheme ?symbol (:constructor ?identity 1 ?exception)) ?span)
        (instantiate-type-scheme ?scheme ?constructor-type)
        (%fresh-type ?left-type) (%fresh-type ?right-type)
        (record-type ((field "1" ?left-type) (field "2" ?right-type)) :closed ?payload)
        (type-unify ?constructor-type (=> ?payload ?type))
        (%pattern ?static ?tyvars ?left ?left-type ?left-semantic)
        (%pattern ?static ?tyvars ?right ?right-type ?right-semantic)
        (%pattern-bindings ?left-semantic ?left-bindings)
        (%pattern-bindings ?right-semantic ?right-bindings)
        (%append ?left-bindings ?right-bindings ?bindings)
        (%unique-bindings ?bindings ?span)
        (record-type ((field "1" ?left-type) (field "2" ?right-type)) :closed ?payload-type)
        (= ?argument (:p-record ?span ?payload-type ?bindings
                                ((:p-row "1" ?left-semantic) (:p-row "2" ?right-semantic))))
        (= ?semantic (:p-constructor ?span ?type ?bindings ?identity ?symbol 1 ?argument)))
    (<- (%pattern-definition ?static ?tyvars (:node :record-pattern ?span ((:rows . nil) (:wildcard-p . nil))) ?type ?semantic)
        (%unit-type ?unit)
        (type-unify ?type ?unit)
        (= ?semantic (:p-unit ?span ?type nil)))
    (<- (%pattern-definition ?static ?tyvars (:node :record-pattern ?span ((:rows . ?rows) (:wildcard-p . ?wildcard))) ?type ?semantic)
        (or (-> (= ?wildcard t) (%fresh-row ?tail))
            (and (lispp ?rows) (= ?tail :closed)))
        (%pattern-rows ?static ?tyvars ?rows ?semantic-rows ?fields ?bindings)
        (record-type ?fields ?tail ?record)
        (type-unify ?type ?record)
        (%unique-bindings ?bindings ?span)
        (= ?semantic (:p-record ?span ?type ?bindings ?semantic-rows)))
    (<- (%pattern-definition ?static ?tyvars (:node :tuple-pattern ?span ((:patterns . ?patterns))) ?type ?semantic)
        (%patterns ?static ?tyvars ?patterns ?items)
        (%pattern-fields ?items 1 ?rows ?fields)
        (record-type ?fields :closed ?record)
        (type-unify ?type ?record)
        (%pattern-item-bindings ?rows ?bindings)
        (%unique-bindings ?bindings ?span)
        (= ?semantic (:p-record ?span ?type ?bindings ?rows)))
    (<- (%pattern-definition ?static ?tyvars (:node :list-pattern ?span ((:patterns . ?patterns))) ?type ?semantic)
        (%fresh-type ?element)
        (%list-pattern ?static ?tyvars ?span ?patterns ?element ?semantic ?bindings)
        (%primitive-type-name ?static "list" ?span
                              (type-name ?spelling ?identity 1 ?equality ?flexibility))
        (type-application (type-name ?spelling ?identity 1 ?equality ?flexibility) (?element) ?list-type)
        (type-unify ?type ?list-type)
        (%unique-bindings ?bindings ?span))
    (<- (%pattern-definition ?static ?tyvars (:node :layered-pattern ?span ((:identifier . ?identifier) (:op-p . ?op) (:type . ?syntax) (:pattern . ?nested))) ?type ?semantic)
        (lisp ?path (%path ?identifier))
        (= ?path (?name))
        (lisp ?name (%name ?identifier))
        (lisp ?host (%fresh-binding ?name))
        (%pattern ?static ?tyvars ?nested ?type ?inner)
        (%pattern-bindings ?inner ?inner-bindings)
        (= ?bindings ((:bind ?name ?type ?host) . ?inner-bindings))
        (%unique-bindings ?bindings ?span)
        (or (-> (= ?syntax nil) true)
            (and (%syntactic-type ?static ?tyvars ?syntax ?annotation)
                 (type-unify ?type ?annotation)))
        (= ?semantic (:p-layered ?span ?type ?bindings ?name ?host ?inner)))

    (<-- (%patterns ?static ?tyvars nil nil) !)
    (<- (%patterns ?static ?tyvars (?pattern . ?patterns) (?semantic . ?semantics))
        (%pattern ?static ?tyvars ?pattern ?ignored ?semantic)
        (%patterns ?static ?tyvars ?patterns ?semantics))
    (<-- (%pattern-fields nil ?index nil nil) !)
    (<- (%pattern-fields (?pattern . ?patterns) ?index
                         ((:p-row ?label ?pattern) . ?rows) ((field ?label ?type) . ?fields))
        (%expression-type-for-pattern ?pattern ?type)
        (lisp ?label (write-to-string ?index))
        (is ?next (+ ?index 1))
        (%pattern-fields ?patterns ?next ?rows ?fields))
    (<-- (%pattern-item-bindings nil nil) !)
    (<- (%pattern-item-bindings ((:p-row ?label ?pattern) . ?items) ?bindings)
        (%pattern-bindings ?pattern ?first)
        (%pattern-item-bindings ?items ?rest)
        (%append ?first ?rest ?bindings))
    (<- (%pattern-item-bindings (?pattern . ?items) ?bindings)
        (%pattern-bindings ?pattern ?first)
        (%pattern-item-bindings ?items ?rest)
        (%append ?first ?rest ?bindings))
    (<-- (%pattern-rows ?static ?tyvars nil nil nil nil) !)
    (<- (%pattern-rows ?static ?tyvars
                       ((:node :pattern-row ?span ((:label . ?label) (:pattern . ?pattern) (:pun-p . ?pun))) . ?rows)
                       ((:p-row ?name ?semantic) . ?semantic-rows)
                       ((field ?name ?type) . ?fields) ?bindings)
        (lisp ?name (%label ?label))
        (%fresh-type ?type)
        (%pattern ?static ?tyvars ?pattern ?type ?semantic)
        (%pattern-rows ?static ?tyvars ?rows ?semantic-rows ?fields ?rest)
        (%pattern-bindings ?semantic ?first)
        (%append ?first ?rest ?bindings))

    (<-- (%pattern-bindings (:p-wildcard ?span ?type ?bindings) ?bindings) !)
    (<- (%pattern-bindings (:p-unit ?span ?type ?bindings) ?bindings) !)
    (<- (%pattern-bindings (:p-literal ?span ?type ?bindings ?literal) ?bindings) !)
    (<- (%pattern-bindings (:p-variable ?span ?type ?bindings ?name ?host) ?bindings) !)
    (<- (%pattern-bindings (:p-constructor ?span ?type ?bindings ?identity ?symbol ?arity ?argument) ?bindings) !)
    (<- (%pattern-bindings (:p-record ?span ?type ?bindings ?rows) ?bindings) !)
    (<- (%pattern-bindings (:p-typed ?span ?type ?bindings ?inner) ?bindings) !)
    (<- (%pattern-bindings (:p-layered ?span ?type ?bindings ?name ?host ?inner) ?bindings) !)
    (<- (%pattern-bindings (:p-list-nil ?span ?type ?bindings ?identity) ?bindings) !)
    (<- (%pattern-bindings (:p-list-cons ?span ?type ?bindings ?identity ?head ?tail) ?bindings) !)
    (<-- (%expression-type-for-pattern (:p-wildcard ?span ?type ?bindings) ?type) !)
    (<- (%expression-type-for-pattern (:p-unit ?span ?type ?bindings) ?type) !)
    (<- (%expression-type-for-pattern (:p-literal ?span ?type ?bindings ?literal) ?type) !)
    (<- (%expression-type-for-pattern (:p-variable ?span ?type ?bindings ?name ?host) ?type) !)
    (<- (%expression-type-for-pattern (:p-constructor ?span ?type ?bindings ?identity ?symbol ?arity ?argument) ?type) !)
    (<- (%expression-type-for-pattern (:p-record ?span ?type ?bindings ?rows) ?type) !)
    (<- (%expression-type-for-pattern (:p-typed ?span ?type ?bindings ?inner) ?type) !)
    (<- (%expression-type-for-pattern (:p-layered ?span ?type ?bindings ?name ?host ?inner) ?type) !)
    (<- (%expression-type-for-pattern (:p-list-nil ?span ?type ?bindings ?identity) ?type) !)
    (<- (%expression-type-for-pattern (:p-list-cons ?span ?type ?bindings ?identity ?head ?tail) ?type) !)

    database))

(defun %install-elaboration-static-predicates (database)
  (let ((*database* database))
    (<-- (%unique-bindings nil ?span) !)
    (<- (%unique-bindings ((:bind ?name ?type ?host) . ?rest) ?span)
        (or (-> (%binding-named ?name ?rest)
                (lisp (%fail ?span (format nil "Duplicate pattern variable ~A." ?name))))
            true)
        (%unique-bindings ?rest ?span))
    (<-- (%binding-named ?name ((:bind ?entry-name ?type ?host) . ?rest))
        (lispp (equal ?name ?entry-name)) !)
    (<- (%binding-named ?name (?entry . ?rest)) (%binding-named ?name ?rest))

    ;;; Lists are emitted as constructor patterns, retaining the initial
    ;;; constructor identities even if source constructors shadow their names.
    (<-- (%initial-value-binding ((:value ?entry-path . ?data) . ?rest) ?path ?result)
        (lispp (equal ?entry-path ?path))
        (or (-> (%initial-value-binding ?rest ?path ?older)
                (= ?result ?older))
            (= ?result (:value ?path . ?data))) !)
    (<- (%initial-value-binding (?entry . ?rest) ?path ?result)
        (%initial-value-binding ?rest ?path ?result))
    (<-- (%primitive-value ?static ?name ?span (:value ?path ?scheme ?symbol ?status))
        (= ?static (:static ?values ?types))
        (= ?path (?name))
        (or (-> (%initial-value-binding ?values ?path
                       (:value ?path ?scheme ?symbol ?status)) true)
            (lisp (%fail ?span (format nil "The initial value identifier ~A is unavailable." ?name)))))
    (<-- (%list-pattern ?static ?tyvars ?span nil ?element
                        (:p-list-nil ?span ?type nil ?nil-identity) nil)
        (%pattern-list-constructor ?static "nil" ?element ?span ?nil-identity ?type))
    (<- (%list-pattern ?static ?tyvars ?span (?pattern . ?patterns) ?element
                       (:p-list-cons ?span ?type ?bindings ?cons-identity ?head ?tail) ?bindings)
        (%pattern ?static ?tyvars ?pattern ?element ?head)
        (%list-pattern ?static ?tyvars ?span ?patterns ?element ?tail ?tail-bindings)
        (%pattern-list-cons-type ?static ?element ?span ?cons-identity ?type)
        (%pattern-bindings ?head ?head-bindings)
        (%append ?head-bindings ?tail-bindings ?bindings))

    (<-- (%pattern-list-constructor ?static ?name ?element ?span ?identity ?type)
        (%primitive-value ?static ?name ?span
                          (:value ?path ?scheme ?symbol (:constructor ?identity 0 ?exception)))
        (instantiate-type-scheme ?scheme ?type)
        (%list-requirement ?static ?element ?span ?expected)
        (type-unify ?type ?expected))
    (<-- (%pattern-list-cons-type ?static ?element ?span ?identity ?type)
        (%primitive-value ?static "::" ?span
                          (:value ?path ?scheme ?symbol (:constructor ?identity 1 ?exception)))
        (instantiate-type-scheme ?scheme ?constructor)
        (%list-requirement ?static ?element ?span ?list-type)
        (record-type ((field "1" ?element) (field "2" ?list-type)) :closed ?payload)
        (type-unify ?constructor (=> ?payload ?list-type))
        (= ?type ?list-type))
    (<-- (%list-requirement ?static ?element ?span ?type)
        (%primitive-type-name ?static "list" ?span
                              (type-name ?spelling ?identity 1 ?equality ?flexibility))
        (= ?type (@ (type-name ?spelling ?identity 1 ?equality ?flexibility) (?element))))

    ;;; Appendix E overloading.  Each overloaded identifier occurrence retains
    ;;; its instantiated type in the typed semantic tree.  Before the nearest
    ;;; value declaration is generalized, bound instances are checked against
    ;;; the admitted initial-basis names and unresolved instances default to
    ;;; int.  No global constraint side channel or speculative mutation is used.
    (<-- (%resolve-overloads (:x-variable ?span ?type ?symbol (:overloaded ?family)) ?static)
        ! (%resolve-overload ?family ?type ?static ?span))
    (<- (%resolve-overloads (:x-variable ?span ?type ?symbol ?status) ?static) !)
    (<- (%resolve-overloads (:x-literal ?span ?type ?literal) ?static) !)
    (<- (%resolve-overloads (:x-unit ?span ?type) ?static) !)
    (<- (%resolve-overloads (:x-selector ?span ?type ?label ?record) ?static) !)
    (<- (%resolve-overloads nil ?static) !)
    (<- (%resolve-overloads (:x-typed ?span ?type ?child) ?static)
        ! (%resolve-overloads ?child ?static))
    (<- (%resolve-overloads (:x-record ?span ?type ?rows) ?static)
        ! (%resolve-overloads ?rows ?static))
    (<- (%resolve-overloads (:x-row ?label ?child) ?static)
        ! (%resolve-overloads ?child ?static))
    (<- (%resolve-overloads (:x-sequence ?span ?type ?children) ?static)
        ! (%resolve-overloads ?children ?static))
    (<- (%resolve-overloads (:x-list ?span ?type ?children) ?static)
        ! (%resolve-overloads ?children ?static))
    (<- (%resolve-overloads (:x-application ?span ?type ?function ?argument) ?static)
        ! (%resolve-overloads ?function ?static) (%resolve-overloads ?argument ?static))
    (<- (%resolve-overloads (:x-andalso ?span ?type ?left ?right) ?static)
        ! (%resolve-overloads ?left ?static) (%resolve-overloads ?right ?static))
    (<- (%resolve-overloads (:x-orelse ?span ?type ?left ?right) ?static)
        ! (%resolve-overloads ?left ?static) (%resolve-overloads ?right ?static))
    (<- (%resolve-overloads (:x-if ?span ?type ?condition ?then ?else) ?static)
        ! (%resolve-overloads ?condition ?static) (%resolve-overloads ?then ?static)
        (%resolve-overloads ?else ?static))
    (<- (%resolve-overloads (:x-while ?span ?type ?condition ?body) ?static)
        ! (%resolve-overloads ?condition ?static) (%resolve-overloads ?body ?static))
    (<- (%resolve-overloads (:x-raise ?span ?type ?child) ?static)
        ! (%resolve-overloads ?child ?static))
    (<- (%resolve-overloads (:x-case ?span ?type ?child ?rules) ?static)
        ! (%resolve-overloads ?child ?static) (%resolve-overloads ?rules ?static))
    (<- (%resolve-overloads (:x-handle ?span ?type ?child ?rules) ?static)
        ! (%resolve-overloads ?child ?static) (%resolve-overloads ?rules ?static))
    (<- (%resolve-overloads (:x-function ?span ?type ?argument ?rules) ?static)
        ! (%resolve-overloads ?rules ?static))
    (<- (%resolve-overloads (:x-let ?span ?type ?declarations ?children) ?static)
        ! (%resolve-overloads ?declarations ?static) (%resolve-overloads ?children ?static))
    (<- (%resolve-overloads (:rules ?rules) ?static) ! (%resolve-overloads ?rules ?static))
    (<- (%resolve-overloads (:rule ?pattern ?child) ?static) ! (%resolve-overloads ?child ?static))
    (<- (%resolve-overloads (:fc ?patterns ?child) ?static) ! (%resolve-overloads ?child ?static))
    (<- (%resolve-overloads (:vb ?pattern ?child) ?static) ! (%resolve-overloads ?child ?static))
    (<- (%resolve-overloads (:d-value ?span ?recursive ?bindings) ?static)
        ! (%resolve-overloads ?bindings ?static))
    (<- (%resolve-overloads (:fb ?name ?host ?type ?rules) ?static)
        ! (%resolve-overloads ?rules ?static))
    (<- (%resolve-overloads (:d-functions ?span ?bindings) ?static)
        ! (%resolve-overloads ?bindings ?static))
    (<- (%resolve-overloads (:d-expression ?name ?host ?child) ?static)
        ! (%resolve-overloads ?child ?static))
    (<- (%resolve-overloads (:d-sequence ?declarations) ?static)
        ! (%resolve-overloads ?declarations ?static))
    (<- (%resolve-overloads (:d-local ?span ?local ?body) ?static)
        ! (%resolve-overloads ?local ?static) (%resolve-overloads ?body ?static))
    (<- (%resolve-overloads (:d-abstype ?span ?datatype ?hidden ?body) ?static)
        ! (%resolve-overloads ?datatype ?static) (%resolve-overloads ?body ?static))
    (<- (%resolve-overloads (?first . ?rest) ?static)
        (%resolve-overloads ?first ?static)
        (%resolve-overloads ?rest ?static))
    (<- (%resolve-overloads ?other ?static) !)
    (<-- (%resolve-overload :word-int ?type ?static ?span)
        ! (%overload-result ?type ?result)
        (%resolve-word-int-type ?result ?static ?span))
    (<- (%resolve-overload :real-int ?type ?static ?span)
        ! (%overload-result ?type ?result)
        (%resolve-real-int-type ?result ?static ?span))
    (<- (%resolve-overload :numeric ?type ?static ?span)
        ! (%overload-result ?type ?result)
        (%resolve-numeric-type ?result ?static ?span))
    (<- (%resolve-overload :ordered ?type ?static ?span)
        ! (%ordered-argument ?type ?argument)
        (%resolve-ordered-type ?argument ?static ?span))
    (<-- (%overload-result (=> ?domain ?result) ?witness) ! (%overload-result ?result ?witness))
    (<- (%overload-result ?type ?type) !)
    ;;; Record labels are value data, not object identities.  Comparing the
    ;;; literal in the head would reject independently allocated "1" strings
    ;;; before ORDERED resolution can validate or default the operand type.
    (<-- (%ordered-argument (=> (record ((field ?label ?argument) . ?fields) ?tail) ?result) ?argument)
        (lispp (equal ?label "1")) !)
    (<- (%ordered-argument (type-var ?cell ?kind ?equality) ?argument)
        ! (%ordered-argument ?cell ?argument))
    (<-- (%unbound-type ?type) (var ?type) !)
    (<- (%unbound-type (type-var ?cell ?kind ?equality)) (var ?cell))
    (<-- (%resolve-word-int-type ?type ?static ?span)
        (or (-> (%unbound-type ?type)
                (and (%named-type ?static "int" ?span ?int)
                     (type-unify ?type ?int)))
            (%check-overloaded-name ?type ?static ?span ("int" "word"))))
    (<-- (%resolve-real-int-type ?type ?static ?span)
        (or (-> (%unbound-type ?type)
                (and (%named-type ?static "int" ?span ?int)
                     (type-unify ?type ?int)))
            (%check-overloaded-name ?type ?static ?span ("int" "real"))))
    (<-- (%resolve-numeric-type ?type ?static ?span)
        (or (-> (%unbound-type ?type)
                (and (%named-type ?static "int" ?span ?int)
                     (type-unify ?type ?int)))
            (%check-overloaded-name ?type ?static ?span ("int" "real" "word"))))
    (<-- (%resolve-ordered-type ?type ?static ?span)
        (or (-> (%unbound-type ?type)
                (and (%named-type ?static "int" ?span ?int)
                     (type-unify ?type ?int)))
            (%check-overloaded-name ?type ?static ?span ("int" "real" "word" "char" "string"))))
    (<-- (%check-overloaded-name (type-var ?cell ?kind ?equality) ?static ?span ?names)
        (nonvar ?cell) ! (%check-overloaded-name ?cell ?static ?span ?names))
    (<- (%check-overloaded-name (@ (type-name ?spelling ?identity ?arity ?equality ?flexibility) ?arguments)
                                ?static ?span ?names)
        (%overloaded-name-member ?spelling ?identity ?static ?span ?names) !)
    (<- (%check-overloaded-name ?other ?static ?span ?names)
        (lisp (%fail ?span "The overloaded identifier has no admitted type at this use.")))
    (<-- (%overloaded-name-member ?spelling ?identity ?static ?span (?name . ?names))
        (%named-type ?static ?name ?span (@ (type-name ?actual ?expected ?arity ?eq ?flex) nil))
        (or (-> (lispp (eq ?identity ?expected)) !)
            (%overloaded-name-member ?spelling ?identity ?static ?span ?names)))
    ;; Exhausting admitted names is logical rejection, not a host error that
    ;; could mask a later stage while Prolog explores alternatives.

    database))

(defun %install-elaboration-declaration-predicates (database)
  (let ((*database* database))
    ;;; Executable images are compacted only after they are frozen; see
    ;;; %COMPACT-SEMANTIC-IMAGE above for the cell-safe shared walker.

    ;;; Declaration-local type-variable scopes.  The host-side native walk
    ;;; stops at nested VAL/FUN declarations, exactly where the next scope starts.
    (<-- (%seed-type-variables ?ast ?outer ?scope)
        (lisp ?names (%explicit-type-variable-names ?ast))
        (%seed-type-variable-names ?names ?outer ?scope))
    (<-- (%seed-type-variable-names nil ?scope ?scope) !)
    (<- (%seed-type-variable-names (?name . ?names) ?in ?out)
        (%named-type-variable ?name ?type)
        (%seed-type-variable-names ?names ?in ?rest)
        (= ?out ((:tyvar ?name ?type) . ?rest)))
    (<-- (%declared-variable-types nil ?tyvars nil) !)
    (<- (%declared-variable-types (?identifier . ?identifiers) ?tyvars (?type . ?types))
        (lisp ?name (%name ?identifier))
        (or (-> (%tyvar-lookup ?tyvars ?name ?found) (= ?type ?found))
            (%named-type-variable ?name ?type))
        (%declared-variable-types ?identifiers ?tyvars ?types))

    ;;; Non-VAL declarations reuse an enclosing explicitly scoped type variable
    ;;; unless their own parameter list shadows it.  At top level, an unlisted
    ;;; occurrence instead remains fresh and is rejected by the scope check.
    (<-- (%declared-variable-name ?name (?identifier . ?rest))
        (lisp ?declared (%name ?identifier))
        (lispp (equal ?name ?declared)) !)
    (<- (%declared-variable-name ?name (?identifier . ?rest))
        (%declared-variable-name ?name ?rest))
    (<-- (%seed-scoped-type-variables ?ast ?outer ?variables ?scope)
        (lisp ?names (%explicit-type-variable-names ?ast))
        (%seed-scoped-type-variable-names ?names ?outer ?variables ?scope))
    (<-- (%seed-scoped-type-variable-names nil ?outer ?variables ?outer) !)
    (<- (%seed-scoped-type-variable-names (?name . ?names) ?outer ?variables ?out)
        (or (-> (%declared-variable-name ?name ?variables)
                (%named-type-variable ?name ?type))
            (or (-> (%tyvar-lookup ?outer ?name ?type) true)
                (%named-type-variable ?name ?type)))
        (%seed-scoped-type-variable-names ?names ?outer ?variables ?rest)
        (= ?out ((:tyvar ?name ?type) . ?rest)))
    (<-- (%type-variable-cell (type-var ?cell ?kind ?equality) ?cell) !)
    (<- (%type-variable-cell ?variable ?variable))
    (<-- (%scoped-type-variable ?variable ((:tyvar ?name ?bound) . ?rest))
        (%type-variable-cell ?variable ?cell)
        (%type-variable-cell ?bound ?bound-cell)
        (== ?cell ?bound-cell) !)
    (<- (%scoped-type-variable ?variable (?entry . ?rest))
        (%scoped-type-variable ?variable ?rest))
    (<-- (%unscoped-type-variables nil ?scope nil) !)
    (<- (%unscoped-type-variables (?variable . ?variables) ?scope ?unscoped)
        (%unscoped-type-variables ?variables ?scope ?rest)
        (or (-> (%scoped-type-variable ?variable ?scope)
                (= ?unscoped ?rest))
            (= ?unscoped (?variable . ?rest))))
    (<-- (%require-type-function-scope ?parameters ?body ?outer ?span ?message)
        (free-type-variables (type-function ?parameters ?body) ?free)
        (%unscoped-type-variables ?free ?outer ?unscoped)
        (or (-> (= ?unscoped nil) true)
            (lisp (%fail ?span ?message))))

    ;;; SML nonexpansiveness is computed over the typed semantic term, with
    ;;; constructor applications distinguished from general function calls.
    (<-- (%nonexpansive (:x-literal ?span ?type ?literal)) !)
    (<- (%nonexpansive (:x-variable ?span ?type ?symbol ?status)) !)
    (<- (%nonexpansive (:x-unit ?span ?type)) !)
    (<- (%nonexpansive (:x-selector ?span ?type ?name ?record)) !)
    (<- (%nonexpansive (:x-record ?span ?type ?rows)) ! (%nonexpansive-rows ?rows))
    (<- (%nonexpansive (:x-list ?span ?type ?items)) ! (%nonexpansive-list ?items))
    (<- (%nonexpansive (:x-typed ?span ?type ?item)) ! (%nonexpansive ?item))
    (<- (%nonexpansive (:x-function ?span ?type ?argument ?match)) !)
    (<- (%nonexpansive (:x-sequence ?span ?type ?items)) ! (%nonexpansive-list ?items))
    (<- (%nonexpansive (:x-let ?span ?type ?declarations ?items))
        ! (%nonexpansive-declarations ?declarations) (%nonexpansive-list ?items))
    (<- (%nonexpansive (:x-application ?span ?type
                         (:x-variable ?fspan ?ftype ?symbol (:constructor ?identity ?arity ?exception)) ?argument))
        ! (%nonexpansive-constructor-identity ?identity) (%nonexpansive ?argument))
    (<-- (%nonexpansive-constructor-identity ?identity)
        (lispp (not (eq ?identity +reference-identity+))))
    (<-- (%nonexpansive-rows nil) !)
    (<- (%nonexpansive-rows ((:x-row ?label ?item) . ?rows))
        (%nonexpansive ?item) (%nonexpansive-rows ?rows))
    (<-- (%nonexpansive-list nil) !)
    (<- (%nonexpansive-list (?item . ?items))
        (%nonexpansive ?item) (%nonexpansive-list ?items))
    (<-- (%nonexpansive-declarations nil) !)
    (<- (%nonexpansive-declarations ((:d-value ?span nil ?bindings) . ?declarations))
        ! (%nonexpansive-value-bindings ?bindings) (%nonexpansive-declarations ?declarations))
    (<- (%nonexpansive-declarations ((:d-type) . ?declarations))
        ! (%nonexpansive-declarations ?declarations))
    (<- (%nonexpansive-declarations ((:d-fixity) . ?declarations))
        ! (%nonexpansive-declarations ?declarations))
    (<- (%nonexpansive-declarations ((:d-value ?span t ?bindings) . ?declarations))
        ! (%nonexpansive-value-bindings ?bindings) (%nonexpansive-declarations ?declarations))
    (<- (%nonexpansive-declarations ((:d-mixed-value ?span ?ordinary ?recursive) . ?declarations))
        ! (%nonexpansive-value-bindings ?ordinary)
        (%nonexpansive-value-bindings ?recursive)
        (%nonexpansive-declarations ?declarations))
    (<- (%nonexpansive-declarations ((:d-functions ?span ?bindings) . ?declarations))
        ! (%nonexpansive-declarations ?declarations))
    (<- (%nonexpansive-declarations ((:d-datatype ?span ?constructors) . ?declarations))
        ! (%nonexpansive-declarations ?declarations))
    (<- (%nonexpansive-declarations ((:d-replication ?span ?copies) . ?declarations))
        ! (%nonexpansive-declarations ?declarations))
    (<- (%nonexpansive-declarations ((:d-exceptions ?span ?constructors ?aliases) . ?declarations))
        ! (%nonexpansive-declarations ?declarations))
    (<- (%nonexpansive-declarations ((:d-abstype ?span ?datatype ?hidden ?body) . ?declarations))
        ! (%nonexpansive-declarations (?datatype)) (%nonexpansive-declarations ?body)
        (%nonexpansive-declarations ?declarations))
    (<- (%nonexpansive-declarations ((:d-open) . ?declarations))
        ! (%nonexpansive-declarations ?declarations))
    (<- (%nonexpansive-declarations ((:d-local ?span ?local ?body) . ?declarations))
        ! (%nonexpansive-declarations ?local)
        (%nonexpansive-declarations ?body)
        (%nonexpansive-declarations ?declarations))
    (<- (%nonexpansive-declarations ((:d-sequence ?items) . ?declarations))
        ! (%nonexpansive-declarations ?items) (%nonexpansive-declarations ?declarations))
    (<-- (%nonexpansive-value-bindings nil) !)
    (<- (%nonexpansive-value-bindings ((:vb ?pattern ?expression) . ?bindings))
        (%nonexpansive ?expression) (%nonexpansive-value-bindings ?bindings))

    (<-- (%static-weak-type-variables (:static ?values ?types) ?variables)
        (%static-value-weak-type-variables ?values ?variables))
    (<-- (%static-value-weak-type-variables nil nil) !)
    (<- (%static-value-weak-type-variables ((:value ?path ?scheme ?host ?status) . ?values) ?variables)
        (free-type-variables ?scheme ?first)
        (%static-value-weak-type-variables ?values ?rest)
        (%append ?first ?rest ?variables))
    (<-- (%weak-type-scope ?variables ?names)
        (%resolved-weak-type-names ?variables ?names))
    (<- (%resolved-weak-type-names nil nil) !)
    (<- (%resolved-weak-type-names (?variable . ?variables) ?names)
        (free-type-names ?variable ?first)
        (%resolved-weak-type-names ?variables ?rest)
        (%append ?first ?rest ?names))
    (<-- (%nominal-checkpoint-declaration (:node :datatype-declaration ?span ?slots)) !)
    (<- (%nominal-checkpoint-declaration (:node :abstype-declaration ?span ?slots)) !)
    (<- (%nominal-checkpoint-declaration (:node :local-declaration ?span ?slots)) !)

    (<-- (%declaration-list ?static ?tyvars ?asts ?out ?semantics)
        (%declaration-list-with-lifetimes ?static ?tyvars ?asts ?out ?semantics ?ignored-checkpoints))
    (<-- (%declaration-list-with-lifetimes ?static ?tyvars nil ?static nil nil) !)
    (<- (%declaration-list-with-lifetimes ?static ?tyvars (?ast . ?asts) ?out (?semantic . ?semantics) ?checkpoints)
        (or (-> (%nominal-checkpoint-declaration ?ast)
                (%static-weak-type-variables ?static ?weak))
            (= ?weak nil))
        (or (-> (= ?weak nil) true)
            (%static-free-type-names ?static ?visible-names))
        (%declaration ?static ?tyvars ?ast ?next ?semantic)
        (%declaration-list-with-lifetimes ?next ?tyvars ?asts ?out ?semantics ?rest-checkpoints)
        (lisp ?span (ast-node-span ?ast))
        (or (-> (= ?weak nil) true)
            (and (%weak-type-scope ?weak ?resolved-names)
                 (or (-> (%type-names-subset ?resolved-names ?visible-names) true)
                     (lisp (%fail ?span "An older monomorphic type variable acquired a later datatype identity.")))))
        (or (-> (%nominal-checkpoint-declaration ?ast)
                (= ?checkpoints ((:checkpoint ?weak ?visible-names ?span) . ?rest-checkpoints)))
            (= ?checkpoints ?rest-checkpoints)))

    (<-- (%declaration ?static ?outer (:node :declaration-sequence ?span ((:declarations . ?declarations))) ?out
                       (:d-sequence ?items))
        (%declaration-list ?static ?outer ?declarations ?out ?items))
    (<- (%declaration ?static ?outer (:node :value-declaration ?span ((:variables . ?variables) (:bindings . ?bindings) (:recursive-p . nil))) ?next
                      (:d-value ?span nil ?semantic-bindings))
        (%seed-type-variables ?bindings ?outer ?scope)
        (%value-bindings ?static ?scope ?bindings ?semantic-bindings)
        (%resolve-overloads ?semantic-bindings ?static)
        (%static-type-environment ?static ?environment)
        (%value-binding-schemes ?semantic-bindings ?environment :per-binding ?values)
        (%extend-values ?static ?values ?next))
    (<- (%declaration ?static ?outer (:node :value-declaration ?span ((:variables . ?variables) (:bindings . ?bindings) (:recursive-p . :mixed))) ?next
                      (:d-mixed-value ?span ?ordinary-bindings ?semantic-recursive-bindings))
        (%seed-type-variables ?bindings ?outer ?scope)
        (%partition-recursive-value-bindings ?bindings ?ordinary-asts ?recursive-asts)
        (%value-bindings ?static ?scope ?ordinary-asts ?ordinary-bindings)
        (%resolve-overloads ?ordinary-bindings ?static)
        (%static-type-environment ?static ?environment)
        (%value-binding-schemes ?ordinary-bindings ?environment :per-binding ?ordinary-values)
        (%recursive-headers ?recursive-asts ?scope ?headers ?recursive-values)
        (%extend-values ?static ?recursive-values ?recursive-static)
        (%recursive-bindings ?recursive-static ?scope ?recursive-asts ?headers ?semantic-recursive-bindings)
        (%resolve-overloads ?semantic-recursive-bindings ?recursive-static)
        (%value-binding-schemes ?semantic-recursive-bindings ?environment :nonexpansive ?recursive-value-schemes)
        (%append ?ordinary-values ?recursive-value-schemes ?values)
        (%extend-values ?static ?values ?next))
    (<- (%declaration ?static ?outer (:node :value-declaration ?span ((:variables . ?variables) (:bindings . ?bindings) (:recursive-p . t))) ?next
                      (:d-value ?span t ?semantic-bindings))
        (%seed-type-variables ?bindings ?outer ?scope)
        (%recursive-headers ?bindings ?scope ?headers ?recursive-values)
        (%extend-values ?static ?recursive-values ?recursive-static)
        (%recursive-bindings ?recursive-static ?scope ?bindings ?headers ?semantic-bindings)
        (%resolve-overloads ?semantic-bindings ?recursive-static)
        (%static-type-environment ?static ?environment)
        (%value-binding-schemes ?semantic-bindings ?environment :nonexpansive ?values)
        (%extend-values ?static ?values ?next))
    (<- (%declaration ?static ?outer (:node :function-declaration ?span ((:variables . ?variables) (:bindings . ?bindings) (:declaration-form . ?form))) ?next
                      (:d-functions ?span ?semantic-bindings))
        (%seed-type-variables ?bindings ?outer ?scope)
        (%function-headers ?bindings ?headers ?recursive-values)
        (%extend-values ?static ?recursive-values ?recursive-static)
        (%function-bindings ?recursive-static ?scope ?bindings ?headers ?semantic-bindings)
        (%resolve-overloads ?semantic-bindings ?recursive-static)
        (%static-type-environment ?static ?environment)
        (%function-schemes ?semantic-bindings ?environment ?values)
        (%extend-values ?static ?values ?next))
    (<- (%declaration ?static ?outer (:node :type-declaration ?span ((:bindings . ?bindings))) ?next (:d-type))
        (%type-bindings ?static ?outer ?bindings ?types)
        (%extend-types ?static ?types ?next))
    (<- (%declaration ?static ?outer (:node :datatype-declaration ?span ((:bindings . ?bindings) (:withtypes . ?withtypes))) ?next
                      (:d-datatype ?span ?constructors))
        (%datatype-declaration ?static ?outer ?bindings ?withtypes ?next ?constructors))
    (<- (%declaration ?static ?outer (:node :datatype-replication ?span ((:name . ?name) (:source . ?source))) ?next
                      (:d-replication ?span ?copies))
        (%datatype-replication ?static ?outer ?name ?source ?span ?types ?copies)
        (%extend-types ?static ?types ?typed)
        (%replication-values ?copies ?values)
        (%extend-values ?typed ?values ?next))
    (<- (%declaration ?static ?outer (:node :abstype-declaration ?span ((:bindings . ?bindings) (:withtypes . ?withtypes) (:declarations . ?declarations))) ?next
                      (:d-abstype ?span ?datatypes ?hidden ?body))
        (%datatype-declaration ?static ?outer ?bindings ?withtypes ?datatype-static ?constructors)
        (%declaration-list ?datatype-static ?outer ?declarations ?body-static ?body)
        (%abstype-visible-values ?static ?body-static ?bindings ?visible)
        (%abstype-export-types ?static ?datatype-static ?body-types)
        (= ?next (:static ?visible ?body-types))
        (= ?datatypes (:d-datatype ?span ?constructors))
        (%datatype-host-symbols ?constructors ?hidden))
    (<- (%declaration ?static ?outer (:node :exception-declaration ?span ((:bindings . ?bindings))) ?next
                      (:d-exceptions ?span ?constructors ?aliases))
        (%seed-scoped-type-variables ?bindings ?outer nil ?scope)
        (%exception-bindings ?static ?scope ?outer ?bindings ?constructors ?aliases ?values)
        (%extend-values ?static ?values ?next))
    (<- (%declaration ?static ?outer (:node :local-declaration ?span ((:local . ?local) (:body . ?body))) ?next
                      (:d-local ?span ?local-items ?body-items))
        (%declaration-list-with-lifetimes ?static ?outer ?local ?local-static
                                          ?local-items ?local-checkpoints)
        (%static-weak-type-variables ?local-static ?local-weak)
        (or (-> (= ?local-weak nil) true)
            (%static-free-type-names ?local-static ?local-visible-names))
        (%declaration-list ?local-static ?outer ?body ?body-static ?body-items)
        (%check-lifetime-checkpoints ?local-checkpoints)
        (%local-export ?static ?local-static ?body-static ?next)
        (%check-local-weak-lifetime ?local-weak ?local-visible-names ?span))
    (<- (%declaration ?static ?outer (:node :open-declaration ?span ((:identifiers . ?identifiers))) ?next (:d-open))
        (%open-identifiers ?static ?identifiers ?static ?next))
    (<- (%declaration ?static ?outer (:node :fixity-declaration ?span ?slots) ?static (:d-fixity)))

    ;;; The LOCAL boundary is a second temporal scope boundary.  Values from
    ;;; its first declaration must not acquire nominal identities introduced
    ;;; only by its second declaration, including when the final value is hidden.
    (<-- (%check-local-weak-lifetime ?weak ?visible-names ?span)
        (or (-> (= ?weak nil) true)
            (and (%weak-type-scope ?weak ?resolved-names)
                 (or (-> (%type-names-subset ?resolved-names ?visible-names) true)
                     (lisp (%fail ?span "An older monomorphic type variable acquired a later datatype identity."))))))
    (<-- (%check-lifetime-checkpoints nil) !)
    (<- (%check-lifetime-checkpoints ((:checkpoint ?weak ?visible-names ?span) . ?checkpoints))
        (%check-local-weak-lifetime ?weak ?visible-names ?span)
        (%check-lifetime-checkpoints ?checkpoints))

    ;;; Compute persistent environment additions in Prolog itself.  Returning a
    ;;; list of live schemes through the host bridge would reify their variables.
    (<-- (%native-environment-prefix ?entries ?older ?prefix)
        (%environment-length ?entries ?length)
        (%environment-length ?older ?older-length)
        (is ?count (- ?length ?older-length))
        (%copy-environment-prefix ?count ?entries ?prefix))
    (<-- (%environment-length nil 0) !)
    (<- (%environment-length (?entry . ?entries) ?length)
        (%environment-length ?entries ?rest)
        (is ?length (+ ?rest 1)))
    (<-- (%copy-environment-prefix 0 ?entries nil) !)
    (<- (%copy-environment-prefix ?count (?entry . ?entries) (?entry . ?prefix))
        (is ?next (- ?count 1))
        (%copy-environment-prefix ?next ?entries ?prefix))

    ;;; LOCAL exports only the second declaration's additions.  Length
    ;;; differences are the persistent boundary, including same-named aliases.
    (<-- (%local-export (:static ?original-values ?original-types)
                        (:static ?local-values ?local-types)
                        (:static ?body-values ?body-types) ?next)
        (%native-environment-prefix ?body-values ?local-values ?new-values)
        (%native-environment-prefix ?body-types ?local-types ?new-types)
        (%append ?new-values ?original-values ?values)
        (%append ?new-types ?original-types ?types)
        (= ?next (:static ?values ?types)))

    database))

(defun %internal-query-variable ()
  ;; MAKE-QUERY returns every ordinary named variable.  Internal typing roots
  ;; must not be reified alongside the single frozen result of a clause step.
  (let ((symbol (gensym "?SML-STREAM-")))
    (setf (get symbol 'dcg-internal) t)
    symbol))

(defun %stream-query-result (goals span)
  (let ((answers (query goals :limit 1 :database *database*)))
    (unless answers
      (%fail span "SML match elaboration did not produce well-typed rules."))
    (let ((frozen-entry (assoc '?frozen-output (first answers)))
          (plain-entry (assoc '?plain-output (first answers))))
      (unless (and frozen-entry plain-entry)
        (error "Match streaming omitted its frozen state or plain semantic output."))
      (values (cdr frozen-entry) (cdr plain-entry)))))

(defun %stream-match-rule-batch (state obligations rules span shared-static-p)
  (let ((static (%internal-query-variable))
        (tyvars (%internal-query-variable))
        (argument (%internal-query-variable))
        (result (%internal-query-variable))
        (live-obligations (%internal-query-variable))
        (map (%internal-query-variable))
        (batch-obligations (%internal-query-variable))
        (combined-obligations (%internal-query-variable)))
    (%stream-query-result
     (list
      (list '%thaw-native (list state obligations) nil map
            (list (list static tyvars argument result) live-obligations))
      (list '%compact-match-rules static tyvars rules argument result
            '?plain-output batch-obligations)
      (list '%append batch-obligations live-obligations combined-obligations)
      ;; Type cells in state and obligations share this one map.  The ground
      ;; plain rules never enter either side of this snapshot operation.
      (list '%freeze-native
            (list (if shared-static-p
                      (list argument result)
                      (list static tyvars argument result))
                  combined-obligations)
            nil (%internal-query-variable) '?frozen-output))
     span)))

(defconstant +match-stream-batch-size+ 64)

(defun %long-match-p (rules)
  (loop for rest = rules then (cdr rest)
        for count below +match-stream-batch-size+
        always (consp rest)
        finally (return t)))

(defun %stream-match-rules (frozen-input rules span shared-static-p)
  "Return frozen STATE/OBLIGATIONS plus an independent plain rule list.
Only the state and minimal live overload products cross batch snapshots; plain
bodies are accumulated directly without another thaw or freeze."
  (let ((state frozen-input)
        (obligations nil)
        (reversed-rules nil))
    (loop for remaining on rules by (lambda (rest) (nthcdr +match-stream-batch-size+ rest))
          for batch = (subseq remaining 0 (min +match-stream-batch-size+ (length remaining)))
          do (multiple-value-bind (frozen-result plain-rules)
                 (%stream-match-rule-batch state obligations batch span shared-static-p)
               (destructuring-bind (views new-obligations) frozen-result
                 (setf obligations new-obligations
                       reversed-rules (revappend plain-rules reversed-rules))
                 (if shared-static-p
                     (destructuring-bind (argument result-type) views
                       (setf state (list (first state) (second state) argument result-type)))
                     (setf state views)))))
    (list state obligations (list :rules (nreverse reversed-rules)))))

(defun %install-elaboration-value-predicates (database)
  (let ((*database* database))
    ;;; Ordinary and recursive value bindings.
    (<-- (%partition-recursive-value-bindings nil nil nil) !)
    (<- (%partition-recursive-value-bindings (?binding . ?bindings) ?ordinary (?binding . ?rest))
        (= ?binding (:node :value-binding ?span ((:pattern . ?pattern) (:expression . ?expression) (:recursive-p . t))))
        (%partition-recursive-value-bindings ?bindings ?ordinary ?rest))
    (<- (%partition-recursive-value-bindings (?binding . ?bindings) (?binding . ?rest) ?recursive)
        (%partition-recursive-value-bindings ?bindings ?rest ?recursive))

    (<-- (%value-bindings ?static ?scope nil nil) !)
    (<- (%value-bindings ?static ?scope
                         ((:node :value-binding ?span ((:pattern . ?pattern) (:expression . ?expression) . ?other-slots)) . ?bindings)
                         ((:vb ?semantic-pattern ?semantic-expression) . ?semantic-bindings))
        (%fresh-type ?pattern-type)
        (%pattern ?static ?scope ?pattern ?pattern-type ?semantic-pattern)
        (%expression ?static ?scope ?expression ?semantic-expression)
        (%type ?semantic-expression ?expression-type)
        (type-unify ?pattern-type ?expression-type)
        (%value-bindings ?static ?scope ?bindings ?semantic-bindings))
    (<-- (%value-binding-schemes nil ?environment ?eligibility nil) !)
    (<- (%value-binding-schemes ((:vb ?pattern ?expression) . ?bindings) ?environment ?eligibility ?values)
        (%pattern-bindings ?pattern ?binders)
        (or (-> (== ?eligibility :per-binding)
                (or (-> (%nonexpansive ?expression)
                        (= ?binding-eligibility :nonexpansive))
                    (= ?binding-eligibility :value-restriction)))
            (= ?binding-eligibility ?eligibility))
        (%generalize-binders ?binders ?environment ?binding-eligibility ?first)
        (%value-binding-schemes ?bindings ?environment ?eligibility ?rest)
        (%append ?first ?rest ?values))
    (<-- (%generalize-binders nil ?environment ?eligibility nil) !)
    (<- (%generalize-binders ((:bind ?name ?type ?host) . ?binders) ?environment ?eligibility
                             ((:value (?name) ?scheme ?host :variable) . ?values))
        (generalize-type ?type ?environment nil ?eligibility ?scheme)
        (%generalize-binders ?binders ?environment ?eligibility ?values))
    (<-- (%binders-environment nil nil) !)
    (<- (%binders-environment ((:bind ?name ?type ?host) . ?binders)
                              ((:value (?name) (scheme nil ?type) ?host :variable) . ?values))
        (%binders-environment ?binders ?values))

    (<-- (%recursive-headers nil ?scope nil nil) !)
    (<- (%recursive-headers
         ((:node :value-binding ?span ((:pattern . ?pattern) (:expression . ?expression) . ?other-slots)) . ?bindings)
         ?scope ((:rh ?pattern ?binders ?type) . ?headers) ?values)
        (%fresh-type ?type)
        (%recursive-pattern-binders ?pattern ?span ?type ?binders)
        (%recursive-values ?binders ?type ?first-values)
        (%recursive-headers ?bindings ?scope ?headers ?rest-values)
        (%append ?first-values ?rest-values ?values))
    (<-- (%recursive-values nil ?type nil) !)
    (<- (%recursive-values ((:bind ?name ?type ?host) . ?binders) ?type
                           ((:value (?name) (scheme nil ?type) ?host :variable) . ?values))
        (%recursive-values ?binders ?type ?values))
    (<-- (%recursive-pattern-binders
          (:node :identifier-pattern ?span ((:identifier . ?identifier) (:op-p . ?op)))
          ?outer ?type ((:bind ?name ?type ?host)))
        (lisp ?path (%path ?identifier))
        (or (-> (= ?path (?name)) true)
            (lisp (%fail ?span "A recursive value binding requires an unqualified variable.")))
        (lisp ?name (%name ?identifier))
        (lisp ?host (%fresh-binding ?name)))
    (<- (%recursive-pattern-binders (:node :grouped-pattern ?span ((:pattern . ?pattern))) ?outer ?type ?binders)
        (%recursive-pattern-binders ?pattern ?outer ?type ?binders))
    (<- (%recursive-pattern-binders (:node :typed-pattern ?span ((:pattern . ?pattern) (:type . ?syntax))) ?outer ?type ?binders)
        (%recursive-pattern-binders ?pattern ?outer ?type ?binders))
    (<- (%recursive-pattern-binders
         (:node :layered-pattern ?span ((:identifier . ?identifier) (:op-p . ?op) (:type . ?syntax) (:pattern . ?nested)))
         ?outer ?type ((:bind ?name ?type ?host) . ?inner-binders))
        (lisp ?path (%path ?identifier))
        (or (-> (= ?path (?name)) true)
            (lisp (%fail ?span "A recursive value binding requires an unqualified variable.")))
        (lisp ?name (%name ?identifier))
        (lisp ?host (%fresh-binding ?name))
        (%recursive-pattern-binders ?nested ?outer ?type ?inner-binders))
    (<- (%recursive-pattern-binders ?other ?span ?type ?binders)
        (lisp (%fail ?span "A recursive value binding requires a variable left-hand side.")))
    (<-- (%recursive-bindings ?static ?scope nil nil nil) !)
    (<- (%recursive-bindings ?static ?scope
                             ((:node :value-binding ?span ((:pattern . ?pattern) (:expression . ?expression) . ?other-slots)) . ?bindings)
                             ((:rh ?ast-pattern ?binders ?type) . ?headers) ?semantic-bindings)
        (%expression ?static ?scope ?expression ?semantic-expression)
        (%type ?semantic-expression ?expression-type)
        (type-unify ?type ?expression-type)
        (%recursive-pattern-type ?static ?scope ?ast-pattern ?type)
        (%recursive-semantic-bindings ?span ?binders ?type ?semantic-expression ?first-bindings)
        (%recursive-bindings ?static ?scope ?bindings ?headers ?rest-bindings)
        (%append ?first-bindings ?rest-bindings ?semantic-bindings))
    (<-- (%recursive-semantic-bindings ?span nil ?type ?expression nil) !)
    (<- (%recursive-semantic-bindings ?span ((:bind ?name ?type ?host) . ?binders) ?type ?expression
                                      ((:vb (:p-variable ?span ?type ((:bind ?name ?type ?host)) ?name ?host) ?expression) . ?bindings))
        (%recursive-semantic-bindings ?span ?binders ?type ?expression ?bindings))
    (<-- (%recursive-pattern-type ?static ?scope (:node :identifier-pattern ?span ?slots) ?type) !)
    (<- (%recursive-pattern-type ?static ?scope (:node :grouped-pattern ?span ((:pattern . ?pattern))) ?type)
        (%recursive-pattern-type ?static ?scope ?pattern ?type))
    (<- (%recursive-pattern-type ?static ?scope (:node :typed-pattern ?span ((:pattern . ?pattern) (:type . ?syntax))) ?type)
        (%recursive-pattern-type ?static ?scope ?pattern ?pattern-type)
        (type-unify ?type ?pattern-type)
        (%syntactic-type ?static ?scope ?syntax ?annotation)
        (type-unify ?type ?annotation))
    (<- (%recursive-pattern-type ?static ?scope
                                 (:node :layered-pattern ?span ((:identifier . ?identifier) (:op-p . ?op) (:type . ?syntax) (:pattern . ?nested))) ?type)
        (or (-> (= ?syntax nil) true)
            (and (%syntactic-type ?static ?scope ?syntax ?annotation)
                 (type-unify ?type ?annotation)))
        (%recursive-pattern-type ?static ?scope ?nested ?type))

    ;;; FUN and VAL REC function-headed derived forms.  An infix head's first
    ;;; two patterns are one pair argument; remaining patterns are curried.
    (<-- (%function-headers nil nil nil) !)
    (<- (%function-headers ((:node :function-binding ?span ((:name . ?identifier) (:clauses . ?clauses))) . ?bindings)
                            ((:fh ?identifier ?name ?host ?type) . ?headers)
                            ((:value (?name) (scheme nil ?type) ?host :variable) . ?values))
        (lisp ?path (%path ?identifier))
        (= ?path (?name))
        (lisp ?name (%name ?identifier))
        (lisp ?host (%fresh-binding ?name))
        ;; Keep the recursive function type as a bare logical variable so the
        ;; curried signature relation can give it its first arrow structurally.
        (%function-headers ?bindings ?headers ?values))
    (<-- (%function-bindings ?static ?scope nil nil nil) !)
    (<- (%function-bindings ?static ?scope
                            ((:node :function-binding ?span ((:name . ?identifier) (:clauses . ?clauses))) . ?bindings)
                            ((:fh ?identifier ?name ?host ?type) . ?headers)
                            ((:fb ?name ?host ?type ?semantic-clauses) . ?semantic-bindings))
        (%function-clauses ?static ?scope ?clauses ?type ?semantic-clauses)
        (%function-bindings ?static ?scope ?bindings ?headers ?semantic-bindings))
    (<-- (%function-clauses ?static ?scope nil ?type nil) !)
    (<- (%function-clauses ?static ?scope
                           ((:node :function-clause ?span ((:name . ?name) (:op-p . ?op) (:arguments . ?arguments) (:result-type . ?annotation) (:expression . ?expression) (:infix-head-p . ?infix))) . ?clauses)
                           ?type ((:fc ?patterns ?semantic-expression) . ?semantic-clauses))
        (or (-> (= ?infix t)
                (%infix-function-argument-types ?arguments ?type ?types ?result))
            (%function-argument-types ?arguments ?type ?types ?result))
        (%function-patterns ?static ?scope ?arguments ?types ?infix ?span ?patterns ?binders)
        (%binders-environment ?binders ?values)
        (%extend-values ?static ?values ?local)
        (%expression ?local ?scope ?expression ?semantic-expression)
        (%type ?semantic-expression ?expression-type)
        (type-unify ?expression-type ?result)
        (or (-> (= ?annotation nil) true)
            (and (%syntactic-type ?static ?scope ?annotation ?annotated)
                 (type-unify ?annotated ?result)))
        (%function-clauses ?static ?scope ?clauses ?type ?semantic-clauses))
    (<-- (%infix-function-argument-types (?left ?right . ?extra) (=> ?pair-type ?rest-type)
                                         (?left-type ?right-type . ?extra-types) ?result)
        (record-type ((field "1" ?left-type) (field "2" ?right-type)) :closed ?pair-type)
        (%function-argument-types ?extra ?rest-type ?extra-types ?result) !)
    (<-- (%function-argument-types nil ?result nil ?result) !)
    (<- (%function-argument-types (?argument . ?arguments) (=> ?type ?rest-type) (?type . ?types) ?result)
        (%function-argument-types ?arguments ?rest-type ?types ?result) !)
    (<- (%function-argument-types (?argument . ?arguments) ?function-type (?type . ?types) ?result)
        (type-unify ?function-type (=> ?type ?rest-type))
        (%function-argument-types ?arguments ?rest-type ?types ?result))
    (<- (%function-argument-types ?other ?type ?types ?result)
        (lisp (%fail nil (format nil "Function clauses have inconsistent argument/result types: ~S at ~S." ?other ?type))))
    (<-- (%function-patterns ?static ?scope (?left ?right . ?arguments) (?left-type ?right-type . ?types) t ?span
                             (?pair . ?patterns) ?binders)
        ! (%pattern ?static ?scope ?left ?left-type ?left-pattern)
        (%pattern ?static ?scope ?right ?right-type ?right-pattern)
        (record-type ((field "1" ?left-type) (field "2" ?right-type)) :closed ?pair-type)
        (%pattern-bindings ?left-pattern ?left-bindings)
        (%pattern-bindings ?right-pattern ?right-bindings)
        (%append ?left-bindings ?right-bindings ?pair-bindings)
        (= ?pair (:p-record ?span ?pair-type ?pair-bindings
                            ((:p-row "1" ?left-pattern) (:p-row "2" ?right-pattern))))
        (%function-patterns ?static ?scope ?arguments ?types nil ?span ?patterns ?rest)
        (%append ?pair-bindings ?rest ?binders)
        (%unique-bindings ?binders ?span))
    (<- (%function-patterns ?static ?scope nil nil ?infix ?span nil nil) !)
    (<- (%function-patterns ?static ?scope (?argument . ?arguments) (?type . ?types) nil ?span
                            (?pattern . ?patterns) ?binders)
        (%pattern ?static ?scope ?argument ?type ?pattern)
        (%function-patterns ?static ?scope ?arguments ?types nil ?span ?patterns ?rest)
        (%pattern-bindings ?pattern ?first)
        (%append ?first ?rest ?binders))
    (<-- (%function-schemes nil ?environment nil) !)
    (<- (%function-schemes ((:fb ?name ?host ?type ?clauses) . ?bindings) ?environment
                           ((:value (?name) ?scheme ?host :variable) . ?values))
        (generalize-type ?type ?environment nil :nonexpansive ?scheme)
        (%function-schemes ?bindings ?environment ?values))

    database))

(defun %install-elaboration-datatype-predicates (database)
  (let ((*database* database))
    ;;; Type aliases and generative datatypes, including WITHtypes.
    (<-- (%type-bindings ?static ?scope nil nil) !)
    (<- (%type-bindings ?static ?scope
                        ((:node :type-binding ?span ((:variables . ?variables) (:name . ?name) (:type . ?syntax))) . ?bindings)
                        ((:tycon (?spelling) (type-function ?parameters ?body)) . ?types))
        (lisp ?spelling (%name ?name))
        (%seed-scoped-type-variables ?syntax ?scope ?variables ?local)
        (%declared-variable-types ?variables ?local ?parameters)
        (%syntactic-type ?static ?local ?syntax ?body)
        (%require-type-function-scope ?parameters ?body ?scope ?span
                                      "A type abbreviation contains a free type variable.")
        (%type-bindings ?static ?scope ?bindings ?types))
    (<-- (%datatype-declaration ?static ?outer ?bindings ?withtypes ?next ?constructors)
        (%datatype-headers ?bindings ?headers ?type-entries)
        (%extend-types ?static ?type-entries ?header-static)
        (%seed-type-variables ?withtypes ?outer ?withtype-scope)
        (%type-bindings ?header-static ?withtype-scope ?withtypes ?aliases)
        (%extend-types ?header-static ?aliases ?constructor-static)
        (%datatype-bodies ?constructor-static ?outer ?bindings ?headers ?constructors ?values)
        (%finish-datatype-equality ?headers ?values ?aliases
                                   ?final-headers ?final-values ?final-aliases)
        (%extend-values ?header-static ?final-values ?valued)
        (%extend-types ?valued ?final-aliases ?aliased)
        (%extend-types ?aliased ?final-headers ?next))
    (<-- (%datatype-headers nil nil nil) !)
    (<- (%datatype-headers ((:node :datatype-binding ?span ((:variables . ?variables) (:name . ?name) (:constructors . ?constructors))) . ?bindings)
                            ((:dh ?name ?type-name) . ?headers)
                            ((:tycon (?spelling) ?type-name) . ?rest))
        (lisp ?spelling (%name ?name))
        (lisp ?identity (%fresh-identity ?spelling))
        (%datatype-headers ?bindings ?headers ?rest)
        (%datatype-arity ?variables ?arity)
        (= ?type-name (type-name ?spelling ?identity ?arity :equality :flexible)))
    (<-- (%datatype-arity nil 0) !)
    (<- (%datatype-arity (?variable . ?variables) ?arity)
        (%datatype-arity ?variables ?rest) (is ?arity (+ ?rest 1)))
    (<-- (%datatype-bodies ?static ?outer nil nil nil nil) !)
    (<- (%datatype-bodies ?static ?outer
                          ((:node :datatype-binding ?span ((:variables . ?variables) (:name . ?name) (:constructors . ?bindings))) . ?datatypes)
                          ((:dh ?name ?type-name) . ?headers) ?constructors ?values)
        (%seed-scoped-type-variables ?bindings ?outer ?variables ?scope)
        (%declared-variable-types ?variables ?scope ?parameters)
        (%datatype-result ?type-name ?parameters ?result)
        (%constructor-bindings ?static ?scope ?outer ?bindings ?type-name ?parameters ?result ?first ?first-values)
        (%datatype-bodies ?static ?outer ?datatypes ?headers ?rest ?rest-values)
        (%append ?first ?rest ?constructors)
        (%append ?first-values ?rest-values ?values))
    (<-- (%datatype-result (type-name ?spelling ?identity ?arity ?equality ?flexibility) ?parameters
                           (@ (type-name ?spelling ?identity ?arity ?equality ?flexibility) ?parameters)))

    ;;; Equality attributes are the least fixed point required by the datatype
    ;;; group.  A function payload or a constructor of an already non-equality
    ;;; member propagates non-equality through mutually recursive constructors;
    ;;; reference payloads remain equality-admissible for every referent.
    (<-- (%finish-datatype-equality ?headers ?values ?aliases
                                    ?final-headers ?final-values ?final-aliases)
        (%non-equality-closure ?headers ?values nil ?forbidden)
        (%header-realizations ?headers ?forbidden ?maps)
        (%realize-datatype-headers ?headers ?forbidden ?final-headers)
        (%realize-datatype-values ?values ?maps ?final-values)
        (%realize-withtype-aliases ?aliases ?maps ?final-aliases))
    (<-- (%non-equality-closure ?headers ?values ?in ?out)
        (%new-non-equality-headers ?headers ?values ?in ?new)
        (or (-> (= ?new nil) (= ?out ?in))
            (and (%append ?new ?in ?next)
                 (%non-equality-closure ?headers ?values ?next ?out))))
    (<-- (%new-non-equality-headers nil ?values ?forbidden nil) !)
    (<- (%new-non-equality-headers ((:dh ?ast (type-name ?spelling ?identity ?arity ?equality ?flexibility)) . ?headers)
                                   ?values ?forbidden ?new)
        (or (-> (%identity-member ?identity ?forbidden)
                (= ?new ?rest))
            (or (-> (%target-has-non-equality-payload ?identity ?values ?forbidden)
                    (= ?new (?identity . ?rest)))
                (= ?new ?rest)))
        (%new-non-equality-headers ?headers ?values ?forbidden ?rest))
    (<-- (%identity-member ?identity (?other . ?rest)) (== ?identity ?other) !)
    (<- (%identity-member ?identity (?other . ?rest)) (%identity-member ?identity ?rest))
    (<-- (%target-has-non-equality-payload ?identity ?values ?forbidden)
        (%target-constructor-payload ?identity ?values ?payload)
        (%payload-non-equality ?payload ?forbidden))
    (<-- (%target-constructor-payload ?target
             ((:value ?path (scheme ?quantified (=> ?payload ?result)) ?host
                       (:constructor ?identity 1 nil)) . ?values) ?payload)
        (%type-name-identity ?result ?target) !)
    (<- (%target-constructor-payload ?target (?entry . ?values) ?payload)
        (%target-constructor-payload ?target ?values ?payload))
    (<-- (%payload-non-equality (=> ?domain ?range) ?forbidden) !)
    (<- (%payload-non-equality (type-var ?cell ?kind ?equality) ?forbidden)
        (nonvar ?cell) ! (%payload-non-equality ?cell ?forbidden))
    (<- (%payload-non-equality (@ (type-name ?spelling ?identity ?arity ?equality ?flexibility) ?arguments)
                               ?forbidden)
        (lispp (eq ?identity +reference-identity+)) ! (fail))
    (<- (%payload-non-equality (@ (type-name ?spelling ?identity ?arity :non-equality ?flexibility) ?arguments)
                               ?forbidden) !)
    (<- (%payload-non-equality (@ (type-name ?spelling ?identity ?arity ?equality ?flexibility) ?arguments)
                               ?forbidden)
        (%identity-member ?identity ?forbidden) !)
    (<- (%payload-non-equality (@ ?name ?arguments) ?forbidden)
        ! (%payload-list-non-equality ?arguments ?forbidden))
    (<- (%payload-non-equality (record ?fields ?tail) ?forbidden)
        ! (%payload-fields-non-equality ?fields ?forbidden))
    (<-- (%payload-list-non-equality (?type . ?types) ?forbidden)
        (%payload-non-equality ?type ?forbidden))
    (<- (%payload-list-non-equality (?type . ?types) ?forbidden)
        (%payload-list-non-equality ?types ?forbidden))
    (<-- (%payload-fields-non-equality ((field ?label ?type) . ?fields) ?forbidden)
        (%payload-non-equality ?type ?forbidden))
    (<- (%payload-fields-non-equality (?field . ?fields) ?forbidden)
        (%payload-fields-non-equality ?fields ?forbidden))
    (<-- (%header-realizations nil ?forbidden nil) !)
    (<- (%header-realizations ((:dh ?ast ?name) . ?headers) ?forbidden ?maps)
        (%realize-header-name ?name ?forbidden ?new)
        (or (-> (== ?name ?new) (= ?maps ?rest))
            (= ?maps ((name-map ?name ?new) . ?rest)))
        (%header-realizations ?headers ?forbidden ?rest))
    (<-- (%realize-header-name (type-name ?spelling ?identity ?arity ?equality ?flexibility)
                               ?forbidden ?new)
        (or (-> (%identity-member ?identity ?forbidden)
                (= ?new (type-name ?spelling ?identity ?arity :non-equality ?flexibility)))
            (= ?new (type-name ?spelling ?identity ?arity ?equality ?flexibility))))
    (<-- (%realize-datatype-headers nil ?forbidden nil) !)
    (<- (%realize-datatype-headers ((:dh ?ast ?name) . ?headers) ?forbidden
                                   ((:tycon (?spelling) ?new) . ?rest))
        (%realize-header-name ?name ?forbidden ?new)
        (= ?name (type-name ?spelling ?identity ?arity ?equality ?flexibility))
        (%realize-datatype-headers ?headers ?forbidden ?rest))
    (<-- (%realize-datatype-values nil ?maps nil) !)
    (<- (%realize-datatype-values ((:value ?path (scheme ?quantified ?body) ?host ?status) . ?values) ?maps
                                  ((:value ?path (scheme ?quantified ?new-body) ?host ?status) . ?rest))
        (realize-type ?body (realization ?maps) ?new-body)
        (%realize-datatype-values ?values ?maps ?rest))
    (<-- (%realize-withtype-aliases nil ?maps nil) !)
    (<- (%realize-withtype-aliases ((:tycon ?path (type-function ?parameters ?body)) . ?aliases) ?maps
                                   ((:tycon ?path (type-function ?parameters ?new-body)) . ?rest))
        (realize-type ?body (realization ?maps) ?new-body)
        (%realize-withtype-aliases ?aliases ?maps ?rest))
    (<- (%realize-withtype-aliases (?entry . ?aliases) ?maps (?entry . ?rest))
        (%realize-withtype-aliases ?aliases ?maps ?rest))

    (<-- (%constructor-bindings ?static ?scope ?outer nil ?type-name ?parameters ?result nil nil) !)
    (<- (%constructor-bindings ?static ?scope ?outer
                               ((:node :constructor-binding ?span ((:name . ?name) (:op-p . ?op) (:type . nil))) . ?bindings)
                               ?type-name ?parameters ?result
                               ((:dc ?spelling ?host ?identity 0 nil) . ?constructors)
                               ((:value (?spelling) (scheme ?parameters ?result) ?host
                                        (:constructor ?identity 0 nil)) . ?values))
        (lisp ?spelling (%name ?name))
        (lisp ?host (%fresh-binding ?spelling))
        (lisp ?identity (%fresh-identity ?spelling))
        (%constructor-bindings ?static ?scope ?outer ?bindings ?type-name ?parameters ?result ?constructors ?values))
    (<- (%constructor-bindings ?static ?scope ?outer
                               ((:node :constructor-binding ?span ((:name . ?name) (:op-p . ?op) (:type . ?syntax))) . ?bindings)
                               ?type-name ?parameters ?result
                               ((:dc ?spelling ?host ?identity 1 nil) . ?constructors)
                               ((:value (?spelling) (scheme ?parameters (=> ?payload ?result)) ?host
                                        (:constructor ?identity 1 nil)) . ?values))
        (lisp ?spelling (%name ?name))
        (lisp ?host (%fresh-binding ?spelling))
        (lisp ?identity (%fresh-identity ?spelling))
        (%syntactic-type ?static ?scope ?syntax ?payload)
        (%require-type-function-scope ?parameters ?payload ?outer ?span
                                      "A datatype constructor payload contains a free type variable.")
        (%constructor-bindings ?static ?scope ?outer ?bindings ?type-name ?parameters ?result ?constructors ?values))

    ;;; Replication preserves type and constructor identities.  Only source
    ;;; constructors whose scheme constructs the replicated type are copied.
    (<-- (%datatype-replication ?static ?outer ?name ?source ?span ?types ?copies)
        (lisp ?spelling (%name ?name))
        (lisp ?source-path (%path ?source))
        (%require-type ?static ?source-path
                       (type-name ?old-spelling ?identity ?arity ?equality ?flexibility) ?span)
        (= ?new-name (type-name ?spelling ?identity ?arity ?equality ?flexibility))
        (= ?types ((:tycon (?spelling) ?new-name)))
        (%replicate-constructors ?static ?source-path ?identity ?new-name ?copies))
    (<- (%datatype-replication ?static ?outer ?name ?source ?span ?types nil)
        (lisp ?spelling (%name ?name))
        (lisp ?source-path (%path ?source))
        (%require-type ?static ?source-path (type-function ?parameters ?body) ?span)
        (= ?types ((:tycon (?spelling) (type-function ?parameters ?body)))))
    (<-- (%static-values (:static ?values ?types) ?values))
    (<-- (%replicate-constructors ?static ?source ?identity ?new-name ?copies)
        (%static-values ?static ?values)
        (%replicate-value-entries ?values ?identity ?new-name ?copies))
    (<-- (%replicate-value-entries nil ?identity ?new-name nil) !)
    (<- (%replicate-value-entries
         ((:value ?path ?scheme ?source-host (:constructor ?constructor ?arity nil)) . ?entries)
         ?identity ?new-name ?copies)
        ! (%scheme-type-name-identity ?scheme ?constructed-identity)
        (or (-> (== ?constructed-identity ?identity)
                (and (lisp ?name (%last-path-name ?path))
                     (and (lisp ?host (%fresh-binding ?name))
                          (= ?copies ((:rc ?name ?host ?source-host ?scheme
                                           (:constructor ?constructor ?arity nil)) . ?rest)))))
            (= ?copies ?rest))
        (%replicate-value-entries ?entries ?identity ?new-name ?rest))
    (<- (%replicate-value-entries (?entry . ?entries) ?identity ?new-name ?copies)
        (%replicate-value-entries ?entries ?identity ?new-name ?copies))
    (<-- (%scheme-type-name-identity (scheme ?quantified (=> ?domain ?range)) ?identity)
        ! (%type-name-identity ?range ?identity))
    (<- (%scheme-type-name-identity (scheme ?quantified ?type) ?identity)
        (%type-name-identity ?type ?identity))
    (<-- (%type-name-identity (@ (type-name ?spelling ?identity ?arity ?equality ?flexibility) ?arguments) ?identity))
    (<-- (%replication-values nil nil) !)
    (<- (%replication-values ((:rc ?name ?host ?source ?scheme ?status) . ?copies)
                             ((:value (?name) ?scheme ?host ?status) . ?values))
        (%replication-values ?copies ?values))

    ;;; ABSTYPE exports body values but not its generative constructor values.
    (<-- (%abstype-export-types (:static ?original-values ?original-types)
                                (:static ?datatype-values ?datatype-types) ?types)
        (%native-environment-prefix ?datatype-types ?original-types ?new-types)
        (%append ?new-types ?original-types ?types))
    (<-- (%body-values (:static ?values ?types) ?values))
    (<-- (%abstype-visible-values ?original ?body-static ?datatype-asts ?visible)
        (%body-values ?body-static ?values)
        (%abstype-type-identities ?datatype-asts ?body-static nil ?identities)
        (%remove-datatype-constructors ?values ?identities ?visible))
    (<-- (%abstype-type-identities nil ?static ?in ?in) !)
    (<- (%abstype-type-identities ((:node :datatype-binding ?span ((:variables . ?variables) (:name . ?name) (:constructors . ?constructors))) . ?datatypes) ?static ?in ?out)
        (lisp ?spelling (%name ?name))
        (%lookup-type ?static (?spelling) (type-name ?actual ?identity ?arity ?equality ?flexibility))
        (%abstype-type-identities ?datatypes ?static (?identity . ?in) ?out))
    (<-- (%remove-datatype-constructors nil ?names nil) !)
    (<- (%remove-datatype-constructors ((:value ?path ?scheme ?host (:constructor ?identity ?arity nil)) . ?entries) ?names ?visible)
        ! (%scheme-type-name-identity ?scheme ?datatype-identity)
        (or (-> (%identity-member ?datatype-identity ?names) (= ?visible ?rest))
            (= ?visible ((:value ?path ?scheme ?host (:constructor ?identity ?arity nil)) . ?rest)))
        (%remove-datatype-constructors ?entries ?names ?rest))
    (<- (%remove-datatype-constructors (?entry . ?entries) ?names (?entry . ?visible))
        (%remove-datatype-constructors ?entries ?names ?visible))
    (<-- (%scheme-type-spelling (scheme ?quantified (=> ?domain ?range)) ?spelling)
        ! (%type-spelling ?range ?spelling))
    (<- (%scheme-type-spelling (scheme ?quantified ?type) ?spelling)
        (%type-spelling ?type ?spelling))
    (<-- (%type-spelling (@ (type-name ?spelling ?identity ?arity ?equality ?flexibility) ?arguments) ?spelling))
    (<-- (%name-member ?name (?name . ?rest)) !)
    (<- (%name-member ?name (?other . ?rest)) (%name-member ?name ?rest))
    (<-- (%datatype-host-symbols nil nil) !)
    (<- (%datatype-host-symbols ((:dc ?name ?host ?identity ?arity ?exception) . ?constructors) (?host . ?hosts))
        (%datatype-host-symbols ?constructors ?hosts))

    database))

(defun %install-elaboration-exception-predicates (database)
  (let ((*database* database))
    ;;; Generative exceptions and exception aliases.
    (<-- (%exception-bindings ?static ?scope ?outer nil nil nil nil) !)
    (<- (%exception-bindings ?static ?scope ?outer
                             ((:node :exception-binding ?span ((:name . ?name) (:op-p . ?op) (:type . nil) (:alias . nil) (:alias-op-p . ?aop))) . ?bindings)
                             ((:dc ?spelling ?host ?identity 0 t) . ?constructors) ?aliases
                             ((:value (?spelling) (scheme nil ?exn) ?host (:constructor ?identity 0 t)) . ?values))
        (lisp ?spelling (%name ?name))
        (lisp ?host (%fresh-binding ?spelling))
        (lisp ?identity (%fresh-identity ?spelling))
        (%named-type ?static "exn" ?span ?exn)
        (%exception-bindings ?static ?scope ?outer ?bindings ?constructors ?aliases ?values))
    (<- (%exception-bindings ?static ?scope ?outer
                             ((:node :exception-binding ?span ((:name . ?name) (:op-p . ?op) (:type . ?syntax) (:alias . nil) (:alias-op-p . ?aop))) . ?bindings)
                             ((:dc ?spelling ?host ?identity 1 t) . ?constructors) ?aliases
                             ((:value (?spelling) (scheme nil (=> ?payload ?exn)) ?host (:constructor ?identity 1 t)) . ?values))
        (lisp ?spelling (%name ?name))
        (lisp ?host (%fresh-binding ?spelling))
        (lisp ?identity (%fresh-identity ?spelling))
        (%named-type ?static "exn" ?span ?exn)
        (%syntactic-type ?static ?scope ?syntax ?payload)
        (%require-type-function-scope nil ?payload ?outer ?span
                                      "An exception payload contains a free type variable.")
        (%exception-bindings ?static ?scope ?outer ?bindings ?constructors ?aliases ?values))
    (<- (%exception-bindings ?static ?scope ?outer
                             ((:node :exception-binding ?span ((:name . ?name) (:op-p . ?op) (:type . nil) (:alias . ?alias) (:alias-op-p . ?aop))) . ?bindings)
                             ?constructors
                             ((:ea ?spelling ?host ?source-host) . ?aliases)
                             ((:value (?spelling) ?scheme ?host ?status) . ?values))
        (lisp ?spelling (%name ?name))
        (lisp ?host (%fresh-binding ?spelling))
        (lisp ?path (%path ?alias))
        (%require-value ?static ?path (:value ?path ?scheme ?source-host ?status) ?span)
        (%require-exception-status ?status ?span)
        (%exception-bindings ?static ?scope ?outer ?bindings ?constructors ?aliases ?values))
    (<-- (%require-exception-status (:constructor ?identity ?arity t) ?span) !)
    (<- (%require-exception-status ?status ?span)
        (lisp (%fail ?span "An exception alias must denote an exception constructor.")))

    ;;; OPEN imports existing bindings (and their identities), never copies of
    ;;; runtime values.  Each successive structure path shadows earlier imports.
    (<-- (%open-identifiers ?basis nil ?static ?static) !)
    (<- (%open-identifiers ?basis (?identifier . ?identifiers) ?in ?out)
        (lisp ?prefix (%path ?identifier))
        (%open-one ?basis ?prefix ?in ?next)
        (%open-identifiers ?basis ?identifiers ?next ?out))
    (<-- (%open-one (:static ?all-values ?all-types) ?prefix (:static ?values ?types)
                    (:static ?new-values ?new-types))
        (%open-values ?all-values ?prefix ?imported-values)
        (%append ?imported-values ?values ?new-values)
        (%open-types ?all-types ?prefix ?imported-types)
        (%append ?imported-types ?types ?new-types))
    (<-- (%open-values nil ?prefix nil) !)
    (<- (%open-values ((:value ?path ?scheme ?host ?status) . ?entries) ?prefix ?values)
        (or (-> (and (lisp ?suffix (%prefix-suffix ?prefix ?path))
                     (lispp (consp ?suffix)))
                (= ?values ((:value ?suffix ?scheme ?host ?status) . ?rest)))
            (= ?values ?rest))
        (%open-values ?entries ?prefix ?rest))
    (<-- (%open-types nil ?prefix nil) !)
    (<- (%open-types ((:tycon ?path ?definition) . ?entries) ?prefix ?types)
        (or (-> (and (lisp ?suffix (%prefix-suffix ?prefix ?path))
                     (lispp (consp ?suffix)))
                (= ?types ((:tycon ?suffix ?definition) . ?rest)))
            (= ?types ?rest))
        (%open-types ?entries ?prefix ?rest))

    ;;; Public DCG entries for declaration lists and complete programs.
    (--> (elaborate-declarations ?static ?asts ?out ?semantic)
         (do (%declaration-list ?static nil ?asts ?out ?semantic)))
    (--> (elaborate-program ?static (:node :declaration-sequence ?span ((:declarations . ?declarations))) ?out ?semantic)
         (do (%declaration-list ?static nil ?declarations ?out ?items)
             (= ?semantic (:program-items ?items nil))))
    (--> (elaborate-program ?static (:node :program ?span ((:topdeclarations . ?topdeclarations))) ?out ?semantic)
         (do (%program-topdeclarations ?static ?topdeclarations ?out ?items ?result)
             (= ?semantic (:program-items ?items ?result))))
    (<-- (%program-topdeclarations ?static nil ?static nil nil) !)
    (<- (%program-topdeclarations ?static (?top . ?tops) ?out ?items ?result)
        (%static-weak-type-variables ?static ?weak)
        (or (-> (= ?weak nil) true)
            (%static-free-type-names ?static ?visible-names))
        (%program-topdeclaration ?static ?top ?next ?first ?first-result)
        (%program-topdeclarations ?next ?tops ?out ?rest ?rest-result)
        (lisp ?span (ast-node-span ?top))
        (or (-> (= ?weak nil) true)
            (and (%weak-type-scope ?weak ?resolved-names)
                 (or (-> (%type-names-subset ?resolved-names ?visible-names) true)
                     (lisp (%fail ?span "An older monomorphic type variable acquired a later datatype identity.")))))
        (%append ?first ?rest ?items)
        (or (-> (= ?rest-result nil) (= ?result ?first-result))
            (= ?result ?rest-result)))
    (<-- (%program-topdeclaration ?static (:node :topdec-structure ?span ((:declarations . ?declarations))) ?next ?items nil)
        (%declaration-list ?static nil ?declarations ?next ?items))
    (<- (%program-topdeclaration ?static (:node :topdec-sequence ?span ((:topdeclarations . ?tops))) ?next ?items ?result)
        (%program-topdeclarations ?static ?tops ?next ?items ?result))
    (<- (%program-topdeclaration ?static (:node :toplevel-expression ?span ((:expression . ?expression) (:binding-name . ?binding-name))) ?next
                                  ((:d-expression ?name ?host ?semantic)) ?semantic)
        (%seed-type-variables ?expression nil ?scope)
        (%expression ?static ?scope ?expression ?semantic)
        (%resolve-overloads ?semantic ?static)
        (%type ?semantic ?type)
        (lisp ?name (%name ?binding-name))
        (lisp ?host (%fresh-binding ?name))
        (%static-type-environment ?static ?environment)
        (or (-> (%nonexpansive ?semantic) (= ?eligibility :nonexpansive))
            (= ?eligibility :value-restriction))
        (generalize-type ?type ?environment nil ?eligibility ?scheme)
        (%extend-values ?static ((:value (?name) ?scheme ?host :variable)) ?next))
    database))

(defun install-elaboration-predicates (database)
  "Install elaboration beside, not instead of, the supplied grammar/type DB."
  (%install-elaboration-persistent-predicates database)
  (%install-elaboration-expression-predicates database)
  (%install-elaboration-pattern-predicates database)
  (%install-elaboration-static-predicates database)
  (%install-elaboration-declaration-predicates database)
  (%install-elaboration-value-predicates database)
  (%install-elaboration-datatype-predicates database)
  (%install-elaboration-exception-predicates database)
  database)

(defun %last-path-name (path)
  (car (last path)))

(defparameter *core-elaboration-database* (make-core-elaboration-database)
  "Isolated native Prolog DB with type and Core elaboration relations.")
