;;; Native SML '97 module elaboration and Curry emission.
;;; Module scope, specifications, realization and generativity are Prolog
;;; relations over the same native terms as the Core elaborator.  Host code is
;;; restricted to fresh identities, source diagnostics and persistent-runtime
;;; adapters; generated programs contain only compiled Curry operations.

(uiop:define-package #:ooparts/sml/modules
  (:use #:cl)
  (:import-from #:ooparts/prolog #:*database* #:<- #:<-- #:-->)
  (:import-from #:ooparts/sml/syntax
    #:identifier-path #:identifier-name #:ast-node-span)
  (:import-from #:ooparts/sml/types
    #:type-unify #:instantiate-type-scheme #:generalize-type
    #:free-type-variables #:ensure-equality #:apply-type-function
    #:substitute-type-variables
    #:type-name #:type-var #:scheme #:type-function #:type-env #:name-map #:variable-map
    #:=> #:@ #:record #:field)
  (:import-from #:ooparts/sml/elaborate #:sml-elaboration-error)
  (:import-from #:ooparts/sml/emit #:install-emitter-predicates)
  (:import-from #:ooparts/curry #:lambda/c)
  (:import-from #:ooparts/sml/runtime
    #:+unit+ #:make-sml-module #:project-sml-module)
  (:export
    #:install-module-predicates #:module-program #:emit-module-program
    #:thaw-module-context #:freeze-module-context #:module-context-static))
(in-package #:ooparts/sml/modules)

(defun %module-fail (span message)
  (error 'sml-elaboration-error :span span :kind :module :message message))

(defun %fresh-module-symbol (prefix)
  (ooparts/sml/elaborate::%fresh-symbol prefix))

(defun %fresh-module-root (&optional (name "S"))
  (%fresh-module-symbol (format nil "M.~A" name)))

(defun %fresh-module-identity (&optional (name "t"))
  (ooparts/sml/elaborate::%fresh-identity name))

(defvar *module-emission-input*)
(defun %module-emission-input ()
  ;; COMPILE-SOURCE binds this only after elaboration, realization and final
  ;; compaction are complete.  The second WAM receives that exact native graph;
  ;; no view lookup, generation or template realization is deferred to it.
  (unless (boundp '*module-emission-input*)
    (error "No completed module program was supplied for native emission."))
  *module-emission-input*)

(defun %path (identifier)
  (identifier-path identifier))

(defun %name (identifier)
  (identifier-name identifier))

(defun %module-emission-answer (name answers)
  (let ((binding (and answers (assoc name (first answers)))))
    (unless binding
      (error "Native module emission omitted ~S." name))
    (cdr binding)))

(defun %query-module-item-interface (item lexicals collected database)
  (let* ((provided (ooparts/sml/elaborate::%internal-query-variable))
         (first-updates (ooparts/sml/elaborate::%internal-query-variable)))
    (let ((ooparts/sml/modules::*module-emission-input* item))
      (or (ooparts/prolog:query
           (list
            (list 'ooparts/sml/modules::%provided-module-emission-input provided)
            (list 'ooparts/sml/modules::%module-item-interface
                  provided lexicals '?next first-updates)
            (list 'ooparts/sml/elaborate::%append
                  collected first-updates '?next-collected))
           :limit 1 :database database)
          (error "Native module item interface failed.")))))

(defun %query-module-declaration (item lexicals next database)
  (let* ((provided (ooparts/sml/elaborate::%internal-query-variable))
         (answers
           (let ((ooparts/sml/modules::*module-emission-input* item))
             (ooparts/prolog:query
              (list
               (list 'ooparts/sml/modules::%provided-module-emission-input provided)
               (list 'ooparts/sml/modules::%emit-module-declaration
                     provided lexicals next '?form))
              :limit 1 :database database))))
    answers))

(defun %module-program-result (items database)
  (let ((provided (ooparts/sml/elaborate::%internal-query-variable))
        ;; The established relation recurses through every earlier item until
        ;; exactly this final top-level cell.  Do not reify that unused prefix
        ;; into a small result query; ITEMS itself remains the full input.
        (ooparts/sml/modules::*module-emission-input* (last items)))
    (let ((answers
            (ooparts/prolog:query
             (list
              (list 'ooparts/sml/modules::%provided-module-emission-input provided)
              (list 'ooparts/sml/modules::%module-result-host provided '?result))
             :limit 1 :database database)))
      (and answers (cdr (assoc '?result (first answers)))))))

(defun %module-terminal (lexicals result collected database)
  (let ((answers (ooparts/prolog:query
                  (list (list 'ooparts/sml/modules::%emit-module-items
                              nil lexicals result collected collected '?body))
                  :limit 1 :database database)))
    (and answers (cdr (assoc '?body (first answers))))))

(defun %splice-module-continuation (template marker continuation)
  "Fill the explicit continuation MARKER without changing source objects.
Only the fresh template connective structure is rebuilt when necessary.
Original sharing and cycles are honored; no raw SML term is evaluated."
  (let ((seen (make-hash-table :test #'eq))
        (visiting (make-symbol "VISITING"))
        (found 0))
    (labels ((walk (object)
               (cond
                 ((eq object marker)
                  (incf found)
                  continuation)
                 ((not (consp object)) object)
                 ((gethash object seen)
                  (multiple-value-bind (entry present) (gethash object seen)
                    (declare (ignore present))
                    (if (eq entry visiting) object entry)))
                 (t
                  (setf (gethash object seen) visiting)
                  (let ((left (walk (car object)))
                        (right (walk (cdr object))))
                    (let ((result (if (and (eq left (car object))
                                           (eq right (cdr object)))
                                      object
                                      (cons left right))))
                      (setf (gethash object seen) result)
                      result))))))
      (let ((result (walk template)))
        (unless (= found 1)
          (error "Expected exactly one module continuation marker, found ~D."
                 found))
        result))))

(defun %splice-emitted-module-continuation (template marker continuation)
  "Compose one actual %QUERY-MODULE-DECLARATION result without scanning its RHS.
The declaration relations receive MARKER only as their final Core/module body:
identity declarations return it directly, LET wrappers retain it in their one
body, and value-bindings retain it in the success branch of their Bind test.
Those relations never pass the private marker to RHS, matcher, module-view or
rule-body emission.  Consequently their returned forms need only this
one-hole spine rebuilt.  Any other shape, including a repeated spine carrier,
uses the complete graph-validating generic splicer instead."
  (let ((path (make-hash-table :test #'eq)))
    (labels ((fallback ()
               (return-from %splice-emitted-module-continuation
                 (%splice-module-continuation template marker continuation)))
             (let-body (object)
               (when (and (consp object) (eq (car object) 'let)
                          (consp (cdr object)) (consp (cddr object)))
                 (cond
                   ((null (cdddr object))
                    (values (third object) 3))
                   ((and (consp (cdddr object)) (null (cddddr object)))
                    (values (fourth object) 4))
                   (t (values nil nil)))))
             (bind-failure-p (object)
               (and (consp object)
                    (eq (car object) 'ooparts/sml/runtime:raise-sml)
                    (consp (cdr object))
                    (eq (cadr object) 'ooparts/sml/runtime:+bind-exception+)
                    (null (cddr object))))
             (value-test-p (object)
               (and (consp object) (eq (car object) 'eq)
                    (consp (cdr object)) (consp (cddr object))
                    (null (cdddr object))
                    (symbolp (cadr object))
                    (eq (caddr object) 'ooparts/sml/runtime:+no-match+)))
             (value-if (object)
               (when (and (consp object) (eq (car object) 'if)
                          (consp (cdr object)) (consp (cddr object))
                          (consp (cdddr object)) (null (cddddr object))
                          (value-test-p (cadr object))
                          (bind-failure-p (caddr object)))
                 (fourth object)))
             (walk (object)
               (cond
                 ((eq object marker) continuation)
                 ((not (consp object)) (fallback))
                 ((gethash object path) (fallback))
                 (t
                  (multiple-value-bind (body let-length) (let-body object)
                    (let ((success (and (not let-length) (value-if object))))
                      (cond
                        (let-length
                         (setf (gethash object path) t)
                         (let ((inner (walk body)))
                           (remhash object path)
                           (if (eq inner body)
                               object
                               (if (= let-length 3)
                                   (list (first object) (second object) inner)
                                   (list (first object) (second object)
                                         (third object) inner)))))
                        (success
                         (setf (gethash object path) t)
                         (let ((inner (walk success)))
                           (remhash object path)
                           (if (eq inner success)
                               object
                               (list (first object) (second object)
                                     (third object) inner))))
                        (t (fallback)))))))))
      (walk template))))

(defun %emit-module-program-parts (items database)
  "Emit M-ITEMS at their real declaration continuations.
Interface and update discovery stays forward, declarations finish in reverse
source order, and each query sees only one item and its lexical context.
Previously assembled suffixes never pass through another query."
  (let ((result-host (%module-program-result items database))
        (lexicals nil)
        (collected nil)
        (descriptions nil)
        (marker (make-symbol "%EMISSION-CONTINUATION")))
    (dolist (item items)
      (push (list item lexicals) descriptions)
      (let ((answers (%query-module-item-interface
                      item lexicals collected database)))
        (setf lexicals (%module-emission-answer '?next answers)
              collected (%module-emission-answer '?next-collected answers))))
    (let ((body (%module-terminal lexicals result-host collected database)))
      (dolist (entry descriptions body)
        (let ((answers (%query-module-declaration
                        (first entry) (second entry) marker database)))
          (setf body
                (%splice-emitted-module-continuation
                 (%module-emission-answer '?form answers)
                 marker body)))))))


(defun %emit-module-program-parts-outer (items database)
  (list 'lambda/c (list 'ooparts/sml/emit::%environment)
        (%emit-module-program-parts items database)))

(defun install-module-predicates (database)
  (let ((*database* database))

    ;;; Persistent contexts and immutable structure views.
    ;;;
    ;;; (:module-context CORE STRUCTURES SIGNATURES FUNCTORS)
    ;;; CORE contains only unqualified/opened Core declarations.  The public
    ;;; flat static basis is always derived by projecting the structure forest.
    ;;; (:view ROOT (:static VALUES TYPES) STRUCTURES FIELDS GENERATIONS)
    ;;; has relative source paths.  FIELDS remember the lexical/pre-projection
    ;;; host descriptors used to assemble its dynamic image.  GENERATIONS is
    ;;; (:generations TYPE-IDENTITIES CONSTRUCTOR-IDENTITIES).
    (<-- (%context-static (:module-context ?core ?structures ?signatures ?functors) ?static)
        (%project-structures ?structures ?core ?static))
    (<-- (module-context-static ?context ?static)
        (%context-static ?context ?static))
    (<-- (%project-structures ?structures ?core ?static)
        (%project-structures-seen ?structures ?core nil ?static))
    (<-- (%project-structures-seen nil ?core ?seen ?core) !)
    (<- (%project-structures-seen ((:structure ?name ?shadowed) . ?rest) ?core ?seen ?static)
        (%name-present ?name ?seen) !
        (%project-structures-seen ?rest ?core ?seen ?static))
    (<- (%project-structures-seen ((:structure ?name (:view ?root (:static ?values ?types) ?nested ?fields ?generations)) . ?rest)
                                  (:static ?root-values ?root-types) ?seen ?static)
        (%prefix-values ?name ?values ?prefixed-values)
        (%prefix-types ?name ?types ?prefixed-types)
        (%project-structures-seen ?rest (:static ?root-values ?root-types) (?name . ?seen)
                                  (:static ?rest-values ?rest-types))
        (%append ?prefixed-values ?rest-values ?all-values)
        (%append ?prefixed-types ?rest-types ?all-types)
        (= ?static (:static ?all-values ?all-types)))
    (<-- (%name-present ?name (?entry . ?rest))
        (lispp (string= ?name ?entry)) !)
    (<- (%name-present ?name (?other . ?rest)) (%name-present ?name ?rest))
    (<-- (%prefix-values ?prefix nil nil) !)
    (<- (%prefix-values ?prefix ((:value ?path ?scheme ?host ?status) . ?rest)
                        ((:value (?prefix . ?path) ?scheme ?host ?status) . ?values))
        (%prefix-values ?prefix ?rest ?values))
    (<-- (%prefix-types ?prefix nil nil) !)
    (<- (%prefix-types ?prefix ((:tycon ?path ?definition) . ?rest)
                       ((:tycon (?prefix . ?path) ?definition) . ?types))
        (%prefix-types ?prefix ?rest ?types))

    (<-- (%lookup-structure ?name ((:structure ?entry-name ?view) . ?rest) ?view)
        (lispp (string= ?name ?entry-name)) !)
    (<- (%lookup-structure ?name (?entry . ?rest) ?view)
        (%lookup-structure ?name ?rest ?view))
    (<-- (%lookup-signature ?name ((:signature ?entry-name ?signature) . ?rest) ?signature)
        (lispp (string= ?name ?entry-name)) !)
    (<- (%lookup-signature ?name (?entry . ?rest) ?signature)
        (%lookup-signature ?name ?rest ?signature))
    (<-- (%lookup-functor ?name ((:functor ?entry-name ?functor) . ?rest) ?functor)
        (lispp (string= ?name ?entry-name)) !)
    (<- (%lookup-functor ?name (?entry . ?rest) ?functor)
        (%lookup-functor ?name ?rest ?functor))
    (<-- (%put-structure ?name ?view ?entries ((:structure ?name ?view) . ?entries)) !)
    (<-- (%put-signature ?name ?value ?entries ((:signature ?name ?value) . ?entries)) !)
    (<-- (%put-functor ?name ?value ?entries ((:functor ?name ?value) . ?entries)) !)

    (<-- (%require-structure-path ?context ?path ?span ?view ?origin)
        (%structure-path ?context ?path ?view ?origin)
        !)
    (<- (%require-structure-path ?context ?path ?span ?view ?origin)
        (lisp (%module-fail ?span (format nil "Unbound structure identifier ~{~A~^.~}." ?path))))
    (<-- (%structure-path (:module-context ?core ?structures ?signatures ?functors)
                          (?name) (:view ?root ?static ?nested ?fields ?generations)
                          (:module-ref ?root nil))
        (%lookup-structure ?name ?structures (:view ?root ?static ?nested ?fields ?generations)) !)
    (<- (%structure-path (:module-context ?core ?structures ?signatures ?functors)
                         (?name . ?path) ?view ?origin)
        (%lookup-structure ?name ?structures (:view ?root ?static ?nested ?fields ?generations))
        (%nested-structure-path ?path ?nested (:module-ref ?root nil) ?view ?origin))
    (<-- (%nested-structure-path (?name) ?structures (:module-ref ?root ?fields) ?view
                                 (:module-ref ?root ?new-fields))
        (%lookup-structure ?name ?structures ?view)
        (%append ?fields ((:structure . ?name)) ?new-fields) !)
    (<- (%nested-structure-path (?name . ?path) ?structures (:module-ref ?root ?fields) ?view ?origin)
        (%lookup-structure ?name ?structures (:view ?nested-root ?static ?nested ?nested-fields ?generations))
        (%append ?fields ((:structure . ?name)) ?next-fields)
        (%nested-structure-path ?path ?nested (:module-ref ?root ?next-fields) ?view ?origin))

    ;;; Rebuilding a view changes only access descriptors; contained host values
    ;;; and reference cells remain shared by the generated projection.
    (<-- (%reroot-view (:view ?old (:static ?values ?types) ?structures ?fields ?generations)
                       ?root
                       (:view ?root (:static ?new-values ?types) ?structures ?fields ?generations))
        (%reroot-values ?root ?values ?new-values))
    (<-- (%reroot-values ?root nil nil) !)
    (<- (%reroot-values ?root ((:value ?path ?scheme ?host ?status) . ?rest)
                       ((:value ?path ?scheme (:module-ref ?root ?field-path) ?status) . ?values))
        (%value-field-path ?path ?field-path)
        (%reroot-values ?root ?rest ?values))
    ;;; Formal nested structures are addressed through the formal root of their
    ;;; containing argument.  Their original signature roots are descriptors,
    ;;; not runtime bindings.  Compound MODULE-REF origins preserve the exact
    ;;; structure path until emission.
    (<-- (%reorigin-view ?old ?origin ?view)
        (%reroot-view ?old ?origin ?rooted)
        (= ?rooted (:view ?origin ?static ?old-structures ?ignored-fields ?generations))
        (or (-> (= ?origin (:module-ref ?root ?fields))
                (= ?module-origin ?origin))
            (= ?module-origin (:module-ref ?origin nil)))
        (%reorigin-structures ?module-origin ?old-structures ?structures)
        (%view-fields ?static ?structures nil ?fields-out)
        (= ?view (:view ?origin ?static ?structures ?fields-out ?generations)))
    (<-- (%reorigin-structures ?origin nil nil) !)
    (<- (%reorigin-structures (:module-ref ?root ?fields)
                              ((:structure ?name ?old-view) . ?rest)
                              ((:structure ?name ?view) . ?views))
        (%append ?fields ((:structure . ?name)) ?child-fields)
        (%reorigin-view ?old-view (:module-ref ?root ?child-fields) ?view)
        (%reorigin-structures (:module-ref ?root ?fields) ?rest ?views))
    (<-- (%value-field-path (?name) ((:value . ?name))) !)
    (<- (%value-field-path (?structure . ?rest) ((:structure . ?structure) . ?fields))
        (%value-field-path ?rest ?fields))
    (<-- (%view-fields ?static ?structures ?host-values ?fields)
        (%direct-value-fields ?static ?host-values ?value-fields)
        (%direct-structure-fields ?structures ?structure-fields)
        (%append ?value-fields ?structure-fields ?fields))
    (<-- (%direct-value-fields (:static ?values ?types) nil ?fields)
        (%direct-value-fields-seen ?values nil ?fields))
    (<-- (%direct-value-fields-seen nil ?seen nil) !)
    (<- (%direct-value-fields-seen ((:value (?name) ?scheme ?host ?status) . ?rest) ?seen ?fields)
        (%name-present ?name ?seen) !
        (%direct-value-fields-seen ?rest ?seen ?fields))
    (<- (%direct-value-fields-seen ((:value (?name) ?scheme ?host ?status) . ?rest) ?seen
                                  ((:field (:value . ?name) ?host) . ?fields))
        (%direct-value-fields-seen ?rest (?name . ?seen) ?fields))
    (<- (%direct-value-fields-seen ((:value ?path ?scheme ?host ?status) . ?rest) ?seen ?fields)
        (%direct-value-fields-seen ?rest ?seen ?fields))
    (<-- (%direct-structure-fields ?structures ?out)
        (%direct-structure-fields-seen ?structures nil ?out))
    (<-- (%direct-structure-fields-seen nil ?seen nil) !)
    (<- (%direct-structure-fields-seen ((:structure ?name ?shadowed) . ?rest) ?seen ?out)
        (%name-present ?name ?seen) !
        (%direct-structure-fields-seen ?rest ?seen ?out))
    (<- (%direct-structure-fields-seen ((:structure ?name (:view ?root ?static ?nested ?fields ?generations)) . ?rest)
                                      ?seen ((:field (:structure . ?name) ?root) . ?out))
        (%direct-structure-fields-seen ?rest (?name . ?seen) ?out))

    ;;; A completed STRUCT/SIG body retains only additions relative to its own
    ;;; entry boundary.  Persistent list tails, not source spelling, delimit it.
    (<-- (%state-view (:module-context (:static ?values ?types) ?structures ?signatures ?functors)
                      (:module-context (:static ?old-values ?old-types) ?old-structures ?old-signatures ?old-functors)
                      ?root ?semantics ?view)
        (%append ?new-values ?old-values ?values)
        (%append ?new-types ?old-types ?types)
        (%append ?new-structures ?old-structures ?structures)
        (%project-structures ?new-structures (:static ?new-values ?new-types)
                             (:static ?exposed-values ?exposed-types))
        (%view-fields (:static ?exposed-values ?exposed-types) ?new-structures ?host-values ?fields)
        (%semantic-generations ?semantics ?new-values ?new-types ?new-structures ?generations)
        (%reroot-view (:view ?root (:static ?exposed-values ?exposed-types)
                            ?new-structures ?fields ?generations)
                      ?root ?view))

    ;;; TYPE-NAME and RUNTIME-CONSTRUCTOR generations are tracked separately.
    ;;; Replication is never marked generative merely because it introduces a
    ;;; new source path.
    (<-- (%semantic-generations ?semantics ?values ?types ?structures (:generations ?type-ids ?constructor-ids))
        (%datatype-type-identities ?types ?values ?semantics ?own-types)
        (%semantic-constructor-identities ?semantics ?own-constructors)
        (%nested-generations ?structures ?nested-types ?nested-constructors)
        (%append ?own-types ?nested-types ?all-types)
        (%append ?own-constructors ?nested-constructors ?all-constructors)
        (%unique-symbols ?all-types ?type-ids)
        (%unique-symbols ?all-constructors ?constructor-ids))
    (<-- (%datatype-type-identities nil ?values ?semantics nil) !)
    (<- (%datatype-type-identities ((:tycon ?path (type-name ?spelling ?identity ?arity ?equality ?flexibility)) . ?rest)
                                  ?values ?semantics (?identity . ?ids))
        ! (%datatype-type-identities ?rest ?values ?semantics ?ids))
    (<- (%datatype-type-identities (?entry . ?rest) ?values ?semantics ?ids)
        (%datatype-type-identities ?rest ?values ?semantics ?ids))
    (<-- (%semantic-constructor-identities nil nil) !)
    (<- (%semantic-constructor-identities ((:m-core (:d-datatype ?span ?constructors)) . ?rest) ?ids)
        (%dc-identities ?constructors ?own)
        (%semantic-constructor-identities ?rest ?others)
        (%append ?own ?others ?ids))
    (<- (%semantic-constructor-identities ((:m-core (:d-exceptions ?span ?constructors ?aliases)) . ?rest) ?ids)
        (%dc-identities ?constructors ?own)
        (%semantic-constructor-identities ?rest ?others)
        (%append ?own ?others ?ids))
    (<- (%semantic-constructor-identities ((:m-core (:d-abstype ?span ?datatype ?hidden ?body)) . ?rest) ?ids)
        (%semantic-constructor-identities ((:m-core ?datatype)) ?first)
        (%core-items-constructor-identities ?body ?second)
        (%semantic-constructor-identities ?rest ?others)
        (%append ?first ?second ?own)
        (%append ?own ?others ?ids))
    (<- (%semantic-constructor-identities ((:m-core (:d-local ?span ?local ?body)) . ?rest) ?ids)
        (%core-items-constructor-identities ?local ?first)
        (%core-items-constructor-identities ?body ?second)
        (%semantic-constructor-identities ?rest ?others)
        (%append ?first ?second ?own)
        (%append ?own ?others ?ids))
    (<- (%semantic-constructor-identities ((:m-core (:d-sequence ?items)) . ?rest) ?ids)
        (%core-items-constructor-identities ?items ?own)
        (%semantic-constructor-identities ?rest ?others)
        (%append ?own ?others ?ids))
    (<- (%semantic-constructor-identities ((:m-bind ?name ?root ?view ?expression) . ?rest) ?ids)
        (%view-generations ?view (:generations ?types ?own))
        (%semantic-constructor-identities ?rest ?others)
        (%append ?own ?others ?ids))
    (<- (%semantic-constructor-identities ((:m-local ?local ?body) . ?rest) ?ids)
        (%semantic-constructor-identities ?local ?first)
        (%semantic-constructor-identities ?body ?second)
        (%semantic-constructor-identities ?rest ?others)
        (%append ?first ?second ?own)
        (%append ?own ?others ?ids))
    (<- (%semantic-constructor-identities (?item . ?rest) ?ids)
        (%semantic-constructor-identities ?rest ?ids))
    (<-- (%core-items-constructor-identities nil nil) !)
    (<- (%core-items-constructor-identities (?item . ?rest) ?ids)
        (%semantic-constructor-identities ((:m-core ?item)) ?own)
        (%core-items-constructor-identities ?rest ?others)
        (%append ?own ?others ?ids))
    (<-- (%dc-identities nil nil) !)
    (<- (%dc-identities ((:dc ?name ?host ?identity ?arity ?exception) . ?rest) (?identity . ?ids))
        (%dc-identities ?rest ?ids))
    (<-- (%nested-generations nil nil nil) !)
    (<- (%nested-generations ((:structure ?name ?view) . ?rest) ?types ?constructors)
        (%view-generations ?view (:generations ?own-types ?own-constructors))
        (%nested-generations ?rest ?other-types ?other-constructors)
        (%append ?own-types ?other-types ?types)
        (%append ?own-constructors ?other-constructors ?constructors))
    (<-- (%view-generations (:view ?root ?static ?structures ?fields ?generations) ?generations) !)
    (<- (%view-generations ((:structure ?name ?view) . ?rest) ?generations)
        (%view-generations ?view ?generations))
    (<-- (%unique-symbols ?symbols ?out)
        (%unique-symbols-seen ?symbols nil ?reversed)
        (%reverse-symbols ?reversed nil ?out))
    (<-- (%unique-symbols-seen nil ?seen ?seen) !)
    (<- (%unique-symbols-seen (?symbol . ?rest) ?seen ?out)
        (or (-> (%seen-symbol-member ?symbol ?seen)
                (= ?next-seen ?seen))
            (= ?next-seen (?symbol . ?seen)))
        (%unique-symbols-seen ?rest ?next-seen ?out))
    (<-- (%seen-symbol-member ?symbol (?entry . ?rest))
        (== ?symbol ?entry) !)
    (<- (%seen-symbol-member ?symbol (?other . ?rest))
        (%seen-symbol-member ?symbol ?rest))
    (<-- (%reverse-symbols nil ?out ?out) !)
    (<- (%reverse-symbols (?symbol . ?rest) ?reversed ?out)
        (%reverse-symbols ?rest (?symbol . ?reversed) ?out))
    (<-- (%delete-symbol ?symbol nil nil) !)
    (<- (%delete-symbol ?symbol (?symbol . ?rest) ?out) ! (%delete-symbol ?symbol ?rest ?out))
    (<- (%delete-symbol ?symbol (?other . ?rest) (?other . ?out))
        (%delete-symbol ?symbol ?rest ?out))

    ;;; Core declarations are elaborated exactly once against the projected
    ;;; environment.  Only their additions become unqualified/opened bindings
    ;;; in the persistent Core root.
    (<-- (%core-declaration ?in ?ast ?out (:m-core ?semantic))
        (%context-static ?in ?static)
        (%core-declaration-in-static ?in ?static ?ast ?out (:m-core ?semantic)))
    (<-- (%core-declaration-in-static ?in ?static ?ast ?out (:m-core ?semantic))
        (ooparts/sml/elaborate::%declaration ?static nil ?ast ?next-static ?semantic)
        (= ?static (:static ?old-visible-values ?old-visible-types))
        (= ?next-static (:static ?new-visible-values ?new-visible-types))
        (%append ?values ?old-visible-values ?new-visible-values)
        (%append ?types ?old-visible-types ?new-visible-types)
        (= ?in (:module-context (:static ?root-values ?root-types) ?structures ?signatures ?functors))
        (%append ?values ?root-values ?next-values)
        (%append ?types ?root-types ?next-types)
        (= ?out (:module-context (:static ?next-values ?next-types)
                                ?structures ?signatures ?functors)))

    ;;; STRUCTURE and LOCAL can introduce nominal identities indirectly.  Core
    ;;; datatype replication and type aliases deliberately are not checkpoints:
    ;;; their source identity already has to be visible in the current basis.
    (<-- (%module-captured-lifetime-environment ?static ?weak ?visible-names)
        (ooparts/sml/elaborate::%static-weak-type-variables ?static ?weak)
        (or (-> (= ?weak nil) true)
            (ooparts/sml/elaborate::%static-free-type-names ?static ?visible-names)))
    (<-- (%module-lifetime-environment (:node :structure-declaration ?span ?slots)
                                      ?static ?weak ?visible-names t)
        ! (%module-captured-lifetime-environment ?static ?weak ?visible-names))
    (<- (%module-lifetime-environment (:node :local-structure-declaration ?span ?slots)
                                     ?static ?weak ?visible-names t)
        ! (%module-captured-lifetime-environment ?static ?weak ?visible-names))
    (<- (%module-lifetime-environment (:node :datatype-declaration ?span ?slots)
                                     ?static ?weak ?visible-names t)
        ! (%module-captured-lifetime-environment ?static ?weak ?visible-names))
    (<- (%module-lifetime-environment (:node :abstype-declaration ?span ?slots)
                                     ?static ?weak ?visible-names t)
        ! (%module-captured-lifetime-environment ?static ?weak ?visible-names))
    (<- (%module-lifetime-environment (:node :local-declaration ?span ?slots)
                                     ?static ?weak ?visible-names t)
        ! (%module-captured-lifetime-environment ?static ?weak ?visible-names))
    (<- (%module-lifetime-environment ?ast ?static nil nil nil) !)

    ;;; Elaborate in source order without nesting every earlier projected
    ;;; environment and semantic suffix in recursive continuations.  The
    ;;; checkpoint order remains newest-first for validation and source-first
    ;;; for callers that defer a LOCAL boundary check.
    (<-- (%module-declarations ?context ?asts ?out ?semantics)
        (%module-declarations-forward ?context ?asts nil nil ?out
                                      ?reversed-semantics ?reversed-checkpoints)
        (ooparts/sml/elaborate::%check-lifetime-checkpoints ?reversed-checkpoints)
        (%reverse-symbols ?reversed-semantics nil ?semantics))
    (<-- (%module-declarations-with-lifetimes ?context ?asts ?out ?semantics ?checkpoints)
        (%module-declarations-forward ?context ?asts nil nil ?out
                                      ?reversed-semantics ?reversed-checkpoints)
        (ooparts/sml/elaborate::%check-lifetime-checkpoints ?reversed-checkpoints)
        (%reverse-symbols ?reversed-semantics nil ?semantics)
        (%reverse-symbols ?reversed-checkpoints nil ?checkpoints))
    (<-- (%module-declarations-forward ?context nil ?semantics ?checkpoints
                                      ?context ?semantics ?checkpoints) !)
    (<- (%module-declarations-forward ?in (?ast . ?asts) ?semantics ?checkpoints
                                     ?out ?final-semantics ?final-checkpoints)
        (%context-static ?in ?static)
        (%module-lifetime-environment ?ast ?static ?weak ?visible-names ?checkpoint-p)
        (lisp ?span (ast-node-span ?ast))
        (%module-declaration-in-static ?in ?static ?ast ?next ?semantic)
        (= ?next-semantics (?semantic . ?semantics))
        (or (-> (= ?checkpoint-p t)
                (= ?next-checkpoints ((:checkpoint ?weak ?visible-names ?span) . ?checkpoints)))
            (= ?next-checkpoints ?checkpoints))
        (%module-declarations-forward ?next ?asts ?next-semantics ?next-checkpoints
                                      ?out ?final-semantics ?final-checkpoints))
    (<-- (%module-declaration-in-static ?in ?static
                                       (:node :structure-declaration ?span ((:bindings . ?bindings)))
                                       ?out (:m-structures ?semantics))
        ! (%structure-bindings ?in ?bindings ?out ?semantics))
    (<- (%module-declaration-in-static ?in ?static
                                      (:node :local-structure-declaration ?span
                                             ((:local . ?local) (:body . ?body)))
                                      ?out (:m-local ?local-semantics ?body-semantics))
        ! (%module-declarations-with-lifetimes ?in ?local ?local-context ?local-semantics
                                               ?local-checkpoints)
        (%module-declarations ?local-context ?body ?body-context ?body-semantics)
        (ooparts/sml/elaborate::%check-lifetime-checkpoints ?local-checkpoints)
        (%export-module-local ?in ?local-context ?body-context ?out))
    (<- (%module-declaration-in-static ?in ?static
                                      (:node :open-declaration ?span ((:identifiers . ?identifiers)))
                                      ?out (:m-structures ?bindings))
        ! (%core-declaration-in-static ?in ?static
                                      (:node :open-declaration ?span ((:identifiers . ?identifiers)))
                                      ?next ?ignored)
        (%open-module-structures ?next ?identifiers ?out ?bindings))
    (<- (%module-declaration-in-static ?in ?static ?ast ?out (:m-core ?semantic))
        (%core-declaration-in-static ?in ?static ?ast ?out (:m-core ?semantic)))
    (<-- (%open-module-structures ?context nil ?context nil) !)
    (<- (%open-module-structures ?in (?identifier . ?identifiers) ?out ?bindings)
        (lisp ?path (%path ?identifier))
        (%require-structure-path ?in ?path (ooparts/sml/syntax:identifier-span ?identifier) ?view ?origin)
        (%open-one-structure-view ?in ?view ?origin ?next ?own)
        (%open-module-structures ?next ?identifiers ?out ?others)
        (%append ?own ?others ?bindings))
    (<-- (%open-one-structure-view ?context (:view ?root ?static ?structures ?fields ?generations)
                                  (:module-ref ?parent-root ?parent-fields) ?out ?bindings)
        (%view-fields ?static ?structures nil ?all-fields)
        (%open-structure-fields ?context ?all-fields ?structures ?parent-root ?parent-fields
                                ?out ?bindings))
    (<-- (%open-structure-fields ?context nil ?structures ?parent-root ?parent-fields ?context nil) !)
    (<- (%open-structure-fields ?in ((:field (:value . ?name) ?host) . ?rest) ?structures
                                ?parent-root ?parent-fields ?out ?bindings)
        ! (%open-structure-fields ?in ?rest ?structures ?parent-root ?parent-fields ?out ?bindings))
    (<- (%open-structure-fields ?in ((:field (:structure . ?name) ?old-root) . ?rest) ?structures
                                ?parent-root ?parent-fields ?out ?bindings)
        (%lookup-structure ?name ?structures ?child)
        (%append ?parent-fields ((:structure . ?name)) ?child-fields)
        (lisp ?root (%fresh-module-root ?name))
        (%reroot-view ?child ?root ?view)
        (= ?in (:module-context ?core ?old-structures ?signatures ?functors))
        (%put-structure ?name ?view ?old-structures ?next-structures)
        (%open-structure-fields (:module-context ?core ?next-structures ?signatures ?functors)
                                ?rest ?structures ?parent-root ?parent-fields ?out ?others)
        (= ?bindings ((:m-bind ?name ?root ?view
                               (:se-alias ?root ?view (:module-ref ?parent-root ?child-fields))) . ?others)))
    (<-- (%export-module-local ?original ?local ?body ?out)
        (= ?original (:module-context (:static ?original-values ?original-types)
                                      ?original-structures ?original-signatures ?original-functors))
        (= ?local (:module-context (:static ?local-values ?local-types)
                                   ?local-structures ?local-signatures ?local-functors))
        (= ?body (:module-context (:static ?body-values ?body-types)
                                  ?body-structures ?body-signatures ?body-functors))
        (%append ?values ?local-values ?body-values)
        (%append ?types ?local-types ?body-types)
        (%append ?structures ?local-structures ?body-structures)
        (%append ?values ?original-values ?next-values)
        (%append ?types ?original-types ?next-types)
        (%append ?structures ?original-structures ?next-structures)
        (= ?out (:module-context (:static ?next-values ?next-types)
                                 ?next-structures ?original-signatures ?original-functors)))

    ;;; A simultaneous structure/signature/functor group elaborates every right
    ;;; hand side in the old environment, then publishes the new namespace.
    ;; The group worker is deterministic; AND never falls through to a
    ;; sequentially-scoped interpretation.
    (<-- (%structure-bindings ?old ?bindings ?out ?semantics)
        (%structure-group ?old ?bindings ?pairs ?semantics)
        (%publish-structures ?pairs ?old ?out))
    (<-- (%structure-group ?old nil nil nil) !)
    (<- (%structure-group ?old ((:node :structure-binding ?span ?slots) . ?rest) ?pairs ?semantics)
        (%structure-binding ?old (:node :structure-binding ?span ?slots) ?name ?view ?semantic)
        (%structure-group ?old ?rest ?other-pairs ?other-semantics)
        (= ?pairs ((:structure ?name ?view) . ?other-pairs))
        (= ?semantics (?semantic . ?other-semantics)))
    (<-- (%publish-structures ?pairs (:module-context ?core ?structures ?signatures ?functors)
                              (:module-context ?core ?out ?signatures ?functors))
        (%publish-structure-list ?pairs ?structures ?out))
    (<-- (%publish-structure-list nil ?structures ?structures) !)
    (<- (%publish-structure-list ((:structure ?name ?view) . ?rest) ?in ?out)
        (%put-structure ?name ?view ?in ?next)
        (%publish-structure-list ?rest ?next ?out))
    (<-- (%structure-binding ?context
                             (:node :structure-binding ?span
                                    ((:name . ?name-ast) (:signature . ?signature)
                                     (:opaque-p . ?opaque) (:structure . ?structure)))
                             ?name ?view ?semantic)
        (lisp ?name (%name ?name-ast))
        (%structure-expression ?context ?structure ?value ?expression)
        (or (-> (= ?signature nil)
                (and (= ?view ?value) (= ?body-semantic ?expression)))
            (%apply-structure-signature ?context ?value ?signature ?opaque ?span ?view ?body-semantic ?expression))
        (= ?view (:view ?root ?view-static ?view-structures ?view-fields ?view-generations))
        (= ?semantic (:m-bind ?name ?root ?view ?body-semantic)))

    ;;; Structure expressions produce immutable views and executable module
    ;;; expressions.  Aliases receive a new root descriptor but return the
    ;;; identical runtime object; no contained reference or closure is copied.
    (<-- (%structure-expression ?context (:node :basic-structure ?span ((:declarations . ?declarations))) ?view
                                (:se-basic ?root ?view ?items))
        (lisp ?root (%fresh-module-root "struct"))
        (%module-declarations ?context ?declarations ?inner ?items)
        (%state-view ?inner ?context ?root ?items ?view) !)
    (<- (%structure-expression ?context (:node :structure-identifier ?span ((:identifier . ?identifier))) ?view
                               (:se-alias ?root ?view ?origin))
        (lisp ?path (%path ?identifier))
        (%require-structure-path ?context ?path ?span ?old-view ?origin)
        (lisp ?name (%name ?identifier))
        (lisp ?root (%fresh-module-root ?name))
        (%reroot-view ?old-view ?root ?view) !)
    (<- (%structure-expression ?context (:node :let-structure ?span
                                               ((:declarations . ?declarations) (:body . ?body))) ?view
                               (:se-let ?items ?body-semantic))
        (%module-declarations-with-lifetimes ?context ?declarations ?inner ?items
                                             ?lifetime-checkpoints)
        (%structure-expression ?inner ?body ?view ?body-semantic)
        (ooparts/sml/elaborate::%check-lifetime-checkpoints ?lifetime-checkpoints) !)
    (<- (%structure-expression ?context (:node :constrained-structure ?span
                                               ((:structure . ?structure) (:signature . ?signature)
                                                (:opaque-p . ?opaque))) ?view ?semantic)
        (%structure-expression ?context ?structure ?actual ?inner)
        (%apply-structure-signature ?context ?actual ?signature ?opaque ?span ?view ?semantic ?inner) !)
    (<- (%structure-expression ?context (:node :functor-application ?span
                                               ((:functor . ?functor) (:argument . ?argument)
                                                (:declarations . ?declarations))) ?view ?semantic)
        (%functor-application ?context ?functor ?argument ?declarations ?span ?view ?semantic))

    ;;; Specifications and signatures.  Abstract TYPE names are flexible holes;
    ;;; matching below realizes them with genuine actual TypeName identities.
    (<-- (%signature-declaration ?old (:node :signature-declaration ?span ((:bindings . ?bindings))) ?out)
        (%signature-group ?old ?bindings ?pairs)
        (%publish-signatures ?pairs ?old ?out))
    (<-- (%signature-group ?old nil nil) !)
    (<- (%signature-group ?old ((:node :signature-binding ?span
                                       ((:name . ?name) (:signature . ?expression))) . ?rest) ?pairs)
        (lisp ?spelling (%name ?name))
        (%signature-expression ?old ?expression ?signature)
        (%signature-group ?old ?rest ?others)
        (= ?pairs ((:signature ?spelling ?signature) . ?others)))
    (<-- (%publish-signatures ?pairs (:module-context ?core ?structures ?signatures ?functors)
                              (:module-context ?core ?structures ?out ?functors))
        (%publish-signature-list ?pairs ?signatures ?out))
    (<-- (%publish-signature-list nil ?signatures ?signatures) !)
    (<- (%publish-signature-list ((:signature ?name ?view) . ?rest) ?in ?out)
        (%put-signature ?name ?view ?in ?next)
        (%publish-signature-list ?rest ?next ?out))

    ;; A signature descriptor is separate from the runtime structure view.
    ;; BOUND-TYPES are canonical TYPE-NAME terms introduced by the signature,
    ;; not ambient/rigid names or datatype-replication aliases.  Every
    ;; occurrence of a named signature freshens these names and their
    ;; associated datatype/exception constructors apart.
    (<-- (%signature-expression ?context (:node :signature-identifier ?span ((:identifier . ?identifier))) ?signature)
        (lisp ?name (%name ?identifier))
        (= ?context (:module-context ?core ?structures ?signatures ?functors))
        (or (-> (%lookup-signature ?name ?signatures ?stored) true)
            (lisp (%module-fail ?span (format nil "Unbound signature identifier ~A." ?name))))
        (%fresh-signature-instance ?stored ?signature) !)
    (<- (%signature-expression ?outer (:node :basic-signature ?span ((:specification . ?specification))) ?signature)
        (lisp ?root (%fresh-module-root "signature"))
        (%specification ?outer ?specification ?inner ?semantics)
        (%state-view ?inner ?outer ?root ?semantics ?view)
        (%make-signature-descriptor ?outer ?view ?signature) !)
    (<- (%signature-expression ?outer (:node :where-type-signature ?span
                                             ((:signature . ?base) (:refinements . ?refinements))) ?signature)
        (%signature-expression ?outer ?base ?initial)
        (%where-refinements ?outer ?initial ?refinements ?signature))

    (<-- (%make-signature-descriptor ?outer ?view
                                     (:signature-descriptor ?view ?bound-types ?bound-constructors))
        (= ?outer (:module-context ?outer-core ?outer-structures ?signatures ?functors))
        (%all-type-names ?view ?all-type-names)
        (%object-type-identities (:module-context ?outer-core ?outer-structures nil nil)
                                 ?captured-types)
        (%uncaptured-type-names ?all-type-names ?captured-types ?bound-types)
        (%object-constructor-identities ?view ?all-constructors)
        (%object-constructor-identities (:module-context ?outer-core ?outer-structures nil nil)
                                        ?captured-constructors)
        (%without-symbols ?all-constructors ?captured-constructors ?bound-constructors))
    (<-- (%object-constructor-identities ?object ?identities)
        (%collect-constructor-identities ?object ?raw)
        (%unique-symbols ?raw ?identities))
    (<-- (%collect-constructor-identities ?object nil)
        (var ?object) !)
    (<- (%collect-constructor-identities (:constructor ?identity ?arity ?exception) (?identity)) !)
    (<- (%collect-constructor-identities (?head . ?tail) ?identities)
        ! (%collect-constructor-identities ?head ?left)
        (%collect-constructor-identities ?tail ?right)
        (%append ?left ?right ?identities))
    (<- (%collect-constructor-identities ?other nil) !)
    ;;; Copy every type-variable cell once per occurrence, including the
    ;;; quantifier descriptors themselves.  Rigid matching below must never
    ;;; bind cells retained by a stored signature or a sibling occurrence.
    (<-- (%freshen-signature-variables ?object ?copy)
        (%freshen-signature-object ?object nil ?ignored ?copy))
    (<-- (%freshen-signature-object ?object ?maps ?maps ?object)
        (var ?object) !)
    (<- (%freshen-signature-object (type-var ?cell ?kind ?equality) ?in ?out ?copy)
        ! (or (-> (var ?cell)
                  (or (-> (%fresh-signature-variable ?cell ?in ?copy)
                          (= ?out ?in))
                      (and (= ?copy (type-var ?fresh ?kind ?equality))
                           (= ?out ((variable-map ?cell ?copy) . ?in)))))
              (and (%freshen-signature-object ?cell ?in ?out ?fresh-cell)
                   (or (-> (== ?kind :row)
                           (= ?copy (type-var ?fresh-cell :row ?equality)))
                       (= ?copy ?fresh-cell)))))
    (<- (%freshen-signature-object (?head . ?tail) ?in ?out (?new-head . ?new-tail))
        ! (%freshen-signature-object ?head ?in ?next ?new-head)
        (%freshen-signature-object ?tail ?next ?out ?new-tail))
    (<- (%freshen-signature-object ?other ?maps ?maps ?other) !)
    (<-- (%fresh-signature-variable ?cell ((variable-map ?old ?copy) . ?rest) ?copy)
        (== ?cell ?old) !)
    (<- (%fresh-signature-variable ?cell (?entry . ?rest) ?copy)
        (%fresh-signature-variable ?cell ?rest ?copy))

    (<-- (%fresh-signature-instance
          (:signature-descriptor ?view ?bound-types ?bound-constructors)
          (:signature-descriptor ?fresh-view ?fresh-types ?fresh-constructors))
        (%freshen-signature-variables (?view ?bound-types ?bound-constructors)
                                      (?variable-view ?variable-types ?variable-constructors))
        (%fresh-type-name-realization ?variable-types ?type-maps)
        (%fresh-constructor-identity-map ?variable-constructors ?constructor-maps)
        (%type-name-identity-map ?type-maps ?type-identity-maps)
        (%append ?type-identity-maps ?constructor-maps ?identities)
        (= ?realization (:realization ?type-maps ?identities))
        (%realize-view ?variable-view ?realization ?fresh-view)
        (%realize-object ?variable-types ?realization ?fresh-types)
        (%realize-object ?variable-constructors ?realization ?fresh-constructors))

    (<-- (%specification ?context (:node :specification-sequence ?span ((:specifications . ?items))) ?out ?semantics)
        ! (%specification-items ?context ?items ?out ?semantics))
    (<- (%specification ?context (:node :type-sharing-specification ?span
                                      ((:specification . ?specification) (:identifiers . ?identifiers))) ?out ?semantics)
        (%specification ?context ?specification ?inner ?semantics)
        (%share-types-in-state ?inner ?identifiers ?span ?out))
    (<- (%specification ?context (:node :structure-sharing-specification ?span
                                      ((:specification . ?specification) (:identifiers . ?identifiers))) ?out ?semantics)
        (%specification ?context ?specification ?inner ?semantics)
        (%share-structures-in-state ?inner ?identifiers ?span ?out))
    (<-- (%specification-items ?context nil ?context nil) !)
    (<- (%specification-items ?in (?item . ?items) ?out (?semantic . ?semantics))
        (%specification-item ?in ?item ?next ?semantic)
        (%specification-items ?next ?items ?out ?semantics))

    (<-- (%specification-item ?in (:node :value-specification ?span ((:descriptions . ?descriptions))) ?out
                              (:m-signature-values))
        ! (ooparts/sml/elaborate::%seed-type-variables ?descriptions nil ?scope)
        (%context-static ?in ?static)
        (%value-descriptions ?static ?scope ?descriptions ?values)
        (= ?in (:module-context (:static ?old-values ?types) ?structures ?signatures ?functors))
        (%append ?values ?old-values ?new-values)
        (= ?out (:module-context (:static ?new-values ?types) ?structures ?signatures ?functors)))
    (<- (%specification-item ?in (:node :type-specification ?span
                                      ((:equality-p . ?equality) (:descriptions . ?descriptions))) ?out
                             (:m-signature-types))
        ! (%abstract-type-descriptions ?in ?equality ?descriptions ?out))
    (<- (%specification-item ?in (:node :datatype-specification ?span ((:descriptions . ?descriptions))) ?out ?semantic)
        ! (= ?ast (:node :datatype-declaration ?span ((:bindings . ?descriptions) (:withtypes . nil))))
        (%core-declaration ?in ?ast ?out ?semantic))
    (<- (%specification-item ?in (:node :datatype-replication-specification ?span
                                      ((:name . ?name) (:source . ?source))) ?out ?semantic)
        ! (= ?ast (:node :datatype-replication ?span ((:name . ?name) (:source . ?source))))
        (%core-declaration ?in ?ast ?out ?semantic))
    (<- (%specification-item ?in (:node :exception-specification ?span ((:descriptions . ?descriptions))) ?out ?semantic)
        ! (= ?ast (:node :exception-declaration ?span ((:bindings . ?descriptions))))
        (%core-declaration ?in ?ast ?out ?semantic))
    (<- (%specification-item ?in (:node :structure-specification ?span ((:descriptions . ?descriptions))) ?out
                             (:m-signature-structures))
        ! (%structure-descriptions ?in ?descriptions ?pairs)
        (%publish-structures ?pairs ?in ?out))
    (<- (%specification-item ?in (:node :include-specification ?span ((:signatures . ?expressions))) ?out
                             (:m-signature-include))
        ! (%include-signatures ?in ?expressions ?out))

    (<-- (%value-descriptions ?static ?scope nil nil) !)
    (<- (%value-descriptions ?static ?scope
                             ((:node :value-description ?span ((:name . ?name) (:type . ?syntax))) . ?rest)
                             ((:value (?spelling) ?scheme (:module-ref ?root ((:value . ?spelling))) :variable) . ?values))
        (lisp ?spelling (%name ?name))
        (lisp ?root (%fresh-module-root "description"))
        (ooparts/sml/elaborate::%syntactic-type ?static ?scope ?syntax ?type)
        (generalize-type ?type (type-env nil) nil :nonexpansive ?scheme)
        (%value-descriptions ?static ?scope ?rest ?values))
    (<-- (%abstract-type-descriptions ?in ?equality nil ?in) !)
    (<- (%abstract-type-descriptions ?in ?equality (?description . ?rest) ?out)
        (%abstract-type-description ?in ?equality ?description ?next)
        (%abstract-type-descriptions ?next ?equality ?rest ?out))
    (<-- (%abstract-type-description ?in ?equality
                                    (:node :type-binding ?span ((:variables . nil) (:name . ?name) (:type . nil))) ?out)
        ! (lisp ?spelling (%name ?name))
        (lisp ?identity (%fresh-module-identity ?spelling))
        (or (-> (= ?equality t) (= ?attribute :equality)) (= ?attribute :non-equality))
        (= ?definition (type-name ?spelling ?identity 0 ?attribute :flexible))
        (= ?in (:module-context (:static ?values ?types) ?structures ?signatures ?functors))
        (= ?out (:module-context (:static ?values ((:tycon (?spelling) ?definition) . ?types))
                                 ?structures ?signatures ?functors)))
    (<- (%abstract-type-description ?in ?equality
                                   (:node :type-binding ?span ((:variables . ?variables) (:name . ?name) (:type . nil))) ?out)
        (lisp ?spelling (%name ?name))
        (lisp ?identity (%fresh-module-identity ?spelling))
        (%native-length ?variables ?arity)
        (or (-> (= ?equality t) (= ?attribute :equality)) (= ?attribute :non-equality))
        (= ?definition (type-name ?spelling ?identity ?arity ?attribute :flexible))
        (= ?in (:module-context (:static ?values ?types) ?structures ?signatures ?functors))
        (= ?out (:module-context (:static ?values ((:tycon (?spelling) ?definition) . ?types))
                                 ?structures ?signatures ?functors)))
    (<- (%abstract-type-description ?in ?equality
                                   (:node :type-binding ?span ((:variables . ?variables) (:name . ?name) (:type . ?syntax))) ?out)
        (= ?ast (:node :type-declaration ?span
                       ((:bindings . ((:node :type-binding ?span
                                             ((:variables . ?variables) (:name . ?name) (:type . ?syntax))))))))
        (%core-declaration ?in ?ast ?out ?ignored))
    (<-- (%native-length nil 0) !)
    (<- (%native-length (?head . ?tail) ?length)
        (%native-length ?tail ?rest) (is ?length (+ ?rest 1)))
    (<-- (%fresh-signature-types 0 nil) !)
    (<- (%fresh-signature-types ?count (?type . ?types))
        (is ?next (- ?count 1))
        (ooparts/sml/elaborate::%fresh-type ?type)
        (%fresh-signature-types ?next ?types))
    (<-- (%structure-descriptions ?old nil nil) !)
    (<- (%structure-descriptions ?old ((:node :structure-description ?span
                                               ((:name . ?name) (:signature . ?expression))) . ?rest) ?pairs)
        (lisp ?spelling (%name ?name))
        (%signature-expression ?old ?expression
                               (:signature-descriptor ?view ?bound-types ?bound-constructors))
        (%structure-descriptions ?old ?rest ?others)
        (= ?pairs ((:structure ?spelling ?view) . ?others)))
    (<-- (%include-signatures ?context nil ?context) !)
    (<- (%include-signatures ?in (?expression . ?expressions) ?out)
        (%signature-expression ?in ?expression
                               (:signature-descriptor
                                (:view ?root (:static ?values ?types) ?structures ?fields ?generations)
                                ?bound-types ?bound-constructors))
        (= ?in (:module-context (:static ?old-values ?old-types) ?old-structures ?signatures ?functors))
        (%append ?values ?old-values ?new-values)
        (%append ?types ?old-types ?new-types)
        (%include-structure-list ?structures ?old-structures ?new-structures)
        (%include-signatures (:module-context (:static ?new-values ?new-types) ?new-structures ?signatures ?functors)
                             ?expressions ?out))
    (<-- (%include-structure-list nil ?structures ?structures) !)
    (<- (%include-structure-list ((:structure ?name ?view) . ?rest) ?in ?out)
        (%put-structure ?name ?view ?in ?next)
        (%include-structure-list ?rest ?next ?out))

    ;;; Identity realization is applicable to static templates and typed
    ;;; semantic terms alike.  It never substitutes by source spelling.
    (<-- (%realize-object ?object (:realization ?names ?identities) ?out)
        (var ?object) ! (= ?out ?object))
    (<- (%realize-object (type-name ?spelling ?identity ?arity ?equality ?flexibility)
                         (:realization ?names ?identities) ?result)
        ! (or (-> (%lookup-name-realization ?identity ?names ?target) (= ?result ?target))
            (= ?result (type-name ?spelling ?identity ?arity ?equality ?flexibility))))
    (<- (%realize-object (@ (type-name ?spelling ?identity ?arity ?equality ?flexibility) ?arguments)
                         (:realization ?names ?identities) ?result)
        ! (%realize-object ?arguments (:realization ?names ?identities) ?new-arguments)
        (or (-> (%lookup-name-realization ?identity ?names ?target)
                (or (-> (= ?target (type-name ?new-spelling ?new-identity ?new-arity ?new-equality ?new-flexibility))
                        (= ?result (@ ?target ?new-arguments)))
                    (and (= ?target (type-function ?parameters ?body))
                         (apply-type-function ?target ?new-arguments ?result))))
            (= ?result (@ (type-name ?spelling ?identity ?arity ?equality ?flexibility)
                          ?new-arguments))))
    (<- (%realize-object ?object (:realization ?names ?identities) ?out)
        (lispp (symbolp ?object)) !
        (or (-> (%lookup-identity-realization ?object ?identities ?new) (= ?out ?new))
            (= ?out ?object)))
    (<- (%realize-object (:view ?root ?static ?structures ?fields ?generations)
                         ?realization ?view)
        ! (%realize-view (:view ?root ?static ?structures ?fields ?generations)
                         ?realization ?view))
    (<- (%realize-object (?head . ?tail) ?realization (?new-head . ?new-tail))
        ! (%realize-object ?head ?realization ?new-head)
        (%realize-object ?tail ?realization ?new-tail))
    (<- (%realize-object ?other ?realization ?other) !)
    (<-- (%lookup-name-realization ?identity
                                  ((name-map (type-name ?spelling ?identity ?arity ?equality ?flexibility) ?target) . ?rest)
                                  ?target) !)
    (<- (%lookup-name-realization ?identity (?entry . ?rest) ?target)
        (%lookup-name-realization ?identity ?rest ?target))
    (<-- (%lookup-identity-realization ?identity ((:identity ?identity ?new) . ?rest) ?new) !)
    (<- (%lookup-identity-realization ?identity (?entry . ?rest) ?new)
        (%lookup-identity-realization ?identity ?rest ?new))
    (<-- (%realize-static (:static ?values ?types) ?realization
                          (:static ?new-values ?new-types))
        (%realize-static-values ?values ?realization ?new-values)
        (%realize-static-types ?types ?realization ?new-types))
    (<-- (%realize-static-values nil ?realization nil) !)
    (<- (%realize-static-values ((:value ?path ?scheme ?host ?status) . ?rest)
                                ?realization
                                ((:value ?path ?new-scheme ?host ?new-status) . ?values))
        (%realize-object ?scheme ?realization ?new-scheme)
        (%realize-static-value-status ?status ?realization ?new-status)
        (%realize-static-values ?rest ?realization ?values))
    (<-- (%realize-static-value-status ?status (:realization ?names nil) ?status) !)
    (<- (%realize-static-value-status ?status ?realization ?new-status)
        (%realize-object ?status ?realization ?new-status))
    (<-- (%realize-static-types nil ?realization nil) !)
    (<- (%realize-static-types ((:tycon ?path ?definition) . ?rest) ?realization
                               ((:tycon ?path ?new-definition) . ?types))
        (%realize-object ?definition ?realization ?new-definition)
        (%realize-static-types ?rest ?realization ?types))
    (<-- (%realize-structures nil ?realization nil) !)
    (<- (%realize-structures ((:structure ?name ?view) . ?rest) ?realization
                             ((:structure ?name ?new-view) . ?structures))
        (%realize-object ?view ?realization ?new-view)
        (%realize-structures ?rest ?realization ?structures))
    ;;; Access paths and hosts remain identical; only static semantics change.
    ;;; Generation lists contain identities, not TYPE-NAME terms, so they need
    ;;; traversal only when constructor-identity maps are present.
    (<-- (%realize-view (:view ?root ?static ?structures ?fields ?generations)
                        (:realization ?names nil)
                        (:view ?root ?new-static ?new-structures ?fields ?generations))
        (%realize-static ?static (:realization ?names nil) ?new-static)
        (%realize-structures ?structures (:realization ?names nil) ?new-structures))
    (<- (%realize-view (:view ?root ?static ?structures ?fields ?generations) ?realization
                       (:view ?root ?new-static ?new-structures ?fields ?new-generations))
        (%realize-static ?static ?realization ?new-static)
        (%realize-structures ?structures ?realization ?new-structures)
        (%realize-object ?generations ?realization ?new-generations))
    (<-- (%realize-context (:module-context ?core ?structures ?signatures ?functors) ?realization
                           (:module-context ?new-core ?new-structures ?new-signatures ?new-functors))
        (%realize-static ?core ?realization ?new-core)
        (%realize-structures ?structures ?realization ?new-structures)
        (%realize-object ?signatures ?realization ?new-signatures)
        (%realize-object ?functors ?realization ?new-functors))

    ;;; WHERE TYPE is a true type-function realization, including parameterized
    ;;; aliases, rather than a spelling rewrite of an individual static entry.
    (<-- (%where-refinements ?outer ?signature nil ?signature) !)
    (<- (%where-refinements ?outer ?in (?refinement . ?rest) ?out)
        (%where-refinement ?outer ?in ?refinement ?next)
        (%where-refinements ?outer ?next ?rest ?out))
    (<-- (%where-refinement ?outer
                           (:signature-descriptor ?view ?bound-types ?bound-constructors)
                           (:node :type-refinement ?span
                                  ((:variables . ?variables) (:constructor . ?constructor) (:type . ?syntax)))
                           (:signature-descriptor ?new-view ?remaining-types ?bound-constructors))
        (lisp ?path (%path ?constructor))
        ;; Rule 64 elaborates the RHS in the outer basis.  Signature components
        ;; are deliberately absent, including their short unqualified names.
        (%context-static ?outer ?outer-static)
        (= ?binding (:node :type-binding ?span ((:variables . ?variables)
                                                (:name . ?constructor) (:type . ?syntax))))
        (ooparts/sml/elaborate::%seed-type-variables ?binding nil ?scope)
        (ooparts/sml/elaborate::%type-bindings ?outer-static ?scope (?binding) ?definitions)
        (= ?definitions ((:tycon ?ignored-path ?definition)))
        (%require-refinable-type-name ?view ?path ?span ?old)
        (= ?old (type-name ?old-spelling ?old-identity ?old-arity ?old-equality ?old-flexibility))
        (or (-> (%bound-type-identity ?old-identity ?bound-types) true)
            (lisp (%module-fail ?span "WHERE TYPE can refine only a signature-bound type name.")))
        (= ?definition (type-function ?refinement-parameters ?refinement-body))
        (%native-length ?refinement-parameters ?refinement-arity)
        (or (-> (= ?old-arity ?refinement-arity) true)
            (lisp (%module-fail ?span (format nil "A WHERE TYPE refinement changes the type constructor's arity (~S to ~S)." ?old-arity ?refinement-arity))))
        (or (-> (== ?old-equality :equality)
                (and (%fresh-signature-types ?refinement-arity ?equality-arguments)
                     (and (apply-type-function ?definition ?equality-arguments ?equality-type)
                          (ensure-equality ?equality-type))))
            true)
        (%check-datatype-refinement ?view ?old ?definition ?span)
        (= ?realization (:realization ((name-map ?old ?definition)) nil))
        (%realize-view ?view ?realization ?new-view)
        (%remove-bound-type ?old-identity ?bound-types ?remaining-types))
    ;;; A DATATYPE specification may be refined only to a nominal type of the
    ;;; same arity, never to a function, record, tuple, or unit expansion.
    ;;; Primitive TyNames such as int and ref deliberately remain valid.
    (<-- (%check-datatype-refinement ?view ?old ?definition ?span)
        (= ?old (type-name ?spelling ?identity ?arity ?equality ?flexibility))
        (or (-> (%view-datatype-type-identity ?view ?identity)
                (%require-nominal-datatype-refinement ?definition ?arity ?span))
            true))
    (<-- (%require-nominal-datatype-refinement (type-function ?parameters ?body) ?arity ?span)
        (%fresh-rigid-type-arguments ?arity ?arguments)
        (apply-type-function (type-function ?parameters ?body) ?arguments ?refined)
        (or (-> (= ?refined (@ (type-name ?spelling ?identity ?arity ?target-equality ?target-flexibility)
                               ?target-arguments)) true)
            (lisp (%module-fail ?span "A datatype WHERE TYPE refinement must denote a type name of matching arity."))))
    (<-- (%view-datatype-type-identity (:view ?root (:static ?values ?types) ?structures ?fields ?generations)
                                      ?identity)
        (or (%datatype-value-type-identity ?values ?identity)
            (%nested-datatype-type-identity ?structures ?identity)))
    (<-- (%datatype-value-type-identity
         ((:value ?path ?scheme ?host (:constructor ?constructor ?constructor-arity nil)) . ?rest)
         ?identity)
        (ooparts/sml/elaborate::%scheme-type-name-identity ?scheme ?identity) !)
    (<- (%datatype-value-type-identity (?entry . ?rest) ?identity)
        (%datatype-value-type-identity ?rest ?identity))
    (<-- (%nested-datatype-type-identity ((:structure ?name ?view) . ?rest) ?identity)
        (%view-datatype-type-identity ?view ?identity))
    (<- (%nested-datatype-type-identity (?entry . ?rest) ?identity)
        (%nested-datatype-type-identity ?rest ?identity))

    (<-- (%require-refinable-type-name ?view ?path ?span ?old)
        (%require-view-type ?view ?path ?span ?definition)
        (%refinable-type-definition ?definition ?old ?span))
    (<-- (%refinable-type-definition (type-name ?spelling ?identity ?arity ?equality ?flexibility)
                                    (type-name ?spelling ?identity ?arity ?equality ?flexibility) ?span) !)
    (<- (%refinable-type-definition (type-function ?parameters ?body) ?old ?span)
        (%native-length ?parameters ?arity)
        (%fresh-rigid-type-arguments ?arity ?arguments)
        (apply-type-function (type-function ?parameters ?body) ?arguments ?applied)
        (or (-> (= ?applied (@ (type-name ?spelling ?identity ?arity ?equality ?flexibility) ?type-arguments))
                (= ?old (type-name ?spelling ?identity ?arity ?equality ?flexibility)))
            (lisp (%module-fail ?span "WHERE TYPE requires an unrefined type name of matching arity."))))

    (<-- (%bound-type-identity ?identity ((type-name ?spelling ?identity ?arity ?equality ?flexibility) . ?rest)) !)
    (<- (%bound-type-identity ?identity (?entry . ?rest))
        (%bound-type-identity ?identity ?rest))
    (<-- (%remove-bound-type ?identity nil nil) !)
    (<- (%remove-bound-type ?identity ((type-name ?spelling ?identity ?arity ?equality ?flexibility) . ?rest) ?out)
        ! (%remove-bound-type ?identity ?rest ?out))
    (<- (%remove-bound-type ?identity (?entry . ?rest) (?entry . ?out))
        (%remove-bound-type ?identity ?rest ?out))
    (<-- (%view-static (:view ?root ?static ?structures ?fields ?generations) ?out)
        (%project-structures ?structures ?static ?out))
    (<-- (%require-view-type ?view ?path ?span ?definition)
        (%view-static ?view (:static ?values ?types))
        (or (-> (%native-type-lookup ?path ?types ?definition) true)
            (lisp (%module-fail ?span (format nil "Unknown signature type path ~{~A~^.~}." ?path)))))
    (<-- (%native-type-lookup ?path ((:tycon ?entry-path ?definition) . ?rest) ?definition)
        (lispp (equal ?path ?entry-path)) !)
    (<- (%native-type-lookup ?path (?entry . ?rest) ?definition)
        (%native-type-lookup ?path ?rest ?definition))
    (<-- (%native-value-lookup ?path ((:value ?entry-path ?scheme ?host ?status) . ?rest)
                              (:value ?entry-path ?scheme ?host ?status))
        (lispp (equal ?path ?entry-path)) !)
    (<- (%native-value-lookup ?path (?entry . ?rest) ?value)
        (%native-value-lookup ?path ?rest ?value))

    ;;; Sharing is realized throughout the just elaborated specification.  A
    ;;; later occurrence denotes the first TypeName; no same-spelling fallback
    ;;; is admitted.
    (<-- (%share-types-in-state ?context (?first . ?rest) ?span ?out)
        (lisp ?first-path (%path ?first))
        (%context-static ?context (:static ?values ?types))
        (or (-> (%native-type-lookup ?first-path ?types ?first-definition) true)
            (lisp (%module-fail ?span "A type-sharing path is unbound.")))
        (%sharing-type-target ?types ?first-definition ?rest ?span ?shared-target)
        (%sharing-type-maps ?types ?shared-target (?first . ?rest) ?span ?maps)
        (%check-sharing-types ?types ?shared-target (?first . ?rest) ?span ?maps)
        (%realize-context ?context (:realization ?maps nil) ?out))
    ;; Choose the first nominal participant as the canonical name, even when an
    ;; alias precedes it.  A sharing equation made solely from rigid aliases
    ;; has no flexible TypeName to realize and is deliberately rejected.
    (<-- (%sharing-type-target ?types ?first-definition ?rest ?span ?shared-target)
        (%initial-sharing-type-target ?first-definition ?initial)
        (%sharing-type-target-rest ?types ?initial ?rest ?span ?shared-target))
    (<-- (%initial-sharing-type-target
          (type-name ?spelling ?identity ?arity ?equality ?flexibility)
          (type-name ?spelling ?identity ?arity ?equality ?flexibility)) !)
    (<- (%initial-sharing-type-target (type-function ?parameters ?body) nil) !)
    (<-- (%sharing-type-target-rest ?types nil nil ?span ?target)
        (lisp (%module-fail ?span "Type sharing requires a realizable nominal type participant.")))
    (<- (%sharing-type-target-rest ?types ?target nil ?span ?target) !)
    (<- (%sharing-type-target-rest ?types ?target (?identifier . ?rest) ?span ?shared-target)
        (lisp ?path (%path ?identifier))
        (or (-> (%native-type-lookup ?path ?types ?definition) true)
            (lisp (%module-fail ?span "A type-sharing path is unbound.")))
        (%join-sharing-type-target ?target ?definition ?span ?next-target)
        (%sharing-type-target-rest ?types ?next-target ?rest ?span ?shared-target))
    (<-- (%join-sharing-type-target nil (type-function ?parameters ?body) ?span nil) !)
    (<- (%join-sharing-type-target nil
                                  (type-name ?spelling ?identity ?arity ?equality ?flexibility)
                                  ?span
                                  (type-name ?spelling ?identity ?arity ?equality ?flexibility)) !)
    (<- (%join-sharing-type-target
         (type-name ?spelling ?identity ?arity ?equality ?flexibility)
         (type-name ?other-spelling ?other-identity ?other-arity ?other-equality ?other-flexibility)
         ?span
         (type-name ?spelling ?identity ?arity ?joined-equality ?flexibility))
        ! (or (-> (== ?arity ?other-arity) true)
              (lisp (%module-fail ?span "Type-sharing constructors have different arities.")))
        (%sharing-equality ?equality ?other-equality ?joined-equality))
    (<- (%join-sharing-type-target
         (type-name ?spelling ?identity ?arity ?equality ?flexibility)
         (type-function ?parameters ?body) ?span
         (type-name ?spelling ?identity ?arity ?equality ?flexibility))
        (%native-length ?parameters ?other-arity)
        (or (-> (== ?arity ?other-arity) true)
            (lisp (%module-fail ?span "Type-sharing constructors have different arities."))))
    (<-- (%sharing-type-maps ?types ?target nil ?span nil) !)
    (<- (%sharing-type-maps ?types ?target (?identifier . ?rest) ?span ?maps)
        (lisp ?path (%path ?identifier))
        (or (-> (%native-type-lookup ?path ?types ?definition) true)
            (lisp (%module-fail ?span "A type-sharing path is unbound.")))
        (%sharing-type-maps ?types ?target ?rest ?span ?others)
        (%sharing-type-map ?definition ?target ?others ?maps))
    (<-- (%sharing-type-map (type-function ?parameters ?body) ?target ?maps ?maps) !)
    (<- (%sharing-type-map (type-name ?spelling ?identity ?arity ?equality ?flexibility)
                          ?target ?others
                          ((name-map (type-name ?spelling ?identity ?arity ?equality ?flexibility)
                                     ?target) . ?others)) !)
    ;;; Validate aliases only after the simultaneous nominal realization.  The
    ;;; same fresh rigid arguments exercise both nominal and alias participants
    ;;; without mutating their stored definitions or weakening rigid identity.
    (<-- (%check-sharing-types ?types ?target ?identifiers ?span ?maps)
        (%type-constructor-arity ?target ?arity)
        (%fresh-rigid-type-arguments ?arity ?arguments)
        (%realize-object ?target (:realization ?maps nil) ?realized-target)
        (%apply-compatible-constructor ?realized-target ?arguments ?target-type)
        (%check-sharing-type-list ?types ?identifiers ?span ?maps ?arguments ?target-type))
    (<-- (%check-sharing-type-list ?types nil ?span ?maps ?arguments ?target-type) !)
    (<- (%check-sharing-type-list ?types (?identifier . ?rest) ?span ?maps ?arguments ?target-type)
        (lisp ?path (%path ?identifier))
        (or (-> (%native-type-lookup ?path ?types ?definition) true)
            (lisp (%module-fail ?span "A type-sharing path is unbound.")))
        (%realize-object ?definition (:realization ?maps nil) ?realized-definition)
        (%apply-compatible-constructor ?realized-definition ?arguments ?definition-type)
        (type-unify ?definition-type ?target-type)
        (%check-sharing-type-list ?types ?rest ?span ?maps ?arguments ?target-type))
    (<-- (%sharing-equality :equality ?other :equality) !)
    (<- (%sharing-equality ?equality :equality :equality) !)
    (<- (%sharing-equality ?equality ?other ?equality) !)
    (<-- (%share-structures-in-state ?context (?first . ?rest) ?span ?out)
        (lisp ?first-path (%path ?first))
        (%require-structure-path ?context ?first-path ?span ?first-view ?origin)
        (%structure-sharing-maps ?context ?first-view ?rest ?span ?raw-maps)
        (%canonicalize-structure-sharing-maps ?raw-maps ?maps)
        (%realize-context ?context (:realization ?maps nil) ?out))
    ;; Resolve every noninitial participant once, in the original target-first
    ;; order.  The operation-local views are then reused for suffix pairs;
    ;; no logical term is cached beyond this sharing operation.
    (<-- (%structure-sharing-maps ?context ?target ?identifiers ?span ?maps)
        (%structure-sharing-target-maps ?context ?target ?identifiers ?span
                                       ?with-target ?views)
        (%structure-sharing-suffix-maps ?views ?span ?suffix)
        (%append ?with-target ?suffix ?maps))
    (<-- (%structure-sharing-target-maps ?context ?target nil ?span nil nil) !)
    (<- (%structure-sharing-target-maps ?context ?target (?identifier . ?rest) ?span
                                       ?maps (?view . ?views))
        (lisp ?path (%path ?identifier))
        (%require-structure-path ?context ?path ?span ?view ?origin)
        (%two-structure-sharing-maps ?target ?view ?span ?own)
        (%structure-sharing-target-maps ?context ?target ?rest ?span ?others ?views)
        (%append ?own ?others ?maps))
    (<-- (%structure-sharing-suffix-maps nil ?span nil) !)
    (<- (%structure-sharing-suffix-maps (?target . ?rest) ?span ?maps)
        (%structure-sharing-view-pair-maps ?target ?rest ?span ?own)
        (%structure-sharing-suffix-maps ?rest ?span ?others)
        (%append ?own ?others ?maps))
    (<-- (%structure-sharing-view-pair-maps ?target nil ?span nil) !)
    (<- (%structure-sharing-view-pair-maps ?target (?view . ?rest) ?span ?maps)
        (%two-structure-sharing-maps ?target ?view ?span ?own)
        (%structure-sharing-view-pair-maps ?target ?rest ?span ?others)
        (%append ?own ?others ?maps))
    (<-- (%two-structure-sharing-maps (:view ?tr (:static ?values ?types) ?ts ?tf ?tg)
                                     (:view ?sr ?static ?ss ?sf ?sg) ?span ?maps)
        (%structure-component-maps ?types ?static ?span ?own)
        (%nested-structure-sharing-maps ?ts ?ss ?span ?nested)
        (%append ?own ?nested ?maps))
    (<-- (%structure-component-maps nil ?static ?span nil) !)
    (<- (%structure-component-maps ((:tycon ?path ?target-definition) . ?rest)
                                  (:static ?values ?types) ?span ?maps)
        (%structure-component-maps ?rest (:static ?values ?types) ?span ?others)
        (%optional-structure-type ?path ?types ?definition)
        (%structure-component-map ?target-definition ?definition ?span ?others ?maps))
    (<-- (%optional-structure-type ?path nil nil) !)
    (<- (%optional-structure-type ?path ((:tycon ?entry-path ?definition) . ?rest) (?definition))
        (lispp (equal ?path ?entry-path)) !)
    (<- (%optional-structure-type ?path (?entry . ?rest) ?definition)
        (%optional-structure-type ?path ?rest ?definition))
    (<-- (%structure-component-map (type-name ?spelling ?identity ?arity ?equality ?flexibility)
                                  nil ?span ?maps ?maps) !)
    (<- (%structure-component-map (type-function ?parameters ?body) nil ?span ?maps ?maps) !)
    (<- (%structure-component-map (type-function ?parameters ?body) (?definition) ?span ?maps ?out)
        ! (lisp (%module-fail ?span "Structure sharing requires type names, not type abbreviations.")))
    (<- (%structure-component-map (type-name ?spelling ?identity ?arity ?equality ?flexibility)
                                  ((type-function ?parameters ?body)) ?span ?maps ?out)
        ! (lisp (%module-fail ?span "Structure sharing requires type names, not type abbreviations.")))
    (<- (%structure-component-map (type-name ?spelling ?identity ?arity ?equality ?flexibility)
                                  ((type-name ?other-spelling ?other-identity ?other-arity ?other-equality ?other-flexibility))
                                  ?span ?others
                                  ((name-map (type-name ?other-spelling ?other-identity ?other-arity ?other-equality ?other-flexibility)
                                            ?shared-target)
                                   (name-map (type-name ?spelling ?identity ?arity ?equality ?flexibility)
                                             ?shared-target) . ?others))
        (or (-> (== ?arity ?other-arity) true)
            (lisp (%module-fail ?span "Shared structure type components have different arities.")))
        (%sharing-equality ?equality ?other-equality ?shared-equality)
        (= ?shared-target (type-name ?spelling ?identity ?arity ?shared-equality ?flexibility)))
    (<- (%structure-component-map ?target ?definition ?span ?maps ?maps) !)
    (<-- (%nested-structure-sharing-maps nil ?actual ?span nil) !)
    (<- (%nested-structure-sharing-maps ((:structure ?name ?target) . ?rest) ?actual ?span ?maps)
        (%nested-structure-sharing-maps ?rest ?actual ?span ?others)
        (or (-> (%lookup-structure ?name ?actual ?view)
                (and (%two-structure-sharing-maps ?target ?view ?span ?own)
                     (%append ?own ?others ?maps)))
            (= ?maps ?others)))
    ;; Component maps are pairwise by construction.  Join every participant's
    ;; equality contribution per target identity, then emit direct maps to the
    ;; final canonical name; no chained or source-order-sensitive realization
    ;; remains, including for sharings of three or more structures.
    (<-- (%canonicalize-structure-sharing-maps ?input ?output)
        (%collect-canonical-sharing-targets ?input nil ?targets)
        (%rewrite-structure-sharing-maps ?input ?targets ?output))
    (<-- (%collect-canonical-sharing-targets nil ?targets ?targets) !)
    (<- (%collect-canonical-sharing-targets ((name-map ?source ?target) . ?rest) ?in ?out)
        (= ?source (type-name ?source-spelling ?source-identity ?source-arity ?source-equality ?source-flexibility))
        (= ?target (type-name ?spelling ?identity ?arity ?equality ?flexibility))
        (%sharing-equality ?source-equality ?equality ?entry-equality)
        (%merge-canonical-sharing-target ?target ?entry-equality ?in ?next)
        (%collect-canonical-sharing-targets ?rest ?next ?out))
    (<-- (%merge-canonical-sharing-target (type-name ?spelling ?identity ?arity ?equality ?flexibility)
                                         ?new-equality nil
                                         ((type-name ?spelling ?identity ?arity ?new-equality ?flexibility))) !)
    (<- (%merge-canonical-sharing-target (type-name ?spelling ?identity ?arity ?equality ?flexibility)
                                        ?new-equality
                                        ((type-name ?old-spelling ?identity ?old-arity ?old-equality ?old-flexibility) . ?rest)
                                        ((type-name ?old-spelling ?identity ?old-arity ?joined ?old-flexibility) . ?rest))
        ! (%sharing-equality ?old-equality ?new-equality ?joined))
    (<- (%merge-canonical-sharing-target ?target ?new-equality (?entry . ?rest) (?entry . ?out))
        (%merge-canonical-sharing-target ?target ?new-equality ?rest ?out))
    (<-- (%rewrite-structure-sharing-maps nil ?targets nil) !)
    (<- (%rewrite-structure-sharing-maps ((name-map ?source ?target) . ?rest) ?targets
                                        ((name-map ?source ?canonical) . ?maps))
        (= ?target (type-name ?spelling ?identity ?arity ?equality ?flexibility))
        (%canonical-sharing-target ?identity ?targets ?canonical)
        (%rewrite-structure-sharing-maps ?rest ?targets ?maps))
    (<-- (%canonical-sharing-target ?identity ((type-name ?spelling ?identity ?arity ?equality ?flexibility) . ?rest)
                                    (type-name ?spelling ?identity ?arity ?equality ?flexibility)) !)
    (<- (%canonical-sharing-target ?identity (?entry . ?rest) ?target)
        (%canonical-sharing-target ?identity ?rest ?target))

    ;;; Signature matching.  Abstract expected TypeNames accumulate an identity
    ;;; realization, then all required value schemes are compared after that
    ;;; realization.  Fields absent from a signature are simply not projected.
    (<-- (%match-view ?actual
                      (:signature-descriptor ?expected ?bound-types ?bound-constructors)
                      ?span ?view ?maps)
        (%match-view-from ?actual ?expected ?bound-types ?span nil ?maps ?view))
    (<-- (%match-view-from (:view ?ar (:static ?actual-values ?actual-types) ?actual-structures ?af ?ag)
                          (:view ?er (:static ?expected-values ?expected-types) ?expected-structures ?ef ?eg)
                          ?bound-types ?span ?in ?out ?view)
        (%match-required-types ?expected-types ?actual-types ?bound-types ?span ?in ?type-maps)
        (%match-required-datatype-components ?expected-types ?expected-values ?actual-types ?span)
        (%match-required-structures ?expected-structures ?actual-structures ?bound-types ?span ?type-maps ?structure-maps ?nested)
        (%match-required-values ?expected-values ?actual-values ?span ?structure-maps ?out)
        (%select-actual-values ?expected-values ?actual-values ?span ?values)
        (%select-actual-types ?expected-types ?actual-types ?span ?types)
        (lisp ?root (%fresh-module-root "view"))
        (%reroot-view (:view ?root (:static ?values ?types) ?nested nil ?ag) ?root ?rooted)
        (%view-fields (:static ?values ?types) ?nested nil ?fields)
        (= ?rooted (:view ?root ?static ?nested-fields ?ignored-fields ?generations))
        (= ?view (:view ?root ?static ?nested-fields ?fields ?generations)))
    (<-- (%match-required-types ?expected ?actual ?bound-types ?span ?in ?out)
        (%match-required-nominal-types ?expected ?actual ?bound-types ?span ?in ?nominal-maps)
        (%match-required-alias-types ?expected ?actual ?bound-types ?span ?nominal-maps ?out))
    (<-- (%match-required-nominal-types nil ?actual ?bound-types ?span ?maps ?maps) !)
    (<- (%match-required-nominal-types ((:tycon ?path (type-name ?spelling ?identity ?arity ?equality ?flexibility)) . ?rest)
                                      ?actual ?bound-types ?span ?in ?out)
        ! (or (-> (%native-type-lookup ?path ?actual ?definition) true)
              (lisp (%module-fail ?span (format nil "The structure lacks required type ~{~A~^.~}." ?path))))
        (%match-type-definition (type-name ?spelling ?identity ?arity ?equality ?flexibility)
                                ?definition ?bound-types ?span ?in ?next)
        (%match-required-nominal-types ?rest ?actual ?bound-types ?span ?next ?out))
    (<- (%match-required-nominal-types (?entry . ?rest) ?actual ?bound-types ?span ?in ?out)
        (%match-required-nominal-types ?rest ?actual ?bound-types ?span ?in ?out))
    (<-- (%match-required-alias-types nil ?actual ?bound-types ?span ?maps ?maps) !)
    (<- (%match-required-alias-types ((:tycon ?path (type-function ?parameters ?body)) . ?rest)
                                    ?actual ?bound-types ?span ?in ?out)
        ! (or (-> (%native-type-lookup ?path ?actual ?definition) true)
              (lisp (%module-fail ?span (format nil "The structure lacks required type ~{~A~^.~}." ?path))))
        (%match-type-definition (type-function ?parameters ?body)
                                ?definition ?bound-types ?span ?in ?next)
        (%match-required-alias-types ?rest ?actual ?bound-types ?span ?next ?out))
    (<- (%match-required-alias-types (?entry . ?rest) ?actual ?bound-types ?span ?in ?out)
        (%match-required-alias-types ?rest ?actual ?bound-types ?span ?in ?out))
    (<-- (%match-type-definition (type-name ?spelling ?identity ?arity ?equality ?flexibility)
                                (type-name ?actual-spelling ?actual-identity ?actual-arity ?actual-equality ?actual-flexibility)
                                ?bound-types ?span ?in ?out)
        ! (or (-> (== ?arity ?actual-arity) true)
              (lisp (%module-fail ?span (format nil "Type constructor ~A has the wrong arity." ?spelling))))
        (or (-> (= ?equality :equality)
                (or (-> (== ?actual-equality :equality) true)
                    (lisp (%module-fail ?span "An eqtype specification matched a non-equality type."))))
            true)
        (or (-> (%bound-type-identity ?identity ?bound-types)
                (%add-name-realization (type-name ?spelling ?identity ?arity ?equality ?flexibility)
                                       (type-name ?actual-spelling ?actual-identity ?actual-arity ?actual-equality ?actual-flexibility)
                                       ?span ?in ?out))
            (and (or (-> (== ?identity ?actual-identity) true)
                     (lisp (%module-fail ?span "A rigid signature type matched a different nominal type.")))
                 (= ?out ?in))))
    (<- (%match-type-definition (type-name ?spelling ?identity ?arity ?equality ?flexibility)
                                (type-function ?parameters ?body) ?bound-types ?span ?in ?out)
        ! (or (-> (%bound-type-identity ?identity ?bound-types) true)
              (lisp (%module-fail ?span "A rigid signature type matched a type abbreviation.")))
        (%native-length ?parameters ?actual-arity)
        (or (-> (== ?arity ?actual-arity) true)
            (lisp (%module-fail ?span "A type abbreviation has the wrong arity.")))
        (%fresh-signature-types ?arity ?arguments)
        (= ?actual (type-function ?parameters ?body))
        (apply-type-function ?actual ?arguments ?actual-type)
        (or (-> (= ?equality :equality) (ensure-equality ?actual-type)) true)
        (%add-name-realization (type-name ?spelling ?identity ?arity ?equality ?flexibility)
                               ?actual ?span ?in ?out))
    (<- (%match-type-definition (type-function ?parameters ?body) ?actual ?bound-types ?span ?maps ?maps)
        ! (%realize-object (type-function ?parameters ?body) (:realization ?maps nil) ?realized-expected)
        (%native-length ?parameters ?arity)
        (%fresh-rigid-type-arguments ?arity ?arguments)
        (%apply-compatible-constructor ?realized-expected ?arguments ?expected-type)
        (%apply-compatible-constructor ?actual ?arguments ?actual-type)
        (type-unify ?expected-type ?actual-type))
    (<- (%match-type-definition ?expected ?actual ?bound-types ?span ?maps ?maps)
        (lisp (%module-fail ?span "A required type is not a compatible concrete type constructor.")))
    (<-- (%add-name-realization ?source ?target ?span ?in ?out)
        (= ?source (type-name ?spelling ?identity ?arity ?equality ?flexibility))
        (or (-> (%lookup-name-realization ?identity ?in ?old)
                (or (-> (%compatible-name-target ?old ?target) (= ?out ?in))
                    (lisp (%module-fail ?span "A signature type is realized by incompatible types."))))
            (= ?out ((name-map ?source ?target) . ?in))))
    (<-- (%compatible-name-target (type-name ?left-spelling ?identity ?left-arity ?left-equality ?left-flexibility)
                                 (type-name ?right-spelling ?identity ?right-arity ?right-equality ?right-flexibility)) !)
    (<- (%compatible-name-target ?left ?right)
        (%type-constructor-arity ?left ?arity)
        (%type-constructor-arity ?right ?arity)
        (%fresh-rigid-type-arguments ?arity ?arguments)
        (%apply-compatible-constructor ?left ?arguments ?left-type)
        (%apply-compatible-constructor ?right ?arguments ?right-type)
        (type-unify ?left-type ?right-type))
    (<-- (%type-constructor-arity (type-name ?spelling ?identity ?arity ?equality ?flexibility) ?arity) !)
    (<- (%type-constructor-arity (type-function ?parameters ?body) ?arity)
        (%native-length ?parameters ?arity))
    (<-- (%fresh-rigid-type-arguments 0 nil) !)
    (<- (%fresh-rigid-type-arguments ?count ((@ ?argument nil) . ?arguments))
        (is ?next (- ?count 1))
        (lisp ?identity (%fresh-module-identity "signature-argument"))
        (= ?argument (type-name "'sig" ?identity 0 :non-equality :rigid))
        (%fresh-rigid-type-arguments ?next ?arguments))
    (<-- (%apply-compatible-constructor (type-name ?spelling ?identity ?arity ?equality ?flexibility)
                                        ?arguments
                                        (@ (type-name ?spelling ?identity ?arity ?equality ?flexibility) ?arguments)) !)
    (<- (%apply-compatible-constructor (type-function ?parameters ?body) ?arguments ?type)
        (apply-type-function (type-function ?parameters ?body) ?arguments ?type))
    ;;; A constructor-bearing DATATYPE specification cannot be satisfied by a
    ;;; same-identity abbreviation whose constructors came from another path.
    ;;; Replication itself remains nominal and therefore keeps working.
    (<-- (%match-required-datatype-components ?expected-types nil ?actual-types ?span) !)
    (<- (%match-required-datatype-components ?expected-types
                                            ((:value ?path ?scheme ?host
                                                      (:constructor ?constructor ?arity nil)) . ?rest)
                                            ?actual-types ?span)
        ! (ooparts/sml/elaborate::%scheme-type-name-identity ?scheme ?identity)
        (or (-> (%datatype-specification-path ?expected-types ?identity ?type-path)
                (and (or (-> (%native-type-lookup ?type-path ?actual-types ?definition) true)
                         (lisp (%module-fail ?span "A required datatype component is missing.")))
                     (or (-> (= ?definition (type-name ?spelling ?actual-identity ?type-arity ?equality ?flexibility)) true)
                         (lisp (%module-fail ?span "A datatype specification matched a type abbreviation.")))))
            true)
        (%match-required-datatype-components ?expected-types ?rest ?actual-types ?span))
    (<- (%match-required-datatype-components ?expected-types (?entry . ?rest) ?actual-types ?span)
        (%match-required-datatype-components ?expected-types ?rest ?actual-types ?span))
    (<- (%datatype-specification-path
         ((:tycon ?path (type-function ?parameters
                           (@ (type-name ?spelling ?identity ?arity ?equality ?flexibility)
                              ?arguments))) . ?rest)
         ?identity ?path) !)
    (<- (%datatype-specification-path
         ((:tycon ?path (type-name ?spelling ?identity ?arity ?equality ?flexibility)) . ?rest)
         ?identity ?path) !)
    (<- (%datatype-specification-path (?entry . ?rest) ?identity ?path)
        (%datatype-specification-path ?rest ?identity ?path))

    (<-- (%match-required-values nil ?actual ?span ?maps ?maps) !)
    (<- (%match-required-values ((:value ?path ?expected-scheme ?expected-host ?expected-status) . ?rest)
                               ?actual ?span ?in ?out)
        (or (-> (%native-value-lookup ?path ?actual (:value ?actual-path ?actual-scheme ?actual-host ?actual-status)) true)
            (lisp (%module-fail ?span (format nil "The structure lacks required value ~{~A~^.~}." ?path))))
        (%match-value-status ?expected-status ?actual-status ?span ?in ?next)
        (%realize-object ?expected-scheme (:realization ?next nil) ?realized-scheme)
        (%match-value-schemes ?realized-scheme ?actual-scheme ?span)
        (%match-required-values ?rest ?actual ?span ?next ?out))
    (<-- (%match-value-schemes ?expected-scheme ?actual-scheme ?span)
        (%freshen-signature-variables ?expected-scheme
                                      (scheme ?quantified ?body))
        (%rigid-signature-parameters ?quantified ?substitutions)
        (substitute-type-variables ?body ?substitutions ?expected-type)
        (free-type-variables ?actual-scheme ?weak-variables)
        (instantiate-type-scheme ?actual-scheme ?actual-type)
        (type-unify ?expected-type ?actual-type)
        (%signature-rigid-identities ?substitutions ?rigid-identities)
        (%reject-weak-rigid-capture ?weak-variables ?rigid-identities ?span))
    (<-- (%rigid-signature-parameters nil nil) !)
    (<- (%rigid-signature-parameters ((type-var ?cell ?kind ?equality) . ?rest)
                                    ((variable-map ?cell (@ ?rigid nil)) . ?maps))
        (lisp ?identity (%fresh-module-identity "signature-variable"))
        (or (-> (== ?equality :equality) (= ?attribute :equality))
            (= ?attribute :non-equality))
        (= ?rigid (type-name "'sig" ?identity 0 ?attribute :rigid))
        (%rigid-signature-parameters ?rest ?maps))
    (<-- (%signature-rigid-identities nil nil) !)
    (<- (%signature-rigid-identities
         ((variable-map ?cell (@ (type-name ?spelling ?identity ?arity ?equality ?flexibility) nil)) . ?rest)
         (?identity . ?identities))
        (%signature-rigid-identities ?rest ?identities))
    (<-- (%reject-weak-rigid-capture nil ?identities ?span) !)
    (<- (%reject-weak-rigid-capture (?variable . ?variables) ?identities ?span)
        (or (-> (%rigid-capture ?variable ?identities)
                (lisp (%module-fail ?span "A polymorphic signature would capture a weak mutable type variable.")))
            true)
        (%reject-weak-rigid-capture ?variables ?identities ?span))
    ;;; An unbound logical cell is not an open-ended cons tree.  Reject that
    ;;; search branch before the structural cases; bound weak cells still
    ;;; receive the full rigid-identity check after signature unification.
    (<-- (%rigid-capture ?variable ?identities)
        (var ?variable) ! (fail))
    (<- (%rigid-capture (type-name ?spelling ?identity ?arity ?equality ?flexibility) ?identities)
        (%rigid-identity-member ?identity ?identities))
    (<- (%rigid-capture (?head . ?tail) ?identities)
        (or (%rigid-capture ?head ?identities)
            (%rigid-capture ?tail ?identities)))
    (<-- (%rigid-identity-member ?identity (?identity . ?rest)) !)
    (<- (%rigid-identity-member ?identity (?other . ?rest))
        (%rigid-identity-member ?identity ?rest))
    (<-- (%match-value-status :variable ?actual ?span ?maps ?maps) !)
    (<- (%match-value-status (:constructor ?identity ?arity ?exception)
                            (:constructor ?actual-identity ?actual-arity ?actual-exception) ?span ?in ?out)
        (or (-> (and (== ?arity ?actual-arity) (== ?exception ?actual-exception)) true)
            (lisp (%module-fail ?span "Constructor status or payload arity does not match its signature.")))
        (%add-constructor-realization ?identity ?actual-identity ?span ?in ?out) !)
    (<- (%match-value-status ?expected ?actual ?span ?maps ?maps)
        (lisp (%module-fail ?span "A variable cannot satisfy a constructor specification.")))
    (<-- (%add-constructor-realization ?identity ?identity ?span ?maps ?maps) !)
    (<- (%add-constructor-realization ?identity ?actual ?span ?in ?out)
        (or (-> (%lookup-identity-realization ?identity ?in ?old)
                (or (-> (== ?old ?actual) (= ?out ?in))
                    (lisp (%module-fail ?span "A formal constructor is realized inconsistently."))))
            (= ?out ((:identity ?identity ?actual) . ?in))))
    (<-- (%match-required-structures nil ?actual ?bound-types ?span ?maps ?maps nil) !)
    (<- (%match-required-structures ((:structure ?name ?expected) . ?rest) ?actual ?bound-types ?span ?in ?out ?nested)
        (or (-> (%lookup-structure ?name ?actual ?found) true)
            (lisp (%module-fail ?span (format nil "The structure lacks required structure ~A." ?name))))
        (%match-view-from ?found ?expected ?bound-types ?span ?in ?next ?view)
        (%match-required-structures ?rest ?actual ?bound-types ?span ?next ?out ?others)
        (= ?nested ((:structure ?name ?view) . ?others)))
    (<-- (%projected-value-status :variable ?actual :variable) !)
    (<- (%projected-value-status ?expected ?actual ?actual) !)

    (<-- (%select-actual-values nil ?actual ?span nil) !)
    (<- (%select-actual-values ((:value ?path ?scheme ?host ?status) . ?rest) ?actual ?span
                               ((:value ?path ?actual-scheme ?actual-host ?selected-status) . ?values))
        (or (-> (%native-value-lookup ?path ?actual
                                      (:value ?actual-path ?actual-scheme ?actual-host ?actual-status)) true)
            (lisp (%module-fail ?span "A required value disappeared during signature selection.")))
        (%projected-value-status ?status ?actual-status ?selected-status)
        (%select-actual-values ?rest ?actual ?span ?values))
    (<-- (%select-actual-types nil ?actual ?span nil) !)
    (<- (%select-actual-types ((:tycon ?path ?definition) . ?rest) ?actual ?span
                              ((:tycon ?path ?actual-definition) . ?types))
        (or (-> (%native-type-lookup ?path ?actual ?actual-definition) true)
            (lisp (%module-fail ?span "A required type disappeared during signature selection.")))
        (%select-actual-types ?rest ?actual ?span ?types))

    ;;; Ascription computes static and dynamic views together.  Transparent
    ;;; matching preserves actual TypeNames.  Opaque sealing instead realizes
    ;;; the expected signature's own bound specifications with fresh names.
    (<-- (%apply-structure-signature ?context ?actual ?signature ?opaque ?span ?view
                                     (:se-project ?root ?view ?inner ?keys) ?inner)
        (%signature-expression ?context ?signature ?expected-signature)
        (= ?expected-signature
           (:signature-descriptor ?expected-view ?bound-types ?bound-constructors))
        (%match-view ?actual ?expected-signature ?span ?matched ?maps)
        (lisp ?root (%fresh-module-root "ascription"))
        (or (-> (= ?opaque t)
                (%opaque-view ?expected-view ?matched ?bound-types ?realized))
            (= ?realized ?matched))
        (%reroot-view ?realized ?root ?view)
        (%expected-field-keys ?expected-view ?keys))
    (<-- (%expected-field-keys (:view ?root ?static ?structures ?fields ?generations) ?keys)
        (%view-fields ?static ?structures nil ?all-fields)
        (%field-keys ?all-fields ?keys))
    (<-- (%field-keys nil nil) !)
    (<- (%field-keys ((:field ?key ?host) . ?rest) (?key . ?keys))
        (%field-keys ?rest ?keys))

    ;; Build the exported static environment from EXPECTED, not by inverting the
    ;; actual match realization.  Two abstract specifications may share one
    ;; actual type yet must seal to distinct names; conversely shared specs use
    ;; one canonical expected identity.  Actual hosts and constructor statuses
    ;; select the existing runtime values, while schemes and equality/arity
    ;; attributes come from the specification.
    (<-- (%opaque-view ?expected ?matched ?bound-types ?view)
        (%fresh-type-name-realization ?bound-types ?maps)
        (%opaque-export-view ?expected ?matched ?exported)
        (= ?realization (:realization ?maps nil))
        (%realize-view ?exported ?realization ?realized)
        (%realize-object ?bound-types ?realization ?fresh-types)
        (%refresh-opaque-generations ?realized ?fresh-types ?view))
    (<-- (%opaque-export-view (:view ?er (:static ?expected-values ?expected-types) ?expected-structures ?ef ?eg)
                              (:view ?mr (:static ?actual-values ?actual-types) ?actual-structures ?af ?ag)
                              ?view)
        (%opaque-export-values ?expected-values ?actual-values ?values)
        (%opaque-export-structures ?expected-structures ?actual-structures ?structures)
        (lisp ?root (%fresh-module-root "opaque-signature"))
        (%reroot-view (:view ?root (:static ?values ?expected-types) ?structures nil ?ag)
                      ?root ?rooted)
        (%view-fields (:static ?values ?expected-types) ?structures nil ?fields)
        (= ?rooted (:view ?root ?static ?nested-fields ?ignored-fields ?generations))
        (= ?view (:view ?root ?static ?nested-fields ?fields ?generations)))
    (<-- (%opaque-export-values nil ?actual nil) !)
    (<- (%opaque-export-values ((:value ?path ?scheme ?host ?status) . ?rest) ?actual
                               ((:value ?path ?scheme ?actual-host ?selected-status) . ?values))
        (%native-value-lookup ?path ?actual
                              (:value ?actual-path ?actual-scheme ?actual-host ?actual-status))
        (%projected-value-status ?status ?actual-status ?selected-status)
        (%opaque-export-values ?rest ?actual ?values))
    (<-- (%opaque-export-structures nil ?actual nil) !)
    (<- (%opaque-export-structures ((:structure ?name ?expected) . ?rest) ?actual
                                   ((:structure ?name ?view) . ?structures))
        (%lookup-structure ?name ?actual ?matched)
        (%opaque-export-view ?expected ?matched ?view)
        (%opaque-export-structures ?rest ?actual ?structures))
    (<-- (%refresh-opaque-generations (:view ?root ?static ?structures ?fields
                                             (:generations ?old-types ?constructors))
                                      ?fresh-types
                                      (:view ?root ?static ?new-structures ?fields
                                             (:generations ?new-types ?constructors)))
        (%refresh-opaque-structure-generations ?structures ?fresh-types ?new-structures)
        (%object-type-identities (:view ?root ?static ?new-structures ?fields (:generations nil nil))
                                 ?present-types)
        (%type-source-identities ?fresh-types ?fresh-identities)
        (%intersect-symbols ?fresh-identities ?present-types ?new-types))
    (<-- (%refresh-opaque-structure-generations nil ?fresh-types nil) !)
    (<- (%refresh-opaque-structure-generations ((:structure ?name ?view) . ?rest) ?fresh-types
                                              ((:structure ?name ?new-view) . ?structures))
        (%refresh-opaque-generations ?view ?fresh-types ?new-view)
        (%refresh-opaque-structure-generations ?rest ?fresh-types ?structures))
    (<-- (%intersect-symbols nil ?present nil) !)
    (<- (%intersect-symbols (?symbol . ?rest) ?present (?symbol . ?intersection))
        (%identity-present ?symbol ?present) !
        (%intersect-symbols ?rest ?present ?intersection))
    (<- (%intersect-symbols (?symbol . ?rest) ?present ?intersection)
        (%intersect-symbols ?rest ?present ?intersection))

    ;;; Functor declarations retain one elaborated generic body.  Applications
    ;;; realize formal identities and freshen only names/constructors generated
    ;;; in that body; captured Basis and datatype-replication identities remain.
    (<-- (%functor-declaration ?old (:node :functor-declaration ?span ((:bindings . ?bindings))) ?out)
        (%functor-group ?old ?bindings ?pairs)
        (%publish-functors ?pairs ?old ?out))
    (<-- (%functor-group ?old nil nil) !)
    (<- (%functor-group ?old ((:node :functor-binding ?span ?slots) . ?rest)
                            ((:functor ?name ?template) . ?pairs))
        (%functor-binding ?old (:node :functor-binding ?span ?slots) ?name ?template)
        (%functor-group ?old ?rest ?pairs))
    (<-- (%publish-functors ?pairs (:module-context ?core ?structures ?signatures ?functors)
                            (:module-context ?core ?structures ?signatures ?out))
        (%publish-functor-list ?pairs ?functors ?out))
    (<-- (%publish-functor-list nil ?functors ?functors) !)
    (<- (%publish-functor-list ((:functor ?name ?template) . ?rest) ?in ?out)
        (%put-functor ?name ?template ?in ?next)
        (%publish-functor-list ?rest ?next ?out))
    (<-- (%functor-binding ?outer
                           (:node :functor-binding ?span
                                  ((:name . ?name-ast) (:parameter . ?parameter)
                                   (:parameter-signature . ?parameter-signature)
                                   (:opened-parameter . ?opened)
                                   (:result-signature . ?result) (:opaque-p . ?opaque)
                                   (:body . ?body)))
                           ?name ?template)
        (lisp ?name (%name ?name-ast))
        (or (-> (= ?opened nil)
                (%named-functor-parameter ?outer ?parameter ?parameter-signature ?span
                                          ?kind ?parameter-name ?formal-signature ?formal-root ?body-context))
            (%opened-functor-parameter ?outer ?opened ?span
                                       ?kind ?parameter-name ?formal-signature ?formal-root ?body-context))
        (= ?formal-signature
           (:signature-descriptor ?formal ?formal-bound-types ?formal-bound-constructors))
        (%structure-expression ?body-context ?body ?raw-view ?body-expression)
        (or (-> (= ?result nil)
                (and (= ?view ?raw-view) (= ?semantic ?body-expression)))
            (%apply-structure-signature ?body-context ?raw-view ?result ?opaque ?span ?view ?semantic ?body-expression))
        (= ?outer (:module-context ?outer-core ?outer-structures ?outer-signatures ?outer-functors))
        (%nested-generations ?outer-structures ?ignored-captured-types ?captured-constructors)
        (%object-type-identities (:module-context ?outer-core ?outer-structures nil nil)
                                 ?captured-types)
        (%object-type-identities ?formal ?formal-types)
        (%view-generations ?formal (:generations ?ignored-formal-types ?formal-constructors))
        (%append ?captured-types ?formal-types ?all-captured-types)
        (%append ?captured-constructors ?formal-constructors ?all-captured-constructors)
        (= ?template (:functor-template ?kind ?parameter-name ?formal-signature ?formal-root
                                        ?all-captured-types ?all-captured-constructors ?view ?semantic)))
    (<-- (%named-functor-parameter ?outer ?parameter ?signature ?span :named ?parameter-name
                                  (:signature-descriptor ?formal ?bound-types ?bound-constructors)
                                  ?formal-root ?body-context)
        (lisp ?parameter-name (%name ?parameter))
        (%signature-expression ?outer ?signature
                               (:signature-descriptor ?expected ?bound-types ?bound-constructors))
        (lisp ?formal-root (%fresh-module-root ?parameter-name))
        (%reorigin-view ?expected ?formal-root ?formal)
        (%publish-structures ((:structure ?parameter-name ?formal)) ?outer ?body-context))
    (<-- (%opened-functor-parameter ?outer ?opened ?span :opened nil ?formal-signature ?formal-root ?body-context)
        (%specification ?outer ?opened ?parameter-context ?semantics)
        (lisp ?formal-root (%fresh-module-root "parameter"))
        (%state-view ?parameter-context ?outer ?formal-root ?semantics ?raw-formal)
        (%reorigin-view ?raw-formal ?formal-root ?formal)
        (%make-signature-descriptor ?outer ?formal ?formal-signature)
        (%open-formal-view ?outer ?formal ?body-context))
    (<-- (%open-formal-view (:module-context (:static ?values ?types) ?structures ?signatures ?functors)
                           (:view ?root (:static ?new-values ?new-types) ?new-structures ?fields ?generations)
                           (:module-context (:static ?all-values ?all-types) ?all-structures ?signatures ?functors))
        (%append ?new-values ?values ?all-values)
        (%append ?new-types ?types ?all-types)
        (%include-structure-list ?new-structures ?structures ?all-structures))

    (<-- (%functor-argument ?context (:node ?kind ?node-span ?slots) ?declarations ?span ?view ?semantic)
        ! (%structure-expression ?context (:node ?kind ?node-span ?slots) ?view ?semantic))
    (<- (%functor-argument ?context nil ?declarations ?span ?view
                           (:se-basic ?root ?view ?items))
        (lisp ?root (%fresh-module-root "argument"))
        (%module-declarations ?context ?declarations ?inner ?items)
        (%state-view ?inner ?context ?root ?items ?view))
    (<-- (%functor-application ?context ?functor ?argument ?declarations ?span ?view
                               (:se-apply ?root ?view ?formal-root ?actual-semantic ?body))
        (lisp ?name (%name ?functor))
        (= ?context (:module-context ?core ?structures ?signatures ?functors))
        (or (-> (%lookup-functor ?name ?functors
                                (:functor-template ?kind ?parameter-name ?formal-signature ?formal-root
                                                   ?captured-types ?captured-constructors ?template-view ?template-body)) true)
            (lisp (%module-fail ?span (format nil "Unbound functor ~A." ?name))))
        (= ?formal-signature
           (:signature-descriptor ?formal ?formal-bound-types ?formal-bound-constructors))
        (%functor-argument ?context ?argument ?declarations ?span ?actual ?source)
        (%match-view ?actual ?formal-signature ?span ?matched-argument ?formal-maps)
        (= ?matched-argument (:view ?argument-root ?argument-static ?argument-structures ?argument-fields ?argument-generations))
        (%expected-field-keys ?formal ?keys)
        (= ?actual-semantic (:se-project ?argument-root ?matched-argument ?source ?keys))
        (%fresh-body-realization ?template-view ?template-body ?formal-maps
                                 ?captured-types ?captured-constructors ?realization)
        (%realize-view ?template-view ?realization ?instance-view)
        (%realize-object ?template-body ?realization ?body)
        (lisp ?root (%fresh-module-root ?name))
        (%reroot-view ?instance-view ?root ?view))
    (<-- (%fresh-body-realization (:view ?root ?static ?structures ?fields (:generations ?types ?constructors))
                                 ?body ?formal-maps ?captured-types ?captured-constructors
                                 (:realization ?names ?identities))
        (%without-symbols ?constructors ?captured-constructors ?generated-constructors)
        (%all-type-names ((:view ?root ?static ?structures ?fields (:generations ?types ?constructors)) ?body)
                         ?all-names)
        (%uncaptured-type-names ?all-names ?captured-types ?generated-names)
        (%fresh-type-name-realization ?generated-names ?fresh-names)
        (%type-name-identity-map ?fresh-names ?type-identities)
        (%fresh-constructor-identity-map ?generated-constructors ?constructor-identities)
        (%append ?type-identities ?constructor-identities ?fresh-identities)
        (%split-formal-realizations ?formal-maps ?formal-names ?formal-identities)
        (%append ?formal-names ?fresh-names ?names)
        (%append ?formal-identities ?fresh-identities ?identities))
    (<-- (%split-formal-realizations nil nil nil) !)
    (<- (%split-formal-realizations ((name-map ?source ?target) . ?rest) ((name-map ?source ?target) . ?names) ?identities)
        ! (%split-formal-realizations ?rest ?names ?identities))
    (<- (%split-formal-realizations ((:identity ?old ?new) . ?rest) ?names ((:identity ?old ?new) . ?identities))
        (%split-formal-realizations ?rest ?names ?identities))
    (<-- (%all-type-names ?object ?names)
        (%collect-type-names ?object ?raw)
        (%unique-native-type-names ?raw nil ?names))
    (<-- (%collect-type-names ?object nil)
        (var ?object) !)
    (<- (%collect-type-names (type-name ?spelling ?identity ?arity ?equality ?flexibility)
                             ((type-name ?spelling ?identity ?arity ?equality ?flexibility))) !)
    (<- (%collect-type-names (?head . ?tail) ?names)
        ! (%collect-type-names ?head ?left)
        (%collect-type-names ?tail ?right)
        (%append ?left ?right ?names))
    (<- (%collect-type-names ?other nil) !)
    (<-- (%unique-native-type-names nil ?seen nil) !)
    (<- (%unique-native-type-names ((type-name ?spelling ?identity ?arity ?equality ?flexibility) . ?rest)
                                  ?seen ?names)
        (%identity-present ?identity ?seen) !
        (%unique-native-type-names ?rest ?seen ?names))
    (<- (%unique-native-type-names ((type-name ?spelling ?identity ?arity ?equality ?flexibility) . ?rest)
                                  ?seen
                                  ((type-name ?spelling ?identity ?arity ?equality ?flexibility) . ?names))
        (%unique-native-type-names ?rest (?identity . ?seen) ?names))
    (<-- (%identity-present ?identity (?identity . ?rest)) !)
    (<- (%identity-present ?identity (?other . ?rest))
        (%identity-present ?identity ?rest))
    (<-- (%object-type-identities ?object ?identities)
        (%all-type-names ?object ?names)
        (%type-source-identities ?names ?identities))
    (<-- (%type-source-identities nil nil) !)
    (<- (%type-source-identities ((type-name ?spelling ?identity ?arity ?equality ?flexibility) . ?rest)
                                (?identity . ?identities))
        (%type-source-identities ?rest ?identities))
    (<-- (%uncaptured-type-names nil ?captured nil) !)
    (<- (%uncaptured-type-names ((type-name ?spelling ?identity ?arity ?equality ?flexibility) . ?rest)
                               ?captured ?names)
        (%identity-present ?identity ?captured) !
        (%uncaptured-type-names ?rest ?captured ?names))
    (<- (%uncaptured-type-names ((type-name ?spelling ?identity ?arity ?equality ?flexibility) . ?rest)
                               ?captured
                               ((type-name ?spelling ?identity ?arity ?equality ?flexibility) . ?names))
        (%uncaptured-type-names ?rest ?captured ?names))
    (<-- (%fresh-type-name-realization nil nil) !)
    (<- (%fresh-type-name-realization ((type-name ?spelling ?identity ?arity ?equality ?flexibility) . ?rest)
                                     ((name-map (type-name ?spelling ?identity ?arity ?equality ?flexibility)
                                                (type-name ?spelling ?fresh ?arity ?equality :rigid)) . ?maps))
        (lisp ?fresh (%fresh-module-identity ?spelling))
        (%fresh-type-name-realization ?rest ?maps))
    (<-- (%without-symbols ?symbols nil ?symbols) !)
    (<- (%without-symbols ?symbols (?excluded . ?rest) ?out)
        (%delete-symbol ?excluded ?symbols ?next)
        (%without-symbols ?next ?rest ?out))
    (<-- (%type-name-identity-map nil nil) !)
    (<- (%type-name-identity-map ((name-map (type-name ?spelling ?identity ?arity ?equality ?flexibility)
                                           (type-name ?new-spelling ?new-identity ?new-arity ?new-equality ?new-flexibility)) . ?rest)
                                ((:identity ?identity ?new-identity) . ?maps))
        (%type-name-identity-map ?rest ?maps))
    (<-- (%fresh-constructor-identity-map nil nil) !)
    (<- (%fresh-constructor-identity-map (?identity . ?rest) ((:identity ?identity ?fresh) . ?maps))
        (lisp ?fresh (%fresh-module-identity "constructor"))
        (%fresh-constructor-identity-map ?rest ?maps))

    ;;; Complete programs, including adjacent topdec components and interactive
    ;;; expressions.  No alternative Core-only fallback follows module failure.
    (<-- (%module-topdeclarations ?context nil ?context nil nil) !)
    (<- (%module-topdeclarations ?in (?top . ?rest) ?out ?items ?result)
        (%context-static ?in ?static)
        (ooparts/sml/elaborate::%static-weak-type-variables ?static ?weak)
        (or (-> (= ?weak nil) true)
            (ooparts/sml/elaborate::%static-free-type-names ?static ?visible-names))
        (%module-topdeclaration ?in ?top ?next ?first ?first-result)
        (%module-topdeclarations ?next ?rest ?out ?others ?other-result)
        (lisp ?span (ast-node-span ?top))
        (or (-> (= ?weak nil) true)
            (and (ooparts/sml/elaborate::%weak-type-scope ?weak ?resolved-names)
                 (or (-> (ooparts/sml/elaborate::%type-names-subset ?resolved-names ?visible-names) true)
                     (lisp (ooparts/sml/elaborate::%fail ?span "An older monomorphic type variable acquired a later datatype identity.")))))
        (%append ?first ?others ?items)
        (or (-> (= ?other-result nil) (= ?result ?first-result))
            (= ?result ?other-result)))
    (<-- (%module-topdeclaration ?in (:node :topdec-structure ?span ((:declarations . ?declarations)))
                                ?out ?items nil)
        ! (%module-declarations ?in ?declarations ?out ?items))
    (<- (%module-topdeclaration ?in (:node :topdec-sequence ?span ((:topdeclarations . ?tops)))
                               ?out ?items ?result)
        ! (%module-topdeclarations ?in ?tops ?out ?items ?result))
    (<- (%module-topdeclaration ?in (:node :signature-declaration ?span ?slots) ?out ((:m-empty)) nil)
        ! (%signature-declaration ?in (:node :signature-declaration ?span ?slots) ?out))
    (<- (%module-topdeclaration ?in (:node :functor-declaration ?span ?slots) ?out ((:m-empty)) nil)
        ! (%functor-declaration ?in (:node :functor-declaration ?span ?slots) ?out))
    (<- (%module-topdeclaration ?in (:node :toplevel-expression ?span
                                           ((:expression . ?expression) (:binding-name . ?binding-name)))
                                ?out ((:m-core (:d-expression ?name ?host ?semantic))) ?semantic)
        ! (%context-static ?in ?static)
        (ooparts/sml/elaborate::%seed-type-variables ?expression nil ?scope)
        (ooparts/sml/elaborate::%expression ?static ?scope ?expression ?semantic)
        (ooparts/sml/elaborate::%resolve-overloads ?semantic ?static)
        (ooparts/sml/elaborate::%type ?semantic ?type)
        (lisp ?name (%name ?binding-name))
        (lisp ?host (ooparts/sml/elaborate::%fresh-binding ?name))
        (= ?static (:static ?values ?types))
        (= ?static-type-environment (type-env ?bindings))
        (ooparts/sml/elaborate::%static-type-environment ?static ?static-type-environment)
        (or (-> (ooparts/sml/elaborate::%nonexpansive ?semantic)
                (= ?eligibility :nonexpansive))
            (= ?eligibility :value-restriction))
        (generalize-type ?type ?static-type-environment nil ?eligibility ?scheme)
        (= ?in (:module-context (:static ?root-values ?root-types) ?structures ?signatures ?functors))
        (= ?out (:module-context (:static ((:value (?name) ?scheme ?host :variable) . ?root-values) ?root-types)
                                 ?structures ?signatures ?functors)))

    (--> (module-program ?context (:node :program ?span ((:topdeclarations . ?tops)))
                         ?out ?static (:m-program ?items ?result))
         (do (%module-topdeclarations ?context ?tops ?out ?items ?result)
             (%context-static ?out ?static)))
    (--> (module-program ?context (:node :declaration-sequence ?span ((:declarations . ?declarations)))
                         ?out ?static (:m-program ?items nil))
         (do (%module-declarations ?context ?declarations ?out ?items)
             (%context-static ?out ?static)))

    ;;; Native emission.  Core declaration wrappers are reused, while module
    ;;; boundaries add only lexical roots and immutable view construction.
    (<-- (%module-interface nil ?lexicals ?lexicals nil) !)
    (<- (%module-interface (?item . ?items) ?lexicals ?out ?updates)
        (%module-item-interface ?item ?lexicals ?next ?first)
        (%module-interface ?items ?next ?out ?rest)
        (%append ?first ?rest ?updates))
    (<-- (%module-item-interface (:m-core ?declaration) ?lexicals ?out ?updates)
        (ooparts/sml/emit::%declaration-interface ?declaration ?lexicals ?out ?updates))
    (<- (%module-item-interface (:m-structures ?bindings) ?lexicals ?out ?updates)
        (%module-bindings-interface ?bindings ?lexicals ?out ?updates))
    (<-- (%module-bindings-interface nil ?lexicals ?lexicals nil) !)
    (<- (%module-bindings-interface ((:m-bind ?name ?root ?view ?expression) . ?rest) ?lexicals ?out ?updates)
        (%module-bindings-interface ?rest (?root . ?lexicals) ?out ?others)
        (= ?updates (?root . ?others)))
    (<- (%module-item-interface (:m-local ?local ?body) ?lexicals ?out ?updates)
        (%module-interface ?body ?lexicals ?out ?updates))
    (<- (%module-item-interface (:m-empty) ?lexicals ?lexicals nil) !)

    (<-- (%emit-module-items nil ?lexicals nil ?updates ?updates
                            (values +unit+ (list . ?forms)))
        (ooparts/sml/emit::%emit-updates ?updates ?forms))
    (<- (%emit-module-items nil ?lexicals ?result ?updates ?updates
                           (values ?result (list . ?forms)))
        (ooparts/sml/emit::%emit-updates ?updates ?forms))
    (<- (%emit-module-items (?item . ?items) ?lexicals ?result ?collected ?updates ?form)
        (%module-item-interface ?item ?lexicals ?next ?first)
        (%append ?collected ?first ?next-collected)
        (%emit-module-items ?items ?next ?result ?next-collected ?updates ?rest)
        (%emit-module-declaration ?item ?lexicals ?rest ?form))
    (<-- (%emit-local-module-items nil ?lexicals ?body ?body) !)
    (<- (%emit-local-module-items (?item . ?items) ?lexicals ?body ?form)
        (%module-item-interface ?item ?lexicals ?next ?updates)
        (%emit-local-module-items ?items ?next ?body ?rest)
        (%emit-module-declaration ?item ?lexicals ?rest ?form))
    (<-- (%emit-module-declaration (:m-core ?declaration) ?lexicals ?body ?form)
        (ooparts/sml/emit::%emit-declaration ?declaration ?lexicals ?body ?form))
    (<- (%emit-module-declaration (:m-structures ?bindings) ?lexicals ?body ?form)
        (%emit-module-bindings ?bindings ?lexicals ?body ?form))
    (<-- (%emit-module-bindings nil ?lexicals ?body ?body) !)
    (<- (%emit-module-bindings ((:m-bind ?name ?root ?view ?expression) . ?rest) ?lexicals ?body ?form)
        (%emit-structure-expression ?expression ?lexicals ?code)
        (%emit-module-bindings ?rest (?root . ?lexicals) ?body ?inner)
        (= ?form (let ((?root ?code)) ?inner)))
    (<- (%emit-module-declaration (:m-local ?local ?body) ?lexicals ?result ?form)
        (%module-interface ?local ?lexicals ?local-lexicals ?ignored)
        (%module-interface ?body ?local-lexicals ?inner-lexicals ?updates)
        (%emit-local-module-items ?body ?local-lexicals ?result ?body-form)
        (%emit-local-module-items ?local ?lexicals ?body-form ?form))
    (<- (%emit-module-declaration (:m-empty) ?lexicals ?body ?body) !)

    (<-- (%emit-structure-expression (:se-basic ?root (:view ?view-root ?static ?structures ?fields ?generations)
                                                ?items)
                                     ?lexicals ?form)
        (%module-interface ?items ?lexicals ?inner-lexicals ?updates)
        (%emit-module-fields ?fields ?inner-lexicals ?field-forms)
        (= ?body (make-sml-module (list . ?field-forms)))
        (%emit-local-module-items ?items ?lexicals ?body ?form))
    (<-- (%emit-module-fields nil ?lexicals nil) !)
    (<- (%emit-module-fields ((:field ?key ?host) . ?rest) ?lexicals
                             ((cons (quote ?key) ?code) . ?fields))
        (ooparts/sml/emit::%emit-variable ?host ?lexicals ?code)
        (%emit-module-fields ?rest ?lexicals ?fields))
    (<- (%emit-structure-expression (:se-alias ?root ?view ?origin) ?lexicals ?code)
        (ooparts/sml/emit::%emit-variable ?origin ?lexicals ?code))
    (<- (%emit-structure-expression (:se-let ?declarations ?body) ?lexicals ?form)
        (%module-interface ?declarations ?lexicals ?inner-lexicals ?updates)
        (%emit-structure-expression ?body ?inner-lexicals ?body-code)
        (%emit-local-module-items ?declarations ?lexicals ?body-code ?form))
    (<- (%emit-structure-expression (:se-project ?root ?view ?inner ?keys) ?lexicals
                                     (project-sml-module ?code (quote ?keys)))
        (%emit-structure-expression ?inner ?lexicals ?code))
    (<- (%emit-structure-expression (:se-apply ?root ?view ?formal-root ?argument ?body)
                                     ?lexicals (funcall (lambda/c (?formal-root) ?body-code) ?argument-code))
        (%emit-structure-expression ?argument ?lexicals ?argument-code)
        (%emit-structure-expression ?body (?formal-root . ?lexicals) ?body-code))

    (<-- (%provided-module-emission-input ?input)
        (lisp ?input (%module-emission-input)))
    (--> (emit-module-program (:m-program ?items ?result) ?code)
         (do (%module-result-host ?items ?host)
             (%emit-module-items ?items nil ?host nil ?updates ?body)
             (= ?code (lambda/c (ooparts/sml/emit::%environment) ?body))))

    (<- (emit-module-program-partitioned (:m-program ?items ?ignored) ?database ?code)
        (lisp ?code (%emit-module-program-parts-outer ?items ?database)))
    (<-- (%module-result-host nil nil) !)
    (<- (%module-result-host ((:m-core (:d-expression ?name ?host ?expression))) ?host) !)
    (<- (%module-result-host (?item) nil) !)
    (<- (%module-result-host (?item . ?items) ?host)
        (%module-result-host ?items ?host))

    ;;; Persistent freezing/thawing shares one type-variable map across the
    ;;; entire forest and all saved generic functor templates.
    (<-- (thaw-module-context ?frozen ?live)
        (ooparts/sml/elaborate::%thaw-native ?frozen nil ?ignored ?live))
    (<-- (freeze-module-context ?live ?frozen)
        (ooparts/sml/elaborate::%freeze-native ?live nil ?ignored ?frozen))
    database))
