(uiop:define-package #:ooparts-tests/advice/behavior
  (:use #:cl)
  (:import-from #:ooparts/advice #:advice-add #:advice-remove #:advice-member-p
                #:advice-mapc #:define-advice #:advice-status)
  (:import-from #:ooparts/host #:threads-supported-p #:call-in-thread #:collect-garbage)
  (:export #:run-audit))
(in-package #:ooparts-tests/advice/behavior)

(defvar *directory*)
(defvar *counter* 0)
(defvar *serial* 0)
(defvar *records*)

(defun invoke (name &rest args) (apply (fdefinition name) args))
(defun invoke-object (function &rest args) (apply function args))
(defun base (x) (values (1+ x) :secondary))
(defun fresh-base ()
  ;; Each probe owns a distinct closure, including on hosts with in-place tracing.
  (let ((last-input (list nil)))
    (lambda (x) (setf (car last-input) x) (values (1+ x) :secondary))))
(defun replacement (x) (values (+ x 2) :secondary))
(defun twice (next &rest args)
  (let ((values (multiple-value-list (apply next args))))
    (values-list (cons (* 2 (first values)) (rest values)))))
(defun count-call (&rest args) (declare (ignore args)) (incf *counter*))
(defun ignored (&rest args) (declare (ignore args)) :ignored)

(defun condition-kind (condition)
  (cond ((typep condition 'undefined-function) "UNDEFINED-FUNCTION")
        ((typep condition 'type-error) "TYPE-ERROR")
        ((typep condition 'program-error) "PROGRAM-ERROR")
        (t "ERROR")))

(defun record (id thunk)
  (when (member id *records* :test #'string=) (error "Duplicate audit ID: ~A" id))
  (push id *records*)
  (let ((*print-pretty* nil) (*print-length* nil) (*print-level* nil)
        (*print-circle* t) (*package* (find-package :cl-user)))
    (handler-case
        (let ((values (multiple-value-list (funcall thunk))))
          (format t "~&AUDIT|~A|VALUE|~S~%" id values))
      (error (condition)
        (format t "~&AUDIT|~A|ERROR|~A~%" id (condition-kind condition)))))
  (finish-output))

(defmacro observe (id &body body) `(record ,id (lambda () ,@body)))

(defun new-name ()
  (intern (format nil "TEMP-~D" (incf *serial*)) *package*))

(defun clear-advice (name)
  (let ((functions nil))
    (advice-mapc (lambda (function properties)
                  (declare (ignore properties)) (push function functions)) name)
    (dolist (function functions) (advice-remove name function))))

(defmacro with-function ((name &optional (definition '(fresh-base))) &body body)
  `(let ((,name (new-name)))
     (setf (fdefinition ,name) ,definition)
     (unwind-protect (progn ,@body)
       (clear-advice ,name)
       (when (fboundp ,name) (fmakunbound ,name)))))

(defun registry-names (name)
  (let ((names nil))
    (advice-mapc (lambda (function properties)
                  (declare (ignore function)) (push (getf properties :name) names)) name)
    (reverse names)))

(defun audit-combinators ()
  (dolist (where '(:before :after :around :override :filter-args :filter-return
                   :before-while :before-until :after-while :after-until))
    (observe (format nil "combinator.~(~A~)" where)
      (let ((events nil))
        (with-function (name (lambda (x) (push :base events) (values (1+ x) :secondary)))
          (advice-add name where
                      (case where
                        (:around (lambda (next x) (push :advice events) (funcall next (+ x 10))))
                        (:filter-args (lambda (args) (push :advice events) (list (+ (first args) 10))))
                        (:filter-return (lambda (x) (push :advice events) (values (* 2 x) :filtered)))
                        (otherwise (lambda (&rest args) (declare (ignore args))
                                     (push :advice events) (values t :advice)))))
          (let ((result (multiple-value-list (invoke name 10))))
            (values result (reverse events)))))))
  (dolist (where '(:before-while :before-until :after-while :after-until))
    (observe (format nil "short-circuit.~(~A~).false" where)
      (with-function (name (lambda () (values nil :base)))
        (advice-add name where (lambda () (values nil :advice)))
        (invoke name)))
    (observe (format nil "short-circuit.~(~A~).zero" where)
      (with-function (name (lambda () (values)))
        (advice-add name where (lambda () (values)))
        (invoke name))))
  (dolist (where '(:before :after :around :override :filter-args :filter-return))
    (observe (format nil "zero-values.~(~A~)" where)
      (with-function (name (lambda () (values)))
        (advice-add name where
                    (case where
                      (:around (lambda (next) (funcall next)))
                      (:filter-args #'identity)
                      (:filter-return (lambda (value) (values value :filtered)))
                      (otherwise (lambda () (values)))))
        (invoke name))))
  (observe "arguments.optional-rest-key"
    (with-function (name (lambda (x &optional (y 2) &rest rest)
                          (values x y rest)))
      (advice-add name :around (lambda (next &rest args) (apply next args)))
      (invoke name 1 3 :key 4)))
  (observe "arguments.keyword-defaults"
    (with-function (name (lambda (&key (x 2)) x))
      (advice-add name :around (lambda (next &rest args) (apply next args)))
      (invoke name)))
  (observe "arguments.wrong-arity"
    (with-function (name) (advice-add name :before #'ignored) (invoke name)))
  (observe "filter-args.improper-list"
    (with-function (name)
      (advice-add name :filter-args (lambda (args) (declare (ignore args)) '(1 . 2)))
      (invoke name 10)))
  (observe "around.skip-next"
    (with-function (name) (advice-add name :around (lambda (&rest args)
                                                   (declare (ignore args)) (values 99 :skip)))
      (invoke name 10)))
  (observe "around.next-twice"
    (let ((calls 0))
      (with-function (name (lambda (x) (incf calls) x))
        (advice-add name :around (lambda (next x) (+ (funcall next x) (funcall next (1+ x)))))
        (values (invoke name 10) calls))))
  (observe "around.escaped-next-after-return"
    (let ((next nil))
      (with-function (name)
        (advice-add name :around (lambda (function x) (setf next function) (funcall function x)))
        (invoke name 10)
        (funcall next 20))))
  (observe "around.escaped-next-after-remove"
    (let ((next nil))
      (with-function (name)
        (advice-add name :around (lambda (function x) (setf next function) (funcall function x)) '(:name :capture))
        (invoke name 10)
        (advice-remove name :capture)
        (funcall next 20))))
  (observe "nonlocal.after-skipped-on-throw"
    (let ((ran nil))
      (with-function (name (lambda () (throw 'done :thrown)))
        (advice-add name :after (lambda () (setf ran t)))
        (values (catch 'done (invoke name)) ran))))
  (observe "nonlocal.after-skipped-on-error"
    (let ((ran nil))
      (with-function (name (lambda () (error "expected")))
        (advice-add name :after (lambda () (setf ran t)))
        (handler-case (invoke name) (error () nil))
        ran)))
  (observe "nonlocal.around-unwind-protect"
    (let ((cleaned nil))
      (with-function (name (lambda () (throw 'done :thrown)))
        (advice-add name :around (lambda (next)
                                  (unwind-protect (funcall next) (setf cleaned t))))
        (values (catch 'done (invoke name)) cleaned))))
  (observe "nonlocal.advice-error-skips-base"
    (let ((ran nil))
      (with-function (name (lambda () (setf ran t)))
        (advice-add name :before (lambda () (error "expected")))
        (handler-case (invoke name) (error () nil))
        ran))))

(defun audit-registry ()
  (observe "registry.add-remove-return-values"
    (with-function (name)
      (list (advice-add name :before #'ignored)
            (advice-remove name #'ignored)
            (advice-remove name :missing))))
  (observe "registry.depth-and-ties"
    (with-function (name)
      (dolist (pair '((:middle 0) (:outer -10) (:inner 10) (:newest 0)))
        (advice-add name :before #'ignored (list :name (first pair) :depth (second pair))))
      (registry-names name)))
  (observe "registry.after-reverses-nesting"
    (let ((events nil))
      (with-function (name (lambda () (push :base events)))
        (dolist (id '(:old :new))
          (let ((id id)) (advice-add name :after (lambda () (push id events)) (list :name id))))
        (invoke name)
        (reverse events))))
  (observe "registry.replace-name-and-depth"
    (with-function (name)
      (advice-add name :before #'ignored '(:name :one :depth -10))
      (advice-add name :before #'ignored '(:name :two))
      (advice-add name :after #'count-call '(:name :one :depth 10))
      (registry-names name)))
  (observe "registry.replace-unnamed-function"
    (with-function (name)
      (advice-add name :before #'ignored)
      (advice-add name :after #'ignored)
      (registry-names name)))
  (observe "registry.function-and-symbol-distinct"
    (with-function (name)
      (advice-add name :before #'ignored)
      (advice-add name :before 'ignored)
      (length (registry-names name))))
  (observe "registry.same-function-multiple-names"
    (with-function (name)
      (advice-add name :before #'ignored '(:name :a))
      (advice-add name :before #'ignored '(:name :b))
      (let ((before (registry-names name)))
        (advice-remove name #'ignored)
        (values before (registry-names name)))))
  (observe "registry.equal-string-names"
    (with-function (name)
      (advice-add name :before #'ignored (list :name (copy-seq "same")))
      (advice-add name :after #'ignored (list :name (copy-seq "same")))
      (values (length (registry-names name)) (advice-member-p (copy-seq "same") name))))
  (observe "registry.symbol-name-package-identity"
    (with-function (name)
      (let ((one (make-symbol "SAME")) (two (make-symbol "SAME")))
        (advice-add name :before #'ignored (list :name one))
        (values (advice-member-p one name) (advice-member-p two name)))))
  (observe "registry.nil-name-is-anonymous"
    (with-function (name)
      (advice-add name :before #'ignored '(:name nil))
      (values (advice-member-p nil name) (advice-member-p #'ignored name))))
  (observe "registry.mapc-snapshot-and-removal"
    (with-function (name)
      (advice-add name :before #'ignored '(:name :a))
      (advice-add name :before #'count-call '(:name :b))
      (let ((seen nil))
        (advice-mapc (lambda (function props)
                      (push (getf props :name) seen) (advice-remove name function)) name)
        (values (reverse seen) (registry-names name)))))
  (observe "registry.mapc-properties-copy"
    (with-function (name)
      (let ((props (list :name :original :custom :kept)))
        (advice-add name :before #'ignored props)
        (setf (getf props :name) :changed)
        (advice-mapc (lambda (function properties)
                      (declare (ignore function)) (setf (getf properties :name) :changed)) name)
        (registry-names name))))
  (observe "registry.mapc-shallow-copy"
    (with-function (name)
      (let ((nested (list :original)) (result nil))
        (advice-add name :before #'ignored (list :nested nested))
        (setf (first nested) :changed)
        (advice-mapc (lambda (function props)
                      (declare (ignore function)) (setf result (getf props :nested))) name)
        result)))
  (observe "registry.update-during-active-call"
    (let ((events nil))
      (with-function (name (lambda () (push :base events)))
        (advice-add name :around
                    (lambda (next)
                      (advice-add name :before (lambda () (push :new events)) '(:name :new))
                      (funcall next)) '(:name :updater))
        (invoke name)
        (let ((first (reverse events)))
          (setf events nil) (invoke name) (values first (reverse events))))))
  (observe "registry.remove-during-active-call"
    (let ((events nil))
      (with-function (name (lambda () (push :base events)))
        (advice-add name :before (lambda () (push :inner events)) '(:name :inner))
        (advice-add name :around (lambda (next) (advice-remove name :inner) (funcall next)) '(:name :outer))
        (invoke name)
        (let ((first (reverse events)))
          (setf events nil) (invoke name) (values first (reverse events))))))
  (observe "designator.symbol-follows-redefinition"
    (with-function (name)
      (with-function (adviser (lambda (next &rest args) (apply next args)))
        (advice-add name :around adviser)
        (setf (fdefinition adviser) #'twice)
        (invoke name 10))))
  (observe "designator.object-keeps-old-definition"
    (with-function (name)
      (with-function (adviser (lambda (next &rest args) (apply next args)))
        (advice-add name :around (fdefinition adviser))
        (setf (fdefinition adviser) #'twice)
        (invoke name 10))))
  (observe "designator.symbol-fmakunbound"
    (with-function (name)
      (with-function (adviser #'ignored)
        (advice-add name :before adviser)
        (fmakunbound adviser)
        (invoke name 10)))))

(defun audit-objects ()
  (with-function (name)
    (let ((original (fdefinition name)) (sharp (eval `(function ,name))))
      (advice-add name :around #'twice '(:name :double))
      (observe "object.saved-fdefinition-before-add" (invoke-object original 10))
      (observe "object.saved-function-before-add" (invoke-object sharp 10))
      (observe "object.late-fdefinition" (invoke name 10))
      (observe "object.late-symbol-function" (funcall (symbol-function name) 10))
      (observe "object.late-function" (funcall (eval `(function ,name)) 10))
      (observe "object.runtime-symbol-designator" (funcall name 10))
      (let ((captured (fdefinition name)))
        (observe "object.identity-before-vs-after-add" (eq original captured))
        (observe "object.identity-fdefinition-vs-symbol-function" (eq captured (symbol-function name)))
        (advice-add name :around #'twice '(:name :second))
        (observe "object.saved-wrapper-sees-addition" (invoke-object captured 10))
        (advice-remove name :second)
        (observe "object.saved-wrapper-sees-partial-removal" (invoke-object captured 10))
        (advice-remove name :double)
        (observe "object.current-after-last-removal" (invoke name 10))
        (observe "object.saved-wrapper-after-last-removal" (invoke-object captured 10))
        (advice-add name :override (lambda (&rest args) (declare (ignore args)) 99) '(:name :fresh))
        (observe "object.saved-wrapper-after-readd" (invoke-object captured 10))
        (observe "object.current-after-readd" (invoke name 10)))))
  (observe "object.alias-bound-before-add"
    (with-function (name)
      (with-function (alias (fdefinition name))
        (advice-add name :around #'twice)
        (invoke alias 10))))
  (observe "object.alias-bound-after-add"
    (with-function (name)
      (advice-add name :around #'twice)
      (with-function (alias (fdefinition name)) (invoke alias 10))))
  (observe "object.wrapper-after-gc"
    (with-function (name)
      (advice-add name :around #'twice)
      (collect-garbage)
      (invoke name 10)))
  (with-function (name)
    (advice-add name :around #'twice '(:name :double))
    (let ((captured (fdefinition name)))
      (setf (fdefinition name) #'replacement)
      (observe "object.saved-wrapper-after-base-redefinition" (invoke-object captured 10))))
  (observe "object.escaped-next-after-base-redefinition"
    (let ((next nil))
      (with-function (name)
        (advice-add name :around (lambda (function x) (setf next function) (funcall function x)))
        (invoke name 10)
        (setf (fdefinition name) #'replacement)
        (funcall next 10))))
  (observe "object.assign-definition-to-itself"
    (with-function (name)
      (advice-add name :around #'twice)
      (setf (fdefinition name) (fdefinition name))
      (invoke name 10)))
  (observe "object.function-assignment-identity"
    (with-function (name)
      (let ((function (fresh-base)))
        (setf (fdefinition name) function)
        (eq function (fdefinition name))))))

(defun audit-redefinition ()
  (dolist (kind '(:defun :compile :fdefinition :symbol-function :fasl))
    (with-function (name)
      (advice-add name :around #'twice '(:name :double))
      (ecase kind
        (:defun (eval `(defun ,name (x) (values (+ x 2) :secondary))))
        (:compile (compile name '(lambda (x) (values (+ x 2) :secondary))))
        (:fdefinition (setf (fdefinition name) #'replacement))
        (:symbol-function (setf (symbol-function name) #'replacement))
        (:fasl
         (let ((source (merge-pathnames "redefinition.lisp" *directory*)))
           (with-open-file (out source :direction :output :if-exists :supersede)
             (write `(in-package ,(package-name *package*)) :stream out) (terpri out)
             (write `(defun ,name (x) (values (+ x 2) :secondary)) :stream out))
           (load (compile-file source)))))
      (observe (format nil "redefinition.~(~A~).current" kind) (invoke name 10))
      (observe (format nil "redefinition.~(~A~).member" kind) (advice-member-p :double name))
      (advice-add name :before #'ignored '(:name :new))
      (observe (format nil "redefinition.~(~A~).add-again" kind) (invoke name 10))
      (clear-advice name)
      (observe (format nil "redefinition.~(~A~).after-remove" kind) (invoke name 10))))
  (with-function (name)
    (advice-add name :around #'twice '(:name :double))
    (fmakunbound name)
    (observe "redefinition.fmakunbound-boundp" (not (null (fboundp name))))
    (observe "redefinition.fmakunbound-member" (advice-member-p :double name))
    (observe "redefinition.fmakunbound-add" (advice-add name :before #'ignored)))
  (with-function (name)
    (advice-add name :around #'twice '(:name :double))
    (fmakunbound name)
    (setf (fdefinition name) #'replacement)
    (observe "redefinition.fmakunbound-then-define" (invoke name 10)))
  (observe "metadata.documentation"
    (with-function (name)
      (setf (documentation name 'function) "Base documentation.")
      (advice-add name :before #'ignored)
      (documentation name 'function)))
  (observe "metadata.documentation-after-remove"
    (with-function (name)
      (setf (documentation name 'function) "Base documentation.")
      (advice-add name :before #'ignored '(:name :temporary))
      (advice-remove name :temporary)
      (documentation name 'function))))

(defun audit-generic-functions ()
  (let ((name (new-name)))
    (eval `(defgeneric ,name (x)))
    (eval `(defmethod ,name ((x number)) (values (1+ x) :secondary)))
    (unwind-protect
         (let ((original (fdefinition name)))
           (advice-add name :around #'twice '(:name :double))
           (observe "generic.current" (invoke name 10))
           (observe "generic.saved-before-add" (invoke-object original 10))
           (observe "generic.identity-preserved" (eq original (fdefinition name)))
           (observe "generic.still-generic-function" (typep (fdefinition name) 'generic-function))
           (observe "generic.add-method-while-advised"
             (eval `(defmethod ,name ((x string)) (length x)))
             (invoke name "abc"))
           (advice-remove name :double)
           (observe "generic.current-after-remove" (invoke name 10))
           (observe "generic.saved-before-after-remove" (invoke-object original 10)))
      (clear-advice name)
      (fmakunbound name))))

(defun audit-validation ()
  (dolist (pair '(("unknown-position" :bad ignored nil)
                  ("invalid-function" :before 12 nil)
                  ("undefined-adviser" :before nonexistent-adviser nil)
                  ("macro-adviser" :before when nil)
                  ("special-adviser" :before if nil)
                  ("odd-plist" :before ignored (:name))
                  ("alist-instead-of-plist" :before ignored ((:name . :a)))
                  ("invalid-depth" :before ignored (:depth bad))
                  ("invalid-name" :before ignored (:name 42))
                  ("ratio-depth" :before ignored (:depth 1/2))
                  ("unknown-property" :before ignored (:custom t))
                  ("string-name" :before ignored (:name "named"))))
    (observe (concatenate 'string "validation." (first pair))
      (with-function (name) (advice-add name (second pair) (third pair) (fourth pair)))))
  (observe "validation.undefined-target"
    (advice-add (new-name) :before #'ignored))
  (observe "validation.macro-target" (advice-add 'when :before #'ignored))
  (observe "validation.special-target" (advice-add 'if :before #'ignored))
  (observe "validation.function-object-target" (advice-add #'base :before #'ignored))
  (observe "validation.invalid-setf-name" (advice-add '(setf x y) :before #'ignored))
  (observe "validation.failed-add-does-not-register"
    (with-function (name)
      (handler-case (advice-add name :bad #'ignored) (error () nil))
      (values (registry-names name) (invoke name 10))))
  (observe "validation.remove-undefined-target" (advice-remove (new-name) :missing))
  (observe "validation.member-undefined-target" (advice-member-p :missing (new-name)))
  (observe "validation.mapc-undefined-target" (advice-mapc #'ignored (new-name))))

(defun audit-names-and-threads ()
  (let* ((symbol (new-name)) (name (list 'setf symbol)))
    (setf (fdefinition name) (lambda (value object) (setf (car object) value)))
    (unwind-protect
         (progn
           (advice-add name :around (lambda (next value object) (funcall next (* 2 value) object)) '(:name :double))
           (observe "target.setf-name" (let ((object (list 0))) (invoke name 10 object) (car object)))
           (observe "target.equal-setf-name-member" (advice-member-p :double (list 'setf symbol))))
      (clear-advice name) (fmakunbound name)))
  (observe "target.lexical-flet-is-separate"
    (with-function (name)
      (advice-add name :around #'twice)
      (eval `(flet ((,name (x) x)) (,name 10)))))
  (with-function (name)
    (observe "define-advice.named-return"
      (symbolp (eval `(define-advice ,name (:before (&rest args) named)
                       (declare (ignore args))))))
    (observe "define-advice.named-reload-count"
      (eval `(define-advice ,name (:before (&rest args) named) (declare (ignore args))))
      (length (registry-names name))))
  (observe "define-advice.anonymous-return"
    (with-function (name)
      (eval `(define-advice ,name (:before (&rest args)) (declare (ignore args))))))
  (observe "define-advice.anonymous-reload-count"
    (with-function (name)
      (dotimes (i 2)
        (eval `(define-advice ,name (:before (&rest args)) (declare (ignore args)))))
      (length (registry-names name))))
  (observe "threads.supported" (threads-supported-p))
  (observe "threads.call-and-update"
    (if (not (threads-supported-p)) :not-supported
        (let ((*counter* 0))
          (with-function (name)
            (advice-add name :around #'twice '(:name :double))
            (let ((result nil))
              (call-in-thread (lambda () (setf result (multiple-value-list (invoke name 10)))))
              result)))))
  (observe "threads.mutate-from-around-without-lock"
    (if (not (threads-supported-p)) :not-supported
        (with-function (name)
          (advice-add name :around
                      (lambda (next x)
                        (call-in-thread (lambda () (advice-add name :before #'ignored '(:name :worker))))
                        (funcall next x)))
          (values (invoke name 10) (advice-member-p :worker name)))))
  (dolist (order '(:trace-first :advice-first))
    (observe (format nil "trace.~(~A~)" order)
      (with-function (name)
        (let ((*trace-output* (make-string-output-stream)))
          (unwind-protect
               (progn
                 (when (eq order :trace-first) (eval `(trace ,name)))
                 (advice-add name :around #'twice '(:name :double))
                 (when (eq order :advice-first) (eval `(trace ,name)))
                 (let ((before (multiple-value-list (invoke name 10))))
                   (advice-remove name :double)
                   (values before (multiple-value-list (invoke name 10)))))
            (eval `(untrace ,name))))))))

(defun compile-source (source forms &optional block)
  (with-open-file (out source :direction :output :if-exists :supersede)
    (dolist (form forms) (write form :stream out :readably t) (terpri out)))
  (multiple-value-bind (fasl warnings failure)
      #+(or sbcl cmucl) (compile-file source :block-compile block)
      #-(or sbcl cmucl) (progn block (compile-file source))
    (declare (ignore warnings))
    (when (or failure (null fasl)) (error "Compilation failed: ~A" source))
    (load fasl)
    fasl))

(defun audit-compilation ()
  (dolist (policy '(:default :fast :debug3 :speed0 :inline :notinline :block))
    (if (and (eq policy :block) #-(or sbcl cmucl) t #+(or sbcl cmucl) nil)
        (observe "compile.block.direct" :not-supported)
        (let* ((package (make-package (format nil "OOPARTS-ADVICE-AUDIT-~A" policy) :use '(#:cl)))
               (target (intern "TARGET" package))
               (caller (intern "CALLER" package))
               (getter (intern "GETTER" package))
               (sharp (intern "SHARP" package))
               (symbol-function-getter (intern "SYMBOL-FUNCTION-GETTER" package))
               (local-sharp (intern "LOCAL-SHARP" package))
               (local-fdef (intern "LOCAL-FDEF" package))
               (recursive (intern "RECURSIVE" package))
               (mutual-a (intern "MUTUAL-A" package))
               (mutual-b (intern "MUTUAL-B" package))
               (separate (intern "SEPARATE" package))
               (late (intern "LATE" package))
               (separate-fasl nil)
               (original nil)
               (source (merge-pathnames (format nil "~(~A~).lisp" policy) *directory*))
               (declarations
                 (append
                  (unless (eq policy :default)
                    '((declaim (optimize (speed 1) (space 1) (safety 1)
                                        (debug 1) (compilation-speed 1)))))
                  (case policy
                   ((:fast :inline) '((declaim (optimize (speed 3) (safety 1) (debug 0)))))
                   (:debug3 '((declaim (optimize (debug 3)))))
                   (:speed0 '((declaim (optimize (speed 0)))))
                   (otherwise nil)))))
          (compile-source
           source
           (append `((in-package ,(package-name package))) declarations
                   (case policy (:inline `((declaim (inline ,target))))
                                (:notinline `((declaim (notinline ,target ,recursive ,mutual-a)))))
                   `((defun ,target (x) (values (1+ x) :secondary))
                     (defun ,caller (x) (,target x))
                     (defun ,getter (x) (funcall (fdefinition ',target) x))
                     (defun ,sharp (x) (funcall #',target x))
                     (defun ,symbol-function-getter (x) (funcall (symbol-function ',target) x))
                     (defun ,local-sharp (x installer)
                       (let ((saved #',target)) (funcall installer) (funcall saved x)))
                     (defun ,local-fdef (x installer)
                       (let ((saved (fdefinition ',target))) (funcall installer) (funcall saved x)))
                     (defun ,recursive (n) (if (zerop n) :done (,recursive (1- n))))
                     (defun ,mutual-a (n) (if (zerop n) :done (,mutual-b (1- n))))
                     (defun ,mutual-b (n) (if (zerop n) :done (,mutual-a (1- n))))))
           (eq policy :block))
          (setf separate-fasl
                (compile-source (merge-pathnames "separate.lisp" *directory*)
                                (append `((in-package ,(package-name package))) declarations
                                        `((defun ,separate (x) (,target x))))))
          (setf original (fdefinition target))
          (advice-add target :around #'twice '(:name :double))
          (unwind-protect
               (progn
                 (observe (format nil "compile.~(~A~).direct" policy) (invoke caller 10))
                 (observe (format nil "compile.~(~A~).fdefinition" policy) (invoke getter 10))
                 (observe (format nil "compile.~(~A~).sharp" policy) (invoke sharp 10))
                 (observe (format nil "compile.~(~A~).symbol-function" policy) (invoke symbol-function-getter 10))
                 (observe (format nil "compile.~(~A~).separate-file" policy) (invoke separate 10))
                 (compile-source (merge-pathnames "late.lisp" *directory*)
                                 (append `((in-package ,(package-name package))) declarations
                                         `((defun ,late (x) (,target x)))))
                 (observe (format nil "compile.~(~A~).compiled-after-add" policy) (invoke late 10))
                 (load separate-fasl)
                 (observe (format nil "compile.~(~A~).reloaded-caller-fasl" policy) (invoke separate 10)))
            (clear-advice target)
            ;; Failed host removal is itself recorded in the object probes.
            ;; Restore explicitly here so later capture probes start unadvised.
            (setf (fdefinition target) original))
          (dolist (pair (list (list local-sharp "local-saved-function")
                             (list local-fdef "local-saved-fdefinition")))
            (unwind-protect
                 (observe (format nil "compile.~(~A~).~A" policy (second pair))
                   (invoke (first pair) 10 (lambda () (advice-add target :around #'twice))))
              (clear-advice target)
              (setf (fdefinition target) original)))
          (dolist (pair (list (list recursive 3 "recursion-count") (list mutual-a 3 "mutual-count")))
            (let ((*counter* 0))
              (advice-add (first pair) :before #'count-call)
              (unwind-protect
                   (observe (format nil "compile.~(~A~).~A" policy (third pair))
                     (invoke (first pair) (second pair)) *counter*)
                (clear-advice (first pair)))))))))

(defun audit-preexisting ()
  (dolist (policy '(:default :fast :inline))
    (let* ((package (find-package (format nil "OOPARTS-ADVICE-PREEXISTING-~A" policy)))
           (target (and package (find-symbol "TARGET" package))))
      (when target
        (advice-add target :around #'twice '(:name :double))
        (unwind-protect
             (dolist (entry '("CALLER" "GETTER"))
               (observe (format nil "preexisting.~(~A~).~(~A~)" policy entry)
                 (invoke (find-symbol entry package) 10)))
          (advice-remove target :double))
        (observe (format nil "preexisting.~(~A~).after-remove" policy)
          (invoke (find-symbol "CALLER" package) 10)))))
  (with-function (name)
    (advice-add name :around #'twice '(:name :double))
    (observe "status.active" (advice-status name))
    (fmakunbound name)
    (observe "status.pending" (advice-status name))
    (setf (fdefinition name) #'base)
    (observe "status.reconnected" (advice-status name))
    (advice-remove name :double)
    (observe "status.removed" (advice-status name))))

(defun run-audit (directory)
  (let ((*directory* (uiop:ensure-directory-pathname directory))
        (*records* nil) (*serial* 0))
    (ensure-directories-exist (merge-pathnames "placeholder" *directory*))
    (flet ((single-line (text)
             (substitute #\Space #\Return (substitute #\Space #\Newline text))))
      (format t "~&AUDIT-HOST|~A|~A|~A|~A~%" (single-line (lisp-implementation-type))
              (single-line (lisp-implementation-version))
              (single-line (or (software-type) "unknown"))
              (single-line (or (machine-type) "unknown"))))
    (audit-combinators)
    (audit-registry)
    (audit-objects)
    (audit-redefinition)
    (audit-generic-functions)
    (audit-validation)
    (audit-names-and-threads)
    (audit-compilation)
    (audit-preexisting)
    (format t "~&AUDIT-COMPLETE|~D~%" (length *records*))
    (finish-output)
    t))
