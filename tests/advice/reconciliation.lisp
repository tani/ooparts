(uiop:define-package #:ooparts-tests/advice/reconciliation
  (:use #:cl)
  (:import-from #:ooparts/advice #:advice-add #:advice-remove #:advice-member-p
                #:advice-status #:prepare-advice-function
                #:enable-advice-compilation #:disable-advice-compilation)
  (:export #:run-tests))
(in-package #:ooparts-tests/advice/reconciliation)

(defun double (next &rest args)
  (multiple-value-bind (x y) (apply next args) (values (* 2 x) y)))
(defun invoke (name &rest args) (apply (fdefinition name) args))
(defun invoke-object (function &rest args) (apply function args))

(defun run-tests ()
  (let ((checks 0))
    (flet ((check (expected actual)
             (incf checks)
             (assert (equal expected actual) () "Expected ~S; got ~S" expected actual)))
      (let ((name (gensym "LIFECYCLE-")))
        (unwind-protect
             (progn
               (advice-add name :around #'double '(:name :double))
               (check :pending (advice-status name))
               (check nil (fboundp name))
               (setf (fdefinition name) (lambda (x) (values (1+ x) :secondary)))
               (check :active (advice-status name))
               (check '(22 :secondary) (multiple-value-list (invoke name 10)))
               (check '(22 :secondary)
                      (multiple-value-list
                       (invoke-object
                        (funcall (compile nil '(lambda (name) (funcall #'fdefinition name))) name)
                        10)))
               (funcall (compile nil '(lambda (name) (funcall #'fmakunbound name))) name)
               (check :pending (advice-status name))
               (check t (advice-member-p :double name))
               (eval `(defun ,name (x) (values (+ x 2) :secondary)))
               (check '(24 :secondary) (multiple-value-list (invoke name 10)))
               (let ((saved (fdefinition name)))
                 (advice-remove name :double)
                 (check nil (advice-status name))
                 (check '(12 :secondary) (multiple-value-list (invoke-object saved 10)))
                 (advice-add name :override (lambda (x) (declare (ignore x)) 99) '(:name :new))
                 (check 99 (invoke name 10))
                 (check '(12 :secondary) (multiple-value-list (invoke-object saved 10)))
                 (advice-remove name :new)))
          (advice-remove name :double)
          (advice-remove name :new)
          (when (fboundp name) (fmakunbound name))))
      (dolist (order '(:trace-first :advice-first))
        (let ((name (gensym "TRACE-")) (*trace-output* (make-string-output-stream)))
          (setf (fdefinition name) (lambda (x) (values (1+ x) :secondary)))
          (unwind-protect
               (progn
                 (when (eq order :trace-first) (eval `(trace ,name)))
                 (advice-add name :around #'double '(:name :double))
                 (when (eq order :advice-first) (eval `(trace ,name)))
                 (let ((saved (fdefinition name)))
                   (check '(22 :secondary) (multiple-value-list (invoke name 10)))
                   (advice-remove name :double)
                   (check '(11 :secondary) (multiple-value-list (invoke name 10)))
                   (check '(11 :secondary) (multiple-value-list (invoke-object saved 10)))
                   (check nil (advice-member-p :double name))))
            (advice-remove name :double)
            (eval `(untrace ,name))
            (fmakunbound name))))
      (let ((name (intern "SHADOW-TARGET" *package*)))
        (setf (fdefinition name) (lambda (x) (1+ x)))
        (unwind-protect
             (progn
               (prepare-advice-function name)
               (advice-add name :around #'double)
               (check 10 (funcall (compile nil `(lambda (x) (flet ((,name (x) x)) (,name x)))) 10))
               (check 3 (funcall (compile nil `(lambda (x) (labels ((,name (n) (if (zerop n) 0 (1+ (,name (1- n)))))) (,name x)))) 3)))
          (advice-remove name #'double)
          (fmakunbound name))))
    (let ((name (intern "ADVICE-ISOLATION-CHECK" :ooparts/host)))
      (unwind-protect
           (progn
             (prepare-advice-function name)
             (assert (null (compiler-macro-function name)))
             (incf checks))
        (unintern name :ooparts/host)))
    (let* ((name (intern "LOADED-DEFINITION" *package*))
           (expansion (macroexpand-1 `(defun ,name (x) (1+ x)))))
      (unwind-protect
           (progn
             (setf (compiler-macro-function name) nil)
             (eval expansion)
             (assert (compiler-macro-function name))
             (incf checks))
        (when (fboundp name) (fmakunbound name))))
    (let ((name (intern "APPLICATION-COMPILER-MACRO" *package*)))
      (setf (fdefinition name) (lambda () :base))
      (prepare-advice-function name)
      (setf (compiler-macro-function name)
            (lambda (form environment) (declare (ignore form environment)) :application))
      (let ((application-expander (compiler-macro-function name)))
        (unwind-protect
             (progn
               (disable-advice-compilation)
               (assert (eq application-expander (compiler-macro-function name)))
               (incf checks)
               (enable-advice-compilation)
               (assert (eq application-expander (compiler-macro-function name)))
               (incf checks))
          (enable-advice-compilation)
          (setf (compiler-macro-function name) nil)
          (fmakunbound name))))
    (format t "~D advice lifecycle checks passed.~%" checks)
    t))
