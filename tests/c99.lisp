(uiop:define-package #:ooparts-tests/c99
  (:use #:cl)
  (:import-from #:ooparts/c99 #:tokenize-c99 #:parse-c99 #:compile-c99)
  (:export #:run-tests))
(in-package #:ooparts-tests/c99)

(defun run-tests ()
  (assert (equal (tokenize-c99 "int main(void) { return 2; }")
                 '(:int (:identifier "main") :lparen (:identifier "void")
                   :rparen :lbrace :return (:number 2) :semicolon :rbrace)))
  (assert (equal (parse-c99 (tokenize-c99 "int main(){return 42;}"))
                 '(:function "main" 42)))
  (dolist (target '(:x86-64-linux :x86-64-macos :aarch64-linux :aarch64-macos))
    (let ((asm (compile-c99 "int main(){return 42;}" :target target)))
      (assert (search "ret" asm))
      (assert (search (if (member target '(:x86-64-macos :aarch64-macos))
                          "_main:" "main:") asm))))
  (assert (handler-case (progn (compile-c99 "int main(){return 1+2;}") nil)
            (error () t)))
  t)
