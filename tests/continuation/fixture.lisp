(uiop:define-package #:ooparts-tests/continuation/fixture
  (:use #:cl #:ooparts/continuation)
  (:export #:checks))
(in-package #:ooparts-tests/continuation/fixture)
(defun/cps factorial (n)
  (if (zerop n) (shift k (funcall k 1)) (* n (factorial (1- n)))))
(defun/cps supplied (&optional (x (shift k (funcall k 7)) xp)) (list x (not (null xp))))
(defun/cps pure-double (x) (+ x x))
(defun opaque-native-caller (f x) (+ 100 (funcall f x)))
(register-cps-adapter 'opaque-native-caller
                      (lambda/cps (f x) (+ 100 (funcall f x))))
(defun/cps (setf controlled-accessor) (value cell)
  (setf (car cell) (shift k (funcall k value))))
(defun/cps discard-optionals (required &optional (option 1 optionp) &rest rest)
  (declare (ignore required option optionp rest))
  (shift k (funcall k :discarded)))
(defun/cps discard-keywords (&rest rest &key ((:key key) 2 keyp) &allow-other-keys)
  (declare (ignore rest key keyp))
  (shift k (funcall k :discarded)))
(defparameter *saved* (reset (+ 10 (shift k k))))
(defparameter *special* :outside)
(defparameter *saved-special*
  (reset (let ((*special* 10)) (shift k k) (incf *special*))))
(defun outer-macro-environment ()
  (let ((x 5))
    (macrolet ((twice (v) `(+ ,v ,v)))
      (symbol-macrolet ((a x))
        (reset (incf a (shift k (funcall k 1))) (twice a))))))
(defun outer-function-environment ()
  (flet ((add (x) (+ 100 x)))
    (reset (add (shift k (funcall k 3))))))
(defun checks ()
  (assert (not (cps-function-p #'pure-double)))
  (assert (cps-function-p #'factorial))
  (assert (= 105 (reset (opaque-native-caller (lambda (x) (+ x (shift k (funcall k 3)))) 2))))
  (assert (eq :direct (getf (analyze '(labels ((f (n) (if (zerop n) 0 (f (1- n))))) (f 8))) :effect)))
  (assert (eq :cps (getf (analyze '(labels ((f () (g)) (g () (shift k k))) (f))) :effect)))
  (assert (eq :direct (getf (analyze '(reset (shift k k))) :effect)))
  (assert (= 120 (reset (factorial 5))))
  (assert (equal '(7 nil) (reset (supplied))))
  (assert (equal '(4 t) (reset (supplied 4))))
  (assert (eq :discarded (reset (discard-optionals :required))))
  (assert (eq :discarded (reset (discard-optionals :required 3 :rest))))
  (assert (eq :discarded (reset (discard-keywords))))
  (assert (eq :discarded (reset (discard-keywords :key 4 :other 5))))
  (let ((cell (list 0)))
    (assert (= 9 (reset (setf (controlled-accessor cell) 9))))
    (assert (= 9 (car cell))))
  (assert (= 12 (outer-macro-environment)))
  (assert (= 103 (outer-function-environment)))
  (assert (equal '(11 12) (list (funcall *saved* 1) (funcall *saved* 2))))
  (assert (equal '(11 12 :outside)
                 (list (funcall *saved-special* 0) (funcall *saved-special* 0) *special*)))
  (format t "Fresh FASL/core checks passed.~%"))
