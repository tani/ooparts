(uiop:define-package #:ooparts-tests/curry/generated
  (:use #:cl)
  (:import-from #:ooparts/curry
    #:defun/c #:lambda/c #:defgeneric/c #:defmethod/c #:defclass/c #:defstruct/c
    #:define-condition/c #:uncurried-function)
  (:import-from #:ooparts/curry/catalog #:*cl-functions*)
  (:import-from #:ooparts-tests/curry/support #:check #:error-p)
  (:export #:run-generated))
(in-package #:ooparts-tests/curry/generated)

(defvar *events* nil)
(defgeneric/c combine (left right)
  (:documentation "Combined fixture."))
(defmethod/c combine ((left integer) (right integer))
  (values (+ left right) :integer))
(defmethod/c combine :before (left right)
  (declare (ignore left right)) (push :before *events*))
(defmethod/c combine :after (left right)
  (declare (ignore left right)) (push :after *events*))
(defmethod/c combine :around (left right)
  (declare (ignore left right))
  (push :around-enter *events*)
  (multiple-value-prog1 (call-next-method) (push :around-exit *events*)))
(defmethod/c implicit ((left string) right)
  (return-from implicit (list left right)))
(defgeneric/c absent (left right))
(defgeneric/c keyword-generic (left right &key ((:scale multiplier)))
  (:method (left right &key ((:scale multiplier) 1)) (* multiplier (+ left right))))
(defgeneric/c rest-generic (head &rest tail))
(defmethod/c rest-generic (head &rest tail) (cons head tail))

(defclass/c cell ()
  ((value :initarg :value :initform 1 :accessor cell-value :reader read-cell :writer write-cell)))
(defclass/c child-cell (cell) ((other :initform 2 :accessor other-value)))
(defmethod/c cell-value :around ((object child-cell)) (1+ (call-next-method)))
(defclass/c sibling-cell () ((value :initarg :value :accessor cell-value)))

(defstruct/c point (x 1) (y 2) (fixed 7 :read-only t))
(defstruct/c (coordinate (:constructor make-coordinate (x y))) (x 0) (y 0))
(defstruct/c (extended-coordinate (:include coordinate)) (z 3))
(defstruct/c (list-record (:type list) :named (:conc-name lr-)) (value 4))
(defstruct/c (anonymous-list (:type list) (:predicate nil) (:copier nil)) (value 6))
(defstruct/c (no-build (:constructor nil) (:predicate nil) (:copier nil)) value)
(defstruct/c (shared-parent (:conc-name nil)) (shared-value 1))
(defstruct/c (shared-child (:conc-name nil) (:include shared-parent)) (child-value 2))
(define-condition/c fixture-error (error) ((datum :initarg :datum :reader fixture-datum)))

(defun run-generated ()
  ;; Original optional/key binding, default evaluation and all ordinary sections.
  (let ((fn (lambda/c (x y &optional (z 3 zp)) (list x y z zp))))
    (check '(1 2 3 nil) (funcall (funcall fn 1) 2))
    (check '(1 2 4 t) (funcall (funcall fn 1) 2 4)))
  (let ((fn (lambda/c (x y &key ((custom value) 3 vp) &allow-other-keys)
              (list x y value vp))))
    (check '(1 2 3 nil) (funcall fn 1 2))
    (check '(1 2 4 t) (funcall (funcall fn 1) 2 'custom 4 :ignored 0)))
  (let ((fn (lambda/c (x y &rest rest &key (scale 1) &aux (sum (+ x y)))
              (list (* scale sum) rest))))
    (check '(9 (:scale 3)) (funcall (funcall fn 1) 2 :scale 3)))
  (let ((fn (lambda/c (x y &optional (z 0) &rest rest) (list x y z rest))))
    (check '(1 2 0 nil) (funcall (funcall fn 1) 2))
    (check '(1 2 3 (4 5)) (funcall (funcall fn 1) 2 3 4 5)))
  (check '(1 2 3) (funcall (lambda/c (&rest values) values) 1 2 3))
  (check nil (funcall (lambda/c (&rest values) values)))
  (check 9 (funcall (lambda/c (&key (value 9)) value)))
  (let ((events nil))
    (let* ((fn (lambda/c (x y &optional (z (progn (push :z events) 3))
                          &aux (sum (progn (push :aux events) (+ x y z))))
                 (push :body events) sum))
           (part (funcall fn 1)))
      (check nil events)
      (check 6 (funcall part 2))
      (check '(:z :aux :body) (reverse events))))
  (let ((*events* nil) (part (combine 1)))
    (check nil *events*)
    (check '(3 :integer) (multiple-value-list (funcall part 2)))
    (check '(:around-enter :before :after :around-exit) (reverse *events*)))
  (check '("left" :right) (funcall (implicit "left") :right))
  (check t (typep (uncurried-function 'combine) 'generic-function))
  (check nil (typep #'combine 'generic-function))
  (check t (not (null (find-method (uncurried-function 'combine) nil
                                 (list (find-class 'integer) (find-class 'integer))))))
  (check t (functionp (absent 1)))
  (check t (error-p (lambda () (funcall (absent 1) 2))))
  (check 12 (funcall (keyword-generic 1) 2 :scale 4))
  (check '(1 2 3) (rest-generic 1 2 3))
  (let ((object (make-instance 'cell :value 3)))
    (check 3 (funcall (cell-value) object))
    (check 4 (funcall (write-cell 4) object))
    (check 4 (read-cell object))
    (check 5 (funcall (funcall #'(setf cell-value) 5) object))
    (check 5 (cell-value object))
    (setf (cell-value object) 6)
    (check 6 (cell-value object)))
  (check 4 (cell-value (make-instance 'child-cell :value 3)))
  (check 8 (cell-value (make-instance 'sibling-cell :value 8)))
  (let ((object (make-point :x 10)))
    (check t (point-p object))
    (check t (funcall (point-p) object))
    (check 10 (funcall (point-x) object))
    (check 20 (funcall (funcall #'(setf point-x) 20) object))
    (check 20 (point-x object))
    (setf (point-y object) 30)
    (check 30 (point-y object))
    (check 7 (point-fixed object))
    (check nil (funcall (symbol-function 'fboundp) '(setf point-fixed)))
    (check 20 (point-x (funcall (copy-point) object))))
  (let ((object (funcall (make-coordinate 10) 20)))
    (check 10 (coordinate-x object))
    (check 20 (coordinate-y object)))
  (let ((object (make-extended-coordinate :x 1 :y 2)))
    (check 1 (coordinate-x object))
    (check 1 (extended-coordinate-x object))
    (check 3 (extended-coordinate-z object)))
  (let ((object (make-list-record)))
    (check t (list-record-p object))
    (setf (lr-value object) 9)
    (check 9 (lr-value object)))
  (let ((parent (make-shared-parent)) (child (make-shared-child)))
    (check 1 (shared-value parent))
    (check 1 (shared-value child))
    (setf (shared-value parent) 5 (shared-value child) 6)
    (check 5 (shared-value parent))
    (check 6 (shared-value child)))
  (check 6 (anonymous-list-value (make-anonymous-list)))
  (check nil (fboundp 'make-no-build))
  (check nil (fboundp 'copy-no-build))
  (check nil (fboundp 'no-build-p))
  (check :datum (funcall (fixture-datum) (make-condition 'fixture-error :datum :datum)))
  ;; Inspect every generated wrapper without invoking effectful zero-arity APIs.
  (dolist (entry *cl-functions*)
    (destructuring-bind (name required) entry
      (multiple-value-bind (symbol status)
          (find-symbol (concatenate 'string name "/C") :ooparts/curry)
        (check :external status)
        (check t (not (null (fboundp symbol))))
        (if (fboundp (find-symbol name :cl))
            (check t (eq (fdefinition (find-symbol name :cl)) (uncurried-function symbol)))
            (check t (error-p (lambda () (uncurried-function symbol)))))
        (when (plusp required) (check t (functionp (funcall symbol)))))))
  (check '(1 . 2) (funcall (ooparts/curry:cons/c 1) 2))
  (check '(2 3) (funcall (ooparts/curry:mapcar/c #'1+) '(1 2)))
  (check 3 (funcall (ooparts/curry:apply/c #'+) '(1 2)))
  (check 6 (ooparts/curry:+/c 1 2 3))
  (check 0 (ooparts/curry:+/c))
  (check 3 (funcall (funcall (ooparts/curry:curry #'+ 2) 1) 2))
  (check 3 (funcall (ooparts/curry:curry '+ 2) 1 2))
  (check 0 (funcall (ooparts/curry:curry #'+ 0)))
  (let ((cell (list 1 2)))
    (setf (ooparts/curry:car/c cell) 4)
    (check '(4 2) cell)
    (setf (ooparts/curry:nth/c 1 cell) 5)
    (check '(4 5) cell))
  t)
