(uiop:define-package #:ooparts-tests/curry/suite
  (:use #:cl)
  (:import-from #:ooparts/curry #:defun/c #:flet/c #:labels/c #:lambda/c)
  (:import-from #:ooparts/test)
  (:import-from #:ooparts-tests/curry/support #:*checks* #:check #:error-p)
  (:import-from #:ooparts-tests/curry/generated #:run-generated)
  (:import-from #:ooparts-tests/curry/user #:run-user)
  (:export #:run-tests))
(in-package #:ooparts-tests/curry/suite)

(defun/c add (x y) (+ x y))
(defun/c scale (x y factor) (* factor (+ x y)))
(defun/c named-exit (x y)
  (declare (ignore y))
  "Documentation after a declaration."
  (return-from named-exit (values x :exit)))
(defun/c documented (x)
  "Documentation before a declaration."
  (declare (type integer x))
  x)
(defun/c literal () "a returned string")
(defun/c no-forms ())
(defun/c only-doc-and-declaration () "Only documentation." (declare (optimize (safety 3))))
(defun/c factorial (n)
  (if (zerop n) 1 (* n (factorial (1- n)))))
(defun/c (setf slotlike) (value object)
  (return-from slotlike (setf (car object) value)))
(defun/c source-function (x y) (list x y))
(defun native-after-declaration (#1=#:x y)
  (declare (ignore y))
  "Documentation after a declaration."
  #1#)
(defun native-before-declaration (#1=#:x)
  "Documentation before a declaration."
  (declare (type integer #1#)) #1#)

(defun %run-tests ()
  (setf *checks* 0)
  (check 3 (add 1 2))
  (check 3 (funcall (add 1) 2))
  (check 3 (funcall (funcall (add) 1) 2))
  (check 3 (funcall (funcall (funcall (add))) 1 2))
  (check 50 (scale 2 3 10))
  (check 50 (funcall (scale 2) 3 10))
  (check 50 (funcall (funcall (scale 2) 3) 10))
  (check '(:a :b) (funcall (lambda/c (x y) (list x y)) :a :b))
  (check 120 (factorial 5))
  (check '(1 :exit) (multiple-value-list (funcall (named-exit 1) 2)))
  ;; Native baselines use uninterned variables too. CLISP discards compiled
  ;; function metadata for such lambda lists, even for an ordinary DEFUN.
  (check (documentation 'native-after-declaration 'function)
         (documentation 'named-exit 'function))
  (check (documentation 'native-before-declaration 'function)
         (documentation 'documented 'function))
  (check "Documentation after a declaration."
         (fourth (macroexpand-1 '(defun/c probe (x) (declare (ignore x))
                                  "Documentation after a declaration." nil))))
  (check "a returned string" (literal))
  (check nil (no-forms))
  (check nil (only-doc-and-declaration))
  (check 3 (documented 3))
  (check 9 (let ((object (list 0))) (funcall (funcall #'(setf slotlike) 9) object)))
  (check '(9) (let ((object (list 0))) (setf (slotlike object) 9) object))
  (check 15 (let ((offset 10)) (funcall (funcall (lambda/c (x y) (+ offset x y)) 2) 3)))
  (check '(1 2) (multiple-value-list (funcall (lambda/c () (values 1 2)))))
  (check nil (multiple-value-list (funcall (lambda/c () (values)))))
  (check :outer (block nil (funcall (lambda/c () (return :outer))) :wrong))
  (check "single string" (funcall (lambda/c () "single string")))
  (check 5 (flet/c ((sum (x y) (+ x y))) (funcall (sum 2) 3)))
  (check 7 (flet ((probe (x) (+ x 2)))
             (flet/c ((probe (x y) (+ (probe x) y))) (probe 2 3))))
  (check 8 (flet ((other (x) (+ x 5)))
             (flet/c ((first-one (x) (other x)) (other (x) (+ x 100)))
               (declare (ignore (function other)))
               (first-one 3))))
  (check 120 (labels/c ((fact (n) (if (zerop n) 1 (* n (fact (1- n)))))) (fact 5)))
  (check t (labels/c ((even-one (n) (if (zerop n) t (odd-one (1- n))))
                    (odd-one (n) (if (zerop n) nil (even-one (1- n)))))
             (even-one 20)))
  (check 15 (labels/c ((sum-to (n accumulator)
                       (if (zerop n) accumulator
                           (funcall (sum-to (1- n)) (+ n accumulator)))))
              (funcall (sum-to 5) 0)))
  (check '(3 4) (flet/c ((exit (x y) (declare (ignore y)) (return-from exit (values x 4))))
                 (multiple-value-list (funcall (exit 3) 0))))
  (check 5 (flet/c ((sum (x y) (declare (type integer x y)) (+ x y)))
             (declare (inline sum)) (sum 2 3)))
  (check 5 (labels/c ((sum (x y) (+ x y)))
             (declare (notinline sum) (ftype (function (&rest t) *) sum))
             (funcall (sum 2) 3)))
  ;; AUX initialization runs only on completed calls, in binding order.
  (let ((events nil))
    (let* ((function (lambda/c (x y &aux (a (progn (push :a events) (+ x y)))
                              (b (progn (push :b events) (+ a 1))))
                       (push :body events) (list x y a b)))
           (partial (funcall function 2)))
      (check nil events)
      (check '(2 3 5 6) (funcall partial 3))
      (check '(:a :b :body) (reverse events))
      (setf events nil)
      (check '(2 4 6 7) (funcall partial 4))
      (check '(:a :b :body) (reverse events))))
  (check nil (funcall (lambda/c (&aux x) x)))
  (check 8 (funcall (lambda/c (&aux (x 8)) x)))
  (check t (functionp (funcall (lambda/c () (lambda () 8)))))
  ;; Every grouping of three required arguments.
  (let ((fn (lambda/c (a b c) (* 3 (+ a b c)))))
    (check 18 (funcall fn 1 2 3))
    (check 18 (funcall (funcall fn 1) 2 3))
    (check 18 (funcall (funcall fn 1 2) 3))
    (check 18 (funcall (funcall (funcall fn 1) 2) 3)))
  (check t (functionp (funcall (lambda/c (x) (lambda (y) (+ x y))) 1)))
  ;; No automatic application to a returned function; excess arguments error.
  (check t (error-p (lambda () (funcall (lambda/c (x) (lambda (y) (+ x y))) 1 2))))
  ;; The rest-list spine of APPLY belongs to the caller.
  (let* ((arguments (list 1)) (part (apply #'add arguments)))
    (setf (car arguments) 100)
    (check 3 (funcall part 2))
    (check 4 (funcall part 3)))
  (let* ((arguments (list 2)) (part (apply (funcall (lambda/c (a b c) (list a b c)) 1)
                                                         arguments)))
    (setf (car arguments) 100)
    (check '(1 2 3) (funcall part 3)))
  ;; Value identity is retained; copying does not recursively copy objects.
  (let* ((value (list 1)) (part (funcall (lambda/c (x y) (declare (ignore y)) x) value)))
    (setf (car value) 9)
    (check t (eq value (funcall part 0))))
  ;; An initializer must see the surrounding block, not a generated wrapper block.
  (check :outer
         (block probe
           (flet/c ((probe (x &aux (y (return-from probe :outer))) (list x y)))
             (probe 1))
           :wrong))
  (check :outer
         (block probe
           (labels/c ((probe (x &aux (y (return-from probe :outer))) (list x y)))
             (probe 1))
           :wrong))
  (check :outer
         (block global-probe
           (defun/c global-probe (x &aux (y (return-from global-probe :outer)))
             (list x y))
           (global-probe 1)
           :wrong))
  (check 12
         (let ((offset 7))
           (defun/c lexical-global (x y) (+ offset x y))
           (funcall (lexical-global 2) 3)))
  (check 9 (block probe
             (flet/c ((probe (x &aux (y 0))
                       (declare (ignore y)) (return-from probe x)))
               (probe 9))))
  ;; Local SPECIAL declaration affects actual binding, never partial capture.
  (let ((calls 0))
    (flet ((read-special () (declare (special dynamic-value)) dynamic-value))
      (let ((part (funcall (lambda/c (dynamic-value other)
                            (declare (special dynamic-value) (ignore other))
                            (incf calls) (read-special)) 42)))
        (check 0 calls)
        (check 42 (funcall part 0))
        (check 1 calls))))
  (check 7 (let ((outside 7))
             (symbol-macrolet ((view outside))
               (funcall (lambda/c (x) (declare (ignore x)) view) 0))))
  (check 5 (symbol-macrolet ((x 999))
             (funcall (lambda/c (x y) (+ x y)) 2 3)))
  ;; Runtime call errors are delegated to the original lambda list.
  (dolist (thunk (list (lambda () (add 1 2 3))
                       (lambda () (funcall (add 1) 2 3))
                       (lambda () (scale 1 2 3 4))
                       (lambda () (funcall (lambda/c () :done) 1))))
    (check t (error-p thunk)))
  ;; All ordinary lambda-list sections are accepted by all four macros.
  (dolist (lambda-list '((&optional) (&key) (&rest xs)
                         (x &optional y) (x &key y)
                         (x &optional y &rest xs &key z &allow-other-keys &aux q)))
    (dolist (form (list `(defun/c accepted ,lambda-list nil)
                       `(lambda/c ,lambda-list nil)
                       `(flet/c ((accepted ,lambda-list nil)) nil)
                       `(labels/c ((accepted ,lambda-list nil)) nil)))
      (check nil (error-p (lambda () (macroexpand-1 form))))))
  ;; Definitions rejected at macroexpansion, before defaults are evaluated.
  (dolist (lambda-list '((x &rest) (x &rest xs y) (x &rest xs &rest ys) (x &body xs) (&whole x) (&environment x)
                         ((x y)) (x x) (x &aux x) (&aux (x 1) x) (&aux &aux) (&aux ()) (x &optional (y 0 x))
                         (&optional x &optional y) (&key x &optional y)
                         (&aux x &key y) (&allow-other-keys) (&key &allow-other-keys x)
                         (&key ((:x y z))) (&key ((3 x))) (&optional (x 0 p extra))
                         (&aux (x 0 extra)) (&optional ()) (nil) (t) (:x)
                         (x . y)))
    (check t (error-p (lambda () (macroexpand-1 `(lambda/c ,lambda-list nil))))))
  (let ((circular (list 'x)))
    (setf (cdr circular) circular)
    (check t (error-p (lambda () (macroexpand-1 `(lambda/c ,circular nil))))))
  (dolist (form '((defun/c (bad name) (x) x)
                   (flet/c ((same (x) x) (same (x) x)) nil)
                   (labels/c ((incomplete)) nil)
                   (flet/c ((f (x) x) . tail) nil)))
    (check t (error-p (lambda () (macroexpand-1 form)))))
  ;; Generated wrappers must not introduce compiler warnings or arity failures.
  (dolist (form '((lambda ()
                    (funcall (funcall (lambda/c (x y) (+ x y)) 1) 2))
                  (lambda ()
                    (flet/c ((sum (x y) (+ x y))) (funcall (sum 1) 2)))
                  (lambda ()
                    (labels/c ((sum (x y) (+ x y))) (funcall (sum 1) 2)))))
    (let ((warnings 0))
      (multiple-value-bind (function warnings-p failure-p)
          (handler-bind ((warning (lambda (condition)
                                    (declare (ignore condition))
                                    (incf warnings))))
            (compile nil form))
        (check 0 warnings)
        (check nil (or warnings-p failure-p))
        (check 3 (funcall function)))))
  (run-generated)
  (run-user)
  (format t "~&Curry: ~D checks on ~A ~A~%" *checks* (lisp-implementation-type)
          (lisp-implementation-version))
  *checks*)

(defun run-tests ()
  (ooparts/test:with-suite ("ooparts-tests/curry")
    (let ((*checks* 0))
      (%run-tests))))
