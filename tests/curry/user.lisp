(uiop:define-package #:ooparts-tests/curry/user
  (:use #:cl)
  (:import-from #:ooparts/curry/user)
  (:import-from #:ooparts/curry/catalog #:*cl-functions*)
  (:import-from #:ooparts-tests/curry/support #:check)
  (:export #:run-user))
(in-package #:ooparts-tests/curry/user)

(defun %evaluate (text)
  (let ((*package* (find-package :ooparts/curry/user))
        (*readtable* ooparts/curry/user:*curried-readtable*))
    (eval (read-from-string text))))

(defun run-user ()
  (do-external-symbols (symbol :cl)
    (check :external (nth-value 1 (find-symbol (symbol-name symbol) :ooparts/curry/user))))
  (dolist (entry *cl-functions*)
    (let* ((name (first entry))
           (public (find-symbol name :ooparts/curry/user))
           (wrapper (find-symbol (concatenate 'string name "/C") :ooparts/curry)))
      (check t (eq (fdefinition public) (fdefinition wrapper)))))
  (check 6 (%evaluate "(progn (defun fixture-sum (x y &optional (z 0)) (+ x y z))
                               (funcall (fixture-sum 1) 2 3))"))
  (check '(1 . 2) (%evaluate "(funcall (cons 1) 2)"))
  (check '(2 3) (%evaluate "(funcall (mapcar #'1+) '(1 2))"))
  (check 3 (%evaluate "(funcall (funcall (curry #'+ 2) 1) 2)"))
  (check 3 (%evaluate "(funcall (funcall (lambda (x y) (+ x y)) 1) 2)"))
  (check 3 (%evaluate "(funcall (funcall #'(lambda (x y) (+ x y)) 1) 2)"))
  (check 3 (%evaluate "(funcall (funcall (function (lambda (x y) (+ x y))) 1) 2)"))
  (check t (not (null (%evaluate "(typep '(1) 'cons)"))))
  (check t (not (null (%evaluate "(typep '(1 . 2) '(cons integer integer))"))))
  (check t (not (null (%evaluate "(typep 3 '(mod 5))"))))
  (check t (not (null (%evaluate "(typep 'a '(member a b))"))))
  (check t (not (null (%evaluate "(typep '(a) '(not null))"))))
  (check t (not (null (%evaluate "(typep #'car 'function)"))))
  (check t (%evaluate "(eq (find-class 'cons) (cl:find-class 'cl:cons))"))
  (check 3 (%evaluate "(progn (defmethod fixture-method ((x cons) y) (+ (car x) y))
                               (funcall (fixture-method '(1)) 2))"))
  (check 3 (%evaluate "(progn (defmethod fixture-eql ((x (eql :tag)) y) (+ 1 y))
                               (funcall (fixture-eql :tag) 2))"))
  (check '(4 2) (%evaluate "(let ((value (list 1 2))) (setf (car value) 4) value)"))
  (check 5 (%evaluate "(flet ((sum (x y) (+ x y))) (funcall (sum 2) 3))"))
  (check 15 (%evaluate "(labels ((sum (n total) (if (zerop n) total
                                          (funcall (sum (1- n)) (+ n total)))))
                              (funcall (sum 5) 0))"))
  t)
