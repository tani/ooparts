(uiop:define-package #:ooparts-tests/curses/features
  (:use #:cl #:ooparts/curses)
  (:shadow #:*features*)
  (:import-from #:ooparts/curses/model)
  (:import-from #:ooparts/curses/extras)
  (:export #:run-features #:*features* #:*results* #:*assertions*))
(in-package #:ooparts-tests/curses/features)
(defvar *features* nil)
(defvar *results* nil)
(defvar *assertions* 0)
(defmacro deffeature (name &body body)
  `(setf *features* (append (remove ,(string-downcase name) *features* :key #'car :test #'string=)
                           (list (cons ,(string-downcase name) (lambda () ,@body))))))
(defmacro check (expression)
  `(progn (incf *assertions*) (unless ,expression (error "Failed: ~S" ',expression))))
(defun feed (text)
  (setf (ooparts/curses/model:screen-input *screen*) (make-string-input-stream text))
  (timeout 0) (keypad *stdscr* t))
(defun esc (suffix) (concatenate 'string (string (code-char 27)) suffix))
(defun row (win &optional (y 0)) (wmove win y 0) (winstr win))
(defun output () (get-output-stream-string (ooparts/curses/model:screen-output *screen*)))
(defun codepoints (&rest numbers) (apply #'concatenate 'string (mapcar #'ooparts/curses/model:codepoint-string numbers)))
(defun run-features ()
  (setf *results* nil *assertions* 0)
  (dolist (entry *features*)
    (let ((id (car entry)))
      (unwind-protect
           (handler-case
               (progn (with-screen (:native nil :input (make-string-input-stream "") :output (make-string-output-stream) :rows 8 :cols 40)
                        (funcall (cdr entry)))
                      (push (list id t "") *results*))
             (error (condition) (push (list id nil (princ-to-string condition)) *results*)))
        (nofilter) (use-env t)
        (setf ooparts/curses/extras::*ripoffs* nil ooparts/curses/extras::*slk-format* nil))))
  (setf *results* (nreverse *results*))
  (dolist (entry *results*)
    (format t "~&CURSES-FEATURE~C~A~C~A~C~A~%" #\Tab (first entry) #\Tab
            (if (second entry) "pass" "fail") #\Tab (substitute #\Space #\Newline (third entry))))
  (format t "~D feature assertions.~%" *assertions*)
  (every #'second *results*))

(deffeature lifecycle
  (check (not (isendwin))) (endwin) (check (isendwin)) (refresh) (check (not (isendwin)))
  (let* ((old *screen*) (next (newterm :native nil :input (make-string-input-stream "") :output (make-string-output-stream) :rows 4 :cols 10)))
    (check (eq next (set-term old))) (delscreen next) (check (eq *screen* old))))
(deffeature environment-layout
  (filter)
  (with-screen (:native nil :rows 5 :cols 20 :output (make-string-output-stream)) (check (= 1 *lines*)))
  (nofilter) (use-env nil) (use-tioctl t)
  (with-screen (:native nil :rows 5 :cols 20 :output (make-string-output-stream)) (check (= 5 *lines*))))
(deffeature ripoffline-layout
  (let ((reserved nil))
    (check (= 0 (ripoffline 1 (lambda (w cols) (check (= 20 cols)) (setf reserved w)))))
    (with-screen (:native nil :rows 5 :cols 20 :output (make-string-output-stream))
      (check reserved) (check (= 4 *lines*)) (check (= 1 (getbegyx *stdscr*))))))
(deffeature soft-labels
  (check (= 0 (slk-init 0)))
  (with-screen (:native nil :rows 5 :cols 80 :output (make-string-output-stream))
    (check (= 4 *lines*)) (check (= 0 (slk-set 1 " Help " 1))) (check (string= "Help" (slk-label 1)))
    (check (= 0 (slk-wset 2 "Save" 2))) (slk-attron +a-bold+) (check (logtest (slk-attr) +a-bold+))
    (slk-attroff +a-bold+) (slk-attr-on +a-reverse+) (slk-attr-off +a-reverse+)
    (slk-attrset 0) (slk-attr-set +a-bold+ 0) (check (= 0 (slk-color 0)))
    (slk-touch) (check (= 0 (slk-noutrefresh))) (check (= 0 (slk-refresh)))
    (check (search "Help" (row (ooparts/curses/extras::slk-window))))
    (slk-clear) (check (not (search "Help" (row (ooparts/curses/extras::slk-window))))) (slk-restore)))
(deffeature palette-definition
  (check (can-change-color)) (output) (check (= 0 (init-color 3 1000 500 0)))
  (check (search "]4;3;rgb:" (output)))
  (check (equal '(1000 500 0 0) (multiple-value-list (color-content 3))))
  (check (= -1 (init-color 3 1001 0 0)))
  (check (= 0 (init-extended-color 4 0 1000 0)))
  (check (equal '(0 1000 0 0) (multiple-value-list (extended-color-content 4)))))
(deffeature extended-pairs
  (start-color) (check (= 0 (init-extended-pair 1024 255 -1)))
  (check (equal '(255 -1 0) (multiple-value-list (extended-pair-content 1024))))
  (wattr-set *stdscr* +a-bold+ 1024) (addch #\X) (refresh)
  (check (search "38;5;255" (output))))
(deffeature default-colors
  (check (= 0 (use-default-colors))) (check (= 0 (assume-default-colors 7 0)))
  (check (equal '(7 0 0) (multiple-value-list (pair-content 0)))))
(deffeature graphics-charset
  (addch +acs-hline+) (refresh) (check (search (esc "(0") (output)))
  (erase) (add-wch +wacs-ulcorner+) (check (char= (code-char #x250c) (char (row *stdscr*) 0))))
(deffeature protected-cells
  (attron +a-protect+) (addch #\X) (refresh) (check (search (esc "[1\"q") (output))))
(deffeature cursor-visibility
  (curs-set 0) (check (search "?25l" (output))) (check (= 0 (curs-set 2)))
  (check (search "1 q" (output))) (check (= 2 (curs-set 1))) (check (= -1 (curs-set 4))))
(deffeature emoji-joiner
  (addstr (codepoints #x1f469 #x200d #x1f4bb))
  (check (= 2 (nth-value 1 (getyx *stdscr*))))
  (move 0 0) (check (string= (codepoints #x1f469 #x200d #x1f4bb) (getcchar (inch)))))
(deffeature emoji-flag
  (addstr (codepoints #x1f1ef #x1f1f5)) (check (= 2 (nth-value 1 (getyx *stdscr*))))
  (move 0 0) (check (string= (codepoints #x1f1ef #x1f1f5) (getcchar (inch)))))
(deffeature emoji-variation
  (addstr (codepoints #x2764 #xfe0f)) (check (= 2 (nth-value 1 (getyx *stdscr*)))) )
(deffeature emoji-skin-tone
  (addstr (codepoints #x1f44d #x1f3fd)) (check (= 2 (nth-value 1 (getyx *stdscr*)))) )
(deffeature input-meta
  (meta *stdscr* nil) (feed (string (code-char 233))) (check (= 105 (getch)))
  (meta *stdscr* t) (feed (string (code-char 233))) (check (= 233 (getch))))
(deffeature input-options
  (intrflush *stdscr* nil) (qiflush) (noqiflush) (check (= 0 (typeahead -1)))
  (check (= -1 (typeahead -2))) (check (characterp (erasechar))) (check (characterp (killchar)))
  (check (characterp (erasewchar))) (check (characterp (killwchar))) (check (>= (baudrate) 0))
  (raw) (noraw) (cbreak) (nocbreak) (echo) (noecho) (nl) (nonl) (halfdelay 1) (timeout 0)
  (notimeout *stdscr* nil) (set-escdelay 10) (check (= 10 (get-escdelay))) (set-tabsize 4)
  (nodelay *stdscr* t) (wtimeout *stdscr* 0) (flushinp))
(deffeature tty-snapshots
  (def-prog-mode) (raw) (reset-prog-mode) (savetty) (cbreak) (resetty)
  (def-shell-mode) (noecho) (reset-shell-mode) (check (= 0 (delay-output 0))))
(deffeature key-definitions
  (define-key (esc "[99~") 999) (check (= 999 (key-defined (esc "[99~"))))
  (check (string= (esc "[99~") (keybound 999))) (check (has-key 999))
  (keyok 999 nil) (check (not (has-key 999))) (keyok 999 t)
  (check (string= "KEY_UP" (keyname +key-up+))) (check (string= "z" (key-name #\z)))
  (check (string= "^A" (unctrl 1))) (check (string= "^A" (wunctrl 1))))
(deffeature mouse-clicks
  (mousemask #x1c) (mouseinterval 500)
  (feed (concatenate 'string (esc "[<0;2;2M") (esc "[<0;2;2m")
                            (esc "[<0;2;2M") (esc "[<0;2;2m")
                            (esc "[<0;2;2M") (esc "[<0;2;2m")))
  (dolist (action '(:click :double-click :triple-click))
    (check (= +key-mouse+ (getch))) (check (eq action (mouse-event-action (getmouse)))))
  (check (= 500 (mouseinterval -1))))
(deffeature mouse-coordinate-conversion
  (let ((w (newwin 2 4 2 3)))
    (check (wenclose w 2 3)) (check (equal '(0 0 t) (multiple-value-list (wmouse-trafo w 2 3 nil))))
    (check (equal '(2 3 t) (multiple-value-list (wmouse-trafo w 0 0 t)))))
    (check (equal '(0 0 t) (multiple-value-list (mouse-trafo 0 0 nil))))
    (ungetmouse (make-mouse-event :x 3 :y 2)) (check (= +key-mouse+ (getch))) (check (= 3 (mouse-event-x (getmouse)))))
(deffeature scanf-integers
  (feed (format nil "-12 0xff 077 ff~%"))
  (check (equal '((-12 255 63 255) 4) (multiple-value-list (scanw "%d %i %o %x")))) )
(deffeature scanf-text
  (feed (format nil "word abc123 Z%~%"))
  (check (equal '(("word" "abc" 123 "Z") 4) (multiple-value-list (wscanw *stdscr* "%s %[a-z]%d %c%%")))))
(deffeature scanf-width-suppression
  (feed (format nil "12345 xx~%"))
  (check (equal '((123 5 "xx" 8) 3) (multiple-value-list (mvscanw 1 1 "%3d%*1d%d %s%n")))))
(deffeature scanf-wide-variants
  (feed (format nil "2.5~%")) (check (= 2.5d0 (first (mvwscanw *stdscr* 0 0 "%f"))))
  (feed (format nil "9~%")) (check (equal '(9) (vw-scanw *stdscr* "%d")))
  (feed (format nil "8~%")) (check (equal '(8) (vwscanw *stdscr* "%d"))))
(deffeature terminfo-profiles
  (check (= 0 (setupterm "xterm-256color"))) (check (= 256 (tigetnum "colors")))
  (check (= 1 (tigetflag "am"))) (check (= -1 (tigetflag "invalid")))
  (check (= -2 (tigetnum "invalid"))) (check (= -1 (tigetstr "invalid")))
  (check (search "H" (tigetstr "cup")))
  (let ((old *cur-term*)) (setupterm "vt100") (check (= -1 (tigetnum "colors")))
    (check (set-curterm old)) (check (= 256 (tigetnum "colors"))))
  (check (= -1 (setupterm "nonexistent"))) (check (= 0 (restartterm "xterm"))))
(deffeature termcap-profiles
  (check (= 1 (tgetent "xterm"))) (check (= 1 (tgetflag "am")))
  (check (= 40 (tgetnum "co")))
  (check (string= (esc "[3;5H") (tgoto (tgetstr "cm") 4 2)))
  (let ((term *cur-term*)) (check (= 0 (del-curterm term))) (check (null *cur-term*))))
(deffeature terminfo-stack-arithmetic
  (dolist (entry '(("%p1%p2%+%d" 7 3 "10") ("%p1%p2%-%d" 7 3 "4")
                   ("%p1%p2%*%d" 7 3 "21") ("%p1%p2%/%d" 7 3 "2")
                   ("%p1%p2%m%d" 7 3 "1") ("%p1%p2%&%d" 7 3 "3")
                   ("%p1%p2%|%d" 4 3 "7") ("%p1%p2%^%d" 7 3 "4")))
    (destructuring-bind (control a b expected) entry (check (string= expected (tparm control a b))))))
(deffeature terminfo-conditionals
  (check (string= "small" (tparm "%?%p1%{5}%<%tsmall%elarge%;" 3)))
  (check (string= "large" (tparm "%?%p1%{5}%<%tsmall%elarge%;" 9)))
  (check (string= "B" (tparm "%?%p1%t%?%p2%tA%eB%;%eC%;" 1 0))))
(deffeature terminfo-variables-and-format
  (check (string= "0007:ff:abc:3" (tiparm "%p1%Pa%ga%04d:%p2%02x:%p3%s:%p3%l%d" 7 255 "abc")))
  (check (string= "A%" (tparm "%{65}%c%%"))))
(deffeature terminfo-output
  (let ((chars nil))
    (tputs "a$<0>b" 1 (lambda (c) (push c chars))) (check (string= "ab" (coerce (reverse chars) 'string))))
  (putp "text") (check (search "text" (output)))
  (vidattr +a-bold+) (check (search "1" (output)))
  (vid-attr +a-underline+ 0) (vidputs +a-bold+ (lambda (c) (declare (ignore c))))
  (vid-puts +a-reverse+ 0 (lambda (c) (declare (ignore c)))))
(deffeature panel-stacking
  (let* ((w1 (newwin 2 5 0 0)) (w2 (newwin 2 5 0 0)) (p1 (new-panel w1)) (p2 (new-panel w2)))
    (waddstr w1 "lower") (waddstr w2 "upper") (update-panels)
    (check (string= "upper" (subseq (row (ooparts/curses/model:screen-desired *screen*)) 0 5)))
    (check (eq p2 (panel-above p1))) (check (eq p1 (panel-below p2)))
    (check (eq p1 (panel-above nil))) (check (eq p2 (panel-below nil)))
    (top-panel p1) (update-panels) (check (string= "lower" (subseq (row (ooparts/curses/model:screen-desired *screen*)) 0 5)))
    (hide-panel p1) (check (panel-hidden p1)) (show-panel p1) (bottom-panel p1)
    (check (eq w1 (panel-window p1))) (replace-panel p1 w2) (move-panel p1 1 2)
    (set-panel-userptr p1 :data) (check (eq :data (panel-userptr p1)))
    (check (= 0 (del-panel p1))) (check (= 0 (del-panel p2)))))
(deffeature menu-navigation-and-pattern
  (let* ((a (new-item "Alpha" "first")) (b (new-item "Beta" "second")) (m (new-menu (list a b))))
    (set-menu-format m 2 1) (check (equal '(2 1) (multiple-value-list (menu-format m))))
    (check (= 2 (item-count m))) (check (= 0 (item-index a)))
    (check (= 0 (post-menu m))) (check (item-visible b))
    (menu-driver m +req-next-item+) (check (eq b (current-item m)))
    (check (= 0 (menu-driver-w m +req-first-item+)))
    (set-menu-pattern m "Be") (check (eq b (current-item m))) (check (string= "Be" (menu-pattern m)))
    (check (= 0 (set-top-row m 0))) (check (= 0 (top-row m)))
    (check (pos-menu-cursor m)) (check (= 0 (unpost-menu m)))
    (check (= 0 (free-menu m))) (check (= 0 (free-item a)))))
(deffeature menu-options-and-properties
  (let* ((i (new-item "A" "desc")) (m (new-menu (list i))))
    (check (string= "A" (item-name i))) (check (string= "desc" (item-description i)))
    (set-item-userptr i 42) (check (= 42 (item-userptr i)))
    (item-opts-off i +o-selectable+) (check (zerop (item-opts i))) (item-opts-on i +o-selectable+)
    (set-item-opts i +o-selectable+)
    (menu-opts-off m +o-onevalue+) (set-item-value i t) (check (item-value i)) (menu-opts-on m +o-onevalue+)
    (set-menu-userptr m :m) (check (eq :m (menu-userptr m)))
    (set-menu-win m *stdscr*) (set-menu-sub m *stdscr*) (check (eq *stdscr* (menu-win m))) (check (eq *stdscr* (menu-sub m)))
    (set-menu-mark m ">") (check (string= ">" (menu-mark m)))
    (set-menu-spacing m 2 1 3) (check (equal '(2 1 3) (multiple-value-list (menu-spacing m))))
    (check (plusp (scale-menu m)))
    (set-menu-fore m +a-bold+) (check (= +a-bold+ (menu-fore m)))
    (set-menu-back m 0) (check (= 0 (menu-back m)))
    (set-menu-grey m +a-dim+) (check (= +a-dim+ (menu-grey m)))
    (set-menu-pad m #\.) (check (char= #\. (menu-pad m)))
    (let ((n 0)) (set-menu-init m (lambda (m) (declare (ignore m)) (incf n)))
      (set-menu-term m (lambda (m) (declare (ignore m)) (incf n)))
      (set-item-init m (lambda (m) (declare (ignore m)) (incf n)))
      (set-item-term m (lambda (m) (declare (ignore m)) (incf n)))
      (post-menu m) (unpost-menu m) (check (= 4 n)))))
(deffeature form-buffer-sharing
  (let* ((a (new-field 1 10 0 0 0 1)) (copy (dup-field a 1 0)) (linked (link-field a 2 0)))
    (set-field-buffer a 0 "hello") (check (string= "hello" (field-buffer linked 0)))
    (check (string= "" (field-buffer copy 0)))
    (check (equal '(1 10 0 0 0 1) (multiple-value-list (field-info a))))
    (check (equal '(1 10 10) (multiple-value-list (dynamic-field-info a))))
    (check (= 0 (move-field a 1 2))) (check (= 0 (set-max-field a 8)))
    (check (= -1 (set-field-buffer a 0 "too-long-text")))
    (check (= 0 (free-field a)))))
(deffeature form-edit-and-navigation
  (let* ((a (new-field 1 10 0 0)) (b (new-field 1 10 1 0)) (f (new-form (list a b))))
    (check (= 0 (post-form f))) (form-driver-w f #\a) (form-driver f #\b)
    (check (string= "ab" (field-buffer a 0)))
    (form-driver f +req-prev-char+) (form-driver f +req-del-char+)
    (check (string= "a" (field-buffer a 0)))
    (form-driver f +req-next-field+) (check (eq b (current-field f)))
    (check (= 1 (field-index b))) (check (= 2 (field-count f)))
    (set-new-page b t) (check (new-page b)) (check (= 0 (set-form-page f 1))) (check (= 1 (form-page f)))
    (set-current-field f a) (check (data-ahead f)) (form-driver f +req-end-field+) (check (data-behind f))
    (check (= 0 (unpost-form f))) (check (= 0 (free-form f)))))
(deffeature form-field-validation
  (let* ((a (new-field 1 10 0 0)) (f (new-form (list a))))
    (post-form f) (set-field-type a type-integer 0 1 9) (set-field-buffer a 0 "4")
    (check (= 0 (form-driver f +req-validation+))) (set-field-buffer a 0 "20")
    (check (= -1 (form-driver f +req-validation+)))
    (set-field-type a type-enum '("red" "blue") nil nil) (set-field-buffer a 0 "red")
    (form-driver f +req-next-choice+) (check (string= "blue" (field-buffer a 0)))
    (set-field-type a type-regexp "^[a-z]+$") (check (= 0 (form-driver f +req-validation+)))
    (set-field-type a type-ipv4) (set-field-buffer a 0 "127.0.0.1") (check (= 0 (form-driver f +req-validation+)))))
(deffeature form-options-and-hooks
  (let* ((a (new-field 1 10 0 0)) (f (new-form (list a))))
    (set-field-just a +justif-right+) (check (= +justif-right+ (field-just a)))
    (set-field-fore a +a-bold+) (check (= +a-bold+ (field-fore a)))
    (set-field-back a +a-dim+) (check (= +a-dim+ (field-back a)))
    (set-field-pad a #\.) (check (char= #\. (field-pad a)))
    (field-opts-off a +o-public+) (check (not (logtest +o-public+ (field-opts a)))) (field-opts-on a +o-public+)
    (set-field-opts a (field-opts a)) (set-field-status a nil) (check (not (field-status a)))
    (set-field-userptr a :field) (check (eq :field (field-userptr a)))
    (set-form-userptr f :form) (check (eq :form (form-userptr f)))
    (set-form-win f *stdscr*) (set-form-sub f *stdscr*)
    (check (eq *stdscr* (form-win f))) (check (eq *stdscr* (form-sub f)))
    (form-opts-off f +o-bs-overload+) (form-opts-on f +o-bs-overload+) (set-form-opts f 3) (check (= 3 (form-opts f)))
    (check (= 1 (scale-form f)))
    (let ((n 0))
      (set-form-init f (lambda (f) (declare (ignore f)) (incf n)))
      (set-form-term f (lambda (f) (declare (ignore f)) (incf n)))
      (set-field-init f (lambda (f) (declare (ignore f)) (incf n)))
      (set-field-term f (lambda (f) (declare (ignore f)) (incf n)))
      (post-form f) (unpost-form f) (check (= 4 n)))))

(defun invoke-variant (name arguments)
  (let* ((name (string-upcase name)) (function (symbol-function (find-symbol name :ooparts/curses))))
    (apply function
           (append (cond ((and (>= (length name) 3) (string= name "MVW" :end1 3)) (list *stdscr* 1 1))
                         ((and (>= (length name) 2) (string= name "MV" :end1 2)) (list 1 1))
                         ((char= (char name 0) #\W) (list *stdscr*)) (t nil)) arguments))))
(deffeature output-variant-matrix
  (dolist (entry '(("ADDCH" (#\A)) ("ADD-WCH" (#\A)) ("ADDSTR" ("AB")) ("ADDNSTR" ("AB" 1))
                   ("ADDWSTR" ("AB")) ("ADDNWSTR" ("AB" 1))
                   ("ADDCHSTR" (#(#\A #\B))) ("ADDCHNSTR" (#(#\A #\B) 1))
                   ("ADD-WCHSTR" (#(#\A #\B))) ("ADD-WCHNSTR" (#(#\A #\B) 1))
                   ("INSCH" (#\A)) ("INS-WCH" (#\A)) ("INSSTR" ("AB")) ("INSNSTR" ("AB" 1))
                   ("INS-WSTR" ("AB")) ("INS-NWSTR" ("AB" 1))))
    (dolist (prefix '("" "W" "MV" "MVW"))
      (erase) (check (= 0 (invoke-variant (concatenate 'string prefix (first entry)) (second entry))))
      (check (char= #\A (char (row *stdscr* (if (search "MV" prefix) 1 0)) (if (search "MV" prefix) 1 0)))))))
(deffeature cell-read-variant-matrix
  (dolist (entry '(("INCH" nil :cell) ("IN-WCH" nil :cell)
                   ("INSTR" nil :string) ("INNSTR" (1) :string) ("INWSTR" nil :string) ("INNWSTR" (1) :string)
                   ("INCHSTR" nil :vector) ("INCHNSTR" (1) :vector)
                   ("IN-WCHSTR" nil :vector) ("IN-WCHNSTR" (1) :vector)))
    (dolist (prefix '("" "W" "MV" "MVW"))
      (erase) (mvaddstr 0 0 "A") (mvaddstr 1 1 "A") (move 0 0)
      (let ((value (invoke-variant (concatenate 'string prefix (first entry)) (second entry))))
        (check (case (third entry)
                 (:cell (string= "A" (getcchar value)))
                 (:string (char= #\A (char value 0)))
                 (:vector (string= "A" (getcchar (aref value 0))))))))))
(deffeature input-variant-matrix
  (dolist (entry '(("GETCH" nil :code) ("GET-WCH" nil :char) ("GETSTR" nil :string) ("GETNSTR" (2) :string)
                   ("GET-WSTR" nil :string) ("GETN-WSTR" (2) :string)))
    (dolist (prefix '("" "W" "MV" "MVW"))
      (feed (format nil "A~%"))
      (let ((value (invoke-variant (concatenate 'string prefix (first entry)) (second entry))))
        (check (case (third entry) (:code (= 65 value)) (:char (char= #\A value)) (:string (string= "A" value)))))))
  (unget-wch #\Z) (check (char= #\Z (get-wch))))
(deffeature line-variant-matrix
  (dolist (base '("HLINE" "VLINE" "HLINE-SET" "VLINE-SET"))
    (dolist (prefix '("" "W" "MV" "MVW"))
      (erase) (check (= 0 (invoke-variant (concatenate 'string prefix base) (list #\X 3))))
      (check (char= #\X (char (row *stdscr* (if (search "MV" prefix) 1 0)) (if (search "MV" prefix) 1 0)))))))
(deffeature deletion-and-attribute-variants
  (dolist (prefix '("" "W" "MV" "MVW"))
    (erase) (mvaddstr 0 0 "AB") (mvaddstr 1 1 "AB") (move 0 0)
    (check (= 0 (invoke-variant (concatenate 'string prefix "DELCH") nil)))
    (check (char= #\B (char (row *stdscr* (if (search "MV" prefix) 1 0)) (if (search "MV" prefix) 1 0))))
    (check (= 0 (invoke-variant (concatenate 'string prefix "CHGAT") (list 1 +a-bold+ 0)))))
  (standout) (check (logtest (getattrs *stdscr*) +a-standout+)) (standend)
  (wstandout *stdscr*) (wstandend *stdscr*)
  (attr-on +a-bold+) (attr-off +a-bold+) (attron +a-bold+) (attroff +a-bold+) (attrset 0)
  (wattr-on *stdscr* +a-bold+) (wattr-off *stdscr* +a-bold+)
  (check (= 0 (getattrs *stdscr*))) (check (= 0 (color-set 0))))
(deffeature background-aliases
  (dolist (function '(bkgdset bkgrndset)) (funcall function #\.) (check (string= "." (getcchar (getbkgd *stdscr*)))))
  (dolist (function '(wbkgdset wbkgrndset)) (funcall function *stdscr* #\.) (check (string= "." (getcchar (getbkgrnd *stdscr*)))))
  (dolist (function '(bkgd bkgrnd)) (funcall function #\.) (erase) (check (char= #\. (char (row *stdscr*) 0))))
  (dolist (function '(wbkgd wbkgrnd)) (funcall function *stdscr* #\.) (erase) (check (char= #\. (char (row *stdscr*) 0))))
  (check (string= "." (getcchar (wgetbkgrnd *stdscr*)))))
(deffeature formatted-output-aliases
  (dolist (prefix '("" "W" "MV" "MVW"))
    (erase) (check (= 0 (invoke-variant (concatenate 'string prefix "PRINTW") (list "~A~D" "A" 7))))
    (check (search "A7" (row *stdscr* (if (search "MV" prefix) 1 0)))))
  (erase) (vw-printw *stdscr* "~A" '("first")) (check (search "first" (row *stdscr*)))
  (erase) (vwprintw *stdscr* "~A" '("second")) (check (search "second" (row *stdscr*))))
(deffeature border-and-echo-aliases
  (dolist (function '(border border-set)) (erase) (funcall function) (check (char= #\+ (char (row *stdscr*) 0))))
  (dolist (function '(wborder wborder-set box box-set))
    (erase) (funcall function *stdscr*) (check (char= #\+ (char (row *stdscr*) 0))))
  (dolist (function '(echochar echo-wchar)) (erase) (funcall function #\A) (check (char= #\A (char (row *stdscr*) 0))))
  (dolist (function '(wechochar wecho-wchar)) (erase) (funcall function *stdscr* #\A) (check (char= #\A (char (row *stdscr*) 0)))))
(deffeature window-sync-and-geometry
  (let* ((parent (newwin 4 10 1 2)) (child (subwin parent 2 4 2 3)) (copy (dupwin parent)))
    (check (equal '(4 10) (multiple-value-list (getmaxyx parent))))
    (check (equal '(1 1) (multiple-value-list (getparyx child))))
    (waddstr child "A") (wsyncup child) (check (is-linetouched parent 1))
    (check (= 0 (delwin copy))))
  (let ((pad (newpad 8 40))) (check (subpad pad 2 4 1 1)))
  (setsyx 2 3) (check (equal '(2 3) (multiple-value-list (getsyx))))
  (leaveok *stdscr* t) (leaveok *stdscr* nil) (immedok *stdscr* t) (addch #\A) (immedok *stdscr* nil)
  (idlok *stdscr* t) (idcok *stdscr* t)
  (clearok *stdscr* t) (touchline *stdscr* 0 1) (redrawwin *stdscr*) (wredrawln *stdscr* 0 1)
  (check (= 0 (mvcur 0 0 2 3))) (check (has-ic)) (check (has-il))
  (check (integerp (termattrs))) (check (integerp (term-attrs))) (check (search "terminal" (longname))))
(deffeature line-edit-aliases
  (addstr "A") (move 0 0) (deleteln) (check (char= #\Space (char (row *stdscr*) 0)))
  (addstr "A") (move 0 0) (wdeleteln *stdscr*) (insdelln 1) (scrollok *stdscr* t) (scroll *stdscr*)
  (check (char= #\Space (char (row *stdscr*) 0))))
(deffeature screen-dump-roundtrip
  (uiop:with-temporary-file (:pathname path :stream stream)
    (close stream) (addstr "persist") (refresh) (check (= 0 (scr-dump path)))
    (erase) (refresh) (check (= 0 (scr-restore path)))
    (check (search "persist" (row (ooparts/curses/model:screen-desired *screen*))))
    (check (= 0 (scr-init path))) (check (= 0 (scr-set path)))))
(deffeature terminal-notifications
  (output) (beep) (check (find (code-char 7) (output)))
  (flash) (check (search "?5h" (output))))
(deffeature truecolor-pairs
  (check (= 0 (init-rgb-pair 2000 '(12 34 56) '(78 90 123))))
  (start-color) (attr-set 0 2000) (addch #\A) (refresh)
  (check (search "38;2;12;34;56" (output)))
  (check (= -1 (init-rgb-pair 2 '(300 0 0) nil))))
(deffeature form-word-and-line-editing
  (let* ((a (new-field 2 10 0 0 2)) (f (new-form (list a))))
    (field-opts-off a +o-static+) (set-max-field a 0) (set-field-buffer a 0 "one two three") (post-form f)
    (check (= 0 (form-driver f +req-next-word+)))
    (form-driver f +req-del-word+) (check (string= "one  three" (field-buffer a 0)))
    (form-driver f +req-prev-word+) (form-driver f +req-ins-char+) (check (char= #\Space (char (field-buffer a 0) 0)))
    (check (= 0 (form-driver f +req-ins-line+))) (check (> (length (field-buffer a 0)) 10))
    (check (= 0 (form-driver f +req-del-line+)))
    (check (= 0 (form-driver f +req-new-line+)))
    (check (= 0 (form-driver f +req-scr-fline+))) (check (= 0 (form-driver f +req-scr-bline+)))
    (unpost-form f)))
(deffeature custom-fieldtypes
  (let* ((a (new-field 1 10 0 0)) (f (new-form (list a)))
         (type (new-fieldtype (lambda (field args) (string= (field-buffer field 0) (first args)))
                              (lambda (char args) (declare (ignore args)) (alpha-char-p char)))))
    (set-fieldtype-arg type #'list #'copy-list (lambda (args) (declare (ignore args))))
    (set-fieldtype-choice type (lambda (field args) (set-field-buffer field 0 (first args)))
                              (lambda (field args) (set-field-buffer field 0 (first args))))
    (set-field-type a type "valid") (check (eq type (field-type a))) (check (equal '("valid") (field-arg a)))
    (post-form f) (check (= -1 (form-driver f #\1))) (check (= 0 (form-driver f #\v)))
    (set-field-buffer a 0 "valid") (check (= 0 (form-driver f +req-validation+)))
    (check (= 0 (form-driver f +req-next-choice+))) (unpost-form f)
    (let ((linked (link-fieldtype type type))) (check (= 0 (free-fieldtype linked))))))

(deffeature terminfo-format-flags
  (check (string= "+0007" (tparm "%p1%:+05d" 7)))
  (check (string= "0x00ff" (tparm "%p1%:#06x" 255)))
  (check (string= "abc     " (tparm "%p1%:-8.3s" "abcdef")))
  (check (= 0 (tigetflag "xenl")))
  (check (null (tigetstr "cpi"))))
