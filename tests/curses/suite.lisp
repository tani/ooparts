(uiop:define-package #:ooparts-tests/curses/suite
  (:use #:cl)
  (:import-from #:ooparts/curses)
  (:import-from #:ooparts/curses/model)
  (:export #:run-tests))
(in-package #:ooparts-tests/curses/suite)

(defvar *checks* 0)
(defmacro check (form)
  `(progn (incf *checks*) (unless ,form (error "Curses check failed: ~S" ',form))))
(defmacro session ((&key (input "") (rows 6) (cols 16) (profile :xterm)) &body body)
  `(let ((output (make-string-output-stream)))
     (ooparts/curses:with-screen (:native nil :input (make-string-input-stream ,input) :output output
                             :rows ,rows :cols ,cols :profile ,profile)
       ,@body)))
(defun line (win y)
  (let ((cy (nth-value 0 (ooparts/curses:getyx win))) (cx (nth-value 1 (ooparts/curses:getyx win))))
    (unwind-protect (progn (ooparts/curses:wmove win y 0) (ooparts/curses:winstr win)) (ooparts/curses:wmove win cy cx))))
(defun esc (suffix) (concatenate 'string (string (code-char 27)) suffix))

(defun run-tests ()
  (let ((*checks* 0))
    (session ()
      (check (= 0 (ooparts/curses:addstr "hello")))
      (check (string= "hello           " (line ooparts/curses:*stdscr* 0)))
      (check (= 5 (nth-value 1 (ooparts/curses:getyx ooparts/curses:*stdscr*))))
      (check (= -1 (ooparts/curses:move 9 0)))
      (check (= 0 (ooparts/curses:mvaddstr 1 2 "world")))
      (check (string= "  world         " (line ooparts/curses:*stdscr* 1)))
      (ooparts/curses:move 0 2) (ooparts/curses:insch #\X)
      (check (string= "heXllo          " (line ooparts/curses:*stdscr* 0)))
      (ooparts/curses:delch) (check (string= "hello           " (line ooparts/curses:*stdscr* 0)))
      (ooparts/curses:move 0 3) (ooparts/curses:clrtoeol)
      (check (string= "hel             " (line ooparts/curses:*stdscr* 0)))
      (ooparts/curses:move 1 3) (ooparts/curses:clrtobot)
      (check (string= "  w             " (line ooparts/curses:*stdscr* 1)))
      (ooparts/curses:clear) (check (equal '(0 0) (multiple-value-list (ooparts/curses:getyx ooparts/curses:*stdscr*)))))
    (session ()
      (let* ((parent (ooparts/curses:newwin 4 10 1 2)) (child (ooparts/curses:derwin parent 2 5 1 2)))
        (check child) (check (null (ooparts/curses:derwin parent 4 10 1 0)))
        (ooparts/curses:waddstr child "abc")
        (check (string= "  abc     " (line parent 1)))
        (check (= -1 (ooparts/curses:delwin parent)))
        (ooparts/curses:wmove child 1 1) (ooparts/curses:wcursyncup child)
        (check (equal '(2 3) (multiple-value-list (ooparts/curses:getyx parent))))
        (ooparts/curses:untouchwin parent) (ooparts/curses:syncok child t) (ooparts/curses:mvwaddch child 0 0 #\Z)
        (check (ooparts/curses:is-linetouched parent 1))
        (check (= 0 (ooparts/curses:mvderwin child 0 0)))
        (check (string= "     " (line child 0)))
        (check (= 0 (ooparts/curses:delwin child))) (check (= 0 (ooparts/curses:delwin parent)))))
    (session (:rows 4 :cols 8)
      (loop for y below 4 for text in '("AAAA" "BBBB" "CCCC" "DDDD") do (ooparts/curses:mvaddstr y 0 text))
      (ooparts/curses:scrollok ooparts/curses:*stdscr* t) (ooparts/curses:setscrreg 1 2) (ooparts/curses:scrl 1)
      (check (string= "AAAA    " (line ooparts/curses:*stdscr* 0)))
      (check (string= "CCCC    " (line ooparts/curses:*stdscr* 1)))
      (check (string= "        " (line ooparts/curses:*stdscr* 2)))
      (check (string= "DDDD    " (line ooparts/curses:*stdscr* 3)))
      (ooparts/curses:scrl -1) (check (string= "CCCC    " (line ooparts/curses:*stdscr* 2)))
      (ooparts/curses:move 1 0) (ooparts/curses:insertln) (check (string= "        " (line ooparts/curses:*stdscr* 2))))
    (session (:rows 4 :cols 8)
      (let ((wide (string (code-char #x754c))) (combining (string (code-char #x301))))
        (check (= 2 (ooparts/curses:text-width wide)))
        (ooparts/curses:addstr (concatenate 'string "a" wide "b"))
        (check (= 4 (nth-value 1 (ooparts/curses:getyx ooparts/curses:*stdscr*))))
        (ooparts/curses:move 0 2) (ooparts/curses:addch #\X)
        (check (string= "a Xb    " (line ooparts/curses:*stdscr* 0)))
        (ooparts/curses:move 1 0) (ooparts/curses:addstr (concatenate 'string "e" combining))
        (check (= 1 (nth-value 1 (ooparts/curses:getyx ooparts/curses:*stdscr*))))
        (check (string= (concatenate 'string "e" combining "       ") (line ooparts/curses:*stdscr* 1)))
        (check (equal (list (concatenate 'string "e" combining) ooparts/curses:+a-bold+ 2)
                      (multiple-value-list (ooparts/curses:getcchar (ooparts/curses:setcchar (concatenate 'string "e" combining) ooparts/curses:+a-bold+ 2)))))
        (ooparts/curses:mvaddstr 2 0 wide) (ooparts/curses:move 2 1) (ooparts/curses:chgat 1 ooparts/curses:+a-bold+ 0)
        (ooparts/curses:move 2 0) (check (= ooparts/curses:+a-bold+ (nth-value 1 (ooparts/curses:getcchar (ooparts/curses:inch)))))
        (ooparts/curses:move 2 1) (check (= ooparts/curses:+a-bold+ (nth-value 1 (ooparts/curses:getcchar (ooparts/curses:inch)))))))
    (session ()
      (check (= 0 (ooparts/curses:start-color))) (check (= 0 (ooparts/curses:init-pair 1 2 4)))
      (check (equal '(2 4 0) (multiple-value-list (ooparts/curses:pair-content 1))))
      (ooparts/curses:attr-set ooparts/curses:+a-bold+ 1) (ooparts/curses:addstr "green")
      (check (equal (list ooparts/curses:+a-bold+ 1) (multiple-value-list (ooparts/curses:attr-get))))
      (check (= 0 (ooparts/curses:refresh)))
      (let ((first (get-output-stream-string output)))
        (check (search "32;44m" first)) (check (search "g" first)))
      (ooparts/curses:refresh)
      (let ((second (get-output-stream-string output)))
        (check (not (search "green" second))) (check (not (search "32;44m" second))))
      (ooparts/curses:mvaddch 0 1 #\X) (ooparts/curses:refresh)
      (check (search "X" (get-output-stream-string output)))
      (let* ((serialized (with-output-to-string (out) (ooparts/curses:putwin ooparts/curses:*stdscr* out)))
             (copy (ooparts/curses:getwin (make-string-input-stream serialized))))
        (check (string= (line copy 0) (line ooparts/curses:*stdscr* 0))) (ooparts/curses:delwin copy))
      (check (= 0 (ooparts/curses:resizeterm 8 20)))
      (check (= 8 ooparts/curses:*lines*)) (check (= 20 ooparts/curses:*cols*))
      (check (string= "gXeen               " (line ooparts/curses:*stdscr* 0))))
    (session (:profile :vt100)
      (check (not (ooparts/curses:has-colors))) (check (= -1 (ooparts/curses:start-color)))
      (check (not (ooparts/curses:has-mouse))) (check (= 0 (ooparts/curses:mousemask 1)))
      (check (not (search "1049" (get-output-stream-string output)))))
    (session (:rows 4 :cols 8)
      (let ((pad (ooparts/curses:newpad 10 20)))
        (ooparts/curses:mvwaddstr pad 3 4 "viewport")
        (check (= 0 (ooparts/curses:pnoutrefresh pad 3 4 0 0 1 7)))
        (ooparts/curses:doupdate) (check (search "v" (get-output-stream-string output)))
        (check (= -1 (ooparts/curses:pnoutrefresh pad 9 19 0 0 2 7)))
        (ooparts/curses:delwin pad)))
    (session ()
      (let ((a (ooparts/curses:newwin 2 5 0 0)) (b (ooparts/curses:newwin 2 5 0 0)))
        (ooparts/curses:waddstr a "a b") (ooparts/curses:waddstr b "XXXXX")
        (ooparts/curses:overlay a b) (check (string= "aXbXX" (line b 0)))
        (ooparts/curses:overwrite a b) (check (string= "a b  " (line b 0)))
        (ooparts/curses:copywin b b 0 0 0 1 0 4 nil) (check (string= "aa b " (line b 0)))))
    (session (:input (concatenate 'string "a" (esc "[A") (esc "OP") (esc "[3~") (esc "x")))
      (ooparts/curses:keypad ooparts/curses:*stdscr* t) (ooparts/curses:nodelay ooparts/curses:*stdscr* t)
      (check (= (char-code #\a) (ooparts/curses:getch)))
      (check (= ooparts/curses:+key-up+ (ooparts/curses:getch))) (check (= (ooparts/curses:key-f 1) (ooparts/curses:getch)))
      (check (= ooparts/curses:+key-dc+ (ooparts/curses:getch))) (check (= 27 (ooparts/curses:getch)))
      (check (= (char-code #\x) (ooparts/curses:getch))) (check (= -1 (ooparts/curses:getch)))
      (ooparts/curses:ungetch 123) (check (= 123 (ooparts/curses:getch))))
    (session (:input (concatenate 'string (esc "[200~") "paste" (esc "[201~") (esc "[<0;4;3M")))
      (ooparts/curses:keypad ooparts/curses:*stdscr* t) (ooparts/curses:mousemask ooparts/curses:+all-mouse-events+)
      (check (= ooparts/curses:+key-paste-begin+ (ooparts/curses:getch)))
      (check (string= "paste" (coerce (loop repeat 5 collect (code-char (ooparts/curses:getch))) 'string)))
      (check (= ooparts/curses:+key-paste-end+ (ooparts/curses:getch)))
      (check (= ooparts/curses:+key-mouse+ (ooparts/curses:getch)))
      (let ((event (ooparts/curses:getmouse)))
        (check (= 3 (ooparts/curses:mouse-event-x event))) (check (= 2 (ooparts/curses:mouse-event-y event)))
        (check (eq :press (ooparts/curses:mouse-event-action event)))))
    (session (:input (concatenate 'string (string (code-char #x754c)) (string #\Newline)))
      (check (char= (code-char #x754c) (ooparts/curses:get-wch)))
      (check (string= "" (ooparts/curses:getstr))))
    (session ()
      (let ((caught nil))
        (handler-case (ooparts/curses:getwin (make-string-input-stream "#.(error \"reader evaluation\")"))
          (error () (setf caught t)))
        (check caught)))
    (session ()
      (ooparts/curses:raw) (ooparts/curses:echo) (ooparts/curses:nonl) (ooparts/curses:savetty)
      (ooparts/curses:cbreak) (ooparts/curses:noecho) (ooparts/curses:nl) (ooparts/curses:resetty)
      (check (eq :raw (ooparts/curses/model:screen-mode ooparts/curses:*screen*)))
      (check (ooparts/curses/model:screen-echo-p ooparts/curses:*screen*))
      (check (not (ooparts/curses/model:screen-nl-p ooparts/curses:*screen*)))
      (let* ((parent (ooparts/curses:newwin 4 10 0 0))
             (child (ooparts/curses:derwin parent 2 4 1 1)))
        (check (= 0 (ooparts/curses:wresize parent 5 12)))
        (check (= -1 (ooparts/curses:wresize parent 1 1)))
        (check (= 0 (ooparts/curses:wresize child 3 5)))
        (ooparts/curses:mvwaddstr child 2 0 "share")
        (check (search "share" (line parent 3)))))
    (session (:input (concatenate 'string (esc "[200~") (esc "[A") (esc "[201~")))
      (ooparts/curses:keypad ooparts/curses:*stdscr* t)
      (check (= ooparts/curses:+key-paste-begin+ (ooparts/curses:getch)))
      (check (= 27 (ooparts/curses:getch)))
      (check (= (char-code #\[) (ooparts/curses:getch)))
      (check (= (char-code #\A) (ooparts/curses:getch)))
      (check (= ooparts/curses:+key-paste-end+ (ooparts/curses:getch))))
    (session ()
      (let ((wide (ooparts/curses:setcchar (string (code-char #x754c)) 0 0)))
        (ooparts/curses:add-wchstr (vector wide #\X))
        (check (string= (concatenate 'string (string (code-char #x754c)) "X             ")
                        (line ooparts/curses:*stdscr* 0)))
        (check (equal '(0 0) (multiple-value-list (ooparts/curses:getyx ooparts/curses:*stdscr*)))))
      (ooparts/curses:endwin) (check (ooparts/curses:isendwin))
      (ooparts/curses:refresh) (check (not (ooparts/curses:isendwin)))
      (let ((pad (ooparts/curses:newpad 8 20)))
        (check (= -1 (ooparts/curses:pechochar pad #\X)))
        (check (= 0 (ooparts/curses:prefresh pad 0 0 0 0 1 5)))
        (check (= 0 (ooparts/curses:pechochar pad #\Y)))))
    (do-external-symbols (symbol :ooparts/curses)
      (check (or (boundp symbol) (fboundp symbol) (eq symbol 'ooparts/curses:mouse-event))))
    (check (null ooparts/curses:*screen*))
    (format t "~D Curses checks passed.~%" *checks*) t))
