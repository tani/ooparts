(uiop:define-package #:ooparts-tests/prolog/kernel/wam-gc
  (:use #:cl #:ooparts/prolog)
  (:import-from #:ooparts-tests/prolog/support/assertions #:check #:solutions #:value-of)
  (:export #:palette #:red #:blue #:compare-gc-modes #:normalize-solutions #:run-wam-gc-tests))
(in-package #:ooparts-tests/prolog/kernel/wam-gc)

(defun normalize-solutions (solutions)
  ;; Normalize fresh unbound-variable symbols while preserving identity per solution.
  (mapcar (lambda (solution)
            (let ((names (make-hash-table :test 'eq)))
              (ooparts/prolog/kernel/engine:map-term solution
                (lambda (x)
                  (if (and (symbolp x) (null (symbol-package x)))
                      (or (gethash x names)
                          (setf (gethash x names) (list :unbound (hash-table-count names)))) x)))))
          solutions))
(defun compare-gc-modes (goals &optional limit)
  (let ((expected (normalize-solutions (query goals :limit limit :gc-threshold nil))))
    (dolist (threshold '(1 8 64))
        (check (equal expected (normalize-solutions
                                (query goals :limit limit :gc-threshold threshold)))
               "GC differential result"))))

(defun run-wam-gc-tests ()
  ;; Stress garbage construction and release while preserving older alternatives.
  (<-- (discard ?))
  (<-- (waste 0) !)
  (<- (waste ?n)
      (lispp (> ?n 0))
      (discard ( payload ?n ( nested ?n)))
      (lisp ?m (1- ?n))
      (waste ?m))
  (<-- (palette red)) (<- (palette blue))
  (<-- (product ?x ?y) (palette ?x) (waste 30) (palette ?y) (waste 30))
  (<-- (retry-gc ?x) (= ?x first) (waste 100) fail)
  (<- (retry-gc ?x) (= ?x second) (waste 100))
  (<-- (structured ( node ?x ( leaf ?x) ?)))
  (<-- (constant-structure ( node a b)))
  (<-- (unbound ?x ?y))
  (dolist (goals '(((append ?xs ?ys ( a b c d)))
                   ((ancestor alice ?x))
                   ((product ?x ?y))
                   ((retry-gc ?x))
                   ((same ?x ?y) (palette ?x) (waste 50))
                   ((structured ?x))
                   ((structured ( node a ( leaf b) ignored)))
                   ((structured ( node a ( leaf a) ignored)))
                   ((constant-structure ( node  . ?tail)))
                   ((constant-structure ( node . ( a  . ?tail))))
                   ((unbound ?x ?y))
                   ((= ?x (f ?y ?y)) (= ?y ( g a)))
                   ((= ?x (f a)) (= ?x ( g a)))
                   ((= ?x ( a  . ?tail)) (= ?x ( a b c)))
                   ((= ?x ( a  . ?tail)) (= ?tail ?rest))))
    (compare-gc-modes goals))
  (<-- (cut-child ?x) (palette ?x) (waste 30) !)
  (compare-gc-modes '((palette ?x) (cut-child ?y)))
  ;; Nested compound arguments and repeated variable constraints vary independently.
  (loop for i below 40 do
    (let ((term (list 'tree (list 'left i) (list 'right (mod i 5)))))
      (compare-gc-modes (list (list '= '?x term)
                              (list '= '?x (list 'tree (list 'left '?a) (list 'right '?b)))
                              (list '= '?a i)))
      (compare-gc-modes (list (list '= '?x term)
                              (list '= '?x (list 'tree (list 'left (1+ i)) '?rest))))))
  ;; Truly cyclic source graphs must compile as well as cycles made by unification.
  (let ((ring (cons 'a nil)))
    (setf (cdr ring) ring)
    (ooparts/prolog/syntax/compiler:add-clause (list 'cyclic-head ring) nil t)
    (dolist (goals (list (list (list '= '?x ring)) '((cyclic-head ?x))))
        (let ((vm (make-query goals :gc-threshold 1)))
          (unwind-protect
               (progn
                 (let ((term (value-of '?x (next-solution vm))))
                   (check (and (eq (car term) 'a) (eq (cdr term) term))
                          "cyclic source graph compiles and reifies"))
                 (collect-query-garbage vm))
            (close-query vm)))))
  ;; Collection between returned answers must retain future alternatives and undo data.
  (<-- (cycle-or-atom ?x) (= ?x ( a  . ?x)))
  (<- (cycle-or-atom final))
  (let ((vm (make-query '((cycle-or-atom ?x)) :gc-threshold 1)))
      (unwind-protect
           (progn
             (let ((x (value-of '?x (next-solution vm))))
               (check (eq (cdr x) x) "cyclic answer before forced GC"))
             (collect-query-garbage vm)
             (check (eq 'final (value-of '?x (next-solution vm))) "rollback after forced cyclic GC")
             (check (not (nth-value 1 (next-solution vm))) "exhaustion after forced GC"))
        (close-query vm)))
  ;; A detached answer must remain valid when subsequent searches collect the VM graph.
  (let ((vm (make-query '((append ?xs ?ys ( a b c))) :gc-threshold 1)))
    (unwind-protect
         (let ((first (next-solution vm)))
           (loop while (nth-value 1 (next-solution vm)) do (collect-query-garbage vm))
           (check (equal (value-of '?ys first) '(a b c)) "answer lifetime independent of VM"))
      (close-query vm)))
  ;; Actual compiler output must use term families rather than generalized templates.
  (let* ((p (gethash (cons 'structured 1) (ooparts/prolog/kernel/model:database-predicates *database*)))
         (ops (map 'list #'car (ooparts/prolog/kernel/model:predicate-code p))))
    (check (member 'ooparts/prolog/kernel/instructions:get-structure ops) "compiled GET_STRUCTURE")
    (check (member 'ooparts/prolog/kernel/instructions:unify-void ops) "compiled anonymous UNIFY_VOID")
    (check (not (intersection ops '(ooparts/prolog/kernel/instructions:get-term ooparts/prolog/kernel/instructions:put-args ooparts/prolog/kernel/engine:unify)))
           "production code uses granular term operations"))
  ;; Direct instruction programs exercise read/write modes, A/X aliasing, and VOID.
  (let* ((vm (ooparts/prolog/kernel/model:%make-machine
              :args (make-array 16 :initial-element nil)
              :code #((ooparts/prolog/kernel/instructions:allocate 3 16)
                      (ooparts/prolog/kernel/instructions:put-list (:x 0))
                      (ooparts/prolog/kernel/instructions:set-void 2)
                      (ooparts/prolog/kernel/instructions:get-list (:a 0))
                      (ooparts/prolog/kernel/instructions:unify-variable (:y 0))
                      (ooparts/prolog/kernel/instructions:unify-variable (:y 1))
                      (ooparts/prolog/kernel/instructions:put-constant a (:a 1))
                      (ooparts/prolog/kernel/instructions:get-value (:y 0) (:a 1))
                      (ooparts/prolog/kernel/instructions:put-structure pair 2 (:a 2))
                      (ooparts/prolog/kernel/instructions:set-value (:y 0))
                      (ooparts/prolog/kernel/instructions:set-variable (:y 2))
                      (ooparts/prolog/kernel/instructions:get-structure pair 2 (:a 2))
                      (ooparts/prolog/kernel/instructions:unify-constant a)
                      (ooparts/prolog/kernel/instructions:unify-void 1)
                      (ooparts/prolog/kernel/instructions:yield)))))
    (unwind-protect
         (progn
           (check (ooparts/prolog/kernel/engine:run-machine vm) "direct term instruction sequence")
           (check (not (eq (aref (ooparts/prolog/kernel/model:machine-slots vm) 0)
                           (aref (ooparts/prolog/kernel/model:machine-slots vm) 1))) "VOID creates independent variables")
           (collect-query-garbage vm)
           (check (equal (car (ooparts/prolog/kernel/engine:reify (aref (ooparts/prolog/kernel/model:machine-args vm) 2))) 'pair)
                  "instruction-register roots survive collection"))
      (close-query vm)))
  ;; Bounded managed live cells for long deterministic tail recursion with garbage terms.
  (let ((vm (make-query '((waste 100000)) :gc-threshold 64)))
    (unwind-protect
         (progn
           (check (nth-value 1 (next-solution vm)) "garbage-producing tail recursion")
           (let ((stats (query-statistics vm)))
             (check (plusp (getf stats :gc-count)) "automatic collection actually ran")
             (check (> (getf stats :gc-reclaimed) 100000) "unreachable cells reclaimed")
             (check (< (getf stats :max-heap-cells) 128) "bounded managed heap during tail recursion")
             (check (< (getf stats :max-trail-cells) 16) "bounded conditional trail")
             (format t "Garbage-producing tail recursion: ~S~%" stats)))
      (close-query vm)))
  ;; Collect while a write scan is active: its unfinished cons cell is a root.
  (let ((vm (ooparts/prolog/kernel/model:%make-machine :args (make-array 1 :initial-element nil))))
    (unwind-protect
         (progn
           (ooparts/prolog/kernel/wam:execute-term-instruction vm 'ooparts/prolog/kernel/instructions:put-list '((:a 0)))
           (setf (aref (ooparts/prolog/kernel/model:machine-args vm) 0) nil)
           (collect-query-garbage vm)
           (check (= 1 (length (ooparts/prolog/kernel/model:machine-heap vm))) "active scan roots survive GC")
           (ooparts/prolog/kernel/wam:execute-term-instruction vm 'ooparts/prolog/kernel/instructions:set-constant '(a))
           (ooparts/prolog/kernel/wam:execute-term-instruction vm 'ooparts/prolog/kernel/instructions:set-constant '(b))
           (collect-query-garbage vm)
           (check (zerop (length (ooparts/prolog/kernel/model:machine-heap vm))) "finished dead scan is reclaimed"))
      (close-query vm)))
  ;; Distinct and repeated numeric IDs must not change pointer identity or fallback.
  (let* ((vm (ooparts/prolog/kernel/model:%make-machine
              :args (make-array 2 :initial-element nil)))
         (first (ooparts/prolog/kernel/model:%make-var 0))
         (second (ooparts/prolog/kernel/model:%make-var 0)))
    (setf (ooparts/prolog/kernel/model:logic-var-binding first) first
          (ooparts/prolog/kernel/model:logic-var-binding second) second)
    (ooparts/prolog/kernel/engine:record-cell vm first)
    (ooparts/prolog/kernel/engine:record-cell vm second)
    (setf (aref (ooparts/prolog/kernel/model:machine-args vm) 0) first
          (aref (ooparts/prolog/kernel/model:machine-args vm) 1) second)
    (ooparts/prolog/kernel/engine:fresh-cons vm :dead nil)
    (unwind-protect
         (progn
           (check (= 1 (collect-query-garbage vm))
                  "duplicate-ID collection reclaims only the unrooted cons")
           (check (and (= 2 (length (ooparts/prolog/kernel/model:machine-heap vm)))
                       (find first (ooparts/prolog/kernel/model:machine-heap vm) :test #'eq)
                       (find second (ooparts/prolog/kernel/model:machine-heap vm) :test #'eq)
                       (not (eq first second))
                       (eq first (aref (ooparts/prolog/kernel/model:machine-args vm) 0))
                       (eq second (aref (ooparts/prolog/kernel/model:machine-args vm) 1)))
                  "duplicate IDs retain both distinct exact roots")
           (check (and (eq first (ooparts/prolog/kernel/model:logic-var-binding first))
                       (eq second (ooparts/prolog/kernel/model:logic-var-binding second)))
                  "duplicate-ID roots retain their self bindings"))
      (close-query vm)))
  (let* ((vm (ooparts/prolog/kernel/model:%make-machine
              :args (make-array 1 :initial-element nil)))
         (shared (ooparts/prolog/kernel/model:%make-var 0)))
    (setf (ooparts/prolog/kernel/model:logic-var-binding shared) shared)
    (ooparts/prolog/kernel/engine:record-cell vm shared)
    (ooparts/prolog/kernel/engine:record-cell vm shared)
    (setf (aref (ooparts/prolog/kernel/model:machine-args vm) 0) shared)
    (ooparts/prolog/kernel/engine:fresh-cons vm :dead nil)
    (unwind-protect
         (progn
           (check (= 1 (collect-query-garbage vm))
                  "repeated exact heap references reclaim only the unrooted cons")
           (check (and (= 2 (length (ooparts/prolog/kernel/model:machine-heap vm)))
                       (eq shared (aref (ooparts/prolog/kernel/model:machine-heap vm) 0))
                       (eq shared (aref (ooparts/prolog/kernel/model:machine-heap vm) 1))
                       (eq shared (ooparts/prolog/kernel/model:logic-var-binding shared)))
                  "indexed marks retain every duplicate exact heap slot"))
      (close-query vm)))
  (let* ((vm (ooparts/prolog/kernel/model:%make-machine
              :args (make-array 5 :initial-element nil)))
         (left (ooparts/prolog/kernel/model:%make-var 0))
         (right (ooparts/prolog/kernel/model:%make-var 2))
         ;; The final ID makes the managed logic-var sequence 0, 2, 1.
         (late (ooparts/prolog/kernel/model:%make-var 1)))
    (setf (ooparts/prolog/kernel/model:logic-var-binding left) left
          (ooparts/prolog/kernel/model:logic-var-binding right) right
          (ooparts/prolog/kernel/model:logic-var-binding late) late)
    (dolist (cell (list left right late))
      (ooparts/prolog/kernel/engine:record-cell vm cell))
    (setf (aref (ooparts/prolog/kernel/model:machine-args vm) 0) left
          (aref (ooparts/prolog/kernel/model:machine-args vm) 1) right
          (aref (ooparts/prolog/kernel/model:machine-args vm) 2) late)
    (let* ((alias (ooparts/prolog/kernel/engine:fresh-cons vm left right))
           (ring (ooparts/prolog/kernel/engine:fresh-cons vm :ring nil))
           (live (list left right late alias ring)))
      (setf (cdr ring) ring
            (aref (ooparts/prolog/kernel/model:machine-args vm) 3) alias
            (aref (ooparts/prolog/kernel/model:machine-args vm) 4) ring)
      (ooparts/prolog/kernel/engine:push-choice vm 0)
      (ooparts/prolog/kernel/engine:bind-var vm left ring)
      (ooparts/prolog/kernel/engine:fresh-cons vm :dead nil)
      (labels ((roots-intact-p ()
                 (let ((args (ooparts/prolog/kernel/model:machine-args vm))
                       (heap (ooparts/prolog/kernel/model:machine-heap vm)))
                   (and (= 5 (length heap))
                        (eq left (aref args 0)) (eq right (aref args 1))
                        (eq late (aref args 2)) (eq alias (aref args 3))
                        (eq ring (aref args 4))
                        (every (lambda (cell) (find cell heap :test #'eq)) live)
                        (eq left (car alias)) (eq right (cdr alias))
                        (eq ring (cdr ring))))))
        (unwind-protect
             (progn
               (check (= 1 (collect-query-garbage vm))
                      "nonmonotonic-ID fallback reclaims only the unrooted cons")
               (check (roots-intact-p)
                      "nonmonotonic-ID fallback retains exact roots, aliases, and cycles")
               (check (and (eq ring (ooparts/prolog/kernel/model:logic-var-binding left))
                           (eq ring (ooparts/prolog/kernel/engine:deref left))
                           (eq right (ooparts/prolog/kernel/model:logic-var-binding right))
                           (eq late (ooparts/prolog/kernel/model:logic-var-binding late)))
                      "nonmonotonic-ID fallback retains bindings")
               (check (ooparts/prolog/kernel/engine:backtrack vm)
                      "nonmonotonic-ID choice remains available")
               (check (and (roots-intact-p)
                           (eq left (ooparts/prolog/kernel/model:logic-var-binding left))
                           (eq right (ooparts/prolog/kernel/model:logic-var-binding right))
                           (eq late (ooparts/prolog/kernel/model:logic-var-binding late)))
                      "rollback after indexed-marker GC restores exact roots and bindings"))
          (close-query vm)))))
  ;; Large root graphs exercise in-place prefix remapping without losing aliases,
  ;; opaque host objects, or undo state around an older alternative.
  (let* ((vm (ooparts/prolog/kernel/model:%make-machine
              :args (make-array 2 :initial-element nil) :code #((yield))))
         (typed (make-array 3 :initial-contents '(:nominal 17 :opaque)))
         (variable (ooparts/prolog/kernel/engine:fresh-var vm))
         (typed-cell (ooparts/prolog/kernel/engine:fresh-cons vm typed nil))
         (chain typed-cell)
         left right alias)
    (unwind-protect
         (progn
           (loop repeat 20000 for index from 0 do
             (setf chain (ooparts/prolog/kernel/engine:fresh-cons vm index chain)))
           (setf left (ooparts/prolog/kernel/engine:fresh-cons vm :left chain)
                 right (ooparts/prolog/kernel/engine:fresh-cons vm :right chain)
                 alias (ooparts/prolog/kernel/engine:fresh-cons vm left right)
                 (aref (ooparts/prolog/kernel/model:machine-args vm) 0) alias
                 (aref (ooparts/prolog/kernel/model:machine-args vm) 1) variable)
           (loop repeat 3000 do
             (ooparts/prolog/kernel/engine:fresh-cons vm :dead-before typed))
           (ooparts/prolog/kernel/engine:push-choice vm 0)
           (ooparts/prolog/kernel/engine:bind-var vm variable alias)
           (loop repeat 3000 do
             (ooparts/prolog/kernel/engine:fresh-cons vm :dead-after typed))
           (check (= 6000 (collect-query-garbage vm)) "large roots retain only live cells")
           (check (= 20005 (length (ooparts/prolog/kernel/model:machine-heap vm)))
                  "large rooted DAG has exact managed extent")
           (check (and (eq (cdr left) (cdr right))
                       (eq typed (car typed-cell)))
                  "large-root aliases and typed payloads survive in-place GC")
           (check (and (= 20005 (ooparts/prolog/kernel/model:choice-heap
                                 (aref (ooparts/prolog/kernel/model:machine-choices vm) 0)))
                       (eq alias (ooparts/prolog/kernel/engine:deref variable)))
                  "choice heap and trail offsets use old prefix liveness")
           (check (ooparts/prolog/kernel/engine:backtrack vm) "large-root alternative resumes")
           (check (eq variable (ooparts/prolog/kernel/model:logic-var-binding variable))
                  "large-root rollback restores the old unbound cell")
           (let ((rebound (ooparts/prolog/kernel/engine:fresh-cons vm :rebound alias)))
             (ooparts/prolog/kernel/engine:bind-var vm variable rebound)
             (collect-query-garbage vm)
             (check (and (eq rebound (ooparts/prolog/kernel/engine:deref variable))
                         (eq alias (cdr rebound)))
                    "rebinding retains its alias after another compaction")))
      (close-query vm)))
  ;; A closed cursor retains neither heap, trail, continuation nor scan roots.
  (let ((vm (make-query '((product ?x ?y)) :gc-threshold 1)))
    (next-solution vm) (close-query vm)
    (check (and (zerop (length (ooparts/prolog/kernel/model:machine-heap vm)))
                (zerop (length (ooparts/prolog/kernel/model:machine-trail vm)))
                (null (ooparts/prolog/kernel/model:machine-scan vm))
                (null (ooparts/prolog/kernel/model:machine-continuation vm))) "closed cursor releases roots")))
