(uiop:define-package #:ooparts-tests/prolog/syntax/native
  (:use #:cl #:ooparts/prolog)
  (:import-from #:ooparts-tests/prolog/support/assertions #:check #:solutions #:value-of)
  (:import-from #:ooparts/prolog/syntax/native #:*native-enabled*)
  (:export #:run-native-tests))
(in-package #:ooparts-tests/prolog/syntax/native)

;;; Differential regressions for the JIT predicate specializer. Every semantic
;;; observation runs on a fresh database; :AUTO and :WAM are compared through
;;; the public cursor API, including ordered answers, exceptions and sharing.

(defvar *native-term-observations* 0)

(defun instrumented-term-instruction (vm op operands)
  "Provider replacement used to prove that instrumentation forces WAM execution."
  (incf *native-term-observations*)
  (funcall (symbol-function 'ooparts/prolog/kernel/wam:execute-term-instruction)
           vm op operands))

(defun native-possible-p ()
  "True when compiled execution is allowed in this process."
  (and *native-enabled*
       (not (equal (uiop:getenv "OOPARTS_PROLOG_DISABLE_NATIVE") "1"))))

(defun term-snapshot (term)
  (let ((*print-circle* t) (*print-pretty* nil) (*print-readably* nil)
        (*print-length* nil) (*print-level* nil) (*print-case* :downcase))
    (prin1-to-string term)))

(defun query-snapshots (goals database &key (gc-threshold 4096))
  (let ((vm (make-query goals :database database :gc-threshold gc-threshold))
        (result nil))
    (unwind-protect
         (loop (multiple-value-bind (solution foundp) (next-solution vm)
                 (unless foundp (return))
                 (push (term-snapshot solution) result)))
      (close-query vm))
    (nreverse result)))

(defun run-query (goals database &key (gc-threshold 4096))
  "Return answer records, truth values, delays and cursor statistics."
  (let ((vm (make-query goals :database database :gc-threshold gc-threshold))
        (results nil) (truths nil) (delays nil) (stats nil))
    (unwind-protect
         (loop (multiple-value-bind (solution foundp truth delay) (next-solution vm)
                 (unless foundp (return))
                 (push (cons truth (term-snapshot solution)) results)
                 (push truth truths) (push delay delays)))
      (setf stats (query-statistics vm))
      (close-query vm))
    (values (nreverse results) (nreverse truths) (nreverse delays) stats)))

(defun query-list (goals database &key (gc-threshold 4096))
  (multiple-value-list (run-query goals database :gc-threshold gc-threshold)))

(defun capture-error (thunk)
  (handler-case (progn (funcall thunk) :no-error)
    (iso-exception (condition) (term-snapshot (iso-exception-term condition)))
    (error (condition) (format nil "HOST-ERROR ~A" condition))))

(defun bag-items (bag model)
  "Decode a FINDALL bag under the live term model without copying it."
  (if (eq model :iso)
      (let ((items nil))
        (loop while (and (consp bag) (eq (car bag) '$cons))
              do (push (second bag) items) (setf bag (third bag)))
        (nreverse items))
      (copy-list bag)))

(defun ensure-test-package (name)
  (or (find-package name) (make-package name :use nil)))

(defun generated-atom (name)
  (intern name (find-package :ooparts/prolog/atoms)))

(defun database-cache (database)
  (ooparts/prolog/kernel/model:database-native-cache database))

(defun cache-table (database)
  (let ((cache (database-cache database)))
    (and cache (cdr cache))))

(defun cache-generation-valid-p (database)
  (let ((cache (database-cache database)))
    (or (null cache)
        (= (car cache) (ooparts/prolog/kernel/model:database-generation database)))))

(defun native-calls (stats) (getf stats :native-calls))
(defun native-deopts (stats) (getf stats :native-deoptimizations))

;;; 1. Public JIT smoke.
(defun test-public-smoke ()
  (let ((*database* (make-database :execution-mode :auto)))
    (load-prolog-string
     "fac(0,1) :- !. fac(N,R) :- N>0, M is N-1, fac(M,S), R is N*S.")
    (let ((vm (make-query '((fac 10 ?r)))))
      (unwind-protect
           (multiple-value-bind (solution foundp truth delays) (next-solution vm)
             (check foundp "fac(10,R) succeeds")
             (check (= 3628800 (value-of '?r solution)) "fac(10,R) = 3628800")
             (check (eq truth :true) "fac truth is :true")
             (check (null delays) "fac has no delayed goals")
             (when (native-possible-p)
               (check (plusp (native-calls (query-statistics vm)))
                      "fac call is handled natively")))
        (close-query vm)))
    (let ((table (cache-table *database*)))
      (when (native-possible-p)
        (check (and table (hash-table-p table)) "native mode cache is built")
        (loop for mode being the hash-values of table
              when mode do
                (check (compiled-function-p
                        (ooparts/prolog/syntax/native::native-mode-function mode))
                       "cached mode function is compiled"))
        (check (some (lambda (mode)
                       (and mode
                            (compiled-function-p
                             (ooparts/prolog/syntax/native::native-mode-function mode))))
                     (loop for mode being the hash-values of table collect mode))
               "at least one compiled mode is cached")))
    (let ((vm (make-query '((fac 10 ?r)))))
      (unwind-protect
           (check (= 3628800 (value-of '?r (next-solution vm)))
                  "second fac query answers")
        (close-query vm)))
    (when (native-possible-p)
      (let ((table (cache-table *database*)))
        (let ((vm (make-query '((fac 10 ?r)))))
          (unwind-protect
               (next-solution vm)
            (close-query vm)))
        (check (eq table (cache-table *database*))
               "second query reuses the compiled cache table"))))
  (let ((*database* (make-database :execution-mode :wam)))
    (load-prolog-string
     "fac(0,1) :- !. fac(N,R) :- N>0, M is N-1, fac(M,S), R is N*S.")
    (let ((vm (make-query '((fac 10 ?r)))))
      (unwind-protect
           (multiple-value-bind (solution foundp truth delays) (next-solution vm)
             (check foundp "wam fac succeeds")
             (check (= 3628800 (value-of '?r solution)) "wam fac result")
             (check (eq truth :true) "wam fac truth")
             (check (null delays) "wam fac delays")
             (let ((stats (query-statistics vm)))
               (check (zerop (native-calls stats)) "wam never calls native")
               (check (zerop (native-deopts stats)) "wam never deoptimizes")))
        (close-query vm)))
    (check (null (database-cache *database*)) "wam builds no native cache")))

;;; 2. Semidet failure and cut.
(defun semidet-data (model mode gc)
  (let* ((*database* (make-database :term-model model :execution-mode mode)))
    (load-prolog-string
     "p(X) :- X>0, !, fail. p(_). pick(a). pick(b). inner(X) :- pick(X), !.")
    (let ((pairs
            (mapcar (lambda (solution)
                      (list (value-of '?a solution) (value-of '?b solution)))
                    (query '((pick ?a) (inner ?b)) :database *database*
                            :gc-threshold gc))))
      (list (query-snapshots '((p 1)) *database* :gc-threshold gc)
            (query-snapshots '((p 0)) *database* :gc-threshold gc)
            (query-snapshots '((pick ?a) (inner ?b)) *database* :gc-threshold gc)
            pairs))))

(defun test-semidet ()
  (dolist (model '(:native :iso))
    (dolist (gc '(nil 1 8 64))
      (let ((auto (semidet-data model :auto gc))
            (wam (semidet-data model :wam gc)))
        (check (equal auto wam)
               (format nil "semidet ~A GC=~A agrees with WAM" model gc))
        (check (null (first auto)) "p(1) fails after a cut")
        (check (= 1 (length (second auto))) "p(0) succeeds")
        (check (equal (fourth auto) '((a a) (b a)))
               "cut preserves caller alternatives in order")
        (check (= 2 (length (third auto))) "two pick/inner answers")))))

;;; 3. No lookahead: errors surface only when the failing answer is requested.
(defun lazy-data (model mode gc)
  (let* ((*database* (make-database :term-model model :execution-mode mode)))
    (load-prolog-string "lazy(a). lazy(b) :- 1 is 1/0. dup(a). dup(a).")
    (let ((first nil) (raised nil))
      (let ((vm (make-query '((lazy ?x)) :database *database* :gc-threshold gc)))
        (unwind-protect
             (progn
               (multiple-value-bind (solution foundp) (next-solution vm)
                 (when foundp (setf first (value-of '?x solution))))
               (handler-case (next-solution vm)
                 (iso-exception (condition)
                   (setf raised (term-snapshot (iso-exception-term condition))))))
          (close-query vm)))
      (let ((limited (query '((lazy ?x)) :database *database* :limit 1
                            :gc-threshold gc))
            (dups (query '((dup ?x)) :database *database* :gc-threshold gc)))
        (list first raised
              (mapcar (lambda (solution) (value-of '?x solution)) limited)
              (length dups))))))

(defun test-lookahead ()
  (dolist (model '(:native :iso))
    (dolist (gc '(nil 1))
      (let ((auto (lazy-data model :auto gc))
            (wam (lazy-data model :wam gc)))
        (check (equal auto wam) "lazy cursor agrees with WAM")
        (check (eq (first auto) 'a) "first lazy answer is a")
        (check (stringp (second auto)) "second lazy answer raises an ISO exception")
        (check (equal (third auto) '(a)) "query :limit 1 returns only the first answer")
        (check (= 2 (fourth auto)) "duplicate answers are preserved")))))

;;; 4. FINDALL boundary: a known bag is rejected before generation.
(defun caught-term (text database)
  (let* ((term (first (parse-prolog-string text :database database)))
         (solutions (query (list term) :database database))
         (solution (first solutions))
         (entry (and solution
                     (find "?E" solution
                           :key (lambda (binding)
                                  (and (symbolp (car binding))
                                       (symbol-name (car binding))))
                           :test #'string=))))
    (and entry (term-snapshot (cdr entry)))))

(defun findall-data (model mode gc)
  (let* ((*database* (make-database :term-model model :execution-mode mode)))
    (load-prolog-string "g(a). p(B) :- findall(X, g(X), B).")
    (let* ((solutions (query '((p ?b)) :database *database* :gc-threshold gc))
           (bag (and solutions (value-of '?b (first solutions)))))
      (list (and bag (bag-items bag model))
            (caught-term "catch(p(foo),E,true)." *database*)
            (caught-term "catch(p([a|b]),E,true)." *database*)))))

(defun test-findall-boundary ()
  (dolist (model '(:native :iso))
    (dolist (gc '(nil 1))
      (let ((auto (findall-data model :auto gc))
            (wam (findall-data model :wam gc)))
        (check (equal auto wam)
               (format nil "findall boundary ~A GC=~A agrees with WAM" model gc))
        (check (equal (first auto) '(a)) "findall bag is [a]")
        (check (stringp (second auto)) "known scalar bag raises a type error")
        (check (stringp (third auto)) "known list bag raises a type error")))))

;;; 5. Collector graph isolation and identity preservation.
(defun collector-data (model mode gc)
  (let* ((*database* (make-database :term-model model :execution-mode mode)))
    (load-prolog-string
     "gen(f(a)). gen(f(a)). p(L) :- findall(X, gen(X), L).")
    (let* ((vm (make-query '((p ?l)) :database *database* :gc-threshold gc))
           (bag nil) (stats nil))
      (unwind-protect
           (multiple-value-bind (solution foundp) (next-solution vm)
             (when foundp (setf bag (value-of '?l solution)))
             (setf stats (query-statistics vm)))
        (close-query vm))
      (list (bag-items bag model) stats))))

(defun test-collector-isolation ()
  (dolist (model '(:native :iso))
    (dolist (gc '(nil 1))
      (let* ((auto (collector-data model :auto gc))
             (wam (collector-data model :wam gc))
             (auto-items (first auto))
             (wam-items (first wam)))
        (check (equal auto-items wam-items) "collector answers agree with WAM")
        (check (= 2 (length auto-items)) "both generator answers are collected")
        (check (equal (first auto-items) (second auto-items))
               "bag elements are structurally equal")
        (check (not (eq (first auto-items) (second auto-items)))
               "bag elements are distinct objects")
        (when (native-possible-p)
          (check (plusp (native-calls (second auto)))
                 "collector wrapper runs natively")))))
  ;; String atoms stay identical inside one answer root.
  (let* ((*database* (make-database))
         (text (copy-seq "identity-atom")))
    (ooparts/prolog/syntax/compiler:add-clause
     (list 'atomgen (list 'wrap text)) nil t *database*)
    (let* ((vm (make-query '((atomgen ?x)) :database *database*))
           (solution nil))
      (unwind-protect
           (multiple-value-bind (value foundp) (next-solution vm)
             (check foundp "atomgen succeeds")
             (setf solution value))
        (close-query vm))
      (let ((wrapped (value-of '?x solution)))
        (check (eq (second wrapped) text)
               "identity-sensitive atom is not duplicated"))))
  ;; Sharing inside one native answer survives the per-answer graph copy.
  (let* ((*database* (make-database))
         (leaf (list 'a))
         (shared (list 'f leaf leaf))
         (roots nil))
    (<-- (id ?a ?a))
    (<-- (collectdag ?s ?l) (findall ?y (id ?s ?y) ?l))
    (prolog (lisp ?s shared) (collectdag ?s ?l) (lisp (push ?l roots)))
    (let* ((bag (first roots))
           (item (first (bag-items bag :native))))
      (check (consp item) "collector produced a compound item")
      (check (equal item shared) "copied item is structurally equal")
      (check (not (eq item shared)) "collector copies the answer graph")
      (check (eq (second item) (third item))
             "sharing inside one answer is preserved"))))

;;; 6. Ground input aliases and graph-shaped source templates.
(defun echo2-alias-root (model mode)
  (let* ((*database* (make-database :term-model model :execution-mode mode))
         (shared (list 'a 'b))
         (roots nil))
    (<-- (echo2 ?a ?b ?a ?b))
    (prolog (lisp ?a shared)
            (= ?b ?a)
            (= ?root (bundle ?a ?b ?x ?y))
            (echo2 ?a ?b ?x ?y)
            (lisp (push ?root roots)))
    (first roots)))

(defun echo2-distinct-root (model mode)
  (let* ((*database* (make-database :term-model model :execution-mode mode))
         (first-graph (list 'a 'b))
         (second-graph (list 'a 'b))
         (roots nil))
    (<-- (echo2 ?a ?b ?a ?b))
    (prolog (lisp ?a first-graph) (lisp ?b second-graph)
            (= ?root (bundle ?a ?b ?x ?y))
            (echo2 ?a ?b ?x ?y)
            (lisp (push ?root roots)))
    (first roots)))

(defun pair-root (model mode)
  (let* ((*database* (make-database :term-model model :execution-mode mode)))
    (<-- (pairsame ?x ?x))
    (value-of '?r
              (first (query '((= ?r (bundle ?a ?b)) (pairsame ?a ?b))
                            :database *database*)))))

(defun source-graph-data (model mode)
  (let* ((*database* (make-database :term-model model :execution-mode mode))
         (leaf (list 'a))
         (dag (list 'dagsrc (list 'pair leaf leaf)))
         (cyclic (list 'f)))
    (setf (cdr cyclic) cyclic)
    (ooparts/prolog/syntax/compiler:add-clause dag nil t *database*)
    (ooparts/prolog/syntax/compiler:add-clause
     (list 'cycsrc cyclic) nil t *database*)
    (list (query-snapshots '((dagsrc ?x)) *database*)
          (query-snapshots '((cycsrc ?x)) *database*))))

(defun boundary-data (model mode gc)
  (let ((*database* (make-database :term-model model :execution-mode mode)))
    (<-- (same ?x ?x))
    (list
     ;; Bound cell inside a ground cons input.
     (query-snapshots '((= ?c (f ?x)) (= ?x a) (same ?c ?out))
                      *database* :gc-threshold gc)
     ;; Open tail input.
     (query-snapshots '((= ?c (f ?tail)) (same ?c ?out))
                      *database* :gc-threshold gc)
     ;; Cyclic input.
     (query-snapshots '((= ?c (f ?c)) (same ?c ?out))
                      *database* :gc-threshold gc))))

(defun test-ground-aliases ()
  (dolist (model '(:native :iso))
    (dolist (mode '(:auto :wam))
      (let ((root (echo2-alias-root model mode)))
        (check (= 5 (length root)) "one compound alias result root")
        (check (eq (second root) (third root))
               "first two aliases share one object")
        (check (eq (second root) (fourth root))
               "first output alias reuses the input object")
        (check (eq (second root) (fifth root))
               "second output alias reuses the input object")
        (check (equal (second root) '(a b)) "aliased input contents")))
    (dolist (mode '(:auto :wam))
      (let ((root (echo2-distinct-root model mode)))
        (check (not (eq (second root) (third root)))
               "distinct equal input graphs stay distinct")
        (check (equal (second root) (third root))
               "distinct input graphs remain structurally equal")
        (check (eq (second root) (fourth root))
               "first output keeps its first input")
        (check (eq (third root) (fifth root))
               "second output keeps its second input")))
    (dolist (mode '(:auto :wam))
      (let ((root (pair-root model mode)))
        (check (eq (second root) (third root))
               "pair(X,X) aliased outputs share one object")))
    (dolist (gc '(nil 1))
      (let ((auto (boundary-data model :auto gc))
            (wam (boundary-data model :wam gc)))
        (check (equal auto wam)
               (format nil "graph boundary cases ~A GC=~A agree with WAM"
                       model gc))
        (check (= 3 (length auto)) "boundary observations produced")))
    (let ((auto (source-graph-data model :auto))
          (wam (source-graph-data model :wam)))
      (check (equal auto wam) "graph-shaped source templates agree with WAM")
      (check (stringp (first (first auto))) "DAG head produced a term")
      (check (stringp (first (second auto))) "cyclic head produced a term"))))

;;; 7. Atomic head matching and canonical name bridging.
(defun nil-cut-data (mode gc)
  (let ((*database* (make-database :execution-mode mode)))
    (load-prolog-string "niltest(nil) :- !. niltest(other).")
    (query-snapshots (list (list 'niltest (generated-atom "nil")))
                     *database* :gc-threshold gc)))

(defun two-package-data (model mode)
  (let* ((*database* (make-database :term-model model :execution-mode mode))
         (one (ensure-test-package "OOPARTS-NATIVE-TEST-ONE"))
         (two (ensure-test-package "OOPARTS-NATIVE-TEST-TWO"))
         (atom (generated-atom "foo")))
    (ooparts/prolog/syntax/compiler:add-clause
     (list 'twopkg (intern "FOO" one) 'first) '(true) t *database*)
    (ooparts/prolog/syntax/compiler:add-clause
     (list 'twopkg (intern "FOO" two) 'second) '(true) nil *database*)
    (let ((goals (list (list 'twopkg atom '?o))))
      (list (mapcar (lambda (solution) (value-of '?o solution))
                    (query goals :database *database*))
            (query-snapshots goals *database*)))))

(defun test-atom-matching ()
  (dolist (gc '(nil 1))
    (let ((auto (nil-cut-data :auto gc))
          (wam (nil-cut-data :wam gc)))
      (check (equal auto wam) "NIL-pattern cut agrees with WAM")
      (check (= 1 (length auto)) "generated nil atom matches the NIL pattern")))
  (dolist (model '(:native :iso))
    (let ((auto (two-package-data model :auto))
          (wam (two-package-data model :wam)))
      (check (equal auto wam)
             (format nil "two-package head symbols agree with WAM (~A)" model))
      (check (equal (first auto) '(first second))
             "both same-named head symbols answer in source order")
      (check (eq (first (first auto)) 'first) "first output atom identity")
      (check (eq (second (first auto)) 'second) "second output atom identity"))))

;;; 8. Transactional bailout and recursion bounds.
(defun depth-bailout-data (mode limit)
  (let ((*database* (make-database :execution-mode mode))
        (ooparts/prolog/syntax/native::*native-depth-limit* limit))
    (load-prolog-string
     "deepc(0, done) :- !. deepc(N, done) :- M is N-1, deepc(M, done).")
    (query-list '((deepc 5 ?r)) *database*)))

(defun fuel-bailout-data (mode limit)
  (let ((*database* (make-database :execution-mode mode))
        (ooparts/prolog/syntax/native::*native-fuel-limit* limit))
    (load-prolog-string
     "deepc(0, done) :- !. deepc(N, done) :- M is N-1, deepc(M, done).")
    (query-list '((deepc 5 ?r)) *database*)))

(defun answer-bailout-data (mode limit)
  (let ((*database* (make-database :execution-mode mode))
        (ooparts/prolog/syntax/native::*native-answer-limit* limit))
    (load-prolog-string
     "g2(a). g2(b). g2(c). p3(L) :- findall(X, g2(X), L).")
    (query-list '((p3 ?l)) *database*)))

(defun cut-bailout-data (mode)
  (let ((*database* (make-database :execution-mode mode)))
    (load-prolog-string
     "step(_) :- 1 is 1 mod 0. trans(X) :- X = f(a), !, step(X).")
    (let ((vm (make-query '((trans ?x)) :database *database*))
          (error nil) (stats nil))
      (unwind-protect
           (handler-case (next-solution vm)
             (iso-exception (condition)
               (setf error (term-snapshot (iso-exception-term condition)))))
        (setf stats (query-statistics vm))
        (close-query vm))
      (list error stats))))

(defun test-bailout ()
  (dolist (limit '(2 8))
    (let* ((auto (depth-bailout-data :auto limit))
           (wam (depth-bailout-data :wam limit)))
      (check (equal (first auto) (first wam)) "depth bailout replays the WAM answer")
      (check (equal (first auto) '((:true . "((?r . done))")))
             "depth bailout returns the complete answer")
      (when (and (native-possible-p) (= limit 2))
        (check (plusp (native-deopts (fourth auto)))
               "depth bailout increments deoptimizations"))))
  (let* ((auto (fuel-bailout-data :auto 5))
         (wam (fuel-bailout-data :wam 5)))
    (check (equal (first auto) (first wam)) "fuel bailout replays the WAM answer")
    (when (native-possible-p)
      (check (plusp (native-deopts (fourth auto))) "fuel bailout is counted")))
  (let* ((auto (answer-bailout-data :auto 1))
         (wam (answer-bailout-data :wam 1)))
    (check (equal (first auto) (first wam)) "answer bailout replays the WAM bag")
    (let* ((snapshot (cdr (first (first auto))))
           (bag (cdr (assoc '?l (read-from-string snapshot)))))
      (check (equal bag '(a b c))
             "replayed bag contains every answer"))
    (when (native-possible-p)
      (check (plusp (native-deopts (fourth auto))) "answer bailout is counted")))
  (let* ((auto (cut-bailout-data :auto))
         (wam (cut-bailout-data :wam)))
    (check (equal (first auto) (first wam))
           "arithmetic bailout after a cut preserves the WAM outcome")
    ;; Hosts differ on integer division by zero (ECL returns the dividend), so
    ;; the native path must reproduce the interpreted outcome rather than assume
    ;; one exception shape.
    (when (stringp (first wam))
      (check (stringp (first auto)) "bailing arithmetic raises the same exception"))
    (when (native-possible-p)
      (check (plusp (native-deopts (second auto)))
             "arithmetic bailout after a cut is counted"))
    (when (native-possible-p)
      (check (plusp (native-deopts (second auto)))
             "cut bailout is counted")))
  ;; Default caps: pure recursion near and beyond the logical depth limit.
  (let ((*database* (make-database)))
    (load-prolog-string
     "tdown(0) :- !. tdown(N) :- M is N-1, tdown(M).
      ntdown(0) :- !. ntdown(N) :- M is N-1, ntdown(M), true.")
    (dolist (predicate '(tdown ntdown))
      ;; The depth cap must hand deep pure recursion back to the WAM instead of
      ;; growing the host stack, so a six-figure input still answers.
      (dolist (depth '(255 256 257 1000 100000))
        (let ((result (query-snapshots (list (list predicate depth)) *database*)))
          (check (= 1 (length result)) "pure recursion succeeds at depth")
          (check (equal result '("nil")) "pure recursion answer"))))))

;;; 9. Mutation and cache lifetime.
(defun test-mutation ()
  (let ((*database* (make-database)))
    (<-- (base 1))
    (<-- (wrap ?x) (base ?x))
    (check (equal (query-snapshots '((wrap ?x)) *database*) '("((?x . 1))"))
           "warm wrapper answers")
    (<-- (base 2))
    (check (equal (query-snapshots '((wrap ?x)) *database*) '("((?x . 2))"))
           "new queries see the replacement dependency"))
  (let ((*database* (make-database)))
    (<-- (unsup ?x) (lisp ?x 7))
    (<-- (caller ?x) (unsup ?x))
    (check (equal (query-snapshots '((caller ?x)) *database*) '("((?x . 7))"))
           "unsupported host dependency still answers")
    (<-- (unsup 3))
    (let ((results (query-list '((caller ?x)) *database*)))
      (check (equal (first results) '((:true . "((?x . 3))")))
             "replaced pure dependency becomes answerable")
      (when (native-possible-p)
        (check (plusp (native-calls (fourth results)))
               "previously rejected caller becomes compilable"))))
  ;; Bailout suppression is qualified by generation inside one cursor.
  (let ((*database* (make-database))
        (ooparts/prolog/syntax/native::*native-depth-limit* 2))
    (load-prolog-string
     "qdeep(0) :- !. qdeep(N) :- M is N-1, qdeep(M).")
    (let* ((mutate
             (ooparts/prolog/kernel/model:make-host-goal
              :function (lambda () (<-- (qdeep 1)) :mutated)
              :arguments nil :output nil :testp nil))
           (results (query-list (list '(qdeep 1000) mutate '(qdeep ?x))
                               *database*)))
      (check (string= (cdr (first (first results))) "((?x . 1))")
             "generation change discards bailout suppression")
      (when (native-possible-p)
        (check (plusp (native-calls (fourth results)))
               "second call after mutation uses a fresh native mode")
        (check (plusp (native-deopts (fourth results)))
               "first call deoptimized before the mutation"))))
  ;; Dynamic state, table declarations and clearing do not leak compiled modes.
  (let ((*database* (make-database)))
    (<-- (warmfact (leaf a)))
    (let ((results (query-list '((warmfact (leaf a))) *database*)))
      (check (= 1 (length (first results))) "warmfact succeeds")
      (when (native-possible-p)
        (check (plusp (native-calls (fourth results))) "warmfact native call")))
    (load-prolog-string ":- dynamic(dyn/1). dyn(1). dyn(2).")
    (check (= 2 (length (query '((dyn ?x)) :database *database*)))
           "dynamic facts enumerate")
    (query (list (list 'assertz (list 'dyn 3))) :database *database*)
    (check (= 3 (length (query '((dyn ?x)) :database *database*)))
           "assertz adds a fact")
    (query (list (list 'retract (list 'dyn 2))) :database *database*)
    (check (equal (mapcar (lambda (solution) (value-of '?x solution))
                          (query '((dyn ?x)) :database *database*))
                  '(1 3))
           "retract removes one fact")
    (query (list (list 'abolish (list '/ 'dyn 1))) :database *database*)
    (check (null (gethash (cons 'dyn 1)
                          (ooparts/prolog/kernel/model:database-predicates
                           *database*)))
           "abolish removes the predicate")
    (when (native-possible-p)
      (check (not (cache-generation-valid-p *database*))
             "mutations invalidate the cached generation"))
    (<-- (tp a))
    (<- (tp b))
    (table 'tp 1 *database*)
    (check (= 2 (length (query '((tp ?x)) :database *database*)))
           "tabled predicate answers")
    (check (gethash (cons 'tp 1)
                    (ooparts/prolog/kernel/model:database-tabled *database*))
           "table declaration is visible")
    (untable 'tp 1 *database*)
    (check (= 2 (length (query '((tp ?x)) :database *database*)))
           "untabled predicate answers")
    (check (null (gethash (cons 'tp 1)
                          (ooparts/prolog/kernel/model:database-tabled *database*)))
           "untable removes the declaration")
    (clear-database *database*)
    (check (null (database-cache *database*)) "clear-database drops compiled modes")
    (check (zerop (hash-table-count
                   (ooparts/prolog/kernel/model:database-predicates *database*)))
           "clear-database drops user predicates"))
  (let ((*database* (make-database)))
    (<-- (pick3 a)) (<- (pick3 b))
    (let ((vm (make-query '((pick3 ?x)) :database *database*)))
      (unwind-protect
           (progn
             (check (eq 'a (value-of '?x (next-solution vm)))
                    "first in-flight answer")
             (<-- (pick3 c))
             (check (eq 'b (value-of '?x (next-solution vm)))
                    "active alternatives retain the old clause snapshot")
             (check (not (nth-value 1 (next-solution vm)))
                    "old snapshot has no third answer"))
        (close-query vm))))
  ;; Separate term-model databases keep independent compiled state.
  (let ((native-db (make-database))
        (iso-db (make-database :term-model :iso)))
    (let ((*database* native-db))
      (load-prolog-string
       "fac(0,1) :- !. fac(N,R) :- N>0, M is N-1, fac(M,S), R is N*S.")
      (check (= 120 (value-of '?r (first (query '((fac 5 ?r))
                                               :database native-db))))
             "native-model factorial"))
    (let ((*database* iso-db))
      (load-prolog-string
       "fac(0,1) :- !. fac(N,R) :- N>0, M is N-1, fac(M,S), R is N*S.")
      (check (= 120 (value-of '?r (first (query '((fac 5 ?r))
                                               :database iso-db))))
             "iso-model factorial")
      (when (native-possible-p)
        (check (not (eq (database-cache native-db) (database-cache iso-db)))
               "databases do not share compiled modes")))))

;;; 10. Instrumentation forces WAM and restoration re-enables native modes.
(defun test-instrumentation ()
  (let* ((*database* (make-database))
         (dispatcher 'ooparts/prolog/kernel/wam:execute-term-instruction)
         (interface 'ooparts/prolog/kernel/protocol:execute-term-instruction))
    (<-- (puremark a))
    (<- (puremark b))
    (let ((warm (query-list '((puremark a)) *database*)))
      (check (= 1 (length (first warm))) "pure predicate warms")
      (when (native-possible-p)
        (check (plusp (native-calls (fourth warm))) "warm-up is native")))
    (let ((original (symbol-function dispatcher)) (seen 0))
      (unwind-protect
           (progn
             (setf (symbol-function dispatcher)
                   (lambda (vm op operands)
                     (incf seen) (funcall original vm op operands)))
             (let ((observed (query-list '((puremark a)) *database*)))
               (check (equal (first observed) '((:true . "nil")))
                      "instrumented dispatcher still answers")
               (check (plusp seen) "WAM observes the wrapped dispatcher")))
        (setf (symbol-function dispatcher) original)))
    (let ((restored (query-list '((puremark a)) *database*)))
      (when (native-possible-p)
        (check (plusp (native-calls (fourth restored)))
               "native execution resumes after restoring the dispatcher")))
    (let ((original (ooparts/prolog/kernel/protocol:provider-symbol interface))
          (before *native-term-observations*))
      (unwind-protect
           (progn
             (ooparts/prolog/kernel/protocol:register-provider
              interface 'instrumented-term-instruction)
             (let ((observed (query-list '((puremark a)) *database*)))
               (check (equal (first observed) '((:true . "nil")))
                      "replaced provider still answers")
               (check (> *native-term-observations* before)
                      "WAM observes the replaced provider")))
        (ooparts/prolog/kernel/protocol:register-provider interface original)))
    (let ((restored (query-list '((puremark a)) *database*)))
      (when (native-possible-p)
        (check (plusp (native-calls (fourth restored)))
               "native execution resumes after restoring the provider")))
    ;; Install and restore from a host callback between two calls in one cursor.
    (let ((original (symbol-function dispatcher)) (seen 0) (done nil))
      (unwind-protect
           (progn
             (prolog (puremark a)
                     (lisp (setf (symbol-function dispatcher)
                                 (lambda (vm op operands)
                                   (incf seen) (funcall original vm op operands))))
                     (puremark a)
                     (lisp (setf (symbol-function dispatcher) original))
                     (lisp (push :done done)))
             (check (plusp seen)
                    "instrumentation between two cursor calls is observed")
             (check (equal done '(:done)) "cursor completed after restoration"))
        (setf (symbol-function dispatcher) original)))))

;;; 11. Forced managed garbage collection around published native output.
(defun test-gc ()
  (let* ((*database* (make-database))
         (text (copy-seq "gc-atom")))
    (ooparts/prolog/syntax/compiler:add-clause
     (list 'gcstring (list 'wrap text)) nil t *database*)
    (<-- (gcgen 1)) (<- (gcgen 2))
    (<-- (gcstep 1 a)) (<- (gcstep 2 b))
    (let ((vm (make-query '((gcstring ?x)) :database *database* :gc-threshold 1)))
      (unwind-protect
           (multiple-value-bind (solution foundp) (next-solution vm)
             (check foundp "gcstring succeeds")
             (let ((wrapped (value-of '?x solution)))
               (check (eq (second wrapped) text)
                      "atom identity after native publication")
               (collect-query-garbage vm)
               (check (eq (second wrapped) text)
                      "atom identity survives forced GC")))
        (close-query vm)))
    (let ((vm (make-query '((gcgen ?n) (gcstep ?n ?v))
                          :database *database* :gc-threshold 1))
          (values nil))
      (unwind-protect
           (loop (multiple-value-bind (solution foundp) (next-solution vm)
                   (unless foundp (return))
                   (push (value-of '?v solution) values)
                   (collect-query-garbage vm)))
        (close-query vm))
      (check (equal (nreverse values) '(a b))
             "native answers remain valid across between-answer GC"))
    ;; A failed speculative output leaves the VM ownership vectors untouched.
    (<-- (bigfail ?x) (= ?x (node a b c d e)) fail)
    (let ((results (query-list '((bigfail ?x)) *database*)))
      (check (null (first results)) "bigfail fails logically")
      (check (< (getf (fourth results) :heap-cells) 1000)
             "speculative output is not adopted by the VM"))))

;;; 12. High arity declines before compilation.
(defun test-high-arity ()
  (let ((*database* (make-database)))
    (load-prolog-string
     "quad(a,b,c,d). quadw(A,B,C,D) :- quad(A,B,C,D).")
    (let ((ooparts/prolog/syntax/native::*native-arity-limit* 2))
      (let ((auto (query-list '((quad a b c d)) *database*))
            (wrapper (query-list '((quadw a b c d)) *database*)))
        (check (equal (first auto) '((:true . "nil")))
               "high-arity fact answers in auto")
        (check (equal (first wrapper) '((:true . "nil")))
               "high-arity wrapper answers in auto")
        (check (zerop (native-calls (fourth auto)))
               "high arity declines before native execution")
        (when (native-possible-p)
          (let ((table (cache-table *database*)))
            (multiple-value-bind (value present)
                (gethash (list 'quad 4 15 nil) table)
              (check (and present (null value))
                     "oversized mode is a cached rejection"))))))))

;;; 13. SLG and arithmetic boundaries.
(defun slg-data (model mode)
  (let ((*database* (make-database :term-model model :execution-mode mode)))
    (load-prolog-string
     "edge(a,b). edge(b,c). path(X,Y) :- edge(X,Y).
      path(X,Y) :- edge(X,Z), path(Z,Y). wrap(X,Y) :- path(X,Y).")
    (table 'path 2 *database*)
    (list (query '((path a ?y)) :database *database*)
          (query-snapshots '((wrap a ?y)) *database*))))

(defun arithmetic-data (model mode)
  (let ((*database* (make-database :term-model model :execution-mode mode)))
    (load-prolog-string
     "badmod(X) :- X is 1 mod 0. badfloat(F,X) :- X is F mod 2.")
    (list (capture-error (lambda ()
                           (query '((badmod ?x)) :database *database*)))
          (capture-error (lambda ()
                           (query (list 'badfloat 1.5 '?x)
                                  :database *database*))))))

(defun test-slg-and-arithmetic ()
  (dolist (model '(:native :iso))
    (let ((auto (slg-data model :auto))
          (wam (slg-data model :wam)))
      (check (equal auto wam) "tabled dependency agrees with WAM")
      (check (= 2 (length (first auto))) "tabled path has two answers")
      (check (equal (mapcar (lambda (solution) (value-of '?y solution))
                            (first auto))
                    '(b c))
             "tabled answers keep source order"))
    (let ((auto (arithmetic-data model :auto))
          (wam (arithmetic-data model :wam)))
      (check (equal auto wam)
             (format nil "arithmetic boundaries agree with WAM (~A)" model))
      ;; Interpreted integer division-by-zero is host dependent (ECL returns the
      ;; dividend); the native path must match whatever the WAM produces.
      (when (stringp (first wam))
        (check (stringp (first auto)) "zero divisor preserves the exception"))
      (when (stringp (second wam))
        (check (stringp (second auto)) "float operand preserves the exception")))))

;;; 14. Every semantic case runs regardless of native availability; only the
;;; execution-specific assertions above are gated by NATIVE-POSSIBLE-P.
(defun run-native-tests ()
  (let ((*package* (find-package '#:ooparts-tests/prolog/syntax/native))
        (start (symbol-value 'ooparts-tests/prolog/support/assertions:*checks*)))
    (test-public-smoke)
    (test-semidet)
    (test-lookahead)
    (test-findall-boundary)
    (test-collector-isolation)
    (test-ground-aliases)
    (test-atom-matching)
    (test-bailout)
    (test-mutation)
    (test-instrumentation)
    (test-gc)
    (test-high-arity)
    (test-slg-and-arithmetic)
    (format t "~D native specializer checks passed.~%"
            (- (symbol-value 'ooparts-tests/prolog/support/assertions:*checks*)
               start))
    t))
