(uiop:define-package #:ooparts-tests/readline
  (:use #:cl)
  (:import-from #:ooparts/readline)
  (:import-from #:ooparts/readline/editor)
  (:import-from #:ooparts/readline/terminal)
  (:import-from #:ooparts/curses/api)
  (:import-from #:ooparts/curses/terminfo)
  (:export #:run-tests))
(in-package #:ooparts-tests/readline)

(defun run-tests ()
  (let ((checks 0))
    (labels ((check (value) (incf checks) (unless value (error "Readline check ~D failed." checks)))
             (edited (text cursor keys &optional history completion)
               (let ((e (ooparts/readline/editor:make-editor
                         :text text :cursor cursor :history history :completion completion)))
                 (dolist (key keys) (ooparts/readline/editor:apply-key e key)) e))
             (text (e) (ooparts/readline/editor:editor-text e))
             (cursor (e) (ooparts/readline/editor:editor-cursor e)))
      (check (equal "abc" (text (edited "ac" 1 '(#\b)))))
      (check (equal "ac" (text (edited "abc" 2 (list (code-char 127))))))
      (check (equal "ac" (text (edited "abc" 1 '(:delete)))))
      (check (= 0 (cursor (edited "a" 0 '(:left :left)))))
      (check (= 1 (cursor (edited "a" 1 '(:right :right)))))
      (check (equal "XabcY" (text (edited "abc" 1 (list :home #\X :end #\Y)))))
      (check (equal "one " (text (edited "one two" 7 (list (code-char 23))))))
      (check (equal "one two" (text (edited "one two" 4 (list (code-char 11) (code-char 25))))))
      (check (equal "one two" (text (edited "one two" 4 (list (code-char 21) (code-char 25))))))
      (check (= 4 (cursor (edited "one two" 7 '(:backward-word)))))
      (check (= 3 (cursor (edited "one two" 0 '(:forward-word)))))
      (check (equal "two" (text (edited "one two" 0 '(:delete-word :delete)))))
      (check (equal "acb" (text (edited "abc" 3 (list (code-char 20))))))
      (check (equal "bac" (text (edited "abc" 1 (list (code-char 20))))))
      (check (equal "draft" (text (edited "draft" 5 '(:up :up :down :down) '("new" "old")))))
      (check (equal "old" (text (edited "draft" 5 '(:up :up :up) '("new" "old")))))
      (let ((e (edited "" 0 nil)))
        (check (eq :eof (ooparts/readline/editor:apply-key e (code-char 4))))
        (check (eq :abort (ooparts/readline/editor:apply-key e (code-char 3))))
        (check (eq :accept (ooparts/readline/editor:apply-key e #\Return))))
      (check (equal "a b" (text (edited "" 0 (list (cons :paste (format nil "a~Cb~C" #\Newline (code-char 27))))))))
      (let ((complete (lambda (prefix) (declare (ignore prefix)) '("hello" "help" "other"))))
        (check (equal "hel" (text (edited "he" 2 (list #\Tab) nil complete))))
        (check (equal "say hel!" (text (edited "say he!" 6 (list #\Tab) nil complete)))))
      (let ((e (edited "draft" 5 (list (code-char 18) #\o #\l #\d) '("new" "old value"))))
        (check (equal "old value" (text e)))
        (ooparts/readline/editor:apply-key e :escape)
        (check (equal "draft" (text e))))
      (let ((e (edited "" 0 (list (code-char 18) #\x (code-char 18) #\Return)
                       '("xx newest" "xx older"))))
        (check (equal "xx older" (text e)))
        (check (null (ooparts/readline/editor:editor-search-query e))))
      (check (= 3 (ooparts/readline/editor:display-width "abc")))
      (check (= (ooparts/curses/api:text-width (string (code-char #x754c)))
                (ooparts/readline/editor:display-width (string (code-char #x754c)))))
      (loop for columns from 4 to 20 do
        (let ((e (edited "012345678901234567890123456789" 30 nil)))
          (multiple-value-bind (line position) (ooparts/readline/editor:render-line e "long prompt> " columns)
            (check (< (ooparts/readline/editor:display-width line) columns))
            (check (< position columns)))))
      (let ((h (ooparts/readline:make-history :limit 2)))
        (dolist (s '("a" "b" "b" "" "c")) (ooparts/readline:add-history s h))
        (check (equal '("c" "b") (ooparts/readline:history-entries h)))
        (ooparts/readline:clear-history h)
        (check (null (ooparts/readline:history-entries h))))
      (let ((h (ooparts/readline:make-history :limit 0)))
        (ooparts/readline:add-history "x" h)
        (check (null (ooparts/readline:history-entries h))))
      (let ((output (make-string-output-stream)) (h (ooparts/readline:make-history)))
        (check (equal "abc" (ooparts/readline:readline "> " :input (make-string-input-stream (format nil "abc~%"))
                                                     :output output :history h)))
        (check (equal "> " (get-output-stream-string output)))
        (check (equal '("abc") (ooparts/readline:history-entries h)))
        (check (eq :done (ooparts/readline:readline "" :input (make-string-input-stream "")
                                                    :output output :eof-value :done)))
        (check (handler-case
                   (progn (ooparts/readline:readline "" :input (make-string-input-stream "")
                                                    :output output :eof-error-p t) nil)
                 (end-of-file () t)))
        (check (handler-case
                   (progn (ooparts/readline:readline "" :input (make-string-input-stream "x")
                                                    :output output :edit t) nil)
                 (error () t))))
      (uiop:with-temporary-file (:pathname path :stream stream)
        (close stream)
        (let ((h (ooparts/readline:make-history)) (restored (ooparts/readline:make-history)))
          (ooparts/readline:add-history "first" h) (ooparts/readline:add-history "second" h)
          (ooparts/readline:write-history path h) (ooparts/readline:read-history path restored)
          (check (equal (ooparts/readline:history-entries h) (ooparts/readline:history-entries restored)))))
      ;; Exercise the shared Curses decoder on finite streams, without touching a TTY.
      (dolist (case (list (list (format nil "~C[D" (code-char 27)) :left)
                         (list (format nil "~Cb" (code-char 27)) :backward-word)
                         (list (format nil "~C[200~~a~Cb~C[201~~" (code-char 27) #\Newline (code-char 27))
                               (cons :paste (format nil "a~Cb" #\Newline)))
                         (list "" :eof)))
        (let* ((input (make-string-input-stream (first case)))
               (terminal (ooparts/readline/terminal::make-terminal :input input)))
          (ooparts/curses/api:with-screen (:native nil :input input :output (make-broadcast-stream))
            (ooparts/curses/api:noecho)
            (ooparts/curses/api:keypad ooparts/curses/api:*stdscr* t)
            (ooparts/curses/api:set-escdelay 1)
            (check (equal (second case) (ooparts/readline/terminal:read-key terminal 0))))))
      (format t "~&Readline: ~D checks passed.~%" checks)
      t)))
