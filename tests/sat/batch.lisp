(uiop:define-package #:ooparts-tests/sat/batch
  (:use #:cl)
  (:import-from #:ooparts/sat/low-level)
  (:import-from #:ooparts-tests/sat/stats)
  (:export #:main))
(in-package #:ooparts-tests/sat/batch)
(defun main (path)
 (let ((id 0))
  (with-open-file (in path)
    (loop for n = (read in nil nil) while n do
      (let ((m (read in)) (limit (read in)))
        (ooparts/sat/low-level:with-solver (s)
          (ooparts/sat/low-level:satch-reserve s n)
          (dotimes (i m)
            (loop for lit = (read in) do (ooparts/sat/low-level:satch-add s lit) until (zerop lit)))
          (let* ((start (get-internal-real-time))
                 (status (ooparts/sat/low-level:satch-solve s limit)))
            (declare (ignore start))
            (format t "~D ~D ~D" id status (ooparts/sat/low-level:satch-conflicts s))
            (dolist (v (ooparts-tests/sat/stats:test-statistics s)) (format t " ~D" v))
            (when (= status 10) (loop for i from 1 to n do (format t " ~D" (ooparts/sat/low-level:satch-val s i))))
            (terpri) (finish-output) (incf id)))))))
)
