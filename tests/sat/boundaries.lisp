(uiop:define-package #:ooparts-tests/sat/boundaries
  (:use #:cl)
  (:import-from #:ooparts/sat/runtime)
  (:import-from #:ooparts/sat/low-level)
  (:export #:run-tests))
(in-package #:ooparts-tests/sat/boundaries)
(defun run-tests ()
(let ((checks 0))
  (flet ((check (value) (incf checks) (assert value))
         (errors-p (thunk) (handler-case (progn (funcall thunk) nil) (error () t))))
    (check (= (ooparts/sat/runtime:c-u64 -1) 18446744073709551615))
    (check (= (ooparts/sat/runtime:c-s64 18446744073709551615) -1))
    (check (= (ooparts/sat/runtime:c-s32 2147483648) -2147483648))
    (check (= (ooparts/sat/runtime:c-u32 -1) 4294967295))
    (macrolet ((check-wrap (operation bits signed)
                 (let* ((top (1- (ash 1 (if signed (1- bits) bits))))
                        (bottom (if signed (- (ash 1 (1- bits))) 0)))
                   `(let ((word ,top))
                      (check (and (= (,operation word) ,bottom) (= word ,bottom)))
                      (check (and (= (,operation word -1) ,top) (= word ,top)))))))
      (check-wrap ooparts/sat/runtime:u8-incf 8 nil)
      (check-wrap ooparts/sat/runtime:u16-incf 16 nil)
      (check-wrap ooparts/sat/runtime:u32-incf 32 nil)
      (check-wrap ooparts/sat/runtime:u64-incf 64 nil)
      (check-wrap ooparts/sat/runtime:s8-incf 8 t)
      (check-wrap ooparts/sat/runtime:s16-incf 16 t)
      (check-wrap ooparts/sat/runtime:s32-incf 32 t)
      (check-wrap ooparts/sat/runtime:s64-incf 64 t))
    (let ((words (vector 255)) (place-evaluations 0) (delta-evaluations 0))
      (check (= 0 (ooparts/sat/runtime:u8-incf
                    (aref words (progn (incf place-evaluations) 0))
                    (progn (incf delta-evaluations) 1))))
      (check (= place-evaluations 1))
      (check (= delta-evaluations 1))
      (check (= (aref words 0) 0)))
    (dolist (n '(0 1 4294967295 4294967296 9007199254740991 9007199254740992
                9007199254740993 9223372036854775807 18446744073709551615))
      (check (= (ooparts/sat/runtime:integer64-double n nil) (float n 1d0))))
    (dolist (n '(-9223372036854775808 -9007199254740993 -4294967297 -1 0 1 9223372036854775807))
      (check (= (ooparts/sat/runtime:integer64-double n t) (float n 1d0))))
    ;; Signed element distances also cover unaligned packed-array starts and
    ;; non-power-of-two element widths; these are independent expected values.
    (check (= 3 (ooparts/sat/runtime:pointer-difference 15 3 4)))
    (check (= -3 (ooparts/sat/runtime:pointer-difference 3 15 4)))
    (check (= 0 (ooparts/sat/runtime:pointer-difference 7 7 8)))
    (check (= -5 (ooparts/sat/runtime:pointer-difference 3 8 1)))
    (check (= 3 (ooparts/sat/runtime:pointer-difference 75 3 24)))
    (check (= -3 (ooparts/sat/runtime:pointer-difference 3 75 24)))
    ;; Maximum uint64 is a valid sentinel, but never a physical arena size or pointer.
    (let ((cell (ooparts/sat/runtime:c-malloc 16)))
      (unwind-protect
           (progn
             (setf (ooparts/sat/runtime:m-u64 cell) 18446744073709551615)
             (check (= (ooparts/sat/runtime:m-u64 cell) 18446744073709551615))
             (check (errors-p (lambda () (ooparts/sat/runtime:m-size cell))))
             (check (errors-p (lambda () (ooparts/sat/runtime:m-ptr cell))))
             (setf (ooparts/sat/runtime:m-u64 cell) ooparts/sat/runtime:+heap-size+)
             (check (= (ooparts/sat/runtime:m-size cell) ooparts/sat/runtime:+heap-size+)))
        (ooparts/sat/runtime:c-free cell)))
    (multiple-value-bind (clauses n)
        (with-input-from-string (in (coerce (format nil "p cnf 1 1~%1 0~%") 'simple-base-string))
          (ooparts/sat/low-level:read-dimacs in))
      (check (and (= n 1) (equal clauses '((1)))))))
  (format t "Numeric/representation boundaries: ~D checks passed.~%" checks))

)
