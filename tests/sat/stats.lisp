(uiop:define-package #:ooparts-tests/sat/stats
  (:use #:cl #:ooparts/sat/layout)
  (:export #:test-statistics))
(in-package #:ooparts-tests/sat/stats)
(defun test-statistics (solver)
  (let ((statistics (solver-statistics solver)))
    (list (statistics-decisions statistics)
          (statistics-propagations statistics)
          (statistics-ticks statistics)
          (statistics-reductions statistics)
          (statistics-restarts statistics)
          (statistics-switched statistics)
          (statistics-rephased statistics)
          (statistics-eliminations statistics)
          (statistics-vivifications statistics))))
