;;; Focused, deterministic SML frontend tests.  RUN-LEXER-TESTS is intentionally
;;; an explicit entry point rather than a global test-registry side effect.
(uiop:define-package #:ooparts-tests/sml/lexer
  (:use #:cl)
  (:import-from #:ooparts/test #:with-suite #:check #:signals)
  (:import-from #:ooparts/sml/source
    #:make-source #:make-span #:source-text #:source-name
    #:source-span-start #:source-span-end #:position-offset
    #:position-line #:position-column #:sml-lexical-error)
  (:import-from #:ooparts/sml/syntax
    #:make-identifier #:make-ast-node #:ast-node-p
    #:ast-node-kind #:ast-node-span #:ast-node-slots #:ast-ref
    #:identifier-path #:identifier-name #:qualified-identifier-p
    #:real-literal-negative-p #:real-literal-significand #:real-literal-scale
    #:literal-kind #:literal-value #:literal-base)
  (:import-from #:ooparts/sml/lexer
    #:tokenize #:token-kind #:token-text #:token-value #:token-span
    #:reserved-word-p #:equality-type-variable-p #:numeric-label-p)
  (:export #:run-lexer-tests))
(in-package #:ooparts-tests/sml/lexer)

(defun %lex (text &optional (source-name "<test>"))
  (tokenize text :source-name source-name))

(defun %tokens (text)
  (let ((tokens (%lex text)))
    (coerce (subseq tokens 0 (1- (length tokens))) 'list)))

(defun %kinds (text)
  (mapcar #'token-kind (%tokens text)))

(defun %texts (text)
  (mapcar #'token-text (%tokens text)))

(defun %only-literal (text)
  (let ((tokens (%lex text)))
    (check (= (length tokens) 2)
           "Literal ~S should produce one token and EOF, got ~S." text tokens)
    (token-value (aref tokens 0))))

(defun %check-source-spans ()
  (let* ((input (copy-seq (format nil "  let~%x")))
         (source (make-source input :name "positions.sml"))
         (tokens (tokenize source))
         (let-token (aref tokens 0))
         (x-token (aref tokens 1))
         (eof-token (aref tokens 2)))
    (setf (char input 0) #\X)
    (check (string= (source-text source) (format nil "  let~%x"))
           "MAKE-SOURCE must retain private source text.")
    (check (string= (source-name source) "positions.sml")
           "Source names must be preserved.")
    (check (equalp (map 'list #'token-kind tokens)
                   '(:keyword :identifier :eof))
           "Unexpected token sequence in span fixture.")
    (let ((start (source-span-start (token-span let-token)))
          (end (source-span-end (token-span let-token))))
      (check (= (position-offset start) 2) "LET starts at offset 2.")
      (check (= (position-line start) 1) "LET starts on line 1.")
      (check (= (position-column start) 3) "LET starts in column 3.")
      (check (= (position-offset end) 5) "LET ends at exclusive offset 5.")
      (check (= (position-column end) 6) "LET ends in column 6."))
    (let ((start (source-span-start (token-span x-token))))
      (check (= (position-offset start) 6) "X starts after the newline.")
      (check (= (position-line start) 2) "X is on line 2.")
      (check (= (position-column start) 1) "X is in column 1."))
    (let ((end (source-span-end (token-span eof-token))))
      (check (= (position-offset end) 7) "EOF is at the input length.")
      (check (= (position-line end) 2) "EOF remains on the final line.")
      (check (= (position-column end) 2) "EOF follows the final character."))
    (let* ((span (make-span source 0 0))
           (identifier (make-identifier '("A" "value") span)))
      (check (equal (identifier-path identifier) '("A" "value"))
             "Identifier paths preserve component order.")
      (check (string= (identifier-name identifier) "value")
             "IDENTIFIER-NAME is the final component.")
      (check (qualified-identifier-p identifier)
             "Multi-component identifiers are qualified.")
      (let ((node (make-ast-node :identifier-expression span
                                 :identifier identifier :op-p nil)))
        (check (ast-node-p node) "The constructor returns a native AST node.")
        (check (and (listp node) (= (length node) 4) (eq (first node) :node)
                    (eq (ast-node-kind node) :identifier-expression)
                    (eq (ast-node-span node) span))
               "AST nodes are exactly (:NODE KIND SPAN SLOTS).")
        (check (equal (ast-node-slots node)
                      (list (cons :identifier identifier) (cons :op-p nil)))
               "AST slots preserve construction order and dotted entries.")
        (check (eq (ast-ref node :identifier) identifier)
               "AST-REF returns stored leaf values.")
        (check (eq (ast-ref node :missing :absent) :absent)
               "AST-REF distinguishes missing keys from present NIL values."))))
  t)

(defun %check-identifiers-and-keywords ()
  (check (equal (%kinds "val x = 1;")
                '(:keyword :identifier :identifier :integer :keyword))
         "Reserved declarations tokenize before qualified-name validation.")
  (let ((tokens (%lex "let letx val1 _ = == | || A.x A.B.+ 'a ''b #1 01")))
    (check
     (equal (subseq (map 'list #'token-kind tokens) 0 15)
            '(:keyword :identifier :identifier :keyword :identifier
              :identifier :keyword :identifier :identifier :identifier
              :tyvar :tyvar :keyword :integer :integer))
     "Identifier, keyword, type variable, and numeric-label token kinds differ.")
    (check (equal (identifier-path (token-value (aref tokens 8))) '("A" "x"))
           "One qualification level is one identifier token.")
    (check (equal (identifier-path (token-value (aref tokens 9))) '("A" "B" "+"))
           "Symbolic final components retain all qualifiers.")
    (check (qualified-identifier-p (token-value (aref tokens 8)))
           "Qualified identifiers are inspectable.")
    (check (not (equality-type-variable-p (aref tokens 10)))
           "One prime is an ordinary type variable.")
    (check (equality-type-variable-p (aref tokens 11))
           "Two primes form an equality type variable.")
    (check (numeric-label-p (aref tokens 13)) "1 is a numeric label.")
    (check (not (numeric-label-p (aref tokens 14)))
           "A zero-prefixed numeral is not a numeric label.")
    (check (reserved-word-p "=") "= remains a reserved spelling.")
    (check (eq (token-kind (aref tokens 4)) :identifier)
           "The exact = token remains usable as an identifier."))
  (let ((spelling "( ) [ ] { } , : ; ... _ | => -> :> #"))
    (check (every (lambda (kind) (eq kind :keyword)) (%kinds spelling))
           "All reserved punctuation has :KEYWORD kind.")
    (check (equal (%texts spelling)
                  '("(" ")" "[" "]" "{" "}" "," ":" ";" "..." "_" "|" "=>" "->" ":>" "#"))
           "Reserved punctuation text is preserved."))
  (check (equal (%kinds "let letx => =>= --> 0wx12 1.0E2 A.x")
                '(:keyword :identifier :keyword :identifier :identifier
                  :word :real :identifier))
         "Longest match prevents reserved, word, real, and qualifier prefixes.")
  (check (equal (%kinds "(* outer (* inner *) still *)val")
                '(:keyword))
         "Nested comments act as formatting.")
  (check (equal (%kinds "\"(*)\"") '(:string))
         "Comment brackets inside strings are literal characters.")
  t)

(defun %check-integers-and-words ()
  (dolist (case '(("0" 0 10) ("123" 123 10) ("~123" -123 10)
                  ("~123456789012345678901234567890"
                   -123456789012345678901234567890 10)
                  ("0x0" 0 16) ("0xdeadBEEF" #xdeadBEEF 16)
                  ("~0x2a" -42 16)))
    (destructuring-bind (text value base) case
      (let ((literal (%only-literal text)))
        (check (eq (literal-kind literal) :integer)
               "~S should be an integer literal." text)
        (check (= (literal-value literal) value)
               "Wrong integer value for ~S: ~S." text (literal-value literal))
        (check (= (literal-base literal) base)
               "Wrong integer base for ~S." text))))
  (dolist (case '(("0w0" 0 10) ("0w42" 42 10)
                  ("0wxff" 255 16) ("0wxDEADbeef" #xDEADbeef 16)))
    (destructuring-bind (text value base) case
      (let ((literal (%only-literal text)))
        (check (eq (literal-kind literal) :word)
               "~S should be a word literal." text)
        (check (= (literal-value literal) value)
               "Wrong word value for ~S." text)
        (check (= (literal-base literal) base)
               "Wrong word base for ~S." text))))
  t)

(defun %check-real-components (text negative significand scale)
  (let ((literal (%only-literal text)))
    (check (eq (literal-kind literal) :real) "~S should be a real literal." text)
    (check (eq (real-literal-negative-p (literal-value literal)) negative)
           "Wrong sign for ~S." text)
    (check (= (real-literal-significand (literal-value literal)) significand)
           "Wrong real significand for ~S: ~S." text
           (real-literal-significand (literal-value literal)))
    (check (= (real-literal-scale (literal-value literal)) scale)
           "Wrong real scale for ~S: ~S." text
           (real-literal-scale (literal-value literal)))))

(defun %check-reals ()
  (%check-real-components "0.0" nil 0 -1)
  (%check-real-components "~12.34" t 1234 -2)
  (%check-real-components "3.32E5" nil 332 3)
  (%check-real-components "3E~7" nil 3 -7)
  (%check-real-components "1e2" nil 1 2)
  (%check-real-components "0.50e~1" nil 50 -3)
  t)

(defun %check-strings-and-characters ()
  (let ((literal (%only-literal "\"\"")))
    (check (eq (literal-kind literal) :string) "Empty strings retain their class.")
    (check (string= (literal-value literal) "") "Empty strings decode to empty values."))
  (let ((literal (%only-literal "\"simple text\"")))
    (check (string= (literal-value literal) "simple text")
           "Printable string characters and spaces decode unchanged."))
  (let ((literal (%only-literal "\"\\a\\b\\t\\n\\v\\f\\r\"")))
    (check (equal (map 'list #'char-code (literal-value literal))
                  '(7 8 9 10 11 12 13))
           "All seven simple control escapes have ASCII values."))
  (let ((input (format nil "\"\\~C\\~C\"" #\" #\\))
        (expected (coerce (list #\" #\\) 'string)))
    (check (string= (literal-value (%only-literal input)) expected)
           "Escaped quotes and backslashes decode literally."))
  (check (string= (literal-value (%only-literal "\"A\\065\\u0041\"")) "AAA")
         "Raw, decimal, and Unicode forms can all denote A.")
  (check (string= (literal-value (%only-literal "\"\\000\""))
                  (string (code-char 0)))
         "Decimal zero decodes to a NUL character.")
  (check (= (char-code (literal-value (%only-literal "#\"\\^@\""))) 0)
         "Control-@ decodes to NUL in a character literal.")
  (check (= (char-code (literal-value (%only-literal "#\"\\^A\""))) 1)
         "Control-A decodes to character code one.")
  (check (= (char-code (literal-value (%only-literal "#\"\\255\""))) 255)
         "Decimal escape 255 is the inclusive upper byte bound.")
  (check (= (char-code (literal-value (%only-literal "#\"\\u00ff\""))) 255)
         "Unicode escape 00FF is the inclusive upper byte bound.")
  (let ((literal (%only-literal "#\"a\"")))
    (check (eq (literal-kind literal) :character) "#\"a\" is a character literal.")
    (check (char= (literal-value literal) #\a) "Character values are host characters."))
  (check (char= (literal-value (%only-literal "#\"\\n\"")) #\Newline)
         "Character literals use string escape decoding.")
  (let ((continued (format nil "\"ab\\~%  \\cd\"")))
    (check (string= (literal-value (%only-literal continued)) "abcd")
           "Backslash-formatting-backslash continuations emit no characters."))
  t)

(defun %check-rejections ()
  (signals sml-lexical-error (%lex "(* outer (* inner *)"))
  (signals sml-lexical-error (%lex "\"unclosed"))
  (signals sml-lexical-error (%lex "#\"unclosed"))
  (dolist (text '("\"\\x\"" "\"\\^a\"" "\"\\12\"" "\"\\u12x4\""
                  "\"\\256\"" "\"\\u0100\"" "#\"\"" "#\"ab\""
                  ".." "0x" "0w" "0wx" "~0x" "1E" "1e+" "1."))
    (signals sml-lexical-error (%lex text)))
  (signals sml-lexical-error (%lex (format nil "\"raw~Ctab\"" #\Tab)))
  (signals sml-lexical-error (%lex (string (code-char 0))))
  (let ((character (code-char 256)))
    (when character
      (signals sml-lexical-error (%lex (string character)))))
  (signals sml-lexical-error (%lex "let.A"))
  t)

(defun run-lexer-tests ()
  "Run the SML source, syntax-value, and deterministic lexer regression suite."
  (with-suite ("ooparts-tests/sml/lexer")
    (%check-source-spans)
    (%check-identifiers-and-keywords)
    (%check-integers-and-words)
    (%check-reals)
    (%check-strings-and-characters)
    (%check-rejections))
  t)
