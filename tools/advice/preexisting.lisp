;;; Compile fixtures before loading the advice library. Declarations are local
;;; to each function, so the host's global default compiler policy is retained.
(when (find-package "OOPARTS/ADVICE")
  (error "Preexisting-code fixtures must be compiled before loading OOPArts advice."))
(let ((directory (uiop:ensure-directory-pathname
                  (or (uiop:getenv "OOPARTS_ADVICE_AUDIT_DIRECTORY") "build/advice/preexisting/"))))
  (dolist (policy '(:default :fast :inline))
    (let* ((package-name (format nil "OOPARTS-ADVICE-PREEXISTING-~A" policy))
           (package (make-package package-name :use '(#:cl)))
           (target (intern "TARGET" package))
           (caller (intern "CALLER" package))
           (getter (intern "GETTER" package))
           (source (merge-pathnames (format nil "preexisting-~(~A~).lisp" policy) directory))
           (declarations (unless (eq policy :default)
                           '((declare (optimize (speed 3) (debug 0) (safety 1)))))))
      (ensure-directories-exist source)
      (with-open-file (out source :direction :output :if-exists :supersede)
        (dolist (form (append `((in-package ,package-name))
                             (when (eq policy :inline) `((declaim (inline ,target))))
                             `((defun ,target (x) ,@declarations (values (1+ x) :secondary))
                               (defun ,caller (x) ,@declarations (,target x))
                               (defun ,getter (x) ,@declarations (funcall (fdefinition ',target) x)))))
          (write form :stream out :readably t) (terpri out)))
      (load (compile-file source)))))
