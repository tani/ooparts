(require "asdf")
(asdf:load-asd (truename "ooparts.asd"))
(asdf:load-system "ooparts/curses")
(with-open-file (out "docs/curses/API.md" :direction :output :if-exists :supersede)
  (format out "# Public API~%~%Generated by `tools/curses/inventory.lisp` from the public package.~%~%")
  (dolist (kind '(:function :macro :variable))
    (format out "## ~A~%~%" (string-capitalize kind))
    (let ((symbols nil))
      (do-external-symbols (symbol :ooparts/curses)
        (when (ecase kind
                (:function (and (fboundp symbol) (not (macro-function symbol))))
                (:macro (macro-function symbol))
                (:variable (boundp symbol)))
          (push symbol symbols)))
      (dolist (symbol (sort symbols #'string< :key #'symbol-name))
        (format out "- `~A`~%" (string-downcase (symbol-name symbol))))
      (unless (eq kind :variable) (terpri out)))))
