(require "asdf")
(asdf:load-asd (truename "ooparts.asd"))
(asdf:load-system "ooparts/curses")
;; CMUCL defaults to Latin-1 independently of LANG. Configure the character
;; streams explicitly, as required by the UTF-8 terminal API contract.
#+cmucl
(setf (lisp:stream-external-format system:*stdin*) :utf-8
      (lisp:stream-external-format system:*stdout*) :utf-8)
(unless (ooparts/curses/ffi:native-available-p)
  (format t "~&CURSES-NATIVE-UNAVAILABLE: host built without FFI support~%")
  (uiop:quit 77))
;; Sample after runtime initialization: some hosts adjust their own TTY flags.
;; The library must restore its entry state, independently of host startup/exit.
(format t "~&CURSES-BASELINE~%") (force-output)
(read-char *standard-input*)
(let ((caught nil))
  (handler-case
      (ooparts/curses:with-screen (:input *standard-input* :output *standard-output*)
        (assert (integerp (ooparts/curses:baudrate)))
        (assert (characterp (ooparts/curses:erasechar)))
        (assert (characterp (ooparts/curses:killchar)))
        (ooparts/curses:noqiflush)
        (ooparts/curses:meta ooparts/curses:*stdscr* nil)
        (ooparts/curses:timeout 3000)
        (format t "~&CURSES-OPTIONS~%") (force-output)
        (assert (= (char-code #\q) (ooparts/curses:getch)))
        (ooparts/curses:qiflush)
        (ooparts/curses:meta ooparts/curses:*stdscr* t)
        (ooparts/curses:raw)
        (ooparts/curses:keypad ooparts/curses:*stdscr* t)
        (ooparts/curses:timeout 3000)
        (assert (= 24 ooparts/curses:*lines*))
        (assert (= 80 ooparts/curses:*cols*))
        (ooparts/curses:mvaddstr 2 0
          (concatenate 'string (ooparts/curses/model:codepoint-string #x1f469)
                       (string (code-char #x200d)) (ooparts/curses/model:codepoint-string #x1f4bb)))
        (ooparts/curses:refresh)
        (format t "~&CURSES-READY~%") (force-output)
        (assert (= ooparts/curses:+key-up+ (ooparts/curses:getch)))
        (assert (char= (code-char #x754c) (ooparts/curses:get-wch)))
        (format t "~&CURSES-RESIZE~%") (force-output)
        (assert (= ooparts/curses:+key-resize+ (ooparts/curses:getch)))
        (assert (= 30 ooparts/curses:*lines*))
        (assert (= 90 ooparts/curses:*cols*))
        (ooparts/curses:cbreak)
        (format t "~&CURSES-CBREAK~%") (force-output)
        (assert (= (char-code #\q) (ooparts/curses:getch)))
        (error "deliberate-unwind"))
    (error (condition)
      (if (search "deliberate-unwind" (princ-to-string condition)) (setf caught t) (error condition))))
  (assert caught)
  (format t "~&CURSES-RESTORED~%") (force-output)
  (read-char *standard-input*))
