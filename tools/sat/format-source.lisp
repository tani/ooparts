;;; Format generated Lisp with the implementation's standard pretty printer.
(require :asdf)
(let ((*compile-verbose* nil) (*load-verbose* nil))
  (asdf:load-asd (merge-pathnames "../../ooparts.asd" *load-truename*))
  (asdf:load-system "ooparts/sat/layout"))
(defun simplify-sequences (form)
  (cond ((atom form) form)
        ((member (car form) '(quote tagbody)) form)
        ((eq (car form) 'progn)
         (let ((forms (loop for item in (cdr form)
                            for clean = (simplify-sequences item)
                            append (if (and (consp clean) (eq (car clean) 'progn))
                                       (cdr clean) (list clean)))))
           (case (length forms) (0 nil) (1 (first forms)) (t (cons 'progn forms)))))
        (t (mapcar #'simplify-sequences form))))
(defun format-generated-source (path)
  (let ((temporary (make-pathname :type "formatted" :defaults path))
        (*package* (find-package :cl-user))
        (*read-eval* nil) (*print-pretty* t) (*print-case* :downcase)
        (*print-right-margin* 100) (*print-circle* nil))
    (unwind-protect
         (progn
           (with-open-file (input path)
             (with-open-file (output temporary :direction :output :if-exists :supersede)
               (loop
                 (loop for ch = (peek-char nil input nil nil)
                       while (and ch (or (find ch '(#\Space #\Tab #\Newline #\Return))
                                         (char= ch #\;)))
                       do (if (char= ch #\;)
                              (write-line (read-line input) output)
                              (read-char input)))
                 (let ((form (read input nil :end)))
                   (when (eq form :end) (return))
                   (when (member (car form) '(uiop:define-package in-package)) (eval form))
                   (pprint (simplify-sequences form) output)
                   (terpri output)))))
           (uiop:rename-file-overwriting-target temporary path))
      (when (probe-file temporary) (delete-file temporary)))))
(dolist (path (uiop:command-line-arguments)) (format-generated-source (pathname path)))
