(require :asdf)
(let ((root (merge-pathnames "../" (uiop:pathname-directory-pathname *load-truename*))))
  (asdf:load-asd (merge-pathnames "ooparts.asd" root))
  (asdf:load-asd (merge-pathnames "ooparts-tests.asd" root)))
(let ((component (or (first (uiop:command-line-arguments)) "all")))
  (if (string= component "all")
      (asdf:test-system "ooparts-tests")
      (let ((system (concatenate 'string "ooparts-tests/" component)))
        (asdf:load-system system)
        (uiop:symbol-call (find-package (string-upcase system)) :run-tests))))
